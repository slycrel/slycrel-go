program ai_test;uses	crt;{$I AI.INC}var	map: maprec;	player: playerrec;	monster: monstrec;	cellmap: weightmaprec;	lastlowest: integer;	head: lookupptr;procedure initcellmap;	var		r, c: byte;	begin		for r := 1 to 12 do			for c := 1 to 48 do				begin					cellmap[r, c].weight := 32700;					cellmap[r, c].direction := ' ';					cellmap[r, c].chosen := false;				end;		lastlowest := 32700;		head := nil;	end;function weightpos (testch: char): integer;	begin		if (testch = '-') or (testch = '|') or (testch = '#') then			weightpos := 100;		if (testch = '.') then			weightpos := 1;		if (testch = '+') then			weightpos := 3;	end;procedure dellookupcell (pos: coord);	var		currp, delptr: lookupptr;		found: boolean;	begin		currp := head;		found := false;		if (currp^.pos.r = pos.r) and (currp^.pos.c = pos.c) then			begin				delptr := currp;				currp := currp^.next;				head := currp;				dispose(delptr);			end		else			begin				repeat					if (currp^.next^.pos.r = pos.r) and (currp^.next^.pos.c = pos.c) then						found := true					else						currp := currp^.next;				until (found) or (currp^.next = nil);				delptr := currp^.next;				currp^.next := currp^.next^.next;				dispose(delptr);			end;	end;procedure addlookupcell (pos: coord);	var		currp, newp: lookupptr;		found: boolean;	begin		if head = nil then			begin				new(head);				head^.next := nil;				head^.pos := pos;			end		else if (cellmap[head^.pos.r, head^.pos.c].weight > (cellmap[pos.r, pos.c].weight)) then			begin				new(newp);				newp^.pos := pos;				newp^.next := head;				head := newp;			end		else			begin				new(newp);				newp^.pos := pos;				newp^.next := nil;				currp := head;				found := false;				repeat					if (currp^.next = nil) then						begin							found := true;							currp^.next := newp;						end					else if (cellmap[currp^.next^.pos.r, currp^.next^.pos.c].weight) > (cellmap[newp^.pos.r, newp^.pos.c].weight) then						begin							newp^.next := currp^.next;							currp^.next := newp;							found := true;						end					else						currp := currp^.next;				until found;			end;{else}	end;{procedure findlowestweight (var pos: coord);}{    var}{    r, c: byte;}{    lowestcell: integer;}{begin}{    lowestcell := lastlowest + 1;}{    for r := 1 to 12 do}{    for c := 1 to 48 do}{    begin}{    if (not cellmap[r, c].chosen) and (cellmap[r, c].weight < lowestcell) then}{    begin}{    lowestcell := cellmap[r, c].weight;}{    pos.x := c;}{    pos.y := r;}{    if (lastlowest = lowestcell) then}{    break;}{    end;}{    end;}{    lastlowest := lowestcell;}{end;}procedure checkfordupes (pos: coord);	var		currp: lookupptr;		found: boolean;	begin		currp := head;		found := false;		while (currp^.next <> nil) and (not found) do			begin				if (currp^.pos.r = pos.r) and (currp^.pos.c = pos.c) then					begin						dellookupcell(pos);						found := true;					end;				currp := currp^.next;			end;	end;procedure findlowestweight (var pos: coord);	begin		pos := head^.pos;		dellookupcell(pos);	end;function findroute (dest: coord): boolean;	var		tmpdirection: char;		currpos, tmppos: coord;		counter: word;{Postcondition	:	string which contains full route to destination}{Result					: round in privates^^.route;}{									if dest was found, return true }	begin		initcellmap;		currpos.x := monster.xpos;		currpos.y := monster.ypos;		cellmap[currpos.r, currpos.c].chosen := true;		cellmap[currpos.r, currpos.c].weight := weightpos(map[currpos.r, currpos.c]);		counter := 0;		repeat			gotoxy(30, 23);			write(' FR: ', counter);			counter := counter + 1;  {UP}			if currpos.r - 1 > 0 then				if (not cellmap[currpos.r - 1, currpos.c].chosen) and (cellmap[currpos.r, currpos.c].weight + weightpos(map[currpos.r - 1, currpos.c]) < cellmap[currpos.r - 1, currpos.c].weight) then					begin						cellmap[currpos.r - 1, currpos.c].weight := cellmap[currpos.r, currpos.c].weight + weightpos(map[currpos.r - 1, currpos.c]);						cellmap[currpos.r - 1, currpos.c].direction := 'D';						tmppos := currpos;						dec(tmppos.r);						checkfordupes(tmppos);						addlookupcell(tmppos);						gotoxy(currpos.c, currpos.r - 1);						write(cellmap[currpos.r - 1, currpos.c].weight mod 9)					end;  {DOWN}			if currpos.r + 1 < 13 then				if (not cellmap[currpos.r + 1, currpos.c].chosen) and (cellmap[currpos.r, currpos.c].weight + weightpos(map[currpos.r + 1, currpos.c]) < cellmap[currpos.r + 1, currpos.c].weight) then					begin						cellmap[currpos.r + 1, currpos.c].weight := cellmap[currpos.r, currpos.c].weight + weightpos(map[currpos.r + 1, currpos.c]);						cellmap[currpos.r + 1, currpos.c].direction := 'U';						tmppos := currpos;						inc(tmppos.r);						checkfordupes(tmppos);						addlookupcell(tmppos);						gotoxy(currpos.c, currpos.r + 1);						write(cellmap[currpos.r + 1, currpos.c].weight mod 9)					end;  {LEFT}			if currpos.c - 1 > 0 then				if not cellmap[currpos.r, currpos.c - 1].chosen and (cellmap[currpos.r, currpos.c].weight + weightpos(map[currpos.r, currpos.c - 1]) < cellmap[currpos.r, currpos.c - 1].weight) then					begin						cellmap[currpos.r, currpos.c - 1].weight := cellmap[currpos.r, currpos.c].weight + weightpos(map[currpos.r, currpos.c - 1]);						cellmap[currpos.r, currpos.c - 1].direction := 'R';						tmppos := currpos;						dec(tmppos.c);						checkfordupes(tmppos);						addlookupcell(tmppos);						gotoxy(currpos.c - 1, currpos.r);						write(cellmap[currpos.r, currpos.c - 1].weight mod 9)					end;  {RIGHT}			if currpos.c + 1 < 49 then				if not cellmap[currpos.r, currpos.c + 1].chosen and (cellmap[currpos.r, currpos.c].weight + weightpos(map[currpos.r, currpos.c + 1]) < cellmap[currpos.r, currpos.c + 1].weight) then					begin						cellmap[currpos.r, currpos.c + 1].weight := cellmap[currpos.r, currpos.c].weight + weightpos(map[currpos.r, currpos.c + 1]);						cellmap[currpos.r, currpos.c + 1].direction := 'L';						tmppos := currpos;						inc(tmppos.c);						checkfordupes(tmppos);						addlookupcell(tmppos);						gotoxy(currpos.c + 1, currpos.r);						write(cellmap[currpos.r, currpos.c + 1].weight mod 9);					end;			findlowestweight(currpos);			cellmap[currpos.r, currpos.c].chosen := true;			gotoxy(currpos.c, currpos.r);			textcolor(12);			write('+');			textcolor(7);		until (currpos.r = dest.r) and (currpos.c = dest.c) or (counter >= 1050);		if counter >= 1050 then			findroute := false		else			findroute := true; {put string, switch and reverse}		monster.route := '';		repeat			case cellmap[currpos.r, currpos.c].direction of				'U': 					begin						currpos.r := currpos.r - 1;						tmpdirection := 'D';					end;				'D': 					begin						currpos.r := currpos.r + 1;						tmpdirection := 'U';					end;				'L': 					begin						currpos.c := currpos.c - 1;						tmpdirection := 'R';					end;				'R': 					begin						currpos.c := currpos.c + 1;						tmpdirection := 'L';					end;			end;			monster.route := concat(tmpdirection, monster.route);		until (currpos.x = monster.xpos) and (currpos.y = monster.ypos);	end;procedure tc (f, b: byte);	begin		textcolor(f);		textbackground(b);	end;procedure out (x, y: byte; ch: char);	begin		gotoxy(x, y);		write(ch);	end;procedure mapfiltout (x, y: byte; ch: char);	var		color: shortint;		oldc: byte;	begin		oldc := textattr;		gotoxy(x, y);		color := -1;		case ch of			'.': 				color := 8;			'|', '-': 				color := 14;			'#': 				color := 2;			' ': 				color := 0;			'+': 				color := 7;		end;		if color = -1 then			begin				ch := #				32;				color := 0;			end;		textcolor(color);		write(ch);		textattr := oldc;	end;procedure quit;	begin		tc(7, 0);		clrscr;		writeln('Thanks for testing.');		writeln;		halt;	end;procedure initializeplayers;	var		x: byte;	begin		with player do			begin				name := PLAYERNAME;				moves := PLAYERMOVES;			end;		with monster do			begin				moves := MONSTERMOVES;				xpos := 24;				ypos := 7;				gotoxy(xpos, ypos);				write('M');			end;	end;procedure readmap;	var		f: text;		r, c: byte;	begin		assign(f, 'map.dat');		reset(f);		for r := 1 to 12 do			for c := 1 to 50 do				begin					read(f, map[r, c]);{    if (map[r,c] = #13) or (map[r,c] = #10) then map[r,c] := #32;}				end;		close(f);	end;procedure displaymap;	var		r, c: byte;	begin		tc(7, 0);		clrscr;		for r := 1 to 12 do			for c := 1 to 48 do				mapfiltout(c, r, map[r, c]);	end;{-route routines----------------------}procedure fire_yn;	begin	end;procedure domonstermoves;	var		startpos: coord;		playpos: coord;		indx: byte;		found: boolean;	begin		monster.moves := MONSTERMOVES;		playpos.r := player.ypos;		playpos.c := player.xpos;		found := findroute(playpos);		if not found then			exit;		indx := 0;		repeat			inc(indx);  {fireyn}			out(monster.xpos, monster.ypos, map[monster.ypos, monster.xpos]);			case monster.route[indx] of				'U': 					dec(monster.ypos);				'D': 					inc(monster.ypos);				'L': 					dec(monster.xpos);				'R': 					inc(monster.xpos);			end;			out(monster.xpos, monster.ypos, 'M');			delay(250);			monster.moves := monster.moves - weightpos(map[monster.ypos, monster.xpos]);			gotoxy(1, 18);			write(' Monster Movement: ', monster.moves, ' ');		until (indx = length(monster.route)) or (monster.moves < 1);	end;procedure doplayermoves;	var		oldr, oldc: byte;	begin {player.moves := PLAYERMOVES;}		oldr := player.ypos;		oldc := player.xpos;		gotoxy(1, 22);		write('X coord: ');		clreol;		readln(player.xpos);		if player.xpos = 0 then			quit;		write('Y coord: ');		clreol;		readln(player.ypos);		out(oldc, oldr, map[oldr, oldc]);		out(player.xpos, player.ypos, 'P');	end;{-------------------------------------}begin	readmap;	initializeplayers;	repeat		displaymap;		out(monster.xpos, monster.ypos, 'M');		out(player.xpos, player.ypos, 'P');		doplayermoves;		domonstermoves;	until 3 = 4;end.