procedure MoveMonster (var R, C, Ru, Cu: integer; Monster: MonsterRec; TheTerr: TerrainType; var HermSetup: UserXIPtr);type	MovementRec = record			Path: str255;			MovementCost: integer;		end;var	dist: real;	st1, st2: str255;	Temp: integer;begin	with HermSetup^ do		begin			dist := sqrt(sqr(abs(R - Ru)) + sqr(abs(C - Cu)));			NumToString(R + 2, st1);			NumToString(C + 2, st2);			ANSICode(concat(st1, ';', st2, 'H'), procs[vANSICode]);			ANSICode(GetTerrChar(TheTerr[R, C], True), procs[vANSICode]);			if dist < 4 then				begin					if rnd(1, 10, HermSetup) < 6 then						begin							repeat								Temp := (rnd(1, 3, HermSetup) - 2);							until Temp <> 0;							r := r + Temp;							if not (NumMovePoints(R, C, TheTerr) < Monster.Movement) then								r := r - Temp;						end					else						begin							repeat								Temp := (rnd(1, 3, HermSetup) - 2);							until temp <> 0;							c := c + Temp;							if not (NumMovePoints(R, C, TheTerr) < Monster.Movement) then								c := c - Temp;						end				end			else { Dist < 4 }				begin					if rnd(1, 10, HermSetup) < 6 then						begin							repeat								Temp := (rnd(1, 3, HermSetup) - 2);							until Temp <> 0;							r := r + Temp;							if not (NumMovePoints(R, C, TheTerr) < Monster.Movement) then								r := r - Temp;						end					else						begin							repeat								Temp := (rnd(1, 3, HermSetup) - 2);							until temp <> 0;							c := c + Temp;							if not (NumMovePoints(R, C, TheTerr) < Monster.Movement) then								c := c - Temp;						end;				end;			if c < 1 then				c := 1;			if c > 48 then				c := 48;			if r < 1 then				r := 1;			if r > 12 then				r := 12;			NumToString(R + 2, st1);			NumToString(C + 2, st2);			ANSICode(concat(st1, ';', st2, 'H'), procs[vANSICode]);			ANSICode('0;31mœ', procs[vANSICode])		end;	{with HermSetup}end;	{procedure}procedure MoveMonster (var R, C, Ru, Cu: integer; Monster: MonsterRec; TheTerr: TerrainType; var HermSetup: UserXIPtr);var	startpos: coord;	playpos: coord;	indx: byte;	found: boolean;	Route: Str255;	st1, st2: str255;begin	with HermSetup^ do		begin			playpos.r := Ru;			playpos.c := Cu;			if findroute(R, C, playpos, Route, HermSetup) then				begin					indx := 0;					repeat						indx := indx + 1;{fireyn()}						NumToString(R + 2, st1);						NumToString(C + 2, st2);						ANSICode(concat(st1, ';', st2, 'H'), procs[vANSICode]);						ANSICode(GetTerrChar(TheTerr[R, C], True), procs[vANSICode]);						case Route[indx] of							'U': 								R := R - 1;							'D': 								R := R + 1;							'L': 								C := C - 1;							'R': 								C := C + 1;						end;						if c < 1 then							c := 2;						if c > 48 then							c := 47;						if r < 1 then							r := 2;						if r > 12 then							r := 11;						NumToString(R + 2, st1);						NumToString(C + 2, st2);						ANSICode(concat(st1, ';', st2, 'H'), procs[vANSICode]);						ANSICode('0;31mœ', procs[vANSICode]);						monster.movement := monster.movement - NumMovePoints(R, C, TheTerr);					until (indx = length(Route)) or (monster.movement < 1);				end;		end;end;boo1 := FindPlayer(Winner, WinnerFName, HermSetup);if not boo1 then	WriteText('Winner Not Found.', privates^^.myWindow, HermSetup);boo1 := FindPlayer(Loser, LoserFName, Hermsetup);if not boo1 then	WriteText('Loser Not Found.', privates^^.myWindow, HermSetup);unit SlyTextCombat;{Make this 'XHRM' ID = 10008, but make the file type 'rsrc' and creator 'RSED'.}{You should include your resource file in this one. (in the 'Run' menu under 'Run Options...').}interfaceuses	HermHeaders, Sly_General, SlyTextCombatUnit;procedure MAIN (HermSetup: UserXIPtr);implementationprocedure MAIN (HermSetup: UserXIPtr);	var		i, x: integer;		long: longint;		damage, int1: integer;		Boo1: boolean;		st1, st2: str255;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}	procedure CS (stage: integer);		begin			with HermSetup^ do				Privates^^.Stage[CurNode^] := stage;		end;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}	procedure RS (stage: integer);		begin			with HermSetup^ do				Privates^^.ReturnStage[CurNode^] := stage;		end;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}	begin		with HermSetup^ do			begin				case privates^^.stage[curNode^] of					SetupTextCombat: 						begin							ANSICode('2J', procs[13]);							ANSICode('H', procs[13]);							bCr(procs[0]);							boo1 := RollInitiative(HermSetup);							InitiativeText(boo1, HermSetup);							CS(TextCombat);						end;					TextCombat: { -- Prompts User for his next action }						begin							if (not Privates^^.char[curNode^]^^.Alive) or (Privates^^.char[curNode^]^^.HitPoints <= 0) then								begin									if privates^^.char[curNode^]^^.Location = TheArenaCombat then										begin											privates^^.char[curNode^]^^.Location := TheArenaMenu;											CS(612);										end									else										begin											privates^^.char[curNode^]^^.Location := TheTown;											Privates^^.char[curNode^]^^.Alive := false;											SaveChar(n[curNode^]^.ThisUser.UserName, privates^^.char[curNode^]^^, HermSetup);											Outline('You''re outta life buddy...', true, 6, procs[1]);											CS(ShutDown3);										end;								end							else								begin									bCr(procs[0]);									bCr(procs[0]);									outline('Attack,Run,Pass', true, 3, procs[1]);									bCr(procs[0]);									ANSICode('1;32m[A,P,R]', procs[13]);									bCr(procs[0]);									ANSICode('0;34mYour choice?', procs[13]);									LettersPrompt(' :', 'APR', 1, true, false, true, chr(0), procs[4]);									CS(151);								end;						end;					151: {Changes Stages to the appropriate stage}						begin							case n[CurNode^]^.CurPrompt[1] of								'A': 									CS(155);								'P': 									CS(156);								'R': 									CS(153);								otherwise									CS(TextCombat);							end;						end;					153: 	{Run Away!}						begin							bCr(procs[0]);							Outline('You try to escape...', true, 3, procs[1]);							for x := 1 to 40 do								Outline('.', false, 2, procs[1]);							bCr(procs[0]);							Outline('You Succeed!', true, 6, procs[1]);							if privates^^.char[curNode^]^^.Location = TheArenaCombat then								begin									privates^^.char[curNode^]^^.Location := TheArenaMenu;									CS(Arena);								end							else								begin									privates^^.char[curNode^]^^.Location := TheWildernessMenu;									CS(Wilderness);								end;						end;					155:   {Character attack}						begin							bCr(procs[0]);							bCr(procs[0]);							Outline(concat('You swing at the foul ', privates^^.Monster[CurNode^].Name, ' with your ', Privates^^.char[curNode^]^^.Weapons[1].Name, '!'), true, 7, procs[1]);							bCr(procs[0]);							if rnd(0, 100, Hermsetup) > 75 then  {Change this!!!!!!!!!}								Outline('You Miss!', true, 6, procs[1])							else								begin									with privates^^.char[curNode^]^^ do										Damage := DoDamage(true, HermSetup);									if damage <= 0 then										outline('You miss!', true, 6, procs[1])									else										begin											Outline(concat('The ', Privates^^.Monster[CurNode^].Name, ' defends with it'' s ', privates^^.monster[CurNode^].DefenseStr, '!'), true, 3, procs[1]);											bCr(procs[0]);											NumToString(damage, st1);											PrintMenu('You hit the vile fiend for ', st1, ' damage!!', '1;34m', '1;31m', true, HermSetup);											bCr(procs[0]);											Privates^^.Monster[CurNode^].HitPoints := Privates^^.Monster[CurNode^].HitPoints - damage;										end;								end;							if Privates^^.Monster[CurNode^].HitPoints <= 0 then								CS(160)							else								CS(156);						end;					156:  {Monster Attack}						begin							Outline(concat('The ', privates^^.Monster[CurNode^].Name, ' attacks you with it''s ', privates^^.Monster[CurNode^].AttackStr1, '!'), true, 2, procs[1]);							damage := DoDamage(false, HermSetup);							if rnd(1, 95, HermSetup) <= Privates^^.char[curNode^]^^.Dexterity then								outline(concat('You sucessfully dodge ', privates^^.Monster[CurNode^].Name, '''s blow'), true, 3, procs[1])							else if Privates^^.char[curNode^]^^.Armor[1].Defense >= damage then								outline(concat(privates^^.Monster[CurNode^].Name, ' hits you, but deals no damage!'), true, 3, procs[1])							else if Privates^^.char[curNode^]^^.Armor[2].Defense > 1 then								begin									int1 := rnd(1, 100, HermSetup);									if int1 <= 20 then										begin											bCr(procs[0]);											Outline(concat('You bring up your ', Privates^^.char[curNode^]^^.Armor[2].Name, ' and block the attack! '), true, 5, procs[1]);											bCr(procs[0]);											Privates^^.char[curNode^]^^.Armor[2].Defense := Privates^^.char[curNode^]^^.Armor[2].Defense - damage div 10;											NumToString(damage div 10, st1);											PrintMenu('Test Note: ', st1, ' Damage is taken by weapon.', '1;33m', '1;31m', true, HermSetup);										end									else										begin											Privates^^.char[curNode^]^^.HitPoints := Privates^^.char[curNode^]^^.HitPoints - (damage - Privates^^.char[curNode^]^^.Armor[1].Defense);											NumToString(damage, st1);											bCr(procs[0]);											PrintMenu('You are hit for ', st1, ' Damage!', '1;33m', '1;31m', true, HermSetup);											bCr(procs[0]);										end;								end							else								begin									Privates^^.char[curNode^]^^.HitPoints := Privates^^.char[curNode^]^^.HitPoints - (damage + Privates^^.char[curNode^]^^.Armor[1].Defense);									NumToString(damage, st1);									bCr(procs[0]);									PrintMenu('You are hit for ', st1, ' Damage!', '1;33m', '1;31m', true, HermSetup);									bCr(procs[0]);								end;							if Privates^^.char[curNode^]^^.HitPoints <= 0 then								begin									Outline('Tough luck.  You''re dead, buddy . ', true, 4, procs[1]);									PrintMenu('See ya in ', 'Hero''s Heaven!', ' ', '1;34;40m', '0;37;44m', true, HermSetup);									Privates^^.char[curNode^]^^.CoinsHand := Privates^^.char[curNode^]^^.CoinsHand - (Privates^^.char[curNode^]^^.CoinsHand div 3);									SaveChar(n[curNode^]^.ThisUser.UserName, privates^^.char[curNode^]^^, HermSetup);									CS(ShutDown3);								end							else								CS(TextCombat);						end;					160:  {User Wins}						begin							if privates^^.char[curNode^]^^.Location = TheArenaCombat then								begin									privates^^.char[curNode^]^^.Location := TheArenaMenu;									CS(610);								end							else								begin									bCr(procs[0]);									int1 := rnd(0, Privates^^.Monster[CurNode^].Coins, HermSetup);									Outline(concat('You have won the ', Privates^^.Monster[CurNode^].name, '!!'), true, 7, procs[1]);									Privates^^.char[curNode^]^^.TotalExperience := Privates^^.char[curNode^]^^.TotalExperience + Privates^^.Monster[CurNode^].experience;									Privates^^.char[curNode^]^^.SpendingExperience := Privates^^.char[curNode^]^^.SpendingExperience + Privates^^.Monster[CurNode^].experience;									Privates^^.char[curNode^]^^.CoinsHand := Privates^^.char[curNode^]^^.CoinsHand + int1;									privates^^.char[curNode^]^^.FightsWon := privates^^.char[curNode^]^^.FightsWon + 1;									bCr(procs[0]);									NumToString(int1, st1);									NumToString(Privates^^.Monster[CurNode^].experience, st2);									ANSICode('1;34mYou receive ', procs[13]);									ANSICode(concat('0;35m', st2), procs[13]);									bCr(procs[0]);									ANSICode('1;34m Experience points.', procs[13]);									ANSICode('1;34mYou receive ', procs[13]);									ANSICode(concat('0;35m', st1), procs[13]);									ANSICode('1;34m Coins.', procs[13]);									bCr(procs[0]);									privates^^.char[curNode^]^^.Location := TheWildernessMenu;									n[curNode^]^.boardaction := none;									myPausePrompt('-=Press A Key=-', HermSetup);									CS(Wilderness);								end;						end;				end;			end;	end;end.{---------------