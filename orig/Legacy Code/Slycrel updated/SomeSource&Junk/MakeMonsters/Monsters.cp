#include <stdio.h>#include <stdlib.h>#include <time.h>#include <string.h>#define kListSize 20#define kStringLength 256void getstr(char *inStr, int, FILE *monsters);void getstr(char *inStr, int, FILE *monsters){	strcpy(inStr, "");	fgets(inStr, 255, monsters);	inStr[strlen(inStr)-1] = 0;}inline void checkLength(char *inStr, int &maxLength){	int length = strlen(inStr);	if (strlen(inStr) > maxLength)		maxLength = length;}void main(void){		char name[kStringLength];	char type[kStringLength];	char action[kStringLength];	char attack1[kStringLength];	char attack2[kStringLength];	char defense[kStringLength];	char inString[kStringLength];	int nameLen = 0;	int typeLen = 0;	int actionLen = 0;	int attack1Len = 0;	int attack2Len = 0;	int defenseLen = 0;		FILE *monsters = fopen("Swamp.csv", "r");		getstr(inString, 255, monsters);	while (inString[0] != 0) {		char *parseStr;		char *parsePtr;		strcpy(name, "");		strcpy(type, "");		strcpy(action, "");		strcpy(attack1, "");		strcpy(attack2, "");		strcpy(defense, "");		parsePtr = strchr(inString, ',');		if (parsePtr != NULL) {			*parsePtr = 0;			parseStr = inString;			strcpy(name, parseStr);			parseStr = parsePtr + 1;			parsePtr = strchr(parseStr, ',');			if (parsePtr != NULL) {				*parsePtr = 0;				strcpy(type, parseStr);				parseStr = parsePtr + 1;				parsePtr = strchr(parseStr, ',');				if (parsePtr != NULL) {					*parsePtr = 0;					strcpy(action, parseStr);					parseStr = parsePtr + 1;					parsePtr = strchr(parseStr, ',');					if (parsePtr != NULL) {						*parsePtr = 0;						strcpy(attack1, parseStr);						parseStr = parsePtr + 1;						parsePtr = strchr(parseStr, ',');						if (parsePtr != NULL) {							*parsePtr = 0;							strcpy(attack2, parseStr);							parseStr = parsePtr + 1;							strcpy(defense, parseStr);						}					}				}			}		}		checkLength(name, nameLen);		checkLength(type, typeLen);		checkLength(action, actionLen);		checkLength(attack1, attack1Len);		checkLength(attack2, attack2Len);		checkLength(defense, defenseLen);		getstr(inString, 255, monsters);	}	printf("name max = %d\n", nameLen);	printf("type max = %d\n", typeLen);	printf("action max = %d\n", actionLen);	printf("attack1 max = %d\n", attack1Len);	printf("attack2 max = %d\n", attack2Len);	printf("defense max = %d\n", defenseLen);	fclose(monsters);}