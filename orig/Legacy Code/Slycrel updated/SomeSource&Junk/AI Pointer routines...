unit Sly_CombatUnit;interfaceuses	SlyHeaders, HermHeaders, Sly_General;{-Utils-}function GetTerrChar (TheByte: integer; ANSI: boolean): string;procedure MovePlayer (Direction: Char; var NewR, NewC: integer; var Movement: byte; TheTerrain: TerrainType; var HermSetup: UserXIPtr);procedure MoveMonster (var R, C, Ru, Cu: integer; Monster: MonsterRec; TheTerr: TerrainType; var HermSetup: UserXIPtr);function NumMovePoints (R, C: integer; TheTerrain: TerrainType): integer;procedure UpdateMovement (Movement: byte; var HermSetup: UserXIPtr);function CanMove (R, C, Movement: integer; TheTerrain: TerrainType): boolean;function SpaceToDot (TheString: str255): str255;function RectToPol (x, y: integer): real;procedure DoShoot (UserRow, UserColumn, MonsterRow, MonsterColumn: integer; HermSetup: UserXIPtr);procedure initCellMap (var HermSetup: UserXIPtr);procedure removeCell (pos: coord; var HermSetup: UserXIPtr);procedure addCell (pos: coord; var HermSetup: UserXIPtr);procedure CheckForDupes (pos: coord; var HermSetup: UserXIPtr);procedure getLowestWeight (var pos: coord; var HermSetup: UserXIPtr);function FindRoute (R, C: byte; dest: coord; var route: str255; var HermSetup: UserXIPtr): boolean;procedure cleanupList (var HermSetup: UserXIPtr);{-Files-}procedure GetTerrain (WhatTerrain: str255; var TheTerrain: TerrainType; var HermSetup: UserXIPtr);procedure GetMonster (MonsterType: str255; WhatMonster: integer; var TheMonster: MonsterRec; var HermSetup: UserXIPtr);{-Screen-}procedure DrawCombatField (TheTerrain: TerrainType; var HermSetup: UserXIPtr);procedure DrawCharInfo (TheCharacter: CharRec; var HermSetup: UserXIPtr);procedure TextOut (TheString: string; HermSetup: UserXIPtr);implementation				{-***********-Utils-***********-}{-------------------------------------------------}function GetTerrChar (TheByte: integer; ANSI: boolean): string;	begin		if ANSI then			case theByte of				0: 					GetTerrChar := concat('0;37;40m', ' ');				1: 					GetTerrChar := concat('0;32;40m', '°');				2: 					GetTerrChar := concat('0;33;40m', '°');				3: 					GetTerrChar := concat('0;34;40m', '÷');				4: 					GetTerrChar := concat('0;34;43m', 'ð');				5: 					GetTerrChar := concat('1;30;40m', 'í');				6: 					GetTerrChar := concat('1;32;40m', chr(6));				7: 					GetTerrChar := concat('0;32;40m', chr(6));				8: 					GetTerrChar := concat('1;30;47m', '±');				9: 					GetTerrChar := concat('1;30;40m', '²');				otherwise					GetTerrChar := concat('1;31;40m', '');			end		else			case theByte of				0: 					GetTerrChar := ' ';				1: 					GetTerrChar := '°';				2: 					GetTerrChar := '°';				3: 					GetTerrChar := '÷';				4: 					GetTerrChar := 'ð';				5: 					GetTerrChar := 'í';				6: 					GetTerrChar := chr(6);				7: 					GetTerrChar := chr(6);				8: 					GetTerrChar := '±';				9: 					GetTerrChar := '²';				otherwise					GetTerrChar := '';			end;	end;{-------------------------------------------------}procedure MovePlayer (Direction: Char; var NewR, NewC: integer; var Movement: byte; TheTerrain: TerrainType; var HermSetup: UserXIPtr);	var		st1, st2: str255;		a: integer;	begin		with HermSetup^ do			begin				NumToString(NewR + 2, st1);				NumToString(NewC + 2, st2);				ANSICode(concat(st1, ';', st2, 'H'), procs[vANSICode]);				ANSICode(GetTerrChar(TheTerrain[NewR, NewC], True), procs[vANSICode]);				if TheTerrain[NewR, NewC] = 3 then					begin						ANSICode('20;7H', procs[vANSICode]);						ANSICode('5;1;31m>>>Swwishhhh<<<', procs[vANSICode]);						bCr(procs[0]);						ANSICode('0;1;34m><>   Gurgle gurgle... blurp!   <><', procs[vANSICode]);						Privates^^.char^^.Alive := false;						n[curNode^]^.BoardAction := none;						myPausePrompt('-=Press A Key=-', HermSetup);					end				else					begin						case direction of							'I': 								if NewR <= 1 then									NewR := 1								else									begin										NewR := NewR - 1;										if not (NumMovePoints(NewR, NewC, TheTerrain) <= movement) then											begin												TextOut('Not ''nuff Movement to Move There.', HermSetup);												NewR := NewR + 1;											end										else											movement := movement - NumMovePoints(NewR, NewC, TheTerrain);									end;							'J': 								if NewC <= 1 then									NewC := 1								else									begin										NewC := NewC - 1;										if not (NumMovePoints(NewR, NewC, TheTerrain) <= movement) then											begin												TextOut('Not ''nuff Movement to Move There.', HermSetup);												NewC := NewC + 1;											end										else											movement := movement - NumMovePoints(NewR, NewC, TheTerrain);									end;							'K': 								if NewR >= 12 then									NewR := 12								else									begin										NewR := NewR + 1;										if not (NumMovePoints(NewR, NewC, TheTerrain) <= movement) then											begin												TextOut('Not ''nuff Movement to Move There.', HermSetup);												NewR := NewR - 1;											end										else											movement := movement - NumMovePoints(NewR, NewC, TheTerrain);									end;							'L': 								if NewC >= 48 then									NewC := 48								else									begin										NewC := NewC + 1;										if not (NumMovePoints(NewR, NewC, TheTerrain) <= movement) then											begin												TextOut('Not ''nuff Movement to Move There.', HermSetup);												NewC := NewC - 1;											end										else											movement := movement - NumMovePoints(NewR, NewC, TheTerrain);									end;						end; { Case }						NumToString(NewR + 2, st1);						NumToString(NewC + 2, st2);						ANSICode(concat(st1, ';', st2, 'H'), procs[vANSICode]);						ANSICode('1;34mè', procs[vANSICode])					end;			end;	end;{-------------------------------------------------}procedure MoveMonster (var R, C, Ru, Cu: integer; Monster: MonsterRec; TheTerr: TerrainType; var HermSetup: UserXIPtr);	var		startpos: coord;		playpos: coord;		indx: byte;		found: boolean;		Route: Str255;		st1, st2: str255;	begin		with HermSetup^ do			begin				playpos.r := Ru;				playpos.c := Cu;				if findroute(R, C, playpos, Route, HermSetup) then					begin						indx := 0;						repeat							indx := indx + 1;{fireyn()}							NumToString(R + 2, st1);							NumToString(C + 2, st2);							ANSICode(concat(st1, ';', st2, 'H'), procs[vANSICode]);							ANSICode(GetTerrChar(TheTerr[R, C], True), procs[vANSICode]);							case Route[indx] of								'U': 									R := R - 1;								'D': 									R := R + 1;								'L': 									C := C - 1;								'R': 									C := C + 1;							end;							if c < 1 then								c := 2;							if c > 48 then								c := 47;							if r < 1 then								r := 2;							if r > 12 then								r := 11;							NumToString(R + 2, st1);							NumToString(C + 2, st2);							ANSICode(concat(st1, ';', st2, 'H'), procs[vANSICode]);							ANSICode('0;31mœ', procs[vANSICode]);							monster.movement := monster.movement - NumMovePoints(R, C, TheTerr);						until (indx = length(Route)) or (monster.movement < 1);					end;			end;	end;{-------------------------------------------------}function NumMovePoints (R, C: integer; TheTerrain: TerrainType): integer;	begin		case TheTerrain[r, c] of			0: 				NumMovePoints := 1;			1: 				NumMovePoints := 2;			2: 				NumMovePoints := 1;			3: 				NumMovePoints := 20;			4: 				NumMovePoints := 1;			5: 				NumMovePoints := 998;			6: 				NumMovePoints := 4;			7: 				NumMovePoints := 5;			8: 				NumMovePoints := 3;			9: 				NumMovePoints := 4;			otherwise				NumMovePoints := 998;		end;	end;{-------------------------------------------------}procedure UpdateMovement (Movement: byte; var HermSetup: UserXIPtr);	var		st1: str255;	begin		with HermSetup^ do			begin				NumToString(Movement, st1);				ANSICode('0;31m', procs[vANSICode]);				ANSICode(concat('5;65H', '    '), procs[vANSICode]);				ANSICode(concat('5;65H', st1), procs[vANSICode]);			end	end;{-------------------------------------------------}function CanMove (R, C, Movement: integer; TheTerrain: TerrainType): boolean;	var		CheckNorth, CheckSouth, CheckEast, CheckWest: boolean;	begin		CheckNorth := true;		CheckSouth := true;		CheckEast := true;		CheckWest := true;		CanMove := false;			{ Checks to see if they're on the border... }		if C + 1 > 48 then			CheckEast := false;		if C - 1 < 1 then			CheckWest := False;		if R + 1 > 12 then			CheckSouth := false;		if R - 1 < 1 then			CheckNorth := False;		if CheckNorth then			if Movement >= NumMovePoints(R, C - 1, TheTerrain) then				CanMove := true;		if CheckSouth then			if Movement >= NumMovePoints(R, C + 1, TheTerrain) then				CanMove := true;		if CheckEast then			if Movement >= NumMovePoints(R + 1, C, TheTerrain) then				CanMove := true;		if CheckWest then			if Movement >= NumMovePoints(R - 1, C, TheTerrain) then				CanMove := true;	end;{-------------------------------------------------}function SpaceToDot (TheString: str255): str255;	var		x: integer;	begin		for x := 1 to length(TheString) do			begin				if TheString[x] = chr(32) then					TheString[x] := chr(250);			end;		SpaceToDot := TheString;	end;{-------------------------------------------------}function RectToPol (x, y: integer): real;{ Be Sure to Include SANELib.lib! }	var		theAngle, z: real;	begin		TheAngle := 0;		if y <> 0 then			theAngle := arcTan(y / x) * 57.29578;		TheAngle := abs(TheAngle);		if (x >= 0) and (y >= 0) then			RectToPol := theAngle		else if (x < 0) and (y >= 0) then			RectToPol := 180 - theAngle		else if (x < 0) and (y < 0) then			RectToPol := theAngle + 180		else if (x >= 0) and (y < 0) then			RectToPol := 360 - theAngle;	end;{-------------------------------------------------}function ShootArrow (UserR, UserC, MonR, MonC, incR, incC: integer; IncDist: real; HermSetup: UserXIPtr): integer;	var		HitTerrain, HitMonster, OutOfBounds, FellShort: boolean;		ArrowR, ArrowC: integer;		ChanceHit, Damage: integer;		st1, st2, st3: str255;		Dist: real;	begin		with HermSetup^ do			begin				HitTerrain := false;				HitMonster := false;				OutOfBounds := false;				FellShort := false;				ArrowR := UserR;				ArrowC := UserC;				dist := 0;				ShootArrow := 0;				while not (HitTerrain or HitMonster or OutOfBounds or FellShort) do					begin						ArrowR := ArrowR + incR;						ArrowC := ArrowC + incC;						dist := dist + IncDist;						if ((ArrowR > 12) or (ArrowR < 1) or (ArrowC < 1) or (ArrowC > 48)) then							begin								ShootArrow := 0;								OutOfBounds := true;							end;						if not OutOfBounds then							begin{Draws New Arrow}								numToString(ArrowR + 2, st1);								numToString(ArrowC + 2, st2);								st3 := concat(st1, ';', st2, 'H');								ANSICode(st3, procs[vANSICode]);								ANSICode('1;33;40m+', procs[vANSICode]);{Re-Draws the Terrain over old arrow}								numToString(ArrowR + 2, st1);								numToString(ArrowC + 2, st2);								st3 := concat(st1, ';', st2, 'H');								ANSICode(st3, procs[vANSICode]);								ANSICode(GetTerrChar(privates^^.Terrain[ArrowR, ArrowC], true), procs[vANSICode]);								if Dist >= Privates^^.char^^.Weapons[2].Range then									begin										FellShort := true;										ShootArrow := 0;									end;								ChanceHit := NumMovePoints(ArrowR, ArrowC, privates^^.Terrain);								if Privates^^.Terrain[ArrowR, ArrowC] = 3 then  {fixes water bug}									ChanceHit := 1;								if (rnd(1, 100, HermSetup) < ChanceHit) then									begin										ShootArrow := -privates^^.Terrain[ArrowR, ArrowC];										HitTerrain := true;									end;								if (ArrowR = MonR) and (ArrowC = MonC) then									begin										HitMonster := true;										NumToString(privates^^.R2 + 2, st1);										NumToString(privates^^.C2 + 2, st2);										ANSICode(concat(st1, ';', st2, 'H'), procs[vANSICode]);										ANSICode('0;31mœ', procs[vANSICode]);										with Privates^^.char^^ do											Damage := Weapons[2].Strike - (Privates^^.Monster.Defense div 4) + rnd(-Weapons[2].Strike div 5, Weapons[2].Strike div 5, HermSetup);										if Damage < 0 then											Damage := 0;										ShootArrow := Damage;									end;							end;					end;{While}			end;	end;{-------------------------------------------------}procedure DoShoot (UserRow, UserColumn, MonsterRow, MonsterColumn: integer; HermSetup: UserXIPtr);	var		HitTarget: Integer;		R, C: integer;		Deg: real;		st1, st2: str255;	begin		with HermSetup^ do			begin				R := (MonsterRow - UserRow) * (-1);				C := (MonsterColumn - UserColumn);				Deg := RectToPol(C, R);				if (((deg >= 0) and (deg <= 15)) or ((deg > 345) and (deg <= 360))) then		{0/360}					HitTarget := ShootArrow(UserRow, UserColumn, MonsterRow, MonsterColumn, 0, 1, 1, HermSetup)				else if ((deg > 15) and (deg <= 37.5)) then														 	{30}					HitTarget := ShootArrow(UserRow, UserColumn, MonsterRow, MonsterColumn, -3, 2, sqrt(3), HermSetup)				else if ((deg > 37.5) and (deg <= 52.5)) then													 	{45}					HitTarget := ShootArrow(UserRow, UserColumn, MonsterRow, MonsterColumn, -1, 1, 2, HermSetup)				else if ((deg > 52.5) and (deg <= 75)) then															{60}					HitTarget := ShootArrow(UserRow, UserColumn, MonsterRow, MonsterColumn, -2, 1, sqrt(3), HermSetup)				else if ((deg > 75) and (deg <= 105)) then															{90}					HitTarget := ShootArrow(UserRow, UserColumn, MonsterRow, MonsterColumn, -1, 0, 1, HermSetup)				else if ((deg > 105) and (deg <= 127.5)) then														{120}					HitTarget := ShootArrow(UserRow, UserColumn, MonsterRow, MonsterColumn, -2, -1, sqrt(3), HermSetup)				else if ((deg > 127.5) and (deg <= 142.5)) then													{135}					HitTarget := ShootArrow(UserRow, UserColumn, MonsterRow, MonsterColumn, -1, -1, 2, HermSetup)				else if ((deg > 142.5) and (deg <= 165)) then														{150}					HitTarget := ShootArrow(UserRow, UserColumn, MonsterRow, MonsterColumn, -1, -2, sqrt(3), HermSetup)				else if ((deg > 165) and (deg <= 195)) then															{180}					HitTarget := ShootArrow(UserRow, UserColumn, MonsterRow, MonsterColumn, 0, -1, 1, HermSetup)				else if ((deg > 195) and (deg <= 217.5)) then														{210}					HitTarget := ShootArrow(UserRow, UserColumn, MonsterRow, MonsterColumn, 1, -2, sqrt(3), HermSetup)				else if ((deg > 217.5) and (deg <= 232.5)) then													{225}					HitTarget := ShootArrow(UserRow, UserColumn, MonsterRow, MonsterColumn, 1, -1, 2, HermSetup)				else if ((deg > 232.5) and (deg <= 255)) then														{240}					HitTarget := ShootArrow(UserRow, UserColumn, MonsterRow, MonsterColumn, 2, -1, sqrt(3), HermSetup)				else if ((deg > 255) and (deg <= 285)) then															{270}					HitTarget := ShootArrow(UserRow, UserColumn, MonsterRow, MonsterColumn, 1, 0, 1, HermSetup)				else if ((deg > 285) and (deg <= 307.5)) then														{300}					HitTarget := ShootArrow(UserRow, UserColumn, MonsterRow, MonsterColumn, 2, 1, sqrt(3), HermSetup)				else if ((deg > 307.5) and (deg <= 322.5)) then													{315}					HitTarget := ShootArrow(UserRow, UserColumn, MonsterRow, MonsterColumn, 1, 1, 2, HermSetup)				else if ((deg > 322.5) and (deg <= 345)) then														{330}					HitTarget := ShootArrow(UserRow, UserColumn, MonsterRow, MonsterColumn, 1, 2, sqrt(3), HermSetup);				if HitTarget > 0 then					begin						privates^^.Monster.HitPoints := privates^^.Monster.HitPoints - HitTarget;						numToString(HitTarget, st1);						st1 := concat('You hit the ', privates^^.Monster.Name, ' for ', st1, ' Damage.');						TextOut(st1, HermSetup);					end				else					case HitTarget of						-4..-1: 							TextOut('Your Shot Fell Short!', HermSetup);						-5: 							TextOut('Your Shot Bounces off a Boulder!', HermSetup);						-6: 							TextOut('Your Aim isn''t very good, it hit a TREE!', HermSetup);						-7: 							TextOut('Aww.. Too Bad, Hit a Tree...', HermSetup);						-8: 							TextOut('It Hit a Swamp Thingy!', HermSetup);						-9: 							TextOut('Argh!  Take some Lessons!', HermSetup);						otherwise							TextOut('You COMPLETLY Miss.', HermSetup);					end;				Privates^^.char^^.Movement := Privates^^.char^^.Movement - 3;				NumToString(MonsterRow + 2, st1);				NumToString(MonsterColumn + 2, st2);				ANSICode(concat(st1, ';', st2, 'H'), procs[vANSICode]);				ANSICode('0;31mœ', procs[vANSICode]);			end;	end;{-------------------------------------------------}procedure initCellMap (var HermSetup: UserXIPtr);	var		r, c: byte;	begin		with HermSetup^ do			begin				for r := 1 to 12 do					for c := 1 to 48 do						begin							Privates^^.cellmap[r, c].weight := 32700;							Privates^^.cellmap[r, c].direction := ' ';							Privates^^.cellmap[r, c].chosen := false;						end;				Privates^^.head := nil;			end;	end;{-------------------------------------------------}procedure removeCell (pos: coord; var HermSetup: UserXIPtr);	var		currp, delptr: lookupptr;		found: boolean;	begin		with HermSetup^ do			begin				currp := Privates^^.head;				found := false;				if (currp^.pos.r = pos.r) and (currp^.pos.c = pos.c) then					begin						delptr := currp;						currp := currp^.next;						Privates^^.head := currp;						DisposPtr(ptr(delptr));					end				else					begin						repeat							if (currp^.next^.pos.r = pos.r) and (currp^.next^.pos.c = pos.c) then								found := true							else								currp := currp^.next;						until (found) or (currp^.next = nil);						delptr := currp^.next;						currp^.next := currp^.next^.next;						DisposPtr(ptr(delptr));					end;			end;	end;{-------------------------------------------------}procedure AddCell (pos: coord; var HermSetup: UserXIPtr);	var		currp, newp: lookupptr;		found: boolean;	begin		with HermSetup^ do			begin				if Privates^^.head = nil then					begin						Privates^^.Head := lookUpPtr(NewPtr(SizeOf(LookUpRec)));						Privates^^.head^.next := nil;						Privates^^.head^.pos := pos;					end				else if (Privates^^.cellmap[Privates^^.head^.pos.r, Privates^^.head^.pos.c].weight > (Privates^^.cellmap[pos.r, pos.c].weight)) then					begin						Privates^^.Head := LookUpPtr(NewPtr(SizeOf(LookUpRec)));						newp^.pos := pos;						newp^.next := Privates^^.head;						Privates^^.head := newp;					end				else					begin						Privates^^.Head := LookUpPtr(NewPtr(SizeOf(LookUpRec)));						newp^.pos := pos;						newp^.next := nil;						currp := Privates^^.head;						found := false;						repeat							if (currp^.next = nil) then								begin									found := true;									currp^.next := newp;								end							else if (Privates^^.cellmap[currp^.next^.pos.r, currp^.next^.pos.c].weight) > (Privates^^.cellmap[newp^.pos.r, newp^.pos.c].weight) then								begin									newp^.next := currp^.next;									currp^.next := newp;									found := true;								end							else								currp := currp^.next;						until found;					end;{else}			end;	end;{-------------------------------------------------}procedure CheckForDupes (pos: coord; var HermSetup: UserXIPtr);	var		currp: lookupptr;		found: boolean;	begin		with HermSetup^ do			begin				currp := Privates^^.head;				found := false;				while (currp^.next <> nil) and (not found) do					begin						if (currp^.pos.r = pos.r) and (currp^.pos.c = pos.c) then							begin								removeCell(pos, HermSetup);								found := true;							end;						currp := currp^.next;					end;			end;	end;{-------------------------------------------------}procedure GetLowestWeight (var pos: coord; var HermSetup: UserXIPtr);	begin		with HermSetup^ do			begin				pos := Privates^^.head^.pos;				removeCell(pos, HermSetup);			end;	end;{-------------------------------------------------}function FindRoute (R, C: byte; dest: coord; var route: str255; var HermSetup: UserXIPtr): boolean;	var		tmpdirection: char;		currpos, tmppos: coord;		counter: longint;{Postcondition	:	string which contains full route to destination}{Result					: route returned in string VAR paramater;}{									if dest was found, return true }	begin		with HermSetup^ do			begin				initcellmap(HermSetup);				currpos.r := R;				currpos.c := C;				Privates^^.cellmap[currpos.r, currpos.c].chosen := true;				Privates^^.cellmap[currpos.r, currpos.c].weight := NumMovePoints(R, C, Privates^^.Terrain);				counter := 0;				repeat  {UP}					if currpos.r - 1 > 0 then						if (not Privates^^.CellMap[currpos.r - 1, currpos.c].chosen) and (Privates^^.CellMap[currpos.r, currpos.c].weight + NumMovePoints(R - 1, C, Privates^^.Terrain) < Privates^^.CellMap[currpos.r - 1, currpos.c].weight) then							begin								Privates^^.CellMap[currpos.r - 1, currpos.c].weight := Privates^^.CellMap[currpos.r, currpos.c].weight + NumMovePoints(R - 1, C, Privates^^.Terrain);								Privates^^.CellMap[currpos.r - 1, currpos.c].direction := 'D';								tmppos := currpos;								tmppos.r := tmppos.r - 1;								CheckForDupes(tmppos, HermSetup);								AddCell(tmppos, HermSetup);							end;  {DOWN}					if currpos.r + 1 < 13 then						if (not Privates^^.CellMap[currpos.r + 1, currpos.c].chosen) and (Privates^^.CellMap[currpos.r, currpos.c].weight + NumMovePoints(R + 1, C, Privates^^.Terrain) < Privates^^.CellMap[currpos.r + 1, currpos.c].weight) then							begin								Privates^^.CellMap[currpos.r + 1, currpos.c].weight := Privates^^.CellMap[currpos.r, currpos.c].weight + NumMovePoints(R + 1, C, Privates^^.Terrain);								Privates^^.CellMap[currpos.r + 1, currpos.c].direction := 'U';								tmppos := currpos;								tmppos.r := tmppos.r + 1;								CheckForDupes(tmppos, HermSetup);								AddCell(tmppos, HermSetup);							end;  {LEFT}					if currpos.c - 1 > 0 then						if not Privates^^.CellMap[currpos.r, currpos.c - 1].chosen and (Privates^^.CellMap[currpos.r, currpos.c].weight + NumMovePoints(R, C - 1, Privates^^.Terrain) < Privates^^.CellMap[currpos.r, currpos.c - 1].weight) then							begin								Privates^^.CellMap[currpos.r, currpos.c - 1].weight := Privates^^.CellMap[currpos.r, currpos.c].weight + NumMovePoints(R, C - 1, Privates^^.Terrain);								Privates^^.CellMap[currpos.r, currpos.c - 1].direction := 'R';								tmppos := currpos;								tmppos.c := tmppos.c - 1;								CheckForDupes(tmppos, HermSetup);								AddCell(tmppos, HermSetup);							end;  {RIGHT}					if currpos.c + 1 < 49 then						if not Privates^^.CellMap[currpos.r, currpos.c + 1].chosen and (Privates^^.CellMap[currpos.r, currpos.c].weight + NumMovePoints(R, C + 1, Privates^^.Terrain) < Privates^^.CellMap[currpos.r, currpos.c + 1].weight) then							begin								Privates^^.CellMap[currpos.r, currpos.c + 1].weight := Privates^^.CellMap[currpos.r, currpos.c].weight + NumMovePoints(R, C + 1, Privates^^.Terrain);								Privates^^.CellMap[currpos.r, currpos.c + 1].direction := 'L';								tmppos := currpos;								tmppos.c := tmppos.c + 1;								CheckForDupes(tmppos, HermSetup);								AddCell(tmppos, HermSetup);							end;					GetLowestWeight(currpos, HermSetup);					Privates^^.CellMap[currpos.r, currpos.c].chosen := true;				until (currpos.r = dest.r) and (currpos.c = dest.c) or (counter >= 1050);				if counter >= 1050 then					findroute := false				else					findroute := true; {put string, switch and reverse}				route := '';				repeat					case Privates^^.CellMap[currpos.r, currpos.c].direction of						'U': 							begin								currpos.r := currpos.r - 1;								tmpdirection := 'D';							end;						'D': 							begin								currpos.r := currpos.r + 1;								tmpdirection := 'U';							end;						'L': 							begin								currpos.c := currpos.c - 1;								tmpdirection := 'R';							end;						'R': 							begin								currpos.c := currpos.c + 1;								tmpdirection := 'L';							end;					end;					route := concat(tmpdirection, route);				until (currpos.r = R) and (currpos.c = C);				cleanupList(HermSetup);			end;	end;{-------------------------------------------------}procedure cleanupList (var HermSetup: UserXIPtr);	var		currp, delptr: lookupptr;	begin		with HermSetup^ do			begin				currp := Privates^^.head;				repeat					delptr := currp;					currp := currp^.next;					DisposPtr(ptr(delptr));				until (currp = nil);			end;	end;{-------------------------------------------------}{-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-}				{-***********-Files-***********-}{-------------------------------------------------}procedure FReadTerrain (fRefNum: integer; var TheTerrain: TerrainType; var HermSetup: UserXIPtr);	var		ByteCount: longint;		err: OSErr;	begin		with HermSetup^ do			begin				ByteCount := SizeOf(TerrainType);				err := FSRead(fRefNum, ByteCount, @TheTerrain);				parseerr(err, HermSetup);			end;	end;{-------------------------------------------------}procedure GetTerrain (WhatTerrain: str255; var TheTerrain: TerrainType; var HermSetup: UserXIPtr);	var		FRefNum: integer;	begin		with HermSetup^ do			begin				FOpen(concat(filesPath^, TerrainPath, WhatTerrain), FRefNum, HermSetup);				FReadTerrain(FRefNum, TheTerrain, HermSetup);				FClose(FRefNum, HermSetup);			end;	end;{-------------------------------------------------}procedure FReadMonster (fRefNum: integer; var TheMonster: MonsterRec; var HermSetup: UserXIPtr);	var		ByteCount: longint;		err: OSErr;	begin		with HermSetup^ do			begin				ByteCount := SizeOf(MonsterRec);				err := FSRead(fRefNum, ByteCount, @TheMonster);				parseerr(err, HermSetup);			end;	end;{-------------------------------------------------}procedure GetMonster (MonsterType: str255; WhatMonster: integer; var TheMonster: MonsterRec; var HermSetup: UserXIPtr);	var		FRefNum: integer;		theOffSet: longint;	begin		with HermSetup^ do			begin				FOpen(concat(filesPath^, MonsterPath, MonsterType), FRefNum, HermSetup);				theOffSet := SizeOf(MonsterRec) * (whatMonster - 1);				SetFilePos(fRefNum, theOffset, HermSetup);				FReadMonster(FRefNum, TheMonster, HermSetup);				FClose(FRefNum, HermSetup);			end;	end;{-------------------------------------------------}				{-***********-Screen-***********-}{-------------------------------------------------}procedure PosCursor (x, y: integer; var HermSetup: UserXIPtr);	var		Xstr, Ystr, where: str255;	begin		with HermSetup^ do			begin				numToString(X, Xstr);				numToString(Y, Ystr);				where := concat(Ystr, ';', Xstr, 'H');				ANSICode(Where, procs[vANSICode]);			end;	end;{-------------------------------------------------}procedure DrawCombatField (TheTerrain: TerrainType; var HermSetup: UserXIPtr);	var		Current, Last: integer;		R, C: integer;		st1, TheLine: str255;	begin		with HermSetup^ do			begin				for r := 1 to 12 do					begin						current := -1;						Last := -1;						TheLine := '';						NumToString(r + 2, st1);						BufferANSI(concat(st1, ';3H'), false, HermSetup);						for c := 1 to 48 do							begin								last := current;								current := TheTerrain[r, c];								if last <> current then									begin										if TheLine <> '' then											BufferANSI(TheLine, false, HermSetup);										TheLine := GetTerrChar(TheTerrain[r, c], True);									end								else									TheLine := concat(TheLine, GetTerrChar(TheTerrain[r, c], False));							end;{ for c }						BufferANSI(TheLine, false, HermSetup);					end; { for r }				ReleaseBuffer(procs[vReleaseBuffer]);			end;{ HermSetup }	end;{ procedure }{-------------------------------------------------}procedure DrawCharInfo (TheCharacter: CharRec; var HermSetup: UserXIPtr);	var		st1: str255;	begin		with HermSetup^ do			begin				BufferANSI('4;56H', false, HermSetup);				BufferANSI('0;35m-', false, Hermsetup);				BufferANSI(concat('0;36m', TheCharacter.Name), false, HermSetup);				BufferANSI('5;65H', false, HermSetup);				NumToString(TheCharacter.Movement, st1);				BufferANSI(concat('0;32m', st1), false, HermSetup);				BufferANSI('6;65H', false, HermSetup);				NumToString(TheCharacter.HitPoints, st1);				BufferANSI(concat('0;32m', st1), false, HermSetup);				BufferANSI('0;34m/', false, HermSetup);				NumToString(TheCharacter.MaxHP, st1);				BufferANSI(concat('0;32m', st1), false, HermSetup);				BufferANSI('7;65H', false, HermSetup);				NumToString(TheCharacter.Psyche, st1);				BufferANSI(concat('0;32m', st1), false, HermSetup);				BufferANSI('0;34m/', false, HermSetup);				NumToString(TheCharacter.MaxPsyche, st1);				BufferANSI(concat('0;32m', st1), false, HermSetup);				BufferANSI('9;57H', false, HermSetup);				BufferANSI(concat('0;35m', TheCharacter.Weapons[1].Name), false, HermSetup);				BufferANSI('10;57H', false, HermSetup);				BufferANSI(concat('0;35m', TheCharacter.Weapons[2].Name), false, HermSetup);				BufferANSI('11;57H', false, HermSetup);				BufferANSI(concat('0;35m', TheCharacter.Weapons[3].Name), false, HermSetup);				BufferANSI('13;57H', false, HermSetup);				BufferANSI(concat('0;35m', TheCharacter.Armor[1].Name), false, HermSetup);				BufferANSI('14;57H', false, HermSetup);				BufferANSI(concat('0;35m', TheCharacter.Armor[2].Name), false, HermSetup);				ReleaseBuffer(procs[vReleaseBuffer]);			end;	end;{-------------------------------------------------}procedure TextOut (TheString: string; HermSetup: UserXIPtr);	var		x: integer;		st1: str255;	begin		with HermSetup^ do			begin				ANSICode('1;30;40m', procs[vANSICode]);				privates^^.TextOutLine := privates^^.TextOutLine + 1;				if privates^^.TextOutLine = 5 then					begin						privates^^.TextOutStr := TheString;						for x := 1 to 48 - length(TheString) do							privates^^.TextOutStr := concat(privates^^.TextOutStr, ' ');						privates^^.TextOutStr := SpaceToDot(privates^^.TextOutStr);					end;				if privates^^.TextOutLine > 5 then					begin						privates^^.TextOutLine := 2;						ANSICode('18;2H', procs[vANSICode]);						ANSICode(concat('1;30;40m', privates^^.TextOutStr), procs[vANSICode]);						for x := 2 to 5 do							begin								numToString(x + 17, st1);								ANSICode(concat(st1, SpaceToDot(';2H                                                ')), procs[vANSICode]);							end;					end;				NumToString(privates^^.TextOutLine + 17, st1);				ANSICode(concat(st1, ';2H'), procs[vANSICode]);				for x := 1 to 48 - length(TheString) do					TheString := concat(TheString, ' ');				ANSICode(concat('1;30;40m', SpaceToDot(TheString)), procs[vANSICode]);			end;	end;{-------------------------------------------------}{-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-}end.