#include <stddef.h>#include <types.h>#include "Builtins.h"#include "PStrings.h"#include "SlySysOpUnit.h"//-------------------------------------------------long ProgressionCurve(long lvl, short Base, short Multiplier){  // when calling this fuction (it's recursive) the lvl paramater is    // the Level that you want the experience/coins/offense/etc. for.      long exp;  if (lvl <= 1)     exp = Base;  else     exp = Multiplier * lvl + ProgressionCurve(lvl - 1, Base, Multiplier);  return exp;}//-------------------------------------------------void DoExitExternal(void){  switch (gSlyPrivates->WhereFrom) {     case 1:      gSlyPrivates->activeOn = false;      gSlyPrivates->stage = 0;      UserGlobPtr()->activeUserExternal = -1;      GoHome(gHermSetup->procs[vGoHome]);      break;    case 2:      gSlyPrivates->activeOn = false;      gSlyPrivates->stage = 0;      UserGlobPtr()->activeUserExternal = -1;      UserGlobPtr()->LogonStage = Trans1;      UserGlobPtr()->boardAction = None;      UserGlobPtr()->BoardSection = Logon;      UserGlobPtr()->crossint9 = gHermSetup->extID + 1;      break;    default:      gSlyPrivates->activeOn = false;      gSlyPrivates->stage = 0;      UserGlobPtr()->activeUserExternal = -1;      break;  } //case    if (gSlyPrivates != NULL) {    delete gSlyPrivates;    gSlyPrivates = NULL;  }}//-------------------------------------------------void NumPrintCharStats(CharacterRec TheStats){  // Adds the Character Sheet to   // the Buffer then RELEASES it  Str255 C1;  Str255 C2;  Str255 C3;  Str255 tempstr;  Str255 st2;  short x;  short ColorNum;  short int1;  Str255 Temp_Str255_1;  ColorNum = RandomBetween(31, 37);  NumToString(ColorNum, C1);  PStr_Set(C1, PStr_Concat(Temp_Str255_1, C1, "\pm"));  ColorNum = RandomBetween(31, 37);  NumToString(ColorNum, C2);  PStr_Set(C2, PStr_Concat(Temp_Str255_1, C2, "\pm"));  ColorNum = RandomBetween(31, 37);  NumToString(ColorNum, C3);  PStr_Set(C3, PStr_Concat(Temp_Str255_1, C3, "\pm"));    ANSICode("\p2J", gHermSetup->procs[vANSICode]);  ANSICode("\pH", gHermSetup->procs[vANSICode]);    BufferANSI("\p1;28H", false);  BufferANSI(PStr_Concat(Temp_Str255_1, C2, "\p컴컴컴컴컴컴컴컴컴컴컴�"), false);  BufferANSI("\p1;32H", false);  BufferANSI(PStr_Concat(Temp_Str255_1, C1, "\pCharacter"),              false);  BufferANSI("\p1;43H", false);  BufferANSI(PStr_Concat(Temp_Str255_1, C1, "\pInfo"), false);    BufferANSI(C1, false);  BufferANSI("\p2H1 Name", false);  BufferANSI("\p2;40H2 Class", false);    BufferANSI("\p3;5H3  HitPoints", false);  BufferANSI("\p3;45H4  Level", false);  BufferANSI("\p4;5H5  Exploration", false);  BufferANSI("\p4;45H6  Won / Lost", false);  BufferANSI("\p5;5H7  Spars", false);  BufferANSI("\p5;45H8  Ammo", false);  BufferANSI("\p6;5H9  Dexterity", false);  BufferANSI("\p6;45H10 Psyche", false);  BufferANSI("\p7;5H11 Strength", false);  BufferANSI("\p7;45H12 Speed", false);  BufferANSI("\p8;5H13 Coins Hand", false);  BufferANSI("\p8;45H14 Coins Bank", false);  BufferANSI("\p9;5H15 Gender", false);    BufferANSI(C3, false);  BufferANSI("\p2;7H-", false);  BufferANSI("\p2;47H-", false);  for (x = 3; x <= 9; ++x) {    NumToString(x, tempstr);    BufferANSI(PStr_Concat(Temp_Str255_1, tempstr, "\p;17H", "\p:"), false);    BufferANSI(PStr_Concat(Temp_Str255_1, tempstr, "\p;57H", "\p:"), false);  }    BufferANSI("\p2;9H", false);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p1;36m", TheStats.name), false);  BufferANSI("\p0;37m", false);  BufferANSI("\p2;49H", false);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p1;36m", TheStats.CharClass), false);  BufferANSI("\p0;37m", false);    BufferANSI(C2, false);  NumToString(TheStats.HitPoints, tempstr);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p3;20H", tempstr), false);  BufferANSI(C3, false);  BufferANSI("\ps/", false);  NumToString(TheStats.MaxHP, tempstr);  BufferANSI(PStr_Concat(Temp_Str255_1, C2, tempstr), false);      PStr_Set(tempstr, "\pNo Level");    BufferANSI(PStr_Concat(Temp_Str255_1, "\p3;60H", tempstr), false);  NumToString(TheStats.Exploration, tempstr);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p4;20H", tempstr), false);  NumToString(TheStats.FightsWon, tempstr);  NumToString(TheStats.TotalFights - TheStats.FightsWon, st2);  PStr_Set(tempstr, PStr_Concat(Temp_Str255_1, tempstr, "\p/", st2));  if (TheStats.TotalFights - TheStats.FightsWon != 0)  	int1 = Round((TheStats.FightsWon / (TheStats.TotalFights - TheStats.FightsWon)) * 100);  else  	int1 = 0;  NumToString(int1, tempstr);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p4;66H", "\p(", tempstr,                          "\p%)"), false);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p4;60H", tempstr),              false);  NumToString(TheStats.Spars, tempstr);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p5;20H", tempstr),              false);  NumToString(TheStats.Ammo, tempstr);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p5;60H", tempstr),              false);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p6;20H", ConvertStats(TheStats.Dexterity)), false);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p6;60H", ConvertStats(TheStats.Psyche)), false);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p7;20H", ConvertStats(TheStats.Strength)), false);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p7;60H", ConvertStats(TheStats.Speed)), false);  NumToString(TheStats.CoinsHand, tempstr);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p8;20H", tempstr), false);  NumToString(TheStats.CoinsBank, tempstr);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p8;60H", tempstr), false);  if (TheStats.Gender)     PStr_Set(tempstr, "\pMale");  else     PStr_Set(tempstr, "\pFemale");  BufferANSI(PStr_Concat(Temp_Str255_1, "\p9;20H", tempstr), false);  ReleaseBuffer(gHermSetup->procs[vReleaseBuffer]);  G_bCr();}//-------------------------------------------------StringPtr GetMonsterType(MonsterRec *TheMonster){  switch (TheMonster->MonType) {     case Humanoid:      return "\pHumanoid";      break;    case Orc:      return "\pOrc";      break;    case Goblin:      return "\pGoblin";      break;    case Fairy:      return "\pFairy";      break;    case Insectoid:      return "\pInsectiod";      break;    case Fantastic:      return "\pFantastic (Magical)";      break;    case Elven:      return "\pElven";      break;    case FElemental:      return "\pFire Elemental";      break;    case WElemental:      return "\pWater Elemental";      break;    case EElemental:      return "\pEarth Elemental";      break;    case AElemental:      return "\pAir Elemental";      break;    case Dwarven:      return "\pDwarven";      break;    case Evil:      return "\pInherently evil";      break;    case Good:      return "\pInherently Good";      break;    case Flying:      return "\pFlying";      break;    case Undead:      return "\pundead";      break;    case psychic:      return "\pPsychic";      break;    case Other:      return "\pOther";      break;  } //case  return "\pOther";}//-------------------------------------------------void PrintMonster(MonsterRec *TheMonster){  Str255 st1;  G_BufferIt("\p[1]  Name: ", false, 7);  G_BufferIt(TheMonster->name, false, 1);  G_BufferbCr();  NumToString(TheMonster->Level, st1);  G_BufferIt("\p[ ]  Level: ", false, 7);  G_BufferIt(st1, false, 1);  G_BufferbCr();  NumToString(TheMonster->MonsterNum, st1);  G_BufferIt("\p[ ]  MonsterNum: ", false, 7);  G_BufferIt(st1, false, 1);  G_BufferbCr();  NumToString(TheMonster->HitPoints, st1);  G_BufferIt("\p[2]  HitPoints: ", false, 7);  G_BufferIt(st1, false, 1);  G_BufferbCr();  NumToString(TheMonster->Offense, st1);  G_BufferIt("\p[3]  Offense: ", false, 7);  G_BufferIt(st1, false, 1);  G_BufferbCr();  NumToString(TheMonster->Defense, st1);  G_BufferIt("\p[4]  Defense: ", false, 7);  G_BufferIt(st1, false, 1);  G_BufferbCr();  NumToString(TheMonster->Experience, st1);  G_BufferIt("\p[5]  Experience: ", false, 7);  G_BufferIt(st1, false, 1);  G_BufferbCr();  G_BufferIt("\p[6]  AttackString 1: ", false, 7);  G_BufferIt(TheMonster->AttackStr1, false, 1);  G_BufferbCr();  G_BufferIt("\p[7]  AttackString 2: ", false, 7);  G_BufferIt(TheMonster->AttackStr2, false, 1);  G_BufferbCr();  G_BufferIt("\p[8]  Defense String: ", false, 7);  G_BufferIt(TheMonster->DefenseStr, false, 1);  G_BufferbCr();  NumToString(TheMonster->Coins, st1);  G_BufferIt("\p[9]  Coins Given: ", false, 7);  G_BufferIt(st1, false, 1);  G_BufferbCr();  NumToString(TheMonster->Movement, st1);  G_BufferIt("\p[10] Movement: ", false, 7);  G_BufferIt(st1, false, 1);  G_BufferbCr();  NumToString(TheMonster->Disposition, st1);  G_BufferIt("\p[11] Disposition: ", false, 7);  G_BufferIt(st1, false, 1);  G_BufferbCr();  PStr_Set(st1, GetMonsterType(TheMonster));  G_BufferIt("\p[12] Monster Type: ", false, 7);  G_BufferIt(st1, false, 1);  G_BufferbCr();  NumToString(TheMonster->RangeOffense, st1);  G_BufferIt("\p[13] Range Offense:", false, 7);  G_BufferIt(st1, false, 1);  G_BufferbCr();  NumToString(TheMonster->Range, st1);  G_BufferIt("\p[14] Range Distance:", false, 7);  G_BufferIt(st1, false, 1);  G_BufferbCr();    ReleaseBuffer(gHermSetup->procs[vReleaseBuffer]);}//-------------------------------------------------