#include <stddef.h>#include <types.h>#include "Builtins.h"#include "PStrings.h"#include "USlySysOp.h"void HandleDoInitialize(void){  TSlyExternal *slyExternal;  try {    slyExternal = new TSlyExternal("\pSlycrel");    FailNIL(slyExternal);    gExternal = slyExternal;    gHermSetup->prefs = Handle(gExternal);  } catch (...) {    G_Outln("\pError: Unable to initialize ", false, 5);    G_Outln("\pSlycrel", true, 5);    gExternal = NULL;    gHermSetup->prefs = Handle(NULL);  }}static void ST_EditWeapon(void);static void ST_WeaponNumPrompt(void);static void ST_WeaponNumMenu(void);static void ST_EditWeaponPrompt(void);static void ST_EditWeaponMenu(void);static void ST_WeaponNamePrompt(void);static void ST_SetWeaponName(void);static void ST_WeaponStrikePrompt(void);static void ST_SetWeaponStrike(void);static void ST_WeaponRangePrompt(void);static void ST_SetWeaponRange(void);static void ST_WeaponCostPrompt(void);static void ST_SetWeaponCost(void);static void ST_WeaponAbilityPrompt(void);static void ST_SetWeaponAbility(void);static void ST_WeaponQualityPrompt(void);static void ST_SetWeaponQuality(void);static void ST_NewWeaponInit(void);static void ST_EditArmor(void);static void ST_ArmorNumPrompt(void);static void ST_ArmorNumMenu(void);static void ST_EditArmorPrompt(void);static void ST_EditArmorMenu(void);static void ST_ArmorNamePrompt(void);static void ST_SetArmorName(void);static void ST_ArmorDefensePrompt(void);static void ST_SetArmorDefense(void);static void ST_ArmorClassPrompt(void);static void ST_SetArmorClass(void);static void ST_ArmorCostPrompt(void);static void ST_SetArmorCost(void);static void ST_ArmorAbilityPrompt(void);static void ST_SetArmorAbility(void);static void ST_ArmorQualityPrompt(void);static void ST_SetArmorQuality(void);static void ST_NewArmorInit(void);static void ST_BeginExternal(void);static void ST_EditPlayer(void);static void ST_PlayerNumPrompt(void);static void ST_PlayerNumMenu(void);static void ST_RollPlayer(void);static void ST_GetPlayer(void);static void ST_PlayerEditPrompt(void);static void ST_PlayerEditMenu(void);static void ST_PlayerNamePrompt(void);static void ST_SetPlayerName(void);static void ST_PlayerClassPrompt(void);static void ST_SetPlayerClass(void);static void ST_PlayerHitPntsPrompt(void);static void ST_SetPlayerHitPnts(void);static void ST_PlayerExplorePrompt(void);static void ST_SetPlayerExplore(void);static void ST_PlayerWinPrompt(void);static void ST_SetPlayerWin(void);static void ST_PlayerTotalPrompt(void);static void ST_SetPlayerTotal(void);static void ST_PlayerSparsPrompt(void);static void ST_SetPlayerSpars(void);static void ST_PlayerAmmoPrompt(void);static void ST_SetPlayerAmmo(void);static void ST_PlayerDextPrompt(void);static void ST_SetPlayerDext(void);static void ST_PlayerPsychePrompt(void);static void ST_SetPlayerPsyche(void);static void ST_PlayerStrengthPrompt(void);static void ST_SetPlayerStrength(void);static void ST_PlayerSpeedPrompt(void);static void ST_SetPlayerSpeed(void);static void ST_PlayerCoinsHPrompt(void);static void ST_SetPlayerCoinsH(void);static void ST_PlayerCoinsBPrompt(void);static void ST_SetPlayerCoinsB(void);static void ST_SysOpEdit(void);static void ST_SysOpEditMenu(void);static void ST_EditMonster(void);static void ST_MonsterNumPrompt(void);static void ST_ReadMonster(void);static void ST_EditMonsterPrompt(void);static void ST_EditMonsterMenu(void);static void ST_MonsterNamePrompt(void);static void ST_SetMonsterName(void);static void ST_MonsterHitPntsPrompt(void);static void ST_SetMonsterHitPnts(void);static void ST_MonsterOffencePrompt(void);static void ST_SetMonsterOffence(void);static void ST_MonsterDefencePrompt(void);static void ST_SetMonsterDefence(void);static void ST_MonsterExperiencPrompt(void);static void ST_SetMonsterExperience(void);static void ST_MonsterAttack1Prompt(void);static void ST_SetMonsterAttack1(void);static void ST_MonsterAttack2Prompt(void);static void ST_SetMonsterAttack2(void);static void ST_MonsterDefenceStrPrompt(void);static void ST_SetMonsterDefenceStr(void);static void ST_MonsterCoinsPrompt(void);static void ST_SetMonsterCoins(void);static void ST_MonsterMovementPrompt(void);static void ST_SetMonsterMovement(void);static void ST_MonsterDispositionPrompt(void);static void ST_SetMonsterDisposition(void);static void ST_MonsterTypePrompt(void);static void ST_SetMonsterType(void);static void ST_MonsterRangeOffPrompt(void);static void ST_SetMonsterRangeOff(void);static void ST_MonsterRangePrompt(void);static void ST_SetMonsterRange(void);static void ST_SaveMonster(void);static void ST_SlySysOpQuit(void);void DisplayPlayer(long itemNum);//-------------------------------------------------void DisplayPlayer(long itemNum){  Str255 st1;  long long1;  CharacterRec charRec;  gCharacterFile->Get(itemNum, charRec);  gCharacterFile->Close();    // print player number  long1 = itemNum;  NumToString(long1, st1);  SpaceOut(st1, 4);  G_Outln(st1, true, 1);    // print slycrel name  PStr_Concat(st1, charRec.name, "\p -- ", charRec.bbsName);  if (st1[0] > 31)    st1[0] = 31;  SpaceOut(st1, 31);  G_Outln(st1, false, 3);  G_Outln("\p ", false, 3);    // print score  NumToString(charRec.scoreVal, st1);  G_Outln(st1, false, 0);}void ST_EditWeapon(void){  if (!gWeaponFile->Exists()) {    G_bCr();    G_Outln("\pNo Weapons file, creating new...", true, 1);    G_bCr();    gWeaponFile->Create();    PStr_Set((*gCharacter)->Weapons[1 - 1].name, "\pGeneric Sword");    (*gCharacter)->Weapons[1 - 1].Strike = 2;    (*gCharacter)->Weapons[1 - 1].Range = 0;    (*gCharacter)->Weapons[1 - 1].Cost = 10;    (*gCharacter)->Weapons[1 - 1].Ability = 0;    (*gCharacter)->Weapons[1 - 1].Quality = 100;    gWeaponFile->Add((*gCharacter)->Weapons[0]);    gWeaponFile->Close();  }    gSlyPrivates->armoryListCount = 0;  UserGlobPtr()->boardAction = Repeating;  SetNextState(stWeaponNumPrompt);}void ST_WeaponNumPrompt(void){  short numWeapons;  numWeapons = gWeaponFile->NumItems();  if (UserGlobPtr()->aborted || gSlyPrivates->armoryListCount >= numWeapons) {    if (UserGlobPtr()->aborted)       G_Outln("\p - Aborted - ", true, 3);        UserGlobPtr()->aborted = false;    gWeaponFile->Close();        G_bCr();    G_bCr();    G_NumbersPrompt("\pChoose Your Weapon: [N,Q,#]", "\pNQ0123456789",                     numWeapons, 1);    SetNextState(stWeaponNumMenu);  } else {    DisplayWeaponList(gSlyPrivates->armoryListCount, 32767);  //else    gSlyPrivates->armoryListCount++;  }}void ST_WeaponNumMenu(void){  long long1;  if (UserGlobPtr()->curPrompt[1] == 'Q')     SetNextState(stSysOpEdit);  else if (UserGlobPtr()->curPrompt[1] == 'N')     SetNextState(stNewWeaponInit);  else if (PStr_Cmp(UserGlobPtr()->curPrompt, "\p") == 0)     SetNextState(stEditWeapon);  else {    StringToNum(UserGlobPtr()->curPrompt, &long1);    gSlyPrivates->weaponToBuy = long1;    GetWeapon(long1, &(*gCharacter)->Weapons[1 - 1]);    SetNextState(stEditWeaponPrompt);  }}void ST_EditWeaponPrompt(void){  SaveWeapon(&(*gCharacter)->Weapons[1 - 1], gSlyPrivates->weaponToBuy);  DisplayWeapon(&(*gCharacter)->Weapons[1 - 1], gSlyPrivates->weaponToBuy);  G_NumbersPrompt("\pEdit: ", "\p0123456789", 6, 0);  SetNextState(stEditWeaponMenu);}void ST_EditWeaponMenu(void){  if (PStr_Cmp(UserGlobPtr()->curPrompt, "\p") == 0)     SetNextState(stEditWeaponPrompt);  switch (UserGlobPtr()->curPrompt[1]) {     case '0':      G_bCr();      SetNextState(stEditWeapon);      break;    case '1':      SetNextState(stWeaponNamePrompt);           //Name      break;    case '2':      SetNextState(stWeaponStrikePrompt);         //Strike      break;    case '3':      SetNextState(stWeaponRangePrompt);          //Range      break;    case '4':      SetNextState(stWeaponCostPrompt);           //Cost      break;    case '5':      SetNextState(stWeaponAbilityPrompt);        //Ability      break;    case '6':      SetNextState(stWeaponQualityPrompt);        //Quality      break;  } //Case}void ST_WeaponNamePrompt(void){  G_bCr();  G_Outln("\pWhat would you like to re-name this weapon to [max 20 chrs]?",           true, 1);  G_bCr();  G_LettersPrompt("\p:", "\p", 20, false, false, false, char(0));  G_ANSIPrompter(20);  SetNextState(stSetWeaponName);}void ST_SetWeaponName(void){  Str255 Temp_Str255_1;  G_bCr();  PStr_Set((*gCharacter)->Weapons[1 - 1].name, UserGlobPtr()->curPrompt);  G_Outln(PStr_Concat(Temp_Str255_1, "\pOkay, your weapon is now re-named to ",                       UserGlobPtr()->curPrompt, "\p."), true,           3);  G_bCr();  SetNextState(stEditWeaponPrompt);}void ST_WeaponStrikePrompt(void){  G_bCr();  G_NumbersPrompt("\pWhat would you like your new strike to be [1..32767]? ",                   "\p0123456789", 32767, 0);  SetNextState(stSetWeaponStrike);}void ST_SetWeaponStrike(void){  long long1;  Str255 Temp_Str255_1;  StringToNum(UserGlobPtr()->curPrompt, &long1);  (*gCharacter)->Weapons[1 - 1].Strike = long1;  G_bCr();  G_Outln(PStr_Concat(Temp_Str255_1, "\pOkay, your weapon\'s strike is now ",                       UserGlobPtr()->curPrompt, "\p."), true,           1);  G_bCr();  SetNextState(stEditWeaponPrompt);}void ST_WeaponRangePrompt(void){  G_bCr();  G_NumbersPrompt("\pWhat is the weapon\'s new range [0-melee, 1..255-ranged]? ",                   "\p0123456789", 255, 0);  G_bCr();  SetNextState(stSetWeaponRange);}void ST_SetWeaponRange(void){  long long1;  Str255 Temp_Str255_1;  StringToNum(UserGlobPtr()->curPrompt, &long1);  (*gCharacter)->Weapons[1 - 1].Range = long1;  G_Outln(PStr_Concat(Temp_Str255_1, "\pOkay, your weapon\'s new range is ",                       UserGlobPtr()->curPrompt, "\p."), true,           1);  G_bCr();  SetNextState(stEditWeaponPrompt);}void ST_WeaponCostPrompt(void){  G_bCr();  G_NumbersPrompt("\pWhat would you like the new cost of this weapon to be [0-unavbl, 1..32767-buyable]?",                   "\p0123456789", 32767, 0);  G_bCr();  SetNextState(stSetWeaponCost);}void ST_SetWeaponCost(void){  long long1;  Str255 Temp_Str255_1;  StringToNum(UserGlobPtr()->curPrompt, &long1);  (*gCharacter)->Weapons[1 - 1].Cost = long1;  G_bCr();  G_Outln(PStr_Concat(Temp_Str255_1, "\pOkay, your weapon\'s cost is now ",                       UserGlobPtr()->curPrompt, "\p."), true,           1);  G_bCr();  SetNextState(stEditWeaponPrompt);}void ST_WeaponAbilityPrompt(void){  G_bCr();  G_NumbersPrompt("\pWhat ability would you like your weapon to have [0-none, 1..255, ?-list]?",                   "\p?0123456789", 255, 0);  G_bCr();  SetNextState(stSetWeaponAbility);}void ST_SetWeaponAbility(void){  long long1;  Str255 Temp_Str255_1;  if (UserGlobPtr()->curPrompt[1] != '?') {    StringToNum(UserGlobPtr()->curPrompt, &long1);    (*gCharacter)->Weapons[1 - 1].Ability = long1;    G_Outln(PStr_Concat(Temp_Str255_1, "\pOkay, your weapon\'s ability is now ",                         UserGlobPtr()->curPrompt, "\p."), true,             1);    G_bCr();    SetNextState(stEditWeaponPrompt);  } else {    G_bCr();    G_Outln("\pNot yet implemented...", true, 1);    G_bCr();    SetNextState(stWeaponAbilityPrompt);  }                                               //End ability mods}void ST_WeaponQualityPrompt(void){  G_bCr();  G_NumbersPrompt("\pWhat quality would you like your weapon to have [0..255]?",                   "\p?0123456789", 255, 0);  G_bCr();  SetNextState(stSetWeaponQuality);}void ST_SetWeaponQuality(void){  long long1;  Str255 Temp_Str255_1;  StringToNum(UserGlobPtr()->curPrompt, &long1);  (*gCharacter)->Weapons[1 - 1].Quality = long1;  G_Outln(PStr_Concat(Temp_Str255_1, "\pOkay, your weapon\'s new quality is ",                       UserGlobPtr()->curPrompt, "\p."), true,           1);  G_bCr();  SetNextState(stEditWeaponPrompt);}void ST_NewWeaponInit(void){  //initialize new weapon  PStr_Set((*gCharacter)->Weapons[1 - 1].name, "\pGeneric Sword");  (*gCharacter)->Weapons[1 - 1].Strike = 2;  (*gCharacter)->Weapons[1 - 1].Range = 0;  (*gCharacter)->Weapons[1 - 1].Cost = 10;  (*gCharacter)->Weapons[1 - 1].Ability = 0;  (*gCharacter)->Weapons[1 - 1].Quality = 100;  gSlyPrivates->weaponToBuy = 0;  //Write weapon to file & close file  gWeaponFile->Add((*gCharacter)->Weapons[1 - 1]);  gSlyPrivates->weaponToBuy = gWeaponFile->NumItems();  gWeaponFile->Close();  //go to edit weapon stage and edit new weapon  SetNextState(stEditWeaponPrompt);}void ST_EditArmor(void){  if (!gArmorFile->Exists()) {    G_bCr();    G_Outln("\pNo Armor file, creating new...", true, 1);    G_bCr();    gArmorFile->Create();    PStr_Set((*gCharacter)->Armor[1 - 1].name, "\pGeneric Armor");    (*gCharacter)->Armor[1 - 1].Class_2 = 0;    (*gCharacter)->Armor[1 - 1].Defense = 2;    (*gCharacter)->Armor[1 - 1].Cost = 10;    (*gCharacter)->Armor[1 - 1].Ability = 0;    (*gCharacter)->Armor[1 - 1].Quality = 100;    gArmorFile->Add((*gCharacter)->Armor[1 - 1]);    gArmorFile->Close();  }    gSlyPrivates->armoryListCount = 0;  UserGlobPtr()->boardAction = Repeating;  SetNextState(stArmorNumPrompt);}void ST_ArmorNumPrompt(void){  short numArmor;    numArmor = gArmorFile->NumItems();  if (UserGlobPtr()->aborted || gSlyPrivates->armoryListCount >= numArmor) {    if (UserGlobPtr()->aborted)       G_Outln("\p - Aborted - ", true, 3);        UserGlobPtr()->aborted = false;    gArmorFile->Close();        G_bCr();    G_bCr();    G_NumbersPrompt("\pChoose Your Weapon: [N,Q,#]", "\pNQ0123456789",                     numArmor, 1);    SetNextState(stArmorNumMenu);  } else {    DisplayArmorList(gSlyPrivates->armoryListCount, 32767);  //else    gSlyPrivates->armoryListCount++;  }}void ST_ArmorNumMenu(void){  long long1;  if (UserGlobPtr()->curPrompt[1] == 'Q')     SetNextState(stSysOpEdit);  else if (UserGlobPtr()->curPrompt[1] == 'N')     SetNextState(stNewArmorInit);  else if (PStr_Cmp(UserGlobPtr()->curPrompt, "\p") == 0)     SetNextState(stEditArmor);  else {    StringToNum(UserGlobPtr()->curPrompt, &long1);    gSlyPrivates->armorToBuy = long1;    GetArmor(long1, &(*gCharacter)->Armor[1 - 1]);    SetNextState(stEditArmorPrompt);  }}void ST_EditArmorPrompt(void){  SaveArmor(&(*gCharacter)->Armor[1 - 1], gSlyPrivates->armorToBuy);  DisplayArmor(&(*gCharacter)->Armor[1 - 1], gSlyPrivates->armorToBuy);  G_NumbersPrompt("\pEdit: ", "\p0123456789", 6, 0);  SetNextState(stEditArmorMenu);}void ST_EditArmorMenu(void){  if (PStr_Cmp(UserGlobPtr()->curPrompt, "\p") == 0)     SetNextState(stEditArmorPrompt);  switch (UserGlobPtr()->curPrompt[1]) {     case '0':      G_bCr();      SetNextState(stEditArmor);      break;    case '1':      SetNextState(stArmorNamePrompt);            //Name      break;    case '2':      SetNextState(stArmorDefensePrompt);         //Defense      break;    case '3':      SetNextState(stArmorClassPrompt);           //Class      break;    case '4':      SetNextState(stArmorCostPrompt);            //Cost      break;    case '5':      SetNextState(stArmorAbilityPrompt);         //Ability      break;    case '6':      SetNextState(stArmorQualityPrompt);         //Quality      break;  } //Case}void ST_ArmorNamePrompt(void){  G_bCr();  G_Outln("\pWhat would you like to re-name this Armor to [max 20 chrs]?",           true, 1);  G_bCr();  G_LettersPrompt("\p:", "\p", 20, false, false, false, char(0));  G_ANSIPrompter(20);  SetNextState(stSetArmorName);}void ST_SetArmorName(void){  Str255 Temp_Str255_1;  G_bCr();  PStr_Set((*gCharacter)->Armor[1 - 1].name, UserGlobPtr()->curPrompt);  G_Outln(PStr_Concat(Temp_Str255_1, "\pOkay, your Armor is now re-named to ",                       UserGlobPtr()->curPrompt, "\p."), true,           3);  G_bCr();  SetNextState(stEditArmorPrompt);}void ST_ArmorDefensePrompt(void){  G_bCr();  G_NumbersPrompt("\pWhat would you like your new defense to be [1..32767]? ",                   "\p0123456789", 32767, 0);  SetNextState(stSetArmorDefense);}void ST_SetArmorDefense(void){  long long1;  Str255 Temp_Str255_1;  StringToNum(UserGlobPtr()->curPrompt, &long1);  (*gCharacter)->Armor[1 - 1].Defense = long1;  G_bCr();  G_Outln(PStr_Concat(Temp_Str255_1, "\pOkay, your Armor\'s Defense is now ",                       UserGlobPtr()->curPrompt, "\p."), true,           1);  G_bCr();  SetNextState(stEditArmorPrompt);}void ST_ArmorClassPrompt(void){  G_bCr();  G_NumbersPrompt("\pWhat is the Armor\'s new Class [0-Body, 1-Shield,2-Full Body]? ",                   "\p0123456789", 2, 0);  G_bCr();  SetNextState(stSetArmorClass);}void ST_SetArmorClass(void){  long long1;  Str255 Temp_Str255_1;  StringToNum(UserGlobPtr()->curPrompt, &long1);  (*gCharacter)->Armor[1 - 1].Class_2 = long1;  G_Outln(PStr_Concat(Temp_Str255_1, "\pOkay, your Armor\'s new Class is ",                       UserGlobPtr()->curPrompt, "\p."), true,           1);  G_bCr();  SetNextState(stEditArmorPrompt);}void ST_ArmorCostPrompt(void){  G_bCr();  G_NumbersPrompt("\pWhat would you like the new cost of this Armor to be [0-unavbl, 1..32767-buyable]?",                   "\p0123456789", 32767, 0);  G_bCr();  SetNextState(stSetArmorCost);}void ST_SetArmorCost(void){  long long1;  Str255 Temp_Str255_1;  StringToNum(UserGlobPtr()->curPrompt, &long1);  (*gCharacter)->Armor[1 - 1].Cost = long1;  G_bCr();  G_Outln(PStr_Concat(Temp_Str255_1, "\pOkay, your Armor\'s cost is now ",                       UserGlobPtr()->curPrompt, "\p."), true,           1);  G_bCr();  SetNextState(stEditArmorPrompt);}void ST_ArmorAbilityPrompt(void){  G_bCr();  G_NumbersPrompt("\pWhat ability would you like your Armor to have [0-none, 1..255, ?-list]?",                   "\p?0123456789", 255, 0);  G_bCr();  SetNextState(stSetArmorAbility);}void ST_SetArmorAbility(void){  long long1;  Str255 Temp_Str255_1;  if (UserGlobPtr()->curPrompt[1] != '?') {    StringToNum(UserGlobPtr()->curPrompt, &long1);    (*gCharacter)->Armor[1 - 1].Ability = long1;    G_Outln(PStr_Concat(Temp_Str255_1, "\pOkay, your Armor\'s ability is now ",                         UserGlobPtr()->curPrompt, "\p."), true,             1);    G_bCr();    SetNextState(stEditArmorPrompt);  } else {    G_bCr();    G_Outln("\pNot yet implemented...", true, 1);    G_bCr();    SetNextState(stArmorAbilityPrompt);  }                                               //End ability mods}void ST_ArmorQualityPrompt(void){  G_bCr();  G_NumbersPrompt("\pWhat quality would you like your Armor to have [0..255]?",                   "\p?0123456789", 255, 0);  G_bCr();  SetNextState(stSetArmorQuality);}void ST_SetArmorQuality(void){  long long1;  Str255 Temp_Str255_1;  StringToNum(UserGlobPtr()->curPrompt, &long1);  (*gCharacter)->Armor[1 - 1].Quality = long1;  G_Outln(PStr_Concat(Temp_Str255_1, "\pOkay, your Armor\'s new quality is ",                       UserGlobPtr()->curPrompt, "\p."), true,           1);  G_bCr();  SetNextState(stEditArmorPrompt);}void ST_NewArmorInit(void){  //initialize new Armor  PStr_Set((*gCharacter)->Armor[1 - 1].name, "\pGeneric Armor");  (*gCharacter)->Armor[1 - 1].Defense = 2;  (*gCharacter)->Armor[1 - 1].Class_2 = 0;  (*gCharacter)->Armor[1 - 1].Cost = 10;  (*gCharacter)->Armor[1 - 1].Ability = 0;  (*gCharacter)->Armor[1 - 1].Quality = 100;  gSlyPrivates->armorToBuy = 0;  //Write Armor to file & close file  gArmorFile->Add((*gCharacter)->Armor[0]);  gSlyPrivates->armorToBuy = gArmorFile->NumItems();  gArmorFile->Close();  //go to edit Armor stage and edit new Armor  SetNextState(stEditArmorPrompt);}void ST_BeginExternal(void){  SetNextState(stSysOpEdit);}void ST_EditPlayer(void){  if (!gCharacterFile->Exists()) {    G_bCr();    G_Outln("\pError: There are currently no player records saved.", true, 1);    G_bCr();    SetNextState(stSysOpEdit);  }  else {    gSlyPrivates->armoryListCount = 0;    UserGlobPtr()->boardAction = Repeating;    SetNextState(stPlayerNumPrompt);  }}void ST_PlayerNumPrompt(void){  short numPlayers;  numPlayers = gCharacterFile->NumItems();  if (UserGlobPtr()->aborted || gSlyPrivates->armoryListCount >= numPlayers) {    if (UserGlobPtr()->aborted)       G_Outln("\p - Aborted - ", true, 3);        UserGlobPtr()->aborted = false;    gCharacterFile->Close();        G_bCr();    G_bCr();    G_NumbersPrompt("\pChoose Player to edit: [Q,#]", "\pQ0123456789",                     numPlayers-1, 0);    SetNextState(stPlayerNumMenu);  } else {    DisplayPlayer(gSlyPrivates->armoryListCount);    gSlyPrivates->armoryListCount++;  }}void ST_PlayerNumMenu(void){  long long1;  if (UserGlobPtr()->curPrompt[1] == 'Q')     SetNextState(stSysOpEdit);  else if (PStr_Cmp(UserGlobPtr()->curPrompt, "\p") == 0)     SetNextState(stEditPlayer);  else {    StringToNum(UserGlobPtr()->curPrompt, &long1);    gSlyPrivates->weaponToBuy = long1;    gCharacterFile->Get(gSlyPrivates->weaponToBuy, **gCharacter);    gCharacterFile->Close();    SetNextState(stPlayerEditPrompt);  }}void ST_RollPlayer(void){  CharacterRec charRec;  try {    ReadSlyChar(UserGlobPtr()->curPrompt, &charRec);    RollChar(&charRec, 'T');    G_Outln("\pOkay, that user has been reset to beginning level.", true, 3);  } catch (...) {    G_Outln("\pError: Unable to find user.", true, 3);  }  SetNextState(stSysOpEdit);}void ST_PlayerEditPrompt(void){  NumPrintCharStats(**gCharacter);  G_bCr();  G_Outln("\p  (R)oll player and set to first level", true, 3);  G_Outln("\p  (S)ave player info", true, 3);  G_Outln("\p  (Q)uit (without saving)", true, 3);  G_bCr();  G_bCr();  G_NumbersPrompt("\pYour choice? [1-15,Q,R,S]  ", "\p1234567890QS",                   15, 1);  SetNextState(stPlayerEditMenu);}void ST_PlayerEditMenu(void){  long long1;  if (UserGlobPtr()->curPrompt[1] == 'Q')     SetNextState(stSysOpEdit);  else if (UserGlobPtr()->curPrompt[1] == '?')     SetNextState(stPlayerEditPrompt);  else if (UserGlobPtr()->curPrompt[1] == 'R')    SetNextState(stRollPlayer);  else if (UserGlobPtr()->curPrompt[1] == 'S') {    SaveChar(*gCharacter);    SetNextState(stPlayerEditPrompt);  } else {    StringToNum(UserGlobPtr()->curPrompt, &long1);    switch (long1) {       case 1:        SetNextState(stPlayerNamePrompt);         //name  x, Done        break;      case 2:        SetNextState(stPlayerClassPrompt);        //Class  x, Done        break;      case 3:        SetNextState(stPlayerHitPntsPrompt);      //HitPoints, Done        break;      case 4:        G_Outln("\pSorry, you can\'t just mess with people\'s levels like that!  ;) ",                 true, 1);        G_bCr();        SetNextState(stEditPlayer);        break;      case 5:        SetNextState(stPlayerExplorePrompt);      //Exploration, Done        break;      case 6:        SetNextState(stPlayerWinPrompt);          //Win/Total, Done        break;      case 7:        SetNextState(stPlayerSparsPrompt);        //Spars, Done        break;      case 8:        SetNextState(stPlayerAmmoPrompt);         //Ammo, Done        break;      case 9:        SetNextState(stPlayerDextPrompt);         //Dexterity, Done        break;      case 10:        SetNextState(stPlayerPsychePrompt);       //Psyche, Done        break;      case 11:        SetNextState(stPlayerStrengthPrompt);     //Strength, Done        break;      case 12:        SetNextState(stPlayerSpeedPrompt);        //Speed, Done        break;      case 13:        SetNextState(stPlayerCoinsHPrompt);       //CoinsHand, Done        break;      case 14:        SetNextState(stPlayerCoinsBPrompt);       //CoinsBank, Done        break;      case 15:                                    //Gender x        CharacterPtr with_5 = *gCharacter;        if ((*gCharacter)->Gender == true) {          G_Outln("\pYou are Now Female.", true, 3);          with_5->Gender = false;          with_5->Strength -= 3;          with_5->MaxPsyche++;          with_5->Dexterity += 2;          with_5->MaxHP -= 2;          with_5->HitPoints = with_5->MaxHP;          with_5->Faith += 2;        } else {          G_Outln("\pYou are Now Male.", true, 3);          (*gCharacter)->Gender = true;          with_5->Strength += 3;          with_5->MaxPsyche--;          with_5->Dexterity -= 2;          with_5->MaxHP += 2;          with_5->HitPoints = with_5->MaxHP;          with_5->Faith -= 2;        }        SetNextState(stPlayerEditPrompt);        break;      default:        SetNextState(stSysOpEdit);        break;    }  }}void ST_PlayerNamePrompt(void){  G_LettersPrompt("\p", "\p", 20, false, false, false, char(0));  G_ANSICode("\p33mWhat is your new Name:");  G_ANSIPrompter(20);  PStr_Set(UserGlobPtr()->curPrompt, (*gCharacter)->name);  G_Outln(UserGlobPtr()->curPrompt, false, 4);  SetNextState(stSetPlayerName);}void ST_SetPlayerName(void){  PStr_Set((*gCharacter)->name, UserGlobPtr()->curPrompt);  SetNextState(stPlayerEditPrompt);}void ST_PlayerClassPrompt(void){  PrintMenu("\p[", "\pF", "\p]ighter", "\p0;36m", "\p1;5;31m", true);  PrintMenu("\p[", "\pT", "\p]hief", "\p0;36m", "\p1;31m", true);  PrintMenu("\p[", "\pM", "\p]age", "\p0;36m", "\p1;31m", true);  ClrPrompt();  G_LettersPrompt("\p", "\pFTM", 1, true, false, true, char(0));  G_ANSICode("\p1;34mNew class");  G_ANSICode("\p0;35m - ");  SetNextState(stSetPlayerClass);}void ST_SetPlayerClass(void){  Str255 st1;  if (!OkPrompt("\pFTM"))     SetNextState(stPlayerClassPrompt);  else {    PStr_Set((*gCharacter)->CharClass, PStr_FromChar(st1, UserGlobPtr()->curPrompt[1]));    SetNextState(stPlayerEditPrompt);  }}void ST_PlayerHitPntsPrompt(void){  PStr_Set(UserGlobPtr()->curPrompt, "\pEmpty");  G_NumbersPrompt("\pNew Maximum HitPoints? [10-32750]  ", "\p1234567890QS",                   32750, 1);  SetNextState(stSetPlayerHitPnts);}void ST_SetPlayerHitPnts(void){  long long1;  if (!(PStr_Cmp(UserGlobPtr()->curPrompt, "\pEmpty") == 0)) {    StringToNum(UserGlobPtr()->curPrompt, &long1);    (*gCharacter)->MaxHP = long1;  }  SetNextState(stPlayerEditPrompt);}void ST_PlayerExplorePrompt(void){  PStr_Set(UserGlobPtr()->curPrompt, "\pEmpty");  G_NumbersPrompt("\pNew Maximum Exploration? [1-255]  ", "\p1234567890QS",                   255, 1);  SetNextState(stSetPlayerExplore);}void ST_SetPlayerExplore(void){  long long1;  if (!(PStr_Cmp(UserGlobPtr()->curPrompt, "\pEmpty") == 0)) {    StringToNum(UserGlobPtr()->curPrompt, &long1);    (*gCharacter)->Exploration = long1;    SetNextState(stPlayerEditPrompt);  }}void ST_PlayerWinPrompt(void){  PStr_Set(UserGlobPtr()->curPrompt, "\pEmpty");  G_NumbersPrompt("\pNew Wins? [1-2 bil]  ", "\p1234567890QS", 2100000000,                   1);  SetNextState(stSetPlayerWin);}void ST_SetPlayerWin(void){  long long1;  if (!(PStr_Cmp(UserGlobPtr()->curPrompt, "\pEmpty") == 0)) {    StringToNum(UserGlobPtr()->curPrompt, &long1);    (*gCharacter)->FightsWon = long1;    SetNextState(stPlayerTotalPrompt);  }}void ST_PlayerTotalPrompt(void){  PStr_Set(UserGlobPtr()->curPrompt, "\pEmpty");  G_NumbersPrompt("\pNew Total fights? [1-2 bil]  ", "\p1234567890QS",                   2100000000, 1);  SetNextState(stSetPlayerTotal);}void ST_SetPlayerTotal(void){  long long1;  if (!(PStr_Cmp(UserGlobPtr()->curPrompt, "\pEmpty") == 0)) {    StringToNum(UserGlobPtr()->curPrompt, &long1);    (*gCharacter)->TotalFights = long1;    SetNextState(stPlayerEditPrompt);  }}void ST_PlayerSparsPrompt(void){  PStr_Set(UserGlobPtr()->curPrompt, "\pEmpty");  G_NumbersPrompt("\pNew Maximum Spars? [1-255]  ", "\p1234567890QS",                   255, 1);  SetNextState(stSetPlayerSpars);}void ST_SetPlayerSpars(void){  long long1;  if (!(PStr_Cmp(UserGlobPtr()->curPrompt, "\pEmpty") == 0)) {    StringToNum(UserGlobPtr()->curPrompt, &long1);    (*gCharacter)->Spars = long1;    SetNextState(stPlayerEditPrompt);  }}void ST_PlayerAmmoPrompt(void){  PStr_Set(UserGlobPtr()->curPrompt, "\pEmpty");  G_NumbersPrompt("\pNew Ammo? [1-255]  ", "\p1234567890QS", 255,                   1);  SetNextState(stSetPlayerAmmo);}void ST_SetPlayerAmmo(void){  long long1;  if (!(PStr_Cmp(UserGlobPtr()->curPrompt, "\pEmpty") == 0)) {    StringToNum(UserGlobPtr()->curPrompt, &long1);    (*gCharacter)->Ammo = long1;    SetNextState(stPlayerEditPrompt);  }}void ST_PlayerDextPrompt(void){  PStr_Set(UserGlobPtr()->curPrompt, "\pEmpty");  G_NumbersPrompt("\pNew Dexterity? [1-200]  ", "\p1234567890QS",                   200, 1);  SetNextState(stSetPlayerDext);}void ST_SetPlayerDext(void){  long long1;  if (!(PStr_Cmp(UserGlobPtr()->curPrompt, "\pEmpty") == 0)) {    StringToNum(UserGlobPtr()->curPrompt, &long1);    (*gCharacter)->Dexterity = long1;    SetNextState(stPlayerEditPrompt);  }}void ST_PlayerPsychePrompt(void){  PStr_Set(UserGlobPtr()->curPrompt, "\pEmpty");  G_NumbersPrompt("\pNew Psyche? [1-200]  ", "\p1234567890QS", 200,                   1);  SetNextState(stSetPlayerPsyche);}void ST_SetPlayerPsyche(void){  long long1;  if (!(PStr_Cmp(UserGlobPtr()->curPrompt, "\pEmpty") == 0)) {    StringToNum(UserGlobPtr()->curPrompt, &long1);    (*gCharacter)->Psyche = long1;    SetNextState(stPlayerEditPrompt);  }}void ST_PlayerStrengthPrompt(void){  PStr_Set(UserGlobPtr()->curPrompt, "\pEmpty");  G_NumbersPrompt("\pNew Strength? [1-200]  ", "\p1234567890QS", 200,                   1);  SetNextState(stSetPlayerStrength);}void ST_SetPlayerStrength(void){  long long1;  if (!(PStr_Cmp(UserGlobPtr()->curPrompt, "\pEmpty") == 0)) {    StringToNum(UserGlobPtr()->curPrompt, &long1);    (*gCharacter)->Strength = long1;    SetNextState(stPlayerEditPrompt);  }}void ST_PlayerSpeedPrompt(void){  PStr_Set(UserGlobPtr()->curPrompt, "\pEmpty");  G_NumbersPrompt("\pNew Speed? [1-200]  ", "\p1234567890QS", 200,                   1);  SetNextState(stSetPlayerSpeed);}void ST_SetPlayerSpeed(void){  long long1;  if (!(PStr_Cmp(UserGlobPtr()->curPrompt, "\pEmpty") == 0)) {    StringToNum(UserGlobPtr()->curPrompt, &long1);    (*gCharacter)->Speed = long1;    SetNextState(stPlayerEditPrompt);  }}void ST_PlayerCoinsHPrompt(void){  PStr_Set(UserGlobPtr()->curPrompt, "\pEmpty");  G_NumbersPrompt("\pNew Coins on hand? [1-2 bil]  ", "\p1234567890QS",                   2100000000, 1);  SetNextState(stSetPlayerCoinsH);}void ST_SetPlayerCoinsH(void){  long long1;  if (!(PStr_Cmp(UserGlobPtr()->curPrompt, "\pEmpty") == 0)) {    StringToNum(UserGlobPtr()->curPrompt, &long1);    (*gCharacter)->CoinsHand = long1;    SetNextState(stPlayerEditPrompt);  }}void ST_PlayerCoinsBPrompt(void){  PStr_Set(UserGlobPtr()->curPrompt, "\pEmpty");  G_NumbersPrompt("\pNew Coins in bank? [1-2 bil]  ", "\p1234567890QS",                   2100000000, 1);  SetNextState(stSetPlayerCoinsB);}void ST_SetPlayerCoinsB(void){  long long1;  if (!(PStr_Cmp(UserGlobPtr()->curPrompt, "\pEmpty") == 0)) {    StringToNum(UserGlobPtr()->curPrompt, &long1);    (*gCharacter)->CoinsBank = long1;    SetNextState(stPlayerEditPrompt);  }}void ST_SysOpEdit(void){  G_bCr();  G_bCr();  G_Outln("\p\t\tWelcome to the Slycrel SysOp Editor!", true, 7);  G_bCr();  PrintMenu("\p(", "\pA", "\p)Edit Armor", "\p1;34m", "\p0;36m", true);  PrintMenu("\p(", "\pB", "\p)Edit Weapon", "\p1;34m", "\p0;36m",             true);  PrintMenu("\p(", "\pC", "\p)Edit Monster", "\p1;34m", "\p0;36m",             true);  PrintMenu("\p(", "\pD", "\p)Edit Player", "\p1;34m", "\p0;36m",             true);  PrintMenu("\p(", "\pQ", "\p)uit to Town", "\p1;34m", "\p0;36m",             true);  G_bCr();  G_bCr();  ClrPrompt();  if (CheckRegistration())     G_LettersPrompt("\pWhat is your wish?", "\pABCDQ", 1, true, false,                     true, char(0));  else {    G_Outln("\pSlycrel is Not Registered, SysOp Editor will work upon registration",             true, 6);    G_bCr();    G_LettersPrompt("\pWhat is your wish?", "\pQ", 1, true, false,                     true, char(0));  }  SetNextState(stSysOpEditMenu);}void ST_SysOpEditMenu(void){  switch (UserGlobPtr()->curPrompt[1]) {     case 'Q':      SetNextState(stSlySysOpQuit);      break;    case 'A':      SetNextState(stEditArmor);      break;    case 'B':      SetNextState(stEditWeapon);      break;    case 'C':      SetNextState(stEditMonster);      break;    case 'D':      SetNextState(stEditPlayer);      break;    default:      SetNextState(stSysOpEdit);      break;  }}static void GetCSVString(TFile *file, StringPtr s);void GetCSVString(TFile *file, StringPtr s){	char fileChar;		s[0] = 0;	file->Read(1, &fileChar);	while (fileChar != ',' && fileChar != '\x0d') {		s[0]++;		s[s[0]] = fileChar;		file->Read(1, &fileChar);	}}static void GetMonsterInfo(TFile *file, StringPtr name, long &type, StringPtr action, StringPtr attack1, StringPtr attack2, StringPtr defense);void GetMonsterInfo(TFile *file, StringPtr name, long &type, StringPtr action, StringPtr attack1,	StringPtr attack2, StringPtr defense){	Str255 typeStr;	GetCSVString(file, name);	GetCSVString(file, typeStr);	StringToNum(typeStr, &type);	GetCSVString(file, action);	GetCSVString(file, attack1);	GetCSVString(file, attack2);	GetCSVString(file, defense);}void ST_EditMonster(void){  short x;  Str255 name;  long type;  Str255 action;  Str255 attack1;  Str255 attack2;  Str255 defense;  TMonsterFile forestFile(MonsterPath, "\pForest");  if (!forestFile.Exists()) {    forestFile.Create();    TFile forestTxtFile(MonsterPath, "\pForest.csv");    for (x = 1; x <= 300; ++x) {      GetMonsterInfo(&forestTxtFile, name, type, action, attack1, attack2, defense);      PStr_Set(gSlyPrivates->Monster.name, name);      gSlyPrivates->Monster.Level = x / 5 + 1;      gSlyPrivates->Monster.MonType = MonsterType(type);      gSlyPrivates->Monster.MonsterNum = x;      gSlyPrivates->Monster.HitPoints = short(ProgressionCurve(gSlyPrivates->Monster.Level, RandomBetween(5, 10), 2));      gSlyPrivates->Monster.Offense = short(ProgressionCurve(gSlyPrivates->Monster.Level, RandomBetween(2, 3), 1)) / 2;      gSlyPrivates->Monster.Defense = short(ProgressionCurve(gSlyPrivates->Monster.Level, RandomBetween(2, 3), 1)) / 2;      gSlyPrivates->Monster.Movement = short(ProgressionCurve(gSlyPrivates->Monster.Level, RandomBetween(3, 6), 1));      gSlyPrivates->Monster.Disposition = 1;      gSlyPrivates->Monster.Experience = short(ProgressionCurve(gSlyPrivates->Monster.Level, RandomBetween(5, 8), 2));      PStr_Set(gSlyPrivates->Monster.AttackStr1, attack1);      PStr_Set(gSlyPrivates->Monster.AttackStr2, attack2);      PStr_Set(gSlyPrivates->Monster.AttackActionStr, action);      PStr_Set(gSlyPrivates->Monster.DefenseStr, defense);      PStr_Set(gSlyPrivates->Monster.DefenseActionStr, "\p");      gSlyPrivates->Monster.Coins = short(ProgressionCurve(gSlyPrivates->Monster.Level, RandomBetween(5, 8), 2));      gSlyPrivates->Monster.RangeOffense = short(ProgressionCurve(gSlyPrivates->Monster.Level, RandomBetween(1, 2), 1) / 2);      gSlyPrivates->Monster.Range = gSlyPrivates->Monster.Level;      forestFile.Add(gSlyPrivates->Monster);    }    forestTxtFile.Close();    forestFile.Close();  }  TMonsterFile mountainFile(MonsterPath, "\pMountain");  if (!mountainFile.Exists()) {    mountainFile.Create();    TFile mountainTxtFile(MonsterPath, "\pForest.csv");    for (x = 1; x <= 300; ++x) {      GetMonsterInfo(&mountainTxtFile, name, type, action, attack1, attack2, defense);      PStr_Set(gSlyPrivates->Monster.name, name);      gSlyPrivates->Monster.Level = x / 5 + 1;      gSlyPrivates->Monster.MonType = MonsterType(type);      gSlyPrivates->Monster.MonsterNum = x;      gSlyPrivates->Monster.HitPoints = short(ProgressionCurve(gSlyPrivates->Monster.Level, RandomBetween(5, 10), 2));      gSlyPrivates->Monster.Offense = short(ProgressionCurve(gSlyPrivates->Monster.Level, RandomBetween(2, 3), 1)) / 2;      gSlyPrivates->Monster.Defense = short(ProgressionCurve(gSlyPrivates->Monster.Level, RandomBetween(2, 3), 1)) / 2;      gSlyPrivates->Monster.Movement = short(ProgressionCurve(gSlyPrivates->Monster.Level, RandomBetween(3, 6), 1));      gSlyPrivates->Monster.Disposition = 1;      gSlyPrivates->Monster.Experience = short(ProgressionCurve(gSlyPrivates->Monster.Level, RandomBetween(5, 8), 2));      PStr_Set(gSlyPrivates->Monster.AttackStr1, attack1);      PStr_Set(gSlyPrivates->Monster.AttackStr2, attack2);      PStr_Set(gSlyPrivates->Monster.AttackActionStr, action);      PStr_Set(gSlyPrivates->Monster.DefenseStr, defense);      PStr_Set(gSlyPrivates->Monster.DefenseActionStr, "\p");      gSlyPrivates->Monster.Coins = short(ProgressionCurve(gSlyPrivates->Monster.Level, RandomBetween(5, 8), 2));      gSlyPrivates->Monster.RangeOffense = short(ProgressionCurve(gSlyPrivates->Monster.Level, RandomBetween(1, 2), 1) / 2);      gSlyPrivates->Monster.Range = gSlyPrivates->Monster.Level;      mountainFile.Add(gSlyPrivates->Monster);    }    mountainTxtFile.Close();    mountainFile.Close();  }  TMonsterFile swampFile(MonsterPath, "\pSwamp");  if (!swampFile.Exists()) {    swampFile.Create();    TFile swampTxtFile(MonsterPath, "\pForest.csv");    for (x = 1; x <= 300; ++x) {      GetMonsterInfo(&swampTxtFile, name, type, action, attack1, attack2, defense);      PStr_Set(gSlyPrivates->Monster.name, name);      gSlyPrivates->Monster.Level = x / 5 + 1;      gSlyPrivates->Monster.MonType = MonsterType(type);      gSlyPrivates->Monster.MonsterNum = x;      gSlyPrivates->Monster.HitPoints = short(ProgressionCurve(gSlyPrivates->Monster.Level, RandomBetween(5, 10), 2));      gSlyPrivates->Monster.Offense = short(ProgressionCurve(gSlyPrivates->Monster.Level, RandomBetween(2, 3), 1)) / 2;      gSlyPrivates->Monster.Defense = short(ProgressionCurve(gSlyPrivates->Monster.Level, RandomBetween(2, 3), 1)) / 2;      gSlyPrivates->Monster.Movement = short(ProgressionCurve(gSlyPrivates->Monster.Level, RandomBetween(3, 6), 1));      gSlyPrivates->Monster.Disposition = 1;      gSlyPrivates->Monster.Experience = short(ProgressionCurve(gSlyPrivates->Monster.Level, RandomBetween(5, 8), 2));      PStr_Set(gSlyPrivates->Monster.AttackStr1, attack1);      PStr_Set(gSlyPrivates->Monster.AttackStr2, attack2);      PStr_Set(gSlyPrivates->Monster.AttackActionStr, action);      PStr_Set(gSlyPrivates->Monster.DefenseStr, defense);      PStr_Set(gSlyPrivates->Monster.DefenseActionStr, "\p");      gSlyPrivates->Monster.Coins = short(ProgressionCurve(gSlyPrivates->Monster.Level, RandomBetween(5, 8), 2));      gSlyPrivates->Monster.RangeOffense = short(ProgressionCurve(gSlyPrivates->Monster.Level, RandomBetween(1, 2), 1) / 2);      gSlyPrivates->Monster.Range = gSlyPrivates->Monster.Level;      swampFile.Add(gSlyPrivates->Monster);    }    swampTxtFile.Close();    swampFile.Close();  }  G_Outln("\p Forest -1,  Mountain -2,  Swamp -3", true, 5);  G_bCr();  ClrPrompt();  G_NumbersPrompt("\pWhich Monster type?", "\p123Q", 3, 1);  SetNextState(stMonsterNumPrompt);}void ST_MonsterNumPrompt(void)                    //Chooses Monster{  if (!OkPrompt("\p123"))     SetNextState(stSysOpEdit);  else {    switch (UserGlobPtr()->curPrompt[1]) {       case '1':        PStr_Set(gSlyPrivates->combatName, "\pForest");        break;      case '2':        PStr_Set(gSlyPrivates->combatName, "\pMountain");        break;      case '3':        PStr_Set(gSlyPrivates->combatName, "\pSwamp");        break;    }    ClrPrompt();    G_NumbersPrompt("\pWhat monster Number? [1-300] :", "\p", 300,                     1);    SetNextState(stReadMonster);  }}void ST_ReadMonster(void){  long long1;  if (!OkPrompt("\p1234567890"))     SetNextState(stMonsterNumPrompt);  else {    StringToNum(UserGlobPtr()->curPrompt, &long1);    gSlyPrivates->monsR = long1;    GetMonster(gSlyPrivates->combatName, long1, &gSlyPrivates->Monster);    SetNextState(stEditMonsterPrompt);  }}void ST_EditMonsterPrompt(void){  G_ClearScreen();  PrintMonster(&gSlyPrivates->Monster);  PStr_Set(UserGlobPtr()->curPrompt, "\p");  G_bCr();  G_NumbersPrompt("\pWhich field [1-14,Q=Quit,S=Save,>=Forward,<=Back]",                   "\p1234567890QS><", 14, 1);  G_bCr();  G_ANSICode("\p0;36m:");  SetNextState(stEditMonsterMenu);}void ST_EditMonsterMenu(void){  Str255 st1;  long long1;  if (!OkPrompt("\p1234567890")) {    switch (UserGlobPtr()->curPrompt[1]) {       case 'Q':        SetNextState(stSysOpEdit);        break;      case 'S':        SetNextState(stSaveMonster);        break;      case '>':        if (gSlyPrivates->monsR == 300)           gSlyPrivates->monsR = 1;        else           gSlyPrivates->monsR = gSlyPrivates->monsR + 1;        NumToString(gSlyPrivates->monsR, st1);        G_Outln(st1, true, 8);        GetMonster(gSlyPrivates->combatName, gSlyPrivates->monsR,                    &gSlyPrivates->Monster);        SetNextState(stEditMonsterPrompt);        break;      case '<':        if (gSlyPrivates->monsR == 1)           gSlyPrivates->monsR = 300;        else           gSlyPrivates->monsR = gSlyPrivates->monsR - 1;        NumToString(gSlyPrivates->monsR, st1);        G_Outln(st1, true, 8);        GetMonster(gSlyPrivates->combatName, gSlyPrivates->monsR,                    &gSlyPrivates->Monster);        SetNextState(stEditMonsterPrompt);        break;      default:        SetNextState(stEditMonsterPrompt);        break;    }  } else {    StringToNum(UserGlobPtr()->curPrompt, &long1);    switch (long1) {       case 1:        SetNextState(stMonsterNamePrompt);        break;      case 2:        SetNextState(stMonsterHitPntsPrompt);        break;      case 3:        SetNextState(stMonsterOffencePrompt);        break;      case 4:        SetNextState(stMonsterDefencePrompt);        break;      case 5:        SetNextState(stMonsterExperiencPrompt);        break;      case 6:        SetNextState(stMonsterAttack1Prompt);        break;      case 7:        SetNextState(stMonsterAttack2Prompt);        break;      case 8:        SetNextState(stMonsterDefenceStrPrompt);        break;      case 9:        SetNextState(stMonsterCoinsPrompt);        break;      case 10:        SetNextState(stMonsterMovementPrompt);        break;      case 11:        SetNextState(stMonsterDispositionPrompt);        break;      case 12:        SetNextState(stMonsterTypePrompt);        break;      case 13:        SetNextState(stMonsterRangeOffPrompt);        break;      case 14:        SetNextState(stMonsterRangePrompt);        break;    }  }}void ST_MonsterNamePrompt(void){  ClrPrompt();  G_bCr();  G_LettersPrompt("\pNew Name: ", "\p", 20, false, false, false, char(0));  G_ANSIPrompter(20);  SetNextState(stSetMonsterName);}void ST_SetMonsterName(void){  if (OkPrompt("\pþ"))     SetNextState(stMonsterNamePrompt);  else {    PStr_Set(gSlyPrivates->Monster.name, UserGlobPtr()->curPrompt);    SetNextState(stEditMonsterPrompt);  }}void ST_MonsterHitPntsPrompt(void){  ClrPrompt();  G_bCr();  G_NumbersPrompt("\pHitPoints:", "\p", 10000, 1);  SetNextState(stSetMonsterHitPnts);}void ST_SetMonsterHitPnts(void){  long long1;  StringToNum(UserGlobPtr()->curPrompt, &long1);  gSlyPrivates->Monster.HitPoints = long1;  SetNextState(stEditMonsterPrompt);}void ST_MonsterOffencePrompt(void){  ClrPrompt();  G_bCr();  G_NumbersPrompt("\pOffense:", "\p", 255, 1);  SetNextState(stSetMonsterOffence);}void ST_SetMonsterOffence(void){  long long1;  StringToNum(UserGlobPtr()->curPrompt, &long1);  gSlyPrivates->Monster.Offense = long1;  SetNextState(stEditMonsterPrompt);}void ST_MonsterDefencePrompt(void){  ClrPrompt();  G_bCr();  G_NumbersPrompt("\pDefense:", "\p", 255, 1);  SetNextState(stSetMonsterDefence);}void ST_SetMonsterDefence(void){  long long1;  StringToNum(UserGlobPtr()->curPrompt, &long1);  gSlyPrivates->Monster.Defense = long1;  SetNextState(stEditMonsterPrompt);}void ST_MonsterExperiencPrompt(void){  ClrPrompt();  G_bCr();  G_NumbersPrompt("\pExperience:", "\p", 10000, 1);  SetNextState(stSetMonsterExperience);}void ST_SetMonsterExperience(void){  long long1;  StringToNum(UserGlobPtr()->curPrompt, &long1);  gSlyPrivates->Monster.Experience = long1;  SetNextState(stEditMonsterPrompt);}void ST_MonsterAttack1Prompt(void){  ClrPrompt();  G_bCr();  G_LettersPrompt("\pNew AttackStr1: ", "\p", 20, false, false, false,                   char(0));  G_ANSIPrompter(20);  SetNextState(stSetMonsterAttack1);}void ST_SetMonsterAttack1(void){  if (OkPrompt("\pþ"))     SetNextState(stMonsterAttack1Prompt);  else {    PStr_Set(gSlyPrivates->Monster.AttackStr1, UserGlobPtr()->curPrompt);    SetNextState(stEditMonsterPrompt);  }}void ST_MonsterAttack2Prompt(void){  ClrPrompt();  G_bCr();  G_LettersPrompt("\pNew AttackStr2: ", "\p", 20, false, false, false,                   char(0));  G_ANSIPrompter(20);  SetNextState(stSetMonsterAttack2);}void ST_SetMonsterAttack2(void){  if (OkPrompt("\pþ"))     SetNextState(stMonsterAttack2Prompt);  else {    PStr_Set(gSlyPrivates->Monster.AttackStr2, UserGlobPtr()->curPrompt);    SetNextState(stEditMonsterPrompt);  }}void ST_MonsterDefenceStrPrompt(void){  ClrPrompt();  G_bCr();  G_LettersPrompt("\pNew DefenseStr: ", "\p", 20, false, false, false,                   char(0));  G_ANSIPrompter(20);  SetNextState(stSetMonsterDefenceStr);}void ST_SetMonsterDefenceStr(void){  if (OkPrompt("\pþ"))     SetNextState(stMonsterDefenceStrPrompt);  else {    PStr_Set(gSlyPrivates->Monster.DefenseStr, UserGlobPtr()->curPrompt);    SetNextState(stEditMonsterPrompt);  }}void ST_MonsterCoinsPrompt(void){  ClrPrompt();  G_bCr();  G_NumbersPrompt("\pCoins:", "\p", 10000, 1);  SetNextState(stSetMonsterCoins);}void ST_SetMonsterCoins(void){  long long1;  StringToNum(UserGlobPtr()->curPrompt, &long1);  gSlyPrivates->Monster.Coins = long1;  SetNextState(stEditMonsterPrompt);}void ST_MonsterMovementPrompt(void){  ClrPrompt();  G_bCr();  G_NumbersPrompt("\pMovement: ", "\p", 255, 1);  SetNextState(stSetMonsterMovement);}void ST_SetMonsterMovement(void){  long long1;  StringToNum(UserGlobPtr()->curPrompt, &long1);  gSlyPrivates->Monster.Movement = long1;  SetNextState(stEditMonsterPrompt);}void ST_MonsterDispositionPrompt(void){  ClrPrompt();  G_bCr();  G_NumbersPrompt("\pDisposition:", "\p", 255, 1);  SetNextState(stSetMonsterDisposition);}void ST_SetMonsterDisposition(void){  long long1;  StringToNum(UserGlobPtr()->curPrompt, &long1);  gSlyPrivates->Monster.Disposition = long1;  SetNextState(stEditMonsterPrompt);}void ST_MonsterTypePrompt(void)                   //This is where you choose the type of monster it is...{  G_bCr();  G_Outln("\pWhich type is this monster? [1..17,<CR>]", true, 2);  G_bCr();  G_Outln("\p 1- Humanoid", true, 1);  G_Outln("\p 2- Orc", true, 1);  G_Outln("\p 3- Goblin", true, 1);  G_Outln("\p 4- Fairy", true, 1);  G_Outln("\p 5- Insectoid", true, 1);  G_Outln("\p 6- Fantastic (Magical)", true, 1);  G_Outln("\p 7- Elven", true, 1);  G_Outln("\p 8- Fire Elemental", true, 1);  G_Outln("\p 9- Water Elemental", true, 1);  G_Outln("\p10- Earth Elemental", true, 1);  G_Outln("\p11- Air Elemental", true, 1);  G_Outln("\p12- Dwarven", true, 1);  G_Outln("\p13- Naturally Evil", true, 1);  G_Outln("\p14- Naturally Good", true, 1);  G_Outln("\p15- Flying", true, 1);  G_Outln("\p16- Undead", true, 1);  G_Outln("\p17- Psychic", true, 1);  G_Outln("\p18- Other", true, 1);  G_bCr();  G_NumbersPrompt("\pYour choice (<CR> to remain unchanged)? ", "\p1234567890",                   18, 1);  SetNextState(stSetMonsterType);}void ST_SetMonsterType(void){  long long1;  if (PStr_Cmp(UserGlobPtr()->curPrompt, "\p") == 0) {    G_Outln("\pMonster Type NOT changed", true, 6);    G_bCr();    G_bCr();    SetNextState(stEditMonsterPrompt);  } else {    StringToNum(UserGlobPtr()->curPrompt, &long1);    switch (long1) {       case 1:        gSlyPrivates->Monster.MonType = Humanoid;        break;      case 2:        gSlyPrivates->Monster.MonType = Orc;        break;      case 3:        gSlyPrivates->Monster.MonType = Goblin;        break;      case 4:        gSlyPrivates->Monster.MonType = Fairy;        break;      case 5:        gSlyPrivates->Monster.MonType = Insectoid;        break;      case 6:        gSlyPrivates->Monster.MonType = Fantastic;        break;      case 7:        gSlyPrivates->Monster.MonType = Elven;        break;      case 8:        gSlyPrivates->Monster.MonType = FElemental;        break;      case 9:        gSlyPrivates->Monster.MonType = WElemental;        break;      case 10:        gSlyPrivates->Monster.MonType = EElemental;        break;      case 11:        gSlyPrivates->Monster.MonType = AElemental;        break;      case 12:        gSlyPrivates->Monster.MonType = Dwarven;        break;      case 13:        gSlyPrivates->Monster.MonType = Evil;        break;      case 14:        gSlyPrivates->Monster.MonType = Good;        break;      case 15:        gSlyPrivates->Monster.MonType = Flying;        break;      case 16:        gSlyPrivates->Monster.MonType = Undead;        break;      case 17:        gSlyPrivates->Monster.MonType = psychic;        break;      case 18:        gSlyPrivates->Monster.MonType = Other;        break;      default:        gSlyPrivates->Monster.MonType = Other;        break;    } //case    G_bCr();    G_Outln("\pOkay, your monster\'s type is now ", false, 1);    G_Outln(GetMonsterType(&gSlyPrivates->Monster), false, 3);    G_bCr();    G_bCr();    SetNextState(stEditMonsterPrompt);  }}void ST_MonsterRangeOffPrompt(void){  ClrPrompt();  G_bCr();  G_NumbersPrompt("\pRange Offense:", "\p", 255, 1);  SetNextState(stSetMonsterRangeOff);}void ST_SetMonsterRangeOff(void){  long long1;  StringToNum(UserGlobPtr()->curPrompt, &long1);  gSlyPrivates->Monster.RangeOffense = long1;  SetNextState(stEditMonsterPrompt);}void ST_MonsterRangePrompt(void){  ClrPrompt();  G_bCr();  G_NumbersPrompt("\pRange:", "\p", 255, 1);  SetNextState(stSetMonsterRange);}void ST_SetMonsterRange(void){  long long1;  StringToNum(UserGlobPtr()->curPrompt, &long1);  gSlyPrivates->Monster.Range = long1;  SetNextState(stEditMonsterPrompt);}void ST_SaveMonster(void){  TMonsterFile monsterFile(MonsterPath, gSlyPrivates->combatName);  monsterFile.Set(gSlyPrivates->Monster.MonsterNum - 1, gSlyPrivates->Monster);  monsterFile.Close();  SetNextState(stEditMonsterPrompt);}void ST_SlySysOpQuit(void){  DoExitExternal();}TSlyPrivates::TSlyPrivates(void)  : TPrivates(){  gSlyPrivates = this;  character = CharacterHandle(NewHandleClear(sizeof(CharacterRec)));  FailNIL(character);  LockHandle(Handle(character));  gCharacter = character;    gUtilPrivates->stage = 0;  PStr_Set((*gCharacter)->name, "\p ");  //0 to init everything to 0  RollChar(*gCharacter, '0');  PStr_Set((*gCharacter)->bbsName, UserGlobPtr()->thisUser.userName);}TSlyPrivates::~TSlyPrivates(void){  if (character != NULL) {                        //dispose of char handle    HUnlock(Handle(character));    HPurge(Handle(character));    DisposeHandle(Handle(character));  }  gCharacter = NULL;  gSlyPrivates = NULL;}void TSlyPrivates::CloseNode(void){}TSlyExternal::TSlyExternal(StringPtr inName)  : TExternal(inName){   mCharacterFile = new TCharFile(PlayerListPath);  FailNIL(mCharacterFile);  mCharacterFile->Close();  mHighScoreFile = new THighScoreFile(HighDataPath);  FailNIL(mHighScoreFile);  mHighScoreFile->Close();  mInnFile = new TInnFile(InnDataPath);  FailNIL(mInnFile);  mInnFile->Close();  mWeaponFile = new TWeaponFile(WeaponsPath);  FailNIL(mWeaponFile);  mWeaponFile->Close();  mArmorFile = new TArmorFile(ArmorPath);  FailNIL(mArmorFile);  mArmorFile->Close();  mGCombatFile = new TGCombatPrefsFile(GCombatPath);  FailNIL(mGCombatFile);  mGCombatFile->Close();  mRegistrationFile = new TRegistrationFile(RegistrationPath);  FailNIL(mRegistrationFile);  mRegistrationFile->Close();  mCombatListFile = new TGCombatListFile(GCombatListPath);  FailNIL(mCombatListFile);  mCombatListFile->Close();}inline void FreeFile(TFile *file){	if (file != NULL)		delete file;}TSlyExternal::~TSlyExternal(void){   FreeFile(mCharacterFile);  FreeFile(mHighScoreFile);  FreeFile(mInnFile);  FreeFile(mWeaponFile);  FreeFile(mArmorFile);  FreeFile(mGCombatFile);  FreeFile(mRegistrationFile);  FreeFile(mCombatListFile);}void TSlyExternal::AllocatePreferences(void){    InitUserRec(gHermSetup->procs[vInitUserRec]);    PStr_Set(GeneralPrefs.TownName, gHermSetup->hSystPtr->bbsName);  GeneralPrefs.NumberPlayers = gHermSetup->hSystPtr->numUsers;  //all these are temporary  GeneralPrefs.GoldPool = 100000000;  GeneralPrefs.ManaPool = 1000000;  GeneralPrefs.RealTime = false;  GeneralPrefs.Population = 3200;  GeneralPrefs.TownSize = SmallTown;  GeneralPrefs.TaxRate = 0;  GeneralPrefs.PlayerPower = false;  GeneralPrefs.NPCNum = 0;  GeneralPrefs.Difficulty = 1;  GeneralPrefs.LevelUpDifficulty = 4;    UserGlobPtr()->ansiTerm = true;  UserGlobPtr()->thisUser.terminalType = 1;  ResetUserColors(&UserGlobPtr()->thisUser, gHermSetup->procs[vResetUserColors]);}void TSlyExternal::AllocatePrivates(void){  TSlyPrivates *slyPrivates;  try {    gUtilPrivates = NULL;    gSlyPrivates = NULL;        slyPrivates = new TSlyPrivates;    FailNIL(slyPrivates);    gHermSetup->privates = Handle(slyPrivates);  } catch (...) {    if (gUtilPrivates != NULL)       delete gUtilPrivates;    gUtilPrivates = NULL;    gSlyPrivates = NULL;    ReportFatalError("\pUnable to allocate enough memory.");  }}void TSlyExternal::DeletePreferences(void){}void TSlyExternal::DeletePrivates(void){  if (gUtilPrivates != NULL)     delete gUtilPrivates;}void TSlyExternal::HandleDoMaintenance(void){}void TSlyExternal::HandleCallLogon(void){}void TSlyExternal::HandleCallMenu(void){}void TSlyExternal::HandleActiveExternal(void){  switch (gUtilPrivates->stage) {         case stBeginExternal:      ST_BeginExternal();      break;    case stEditPlayer:      ST_EditPlayer();      break;    case stPlayerNumPrompt:      ST_PlayerNumPrompt();      break;    case stPlayerNumMenu:      ST_PlayerNumMenu();      break;          case stRollPlayer:      ST_RollPlayer();      break;    case stPlayerEditPrompt:      ST_PlayerEditPrompt();      break;    case stPlayerEditMenu:      ST_PlayerEditMenu();      break;    case stPlayerNamePrompt:      ST_PlayerNamePrompt();      break;    case stSetPlayerName:      ST_SetPlayerName();      break;    case stPlayerClassPrompt:      ST_PlayerClassPrompt();      break;    case stSetPlayerClass:      ST_SetPlayerClass();      break;    case stPlayerHitPntsPrompt:      ST_PlayerHitPntsPrompt();      break;    case stSetPlayerHitPnts:      ST_SetPlayerHitPnts();      break;    case stPlayerExplorePrompt:      ST_PlayerExplorePrompt();      break;    case stSetPlayerExplore:      ST_SetPlayerExplore();      break;    case stPlayerWinPrompt:      ST_PlayerWinPrompt();      break;    case stSetPlayerWin:      ST_SetPlayerWin();      break;    case stPlayerTotalPrompt:      ST_PlayerTotalPrompt();      break;    case stSetPlayerTotal:      ST_SetPlayerTotal();      break;    case stPlayerSparsPrompt:      ST_PlayerSparsPrompt();      break;    case stSetPlayerSpars:      ST_SetPlayerSpars();      break;    case stPlayerAmmoPrompt:      ST_PlayerAmmoPrompt();      break;    case stSetPlayerAmmo:      ST_PlayerAmmoPrompt();      break;    case stPlayerDextPrompt:      ST_PlayerDextPrompt();      break;    case stSetPlayerDext:      ST_SetPlayerDext();      break;    case stPlayerPsychePrompt:      ST_PlayerPsychePrompt();      break;    case stSetPlayerPsyche:      ST_SetPlayerPsyche();      break;    case stPlayerStrengthPrompt:      ST_PlayerStrengthPrompt();      break;    case stSetPlayerStrength:      ST_SetPlayerStrength();      break;    case stPlayerSpeedPrompt:      ST_PlayerSpeedPrompt();      break;    case stSetPlayerSpeed:      ST_SetPlayerSpeed();      break;    case stPlayerCoinsHPrompt:      ST_PlayerCoinsHPrompt();      break;    case stSetPlayerCoinsH:      ST_SetPlayerCoinsH();      break;    case stPlayerCoinsBPrompt:      ST_PlayerCoinsBPrompt();      break;    case stSetPlayerCoinsB:      ST_SetPlayerCoinsB();      break;    case stSysOpEdit:      ST_SysOpEdit();      break;    case stSysOpEditMenu:      ST_SysOpEditMenu();      break;        case stEditMonster:      ST_EditMonster();      break;    case stMonsterNumPrompt:      ST_MonsterNumPrompt();      break;    case stReadMonster:      ST_ReadMonster();      break;    case stEditMonsterPrompt:      ST_EditMonsterPrompt();      break;    case stEditMonsterMenu:      ST_EditMonsterMenu();      break;    case stMonsterNamePrompt:      ST_MonsterNamePrompt();      break;    case stSetMonsterName:      ST_SetMonsterName();      break;    case stMonsterHitPntsPrompt:      ST_MonsterHitPntsPrompt();      break;    case stSetMonsterHitPnts:      ST_SetMonsterHitPnts();      break;    case stMonsterOffencePrompt:      ST_MonsterOffencePrompt();      break;    case stSetMonsterOffence:      ST_SetMonsterOffence();      break;    case stMonsterDefencePrompt:      ST_MonsterDefencePrompt();      break;    case stSetMonsterDefence:      ST_SetMonsterDefence();      break;    case stMonsterExperiencPrompt:      ST_MonsterExperiencPrompt();      break;    case stSetMonsterExperience:      ST_SetMonsterExperience();      break;    case stMonsterAttack1Prompt:      ST_MonsterAttack1Prompt();      break;    case stSetMonsterAttack1:      ST_SetMonsterAttack1();      break;    case stMonsterAttack2Prompt:      ST_MonsterAttack2Prompt();      break;    case stSetMonsterAttack2:      ST_SetMonsterAttack2();      break;    case stMonsterDefenceStrPrompt:      ST_MonsterDefenceStrPrompt();      break;    case stSetMonsterDefenceStr:      ST_SetMonsterDefenceStr();      break;    case stMonsterCoinsPrompt:      ST_MonsterCoinsPrompt();      break;    case stSetMonsterCoins:      ST_SetMonsterCoins();      break;    case stMonsterMovementPrompt:      ST_MonsterMovementPrompt();      break;    case stSetMonsterMovement:      ST_SetMonsterMovement();      break;    case stMonsterDispositionPrompt:      ST_MonsterDispositionPrompt();      break;    case stSetMonsterDisposition:      ST_SetMonsterDisposition();      break;    case stMonsterTypePrompt:      ST_MonsterTypePrompt();      break;    case stSetMonsterType:      ST_SetMonsterType();      break;    case stMonsterRangeOffPrompt:      ST_MonsterRangeOffPrompt();      break;    case stSetMonsterRangeOff:      ST_SetMonsterRangeOff();      break;    case stMonsterRangePrompt:      ST_MonsterRangePrompt();      break;    case stSetMonsterRange:      ST_SetMonsterRange();      break;    case stSaveMonster:      ST_SaveMonster();      break;    case stSlySysOpQuit:      ST_SlySysOpQuit();      break;            case stEditWeapon:      ST_EditWeapon();      break;    case stWeaponNumPrompt:      ST_WeaponNumPrompt();      break;    case stWeaponNumMenu:      ST_WeaponNumMenu();      break;    case stEditWeaponPrompt:      ST_EditWeaponPrompt();      break;    case stEditWeaponMenu:      ST_EditWeaponMenu();      break;    case stWeaponNamePrompt:      ST_WeaponNamePrompt();      break;    case stSetWeaponName:      ST_SetWeaponName();      break;    case stWeaponStrikePrompt:      ST_WeaponStrikePrompt();      break;    case stSetWeaponStrike:      ST_SetWeaponStrike();      break;    case stWeaponRangePrompt:      ST_WeaponRangePrompt();      break;    case stSetWeaponRange:      ST_SetWeaponRange();      break;    case stWeaponCostPrompt:      ST_WeaponCostPrompt();      break;    case stSetWeaponCost:      ST_SetWeaponCost();      break;    case stWeaponAbilityPrompt:      ST_WeaponAbilityPrompt();      break;    case stSetWeaponAbility:      ST_SetWeaponAbility();      break;    case stWeaponQualityPrompt:      ST_WeaponQualityPrompt();      break;    case stSetWeaponQuality:      ST_SetWeaponQuality();      break;    case stNewWeaponInit:      ST_NewWeaponInit();      break;            case stEditArmor:      ST_EditArmor();      break;    case stArmorNumPrompt:      ST_ArmorNumPrompt();      break;    case stArmorNumMenu:      ST_ArmorNumMenu();      break;    case stEditArmorPrompt:      ST_EditArmorPrompt();      break;    case stEditArmorMenu:      ST_EditArmorMenu();      break;    case stArmorNamePrompt:      ST_ArmorNamePrompt();      break;    case stSetArmorName:      ST_SetArmorName();      break;    case stArmorDefensePrompt:      ST_ArmorDefensePrompt();      break;    case stSetArmorDefense:      ST_SetArmorDefense();      break;    case stArmorClassPrompt:      ST_ArmorClassPrompt();      break;    case stSetArmorClass:      ST_SetArmorClass();      break;    case stArmorCostPrompt:      ST_ArmorCostPrompt();      break;    case stSetArmorCost:      ST_SetArmorCost();      break;    case stArmorAbilityPrompt:      ST_ArmorAbilityPrompt();      break;    case stSetArmorAbility:      ST_SetArmorAbility();      break;    case stArmorQualityPrompt:      ST_ArmorQualityPrompt();      break;    case stSetArmorQuality:      ST_SetArmorQuality();      break;    case stNewArmorInit:      ST_NewArmorInit();      break;        default:      ReportFatalError("\pError: reached unprogrammed stage");      break;  }}void TSlyExternal::SetupGlobalVariables(void){  // first setup framework globals  TExternal::SetupGlobalVariables();    // then setup our own  gSlyExternal = (TSlyExternal *)gExternal;  gSlyPrivates = (TSlyPrivates *)gHermSetup->privates;  if (gSlyPrivates != NULL)     gCharacter = CharacterHandle(gSlyPrivates->character);  gCharacterFile = mCharacterFile;  gHighScoreFile = mHighScoreFile;  gInnFile = mInnFile;  gWeaponFile = mWeaponFile;  gArmorFile = mArmorFile;  gGCombatFile = mGCombatFile;  gCombatListFile = mCombatListFile;  gRegistrationFile = mRegistrationFile;}void TSlyExternal::SaveGlobalVariables(void){  TExternal::SaveGlobalVariables();  mCharacterFile = gCharacterFile;  mHighScoreFile = gHighScoreFile;  mInnFile = gInnFile;  mWeaponFile = gWeaponFile;  mArmorFile = gArmorFile;  mGCombatFile = gGCombatFile;  mCombatListFile = gCombatListFile;  mRegistrationFile = gRegistrationFile;}