#include "Builtins.h"#include "PStrings.h"#include "SlyTextCombat.h"void ST_SetupTextCombat(void){  Boolean boo1;  G_ANSICode("\p2J");  G_ANSICode("\pH");  G_bCr();  //init user/monster attack stage values  gSlyPrivates->userAttackLoop = ((*gCharacter)->Speed) / 10;  //User's attack loop val  if (gSlyPrivates->userAttackLoop <= 0)     gSlyPrivates->userAttackLoop = 1;  gSlyPrivates->monAttackLoop = gSlyPrivates->Monster.Movement / 10;  //Monster's attack loop val  if (gSlyPrivates->monAttackLoop <= 0)     gSlyPrivates->monAttackLoop = 1;  gSlyPrivates->textCombatLoop = 15;                    //this is our loop value  gSlyPrivates->Hit = _none;                      //Who hit who when, etc. ;-)   gSlyPrivates->userMove = Attack;  gSlyPrivates->monMove = Attack;  gSlyPrivates->lastDisposition = 0;    //initiative roll  boo1 = RollInitiative();  InitiativeText(boo1);  SetNextState(stTextCombatLoop);}void ST_TextCombatLoop(void){    if ((*gCharacter)->HitPoints <= 0)     SetNextState(stUserKilled);  else if (gSlyPrivates->Monster.HitPoints <= 0)     SetNextState(stUserVictorious);  else if (gSlyPrivates->Hit == UserRan)     SetNextState(stUserEscapes);  else if (gSlyPrivates->Hit == OpponentRan)     SetNextState(stMonsterRuns);  else if (gSlyPrivates->userAttackLoop >= gSlyPrivates->textCombatLoop &&            gSlyPrivates->Hit == _none)     SetNextState(stUserAttackStage);  else if (gSlyPrivates->monAttackLoop >= gSlyPrivates->textCombatLoop &&            gSlyPrivates->Hit != Opponent &&            gSlyPrivates->Hit != OpponentOnly &&            gSlyPrivates->Hit != Both &&            gSlyPrivates->Hit != Neither &&            gSlyPrivates->Hit != UserOnly &&            gSlyPrivates->Hit != OpponentRan)     SetNextState(stOpponentAttackStage);  else {    gSlyPrivates->textCombatLoop--;    gSlyPrivates->Hit = _none;  }    if (gSlyPrivates->textCombatLoop <= 0)     gSlyPrivates->textCombatLoop = 27;  }void ST_UserAttackStage(void){  G_bCr();  GetMainCombatText((*gCharacter)->HitPoints, (*gCharacter)->MaxHP, gSlyPrivates->Monster.HitPoints, gSlyPrivates->monHitPoints);  G_bCr();  G_LettersPrompt("\pA]ttack, B]lock, P]arry, D]odge, S]pecial, R]un -- ", "\pABPDSR", 1, true, false, true, char(0));  SetNextState(stCalcAdvanceMoves);}void ST_CalcAdvanceMoves(void){  //Calculates The # of advance moves  Boolean boo1;  short int1;  short int2;  boo1 = true;  int1 = 0;  int2 = gSlyPrivates->textCombatLoop;  while (boo1) {    int2--;    if (gSlyPrivates->userAttackLoop >= int2 && gSlyPrivates->monAttackLoop < int2)       int1++;    else if (gSlyPrivates->userAttackLoop >= int2 && gSlyPrivates->monAttackLoop >= int2 || gSlyPrivates->userAttackLoop < int2 && gSlyPrivates->monAttackLoop >= int2)       boo1 = false;  }  CalcUserMove(UserGlobPtr()->curPrompt[1], &int2, &int1);  SetNextState(stTextCombatLoop);}void ST_OpponentAttackStage(void){  short int1;  short int2;  Boolean boo1;  int1 = 0;  int2 = gSlyPrivates->textCombatLoop;  boo1 = true;  while (boo1) {    int2--;    if (gSlyPrivates->monAttackLoop >= int2 && gSlyPrivates->userAttackLoop < int2)       int1++;    else if (gSlyPrivates->monAttackLoop >= int2 && gSlyPrivates->userAttackLoop >= int2 || gSlyPrivates->monAttackLoop < int2 && gSlyPrivates->userAttackLoop >= int2)       boo1 = false;  }    MonsterAttacks(gSlyPrivates->userMove, int1);  SetNextState(stTextCombatLoop);}void ST_UserKilled(void){  if ((*gCharacter)->Location == TheArenaCombat) {    (*gCharacter)->Location = TheArenaMenu;    SetNextState(stChallengeLost);  } else {    G_bCr();    G_Outln("\pTough luck.  You're dead, buddy. ", true, 4);    PrintMenu("\pSeeya in ", "\pHero's Heaven!", "\p ", "\p1:34;40m", "\p0:37;44m", true);    (*gCharacter)->CoinsHand = (*gCharacter)->CoinsHand - (*gCharacter)->CoinsHand/3;    SetNextState(stSaveAndQuit);  }}void ST_UserVictorious(void){  short int1;  Str255 st1;  Str255 st2;  Str255 Temp_Str255_1;  if ((*gCharacter)->Location == TheArenaCombat) {    (*gCharacter)->Location = TheArenaMenu;    SetNextState(stChallengeWon);  } else {    G_bCr();    int1 = RandomBetween(0, gSlyPrivates->Monster.Coins);    G_Outln(PStr_Concat(Temp_Str255_1, "\pYou have defeated the ", gSlyPrivates->Monster.name,                         "\p!!"), true, 7);    (*gCharacter)->TotalExperience = (*gCharacter)->TotalExperience + gSlyPrivates->Monster.Experience;    (*gCharacter)->SpendingExperience = (*gCharacter)->SpendingExperience + gSlyPrivates->Monster.Experience;    (*gCharacter)->CoinsHand = (*gCharacter)->CoinsHand + int1;    (*gCharacter)->FightsWon = (*gCharacter)->FightsWon + 1;    G_bCr();    NumToString(int1, st1);    NumToString(gSlyPrivates->Monster.Experience, st2);    G_ANSICode("\p1;34mYou receive ");    G_ANSICode(PStr_Concat(Temp_Str255_1, "\p0;35m", st2));    G_ANSICode("\p1;34m Experience points.");    G_bCr();    G_ANSICode("\p1;34mYou receive ");    G_ANSICode(PStr_Concat(Temp_Str255_1, "\p0;35m", st1));    G_ANSICode("\p1;34m Coins.");    G_bCr();    G_bCr();    (*gCharacter)->Location = TheWildernessMenu;    UserGlobPtr()->boardAction = None;    myPausePrompt("\p-=Press A Key=-");    SetNextState(stWilderness);  }}void ST_UserEscapes(void){  short x;  G_bCr();  G_Outln("\pYou try to escape...", true, 3);  for (x = 1; x <= 40; ++x)     G_Outln("\p.", false, 2);  G_bCr();  G_Outln("\pYou Succeed!", true, 6);  if ((*gCharacter)->Location == TheArenaCombat) {    (*gCharacter)->Location = TheArenaMenu;    SetNextState(stArena);  } else {    (*gCharacter)->Location = TheWildernessMenu;    SetNextState(stWilderness);  }}void ST_MonsterRuns(void){  G_bCr();  G_Outln("\p<blink blink>", true, 1);  G_bCr();  G_Outln("\pThe monster ran away from you!  What a coward.", true,           1);  G_bCr();  myPausePrompt("\p-More-");  if ((*gCharacter)->Location == TheArenaCombat) {    (*gCharacter)->Location = TheArenaMenu;    SetNextState(stArena);  } else {    (*gCharacter)->Location = TheWildernessMenu;    SetNextState(stWilderness);  }}