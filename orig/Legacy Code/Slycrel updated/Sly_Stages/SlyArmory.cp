#include "Builtins.h"#include "PStrings.h"#include "SlyArmory.h"void ST_Armory(void){  (*gCharacter)->Location = TheArmory;  ShowANSIMenu("\pArmoryMenu", stArmoryShortPrompt);}void ST_ArmoryShortPrompt(void){  G_Outln("\p[A,Q,G,M,S,W,?]", true, 1);  G_bCr();  PStr_Set(UserGlobPtr()->curPrompt, "\p ");  G_LettersPrompt("\pYour choice?  ", "\pAGMSWQ?", 1, true, false,                   true, char(0));  SetNextState(stArmoryMenu);}void ST_ArmoryMenu(void){  WeaponRec TWeapon;  switch (UserGlobPtr()->curPrompt[1]) {     case 'W':      (*gCharacter)->Location = TheArmory;      SetNextState(stOpenWeaponsFile);      break;    case 'A':      (*gCharacter)->Location = TheArmory;      SetNextState(stOpenArmorFile);      break;    case 'S':      (*gCharacter)->Location = TheArmory;      SetNextState(stQSellWeapon);      break;    case 'G':      (*gCharacter)->Location = TheArmory;      SetNextState(stQSellArmor);      break;    case 'M':      G_bCr();      G_Outln("\pYou switch your weapons.", true, 1);      G_bCr();      TWeapon = (*gCharacter)->Weapons[0];      (*gCharacter)->Weapons[0] = (*gCharacter)->Weapons[1];      (*gCharacter)->Weapons[1] = TWeapon;      SetNextState(stArmoryShortPrompt);      break;    case 'Q':      (*gCharacter)->Location = TheTown;      SetNextState(stTown);      break;    case '?':      (*gCharacter)->Location = TheArmory;      SetNextState(stArmory);      break;    default:      SetNextState(stArmory);      break;  }}void ST_OpenWeaponsFile(void){  if (!gWeaponFile->Exists()) {    G_bCr();    G_Outln("\pNo Weapons file, creating new...  PLEASE INFORM SYSOP!!",             true, 1);    G_bCr();    gWeaponFile->Create();    PStr_Set((*gCharacter)->Weapons[0].name, "\pGeneric Sword");    (*gCharacter)->Weapons[0].Strike = 3;    (*gCharacter)->Weapons[0].Range = 0;    (*gCharacter)->Weapons[0].Cost = 10;    (*gCharacter)->Weapons[0].Ability = 0;    (*gCharacter)->Weapons[0].Quality = 100;        gWeaponFile->Set((*gCharacter)->Weapons[0]);    gWeaponFile->Close();  }    gSlyPrivates->armoryListCount = 0;  UserGlobPtr()->boardAction = Repeating;  SetNextState(stChooseWeapon);}void ST_ChooseWeapon(void){  short numWeapons;  numWeapons = gWeaponFile->NumItems();  if (UserGlobPtr()->aborted || gSlyPrivates->armoryListCount >= numWeapons) {    if (UserGlobPtr()->aborted)       G_Outln("\p - Aborted - ", true, 3);        UserGlobPtr()->aborted = false;    gWeaponFile->Close();        G_bCr();    G_bCr();    G_NumbersPrompt("\pChoose Your Weapon: [Q=Quit]", "\pQ0123456789",                     numWeapons, 1);    SetNextState(stQBuyWeapon);  } else {    DisplayWeaponList(gSlyPrivates->armoryListCount, (*gCharacter)->CoinsHand);    gSlyPrivates->armoryListCount++;  }}void ST_QBuyWeapon(void){  long long1;  if (UserGlobPtr()->curPrompt[1] == 'Q')     SetNextState(stArmory);  else if (PStr_Cmp(UserGlobPtr()->curPrompt, "\p") == 0)     SetNextState(stOpenWeaponsFile);  else {    StringToNum(UserGlobPtr()->curPrompt, &long1);    gSlyPrivates->weaponToBuy = long1;    G_Outln("\pDo you want to buy this Weapon? [Y/n] ", true, 3);    G_YesNoQuestion("\p", true);    SetNextState(stQReplaceWeapon);  }}void ST_QReplaceWeapon(void){  if (UserGlobPtr()->curPrompt[1] == 'Y') {    G_NumbersPrompt("\pWhich weapon would you like to replace? [1/2, D-isplay, Q-uit] ",                     "\p12D", 2, 1);  }  SetNextState(stDisplayWeapons);}void ST_DisplayWeapons(void){  //Display two weapons and go back to choice  long long1;  long long2;  WeaponRec TWeapon;  Str255 Temp_Str255_1;  if (UCaseEqual(PStr_FromChar(Temp_Str255_1, UserGlobPtr()->curPrompt[1]), "\pD")) {    G_Outln(PStr_Concat(Temp_Str255_1, "\pWeapon 1: ", (*gCharacter)->Weapons[0].name), true, 1);    G_bCr();    G_Outln(PStr_Concat(Temp_Str255_1, "\pWeapon 2: ", (*gCharacter)->Weapons[1].name), true, 1);    G_bCr();    PStr_Set(UserGlobPtr()->curPrompt, "\pY");    SetNextState(stQReplaceWeapon);  } else if (UCaseEqual(PStr_FromChar(Temp_Str255_1, UserGlobPtr()->curPrompt[1]), "\pQ")) {    G_bCr();    G_Outln("\pFINE, I didn\'t want your stupid weapon anyway...",             true, 1);    G_bCr();  } else {    //Long2 is the number of weapon record that you need, either one or two    StringToNum(UserGlobPtr()->curPrompt, &long2);    if (UserGlobPtr()->curPrompt[1] != 'N')       PStr_Set(UserGlobPtr()->curPrompt, "\pY");    long1 = gSlyPrivates->weaponToBuy;    GetWeapon(long1, &TWeapon);    if (UserGlobPtr()->curPrompt[1] == 'Y') {      if ((*gCharacter)->CoinsHand >= TWeapon.Cost) {        GetWeapon(long1, &(*gCharacter)->Weapons[long2 - 1]);        G_bCr();        G_Outln(PStr_Concat(Temp_Str255_1, "\pOkay, you buy the spiffy ",                             (*gCharacter)->Weapons[long2 - 1].name,                             "\p."), true, 3);        (*gCharacter)->CoinsHand = (*gCharacter)->CoinsHand - (*gCharacter)->Weapons[long2 - 1].Cost;        myPausePrompt("\p--More--");        SetNextState(stArmory);      } else if ((*gCharacter)->CoinsHand < TWeapon.Cost) {        G_bCr();        G_Outln("\pSorry, I\'m not giving these away . Come back when you get more money . ",                 true, 2);        G_bCr();        myPausePrompt("\p--More--");        SetNextState(stArmory);      }                                           //else if    } else {                                      //if they said no then      G_bCr();      G_Outln("\pOkay, your loss.  Have fun dying.", true, 1);      G_bCr();      myPausePrompt("\p--More--");      SetNextState(stArmory);    }                                             //else 'N'  }}void ST_OpenArmorFile(void){  if (!gArmorFile->Exists()) {    G_bCr();    G_Outln("\pNo Armor file, creating new...  PLEASE INFORM SYSOP",             true, 1);    G_bCr();    gArmorFile->Create();    PStr_Set((*gCharacter)->Armor[0].name, "\pGeneric Armor");    (*gCharacter)->Armor[0].Defense = 25;    (*gCharacter)->Armor[0].Class_2 = 0;    (*gCharacter)->Armor[0].Cost = 10;    (*gCharacter)->Armor[0].Ability = 0;    (*gCharacter)->Armor[0].Quality = 100;    gArmorFile->Set((*gCharacter)->Armor[0]);    gArmorFile->Close();  }  gSlyPrivates->armoryListCount = 0;  UserGlobPtr()->boardAction = Repeating;  SetNextState(stChooseArmor);}void ST_ChooseArmor(void){  short numArmor;    numArmor = gArmorFile->NumItems();  if (UserGlobPtr()->aborted || gSlyPrivates->armoryListCount >= numArmor) {    if (UserGlobPtr()->aborted)       G_Outln("\p - Aborted - ", true, 3);        UserGlobPtr()->aborted = false;    gArmorFile->Close();;        G_bCr();    G_bCr();    G_NumbersPrompt("\pChoose Your Armor: [Q=Quit]", "\pQ0123456789",                     numArmor, 1);    SetNextState(stQBuyArmor);  } else {    DisplayArmorList(gSlyPrivates->armoryListCount, (*gCharacter)->CoinsHand);    gSlyPrivates->armoryListCount++;  }}void ST_QBuyArmor(void){  long long1;  if (UserGlobPtr()->curPrompt[1] == 'Q')     SetNextState(stArmory);  else if (PStr_Cmp(UserGlobPtr()->curPrompt, "\p") == 0)     SetNextState(stOpenArmorFile);  else {    StringToNum(UserGlobPtr()->curPrompt, &long1);    gSlyPrivates->armorToBuy = long1;    G_Outln("\pDo you want to buy this Armor? [Y/n] ", true, 3);    G_YesNoQuestion("\p", true);    SetNextState(stSaveNewArmor);  }}void ST_SaveNewArmor(void){  ArmorRec TArmor;  long long1;  Str255 Temp_Str255_1;  long1 = gSlyPrivates->armorToBuy;  GetArmor(long1, &TArmor);  if (UserGlobPtr()->curPrompt[1] == 'Y') {    if ((*gCharacter)->CoinsHand >= TArmor.Cost) {      GetArmor(long1, &(*gCharacter)->Armor[0]);      G_bCr();      G_Outln(PStr_Concat(Temp_Str255_1, "\pOkay, you buy the spiffy ",                           (*gCharacter)->Armor[0].name, "\p."), true, 3);      (*gCharacter)->CoinsHand = (*gCharacter)->CoinsHand - (*gCharacter)->Armor[0].Cost;      SetNextState(stArmory);    } else if ((*gCharacter)->CoinsHand < TArmor.Cost) {      G_bCr();      G_Outln("\pSorry, I\'m not giving these away . Come back when you get more money . ",               true, 2);      G_bCr();      SetNextState(stArmory);    }                                             //else if  }                                               //if 'Y' then  else {                                          //if they said no then    G_bCr();    G_Outln("\pOkay, your loss.  Have fun dying.", true, 1);    G_bCr();    SetNextState(stArmory);  }                                               //else 'N'}void ST_QSellWeapon(void){  short int1;  Str255 st1;  Str255 st2;  Str255 Temp_Str255_1;  G_bCr();  int1 = ((*gCharacter)->Weapons[0].Cost) / 2;  NumToString(int1, st2);  PStr_Set(st1, (*gCharacter)->Weapons[0].name);  G_Outln(PStr_Concat(Temp_Str255_1, "\pSell your ", st1, "\p for ",                       st2, "\p coins? [Y/n] "), true, 2);  G_YesNoQuestion("\p", true);  SetNextState(stSaveWeaponSale);}void ST_SaveWeaponSale(void){  short int1;  if (UserGlobPtr()->curPrompt[1] == 'Y')     if (PStr_Cmp((*gCharacter)->Weapons[0].name, "\pHands") == 0) {      G_bCr();      G_Outln("\pYou can\'t sell your hands.  Idiot...", true, 6);      G_bCr();      myPausePrompt("\p-More-");    } else if ((*gCharacter)->Weapons[0].Cost <= 0) {      G_bCr();      G_Outln("\pSorry, I don\'t buy junk.", true, 6);      G_bCr();      myPausePrompt("\p-More-");    } else {      G_bCr();      G_Outln("\pOkay, thanks.  Come back anytime.", true, 1);      G_bCr();      myPausePrompt("\p-More-");            int1 = ((*gCharacter)->Weapons[0].Cost) / 2;      (*gCharacter)->CoinsHand = (*gCharacter)->CoinsHand + int1;      PStr_Set((*gCharacter)->Weapons[0].name, "\pHands");      (*gCharacter)->Weapons[0].Strike = 1;      (*gCharacter)->Weapons[0].Range = 0;      (*gCharacter)->Weapons[0].Cost = 0;      (*gCharacter)->Weapons[0].Ability = 0;      (*gCharacter)->Weapons[0].Quality = 0;      SetNextState(stArmory);    }                                             //if 'Y' then  else {    G_bCr();    G_Outln("\pOkay, you jerk, I didn\'t want it anyway.", true, 3);    G_bCr();    myPausePrompt("\p-More-");    SetNextState(stArmory);  }                                               //if 'N' then}void ST_QSellArmor(void){  short int1;  Str255 st1;  Str255 st2;  Str255 Temp_Str255_1;  G_bCr();  int1 = ((*gCharacter)->Armor[0].Cost) / 2;  NumToString(int1, st2);  PStr_Set(st1, (*gCharacter)->Armor[0].name);  G_Outln(PStr_Concat(Temp_Str255_1, "\pSell your ", st1, "\p for ",                       st2, "\p coins? [Y/n] "), true, 2);  G_YesNoQuestion("\p", true);  SetNextState(stSaveArmorSale);}void ST_SaveArmorSale(void){  short int1;  if (UserGlobPtr()->curPrompt[1] == 'Y') {    G_bCr();    G_Outln("\pOkay, thanks.  Come back anytime.", true, 1);    G_bCr();    myPausePrompt("\p-More-");    int1 = ((*gCharacter)->Armor[0].Cost) / 2;    (*gCharacter)->CoinsHand = (*gCharacter)->CoinsHand + int1;        PStr_Set((*gCharacter)->Armor[0].name, "\pHands");    (*gCharacter)->Armor[0].Defense = 1;    (*gCharacter)->Armor[0].Class_2 = 0;    (*gCharacter)->Armor[0].Cost = 0;    (*gCharacter)->Armor[0].Ability = 0;    (*gCharacter)->Armor[0].Quality = 0;    SetNextState(stArmory);  }                                               //if 'Y' then  else {    G_bCr();    G_Outln("\pOkay, you jerk, I didn\'t want it anyway.", true, 3);    G_bCr();    myPausePrompt("\p-More-");    SetNextState(stArmory);  }                                               //if 'N' then}