#include "Builtins.h"#include "PStrings.h"#include "SlyHealer.h"void ST_Healer(void){  ShowANSIMenu("\pHealerMenu", stHealerPrompt);}void ST_HealerPrompt(void){  Str255 hitPointsStr;  Str255 maxHPStr;  Str255 hitStr;  Str255 coinsStr;  Str255 Temp_Str255_1;  NumToString((*gCharacter)->HitPoints, hitPointsStr);  NumToString((*gCharacter)->MaxHP, maxHPStr);  PStr_Set(hitStr, PStr_Concat(Temp_Str255_1, hitPointsStr, "\p/",                                maxHPStr));  NumToString((*gCharacter)->CoinsHand, coinsStr);  G_ANSICode(PStr_Concat(Temp_Str255_1, "\p1;34m", "\pYou have "));  G_ANSICode(PStr_Concat(Temp_Str255_1, "\p1;30m", hitStr));  G_ANSICode(PStr_Concat(Temp_Str255_1, "\p1;34m", "\p Hit Points and "));  G_ANSICode(PStr_Concat(Temp_Str255_1, "\p1;30m", coinsStr));  G_ANSICode(PStr_Concat(Temp_Str255_1, "\p1;34m", "\p Coins on hand."));  G_Outln("\p[H,N,Q,?]", true, 1);  G_bCr();  PStr_Set(UserGlobPtr()->curPrompt, "\p ");  G_LettersPrompt("\pYour choice?  ", "\pHNQ?", 1, true, false, true,                   char(0));  SetNextState(stHealerMenu);}void ST_HealerMenu(void){  switch (UserGlobPtr()->curPrompt[1]) {     case 'H':      (*gCharacter)->Location = TheHealersHut;      SetNextState(stAgathaHeals);      break;    case 'N':      (*gCharacter)->Location = TheHealersHut;      SetNextState(stLifeHealedPrompt);      break;    case 'Q':      (*gCharacter)->Location = TheWildernessMenu;      SetNextState(stWilderness);      break;    case '?':      (*gCharacter)->Location = TheHealersHut;      SetNextState(stHealer);      break;    default:      SetNextState(stHealerPrompt);      break;  } //case}void ST_AgathaHeals(void){  short x;  short int1;  short avg;  short tempint;  G_Outln("\pAgatha waves her hands strangely above you...", true,           5);  for (x = 1; x <= 10; ++x)     G_Outln("\p.", false, RandomBetween(1, 16));  G_bCr();  CharacterPtr with_1 = *gCharacter;  int1 = with_1->MaxHP - with_1->HitPoints;  avg = (with_1->ThiefLvl + with_1->MageLvl + with_1->FighterLvl) / 3;  if (avg < 2)     avg = 1;  tempint = int1 * Trunc(avg * 1.25);  if (tempint < 2)     tempint = 1;  else if (int1 == 0)     tempint = 0;  if (with_1->CoinsHand < tempint) {    G_bCr();    G_Outln("\pHer eyes flutter open annoyed at you.", true, 5);    G_Outln("\pYou don\'t have enough money, THIEF!!!", true, 3);    G_bCr();  } else {    with_1->CoinsHand -= tempint;    with_1->HitPoints += int1;    G_bCr();    G_Outln("\pYou have been HEALED!", true, 2);    G_bCr();  }  SaveChar(*gCharacter);  SetNextState(stHealerPrompt);}void ST_LifeHealedPrompt(void){  short int1;  G_bCr();  int1 = (*gCharacter)->MaxHP - (*gCharacter)->HitPoints;  G_Outln("\pHow much life would you like healed? ", true, 5);  G_NumbersPrompt("\p:", "\p1234567890", int1, 0);  SetNextState(stHealbyHealer);}void ST_HealbyHealer(void){  long long1;  short int1;  short avg;  short tempint;  StringToNum(UserGlobPtr()->curPrompt, &long1);  CharacterPtr with_2 = *gCharacter;  int1 = with_2->MaxHP - with_2->HitPoints;  avg = (with_2->ThiefLvl + with_2->MageLvl + with_2->FighterLvl) / 3;  if (avg < 2)     avg = 1;  tempint = long1 * Trunc(avg * 1.25);  if (tempint < 2)     tempint = 1;  if (with_2->CoinsHand < tempint) {    G_Outln("\pWhat ARE you trying to do, rip me off???", true, 3);    G_bCr();    SetNextState(stLifeHealedPrompt);  } else {    with_2->CoinsHand -= tempint;    with_2->HitPoints += long1;    G_bCr();    G_Outln("\pYou have been HEALED!", true, 2);  }  G_bCr();  SetNextState(stHealerPrompt);}void ST_Herbalist(void){  ShowANSIMenu("\pHerbalistMenu", stHerbalistPrompt);}void ST_HerbalistPrompt(void){  Str255 st1;  Str255 st2;  Str255 Temp_Str255_1;  NumToString((*gCharacter)->HitPoints, st1);  NumToString((*gCharacter)->MaxHP, st2);  PStr_Set(st1, PStr_Concat(Temp_Str255_1, st1, "\p/", st2));  NumToString((*gCharacter)->CoinsHand, st2);  G_ANSICode(PStr_Concat(Temp_Str255_1, "\p1;34m", "\pYou have "));  G_ANSICode(PStr_Concat(Temp_Str255_1, "\p1;30m", st1));  G_ANSICode(PStr_Concat(Temp_Str255_1, "\p1;34m", "\p Hit Points and "));  G_ANSICode(PStr_Concat(Temp_Str255_1, "\p1;30m", st2));  G_ANSICode(PStr_Concat(Temp_Str255_1, "\p1;34m", "\p Coins on hand."));  G_Outln("\p[H,Q,?]", true, 1);  G_bCr();  PStr_Set(UserGlobPtr()->curPrompt, "\p ");  G_LettersPrompt("\pYour choice?  ", "\pHQ?", 1, true, false, true,                   char(0));  SetNextState(stHerbalistMenu);}void ST_HerbalistMenu(void){  switch (UserGlobPtr()->curPrompt[1]) {     case 'H':      (*gCharacter)->Location = TheHerbalist;      SetNextState(stHerbalistHeal);      break;    case 'Q':      (*gCharacter)->Location = TheTown;      SetNextState(stTown);      break;    case '?':      (*gCharacter)->Location = TheHerbalist;      SetNextState(stHerbalist);      break;    default:      SetNextState(stHerbalistPrompt);      break;  }}void ST_HerbalistHeal(void){  short x;  short int1;  short avg;  short tempint;  G_Outln("\pThe Herbalist waves her hands strangely above you...",           true, 5);  for (x = 1; x <= 1000; ++x)     if (x % 100 == 0)       G_Outln("\p.", false, RandomBetween(1, 7));  G_bCr();  CharacterPtr with_3 = *gCharacter;  int1 = with_3->MaxHP - with_3->HitPoints;  avg = (with_3->ThiefLvl + with_3->MageLvl + with_3->FighterLvl) / 3;  if (avg < 2)     avg = 1;  tempint = int1 * Trunc(avg * 1.25);  if (tempint < 2)     tempint = 1;  if (with_3->CoinsHand < tempint) {    G_bCr();    G_Outln("\pHer eyes flutter open annoyed at you.", true, 2);    G_Outln("\pYou don\'t have enough money, THIEF!!!", true, 6);    G_bCr();  } else {    with_3->CoinsHand -= tempint;    with_3->HitPoints += int1;    G_bCr();    G_Outln("\pYou have been HEALED!   <da da da da!>", true, 2);    G_bCr();  }  SaveChar(*gCharacter);  SetNextState(stHerbalistPrompt);}