#include "Builtins.h"#include "PStrings.h"#include "SlyTower.h"void ST_Tower(void){  (*gCharacter)->Location = TheTower;  short randomNum = RandomBetween(0, 5);  switch (randomNum) {    case 0:      G_Outln("\pYou enter the dark dingy tower, and immediatly encounter", true, 3);      G_Outln("\pa holy man saying a prayer in some strange language.", true, 3);      G_Outln("\pAfter he finishes, the holy man looks up and smiles,", true, 3);      G_Outln("\phappy to see a hero such as yourself.  Again, he begins", true, 3);      G_Outln("\pto chant out a prayer....", true, 3);      G_Outln("\pThankfully, its a blessing.  When he's finished he", true, 3);      G_Outln("\psends you on to do your hero's work.", true, 3);      G_bCr();      myPausePrompt("\p-=Press A Key=-");      (*gCharacter)->Faith += RandomBetween(1, 2);      SetNextState(stTown);      break;    case 1:      G_Outln("\pYou enter the tower, hopeful that you will gain some", true, 3);      G_Outln("\pmuch needed wisdom....", true, 3);      G_bCr();      G_Outln("\pEventually, you encounter a High Priestess.  The", true, 3);      G_Outln("\ppriestess lets out a shreek of laugh, and casts a spell", true, 3);      G_Outln("\pon you...", true, 3);      G_bCr();      G_Outln("\pWhen you awaken, you feel dreadfully weak.  When you", true, 3);      G_Outln("\peventually find the stength, you leave the tower as", true, 3);      G_Outln("\pquickly as possible.", true, 3);      G_bCr();      myPausePrompt("\p-=Press A Key=-");      (*gCharacter)->Faith -= RandomBetween(1, 2);      SetNextState(stTown);      break;    case 2:      G_Outln("\pAs you enter the tower, you notice an evil feeling", true, 3);      G_Outln("\phas covered the area.  Being a hero, you don't seem to mind.", true, 3);      G_Outln("\pAfter a considerable search, you encounter a wizard.  The", true, 3);      G_Outln("\pWizard immediately begins to cast a spell.....", true, 3);      G_Outln("\pSuddenly you find yourself back in town,", true, 3);      G_Outln("\pwith an incredible amount of new energy.", true, 3);      G_bCr();      myPausePrompt("\p-=Press A Key=-");      (*gCharacter)->Faith += RandomBetween(1, 3);      SetNextState(stTown);      break;    case 3:      G_Outln("\pYou enter the tower, and a fearful feeling", true, 3);      G_Outln("\pimmediatly consumes your every thought.  As you", true, 3);      G_Outln("\ppeer through the darkness, you see a faint image", true, 3);      G_Outln("\pacross the room.  As you creep closer, you finally", true, 3);      G_Outln("\prealize you've encountered a High Priest.  Before", true, 3);      G_Outln("\pyou can even turn around, he casts a spell on you.", true, 3);      G_Outln("\pan increadible dizziness immediately overtakes you....", true, 3);	  G_bCr();	  G_Outln("\pYou awaken in the center of town, so weak you can", true, 3);	  G_Outln("\pbarely stand.", true, 3);	  G_bCr();      myPausePrompt("\p-=Press A Key=-");      (*gCharacter)->Faith -= RandomBetween(1, 2);	  SetNextState(stTown);      break;  }}