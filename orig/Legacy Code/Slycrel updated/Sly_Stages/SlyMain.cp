#include "Builtins.h"#include "PStrings.h"#include "SlyMain.h"void ST_BeginExternal(void){  PStr_Set((*gCharacter)->name, "\p");  RollChar(*gCharacter, '0');                     //0 to init everything to 0  if (!(UserGlobPtr()->thisUser.terminalType == 1))     SetNextState(stDemandANSI);  else     SetNextState(stGetOpeningANSI);}void ST_GetOpeningANSI(void){  ShowANSIMenu("\pOpeningANSI", stCheckForRegistration);}void ST_CheckForRegistration(void){  Str255 Temp_Str255_1;  if (!CheckRegistration()) {    SuggestRegistration();    if (UserGlobPtr()->thisUser.SL == 255)       G_Outln("\ppress \'$\' to register Slycrel.", true, 6);  } else {    G_ANSICode("\pA");    G_ANSICode("\p39C");    G_ANSICode("\p1;32mRegistered To: ");    G_ANSICode(PStr_Concat(Temp_Str255_1, "\p0;36m", HSystPtr()->bbsName));  }  G_bCr();  G_LettersPrompt("\pYour Selection >", "\pEVCL$?", 1, true, false,                   true, char(32));  SetNextState(stMainMenu);}void ST_MainMenu(void){  switch (UserGlobPtr()->curPrompt[1]) {     case 'E':      SetNextState(stEnterSlycrel);      break;    case 'L':      G_Outln("\pExiting Slycrel...", true, 3);      SetNextState(stQuiting);      break;    case 'V':      ViewGuildLists();      SetNextState(stGetOpeningANSI);      break;    case 'C': {          long fileIndex;          if (!FindBBSCharacter(UserGlobPtr()->thisUser.userName, &fileIndex)) {		    PStr_Set((*gCharacter)->name, UserGlobPtr()->thisUser.userName);		    short randomNum = RandomBetween(1, 3);		    switch (randomNum) { 		      case 1:		        RollChar(*gCharacter, 'F');		        break;		      case 2:		        RollChar(*gCharacter, 'T');		        break;		      case 3:		        RollChar(*gCharacter, 'M');		        break;		      default:		        RollChar(*gCharacter, 'F');		        break;		    }		  } else {            gCharacterFile->Get(fileIndex, **gCharacter);          }		  SetReturnState(stCreateCharacter);		  SetNextState(stViewCharacter);	      gCharacterFile->Close();      }      break;    case '?':      SetNextState(stGetOpeningANSI);      break;    case '$':      SetNextState(stBeginRegistration);      break;    default:      SetNextState(stCheckForRegistration);      break;  }}void ST_BeginRegistration(void){  G_Outln("\pSlycrel is not Registered! it only costs $20.00 (USA)",           true, 6);  G_Outln("\pSend Your Name, BBS Name, Hermes Serial Number (Displayed at login),",           true, 6);  G_Outln("\pBBS Phone #, and $20 (CashiersCheck/MoneyOrder made out to Bill Dolinar) to:",           true, 6);  G_Outln("\pSlycrel", true, 3);  G_Outln("\p583 North 30 West", true, 3);  G_Outln("\pAmerican Fork, UT 84003", true, 3);  G_bCr();  G_Outln("\pEnter SysOp\'s Name.", true, 1);  G_bCr();  PStr_Set(UserGlobPtr()->curPrompt, "\p");  G_LettersPrompt("\p: ", "\p", 50, false, false, false, char(0));  G_ANSIPrompter(50);  SetNextState(stSaveSysopName);}void ST_SaveSysopName(void){  if (PStr_Cmp(UserGlobPtr()->curPrompt, "\p") == 0)     SetNextState(stBeginRegistration);  else {    PStr_Set(gSlyPrivates->regSysOpName, UserGlobPtr()->curPrompt);    PStr_Set(UserGlobPtr()->curPrompt, "\p");    SetNextState(stGetKey);  }}void ST_GetKey(void){  G_Outln("\pEnter Registration Key.", true, 1);  G_bCr();  PStr_Set(UserGlobPtr()->curPrompt, "\p");  G_LettersPrompt("\p: ", "\p", 31, false, false, false, char(0));  G_ANSIPrompter(31);  SetNextState(stSaveKey);}void ST_SaveKey(void){  if (PStr_Cmp(UserGlobPtr()->curPrompt, "\p") == 0)     SetNextState(stGetKey);  else {    PStr_Set(gSlyPrivates->regKey, UserGlobPtr()->curPrompt);    PStr_Set(UserGlobPtr()->curPrompt, "\p");    SetNextState(stEndRegistration);  }}void ST_EndRegistration(void){  Str255 registrationStr;  Str255 Temp_Str255_1;  MakeRegString(HSystPtr()->bbsName, PStr_Copy(Temp_Str255_1, HSystPtr()->realSerial,                                                1, 8), gSlyPrivates->regSysOpName,                 registrationStr);    if (PStr_Cmp(registrationStr, gSlyPrivates->regKey) != 0)     G_Outln("\pRegistration Failed!", true, 6);  else {    RegisterGame(gSlyPrivates->regSysOpName, gSlyPrivates->regKey);    if (CheckRegistration())       G_Outln("\pSlycrel is now registered! (wahoo!)", true, 3);    else       G_Outln("\pRegistration Failed!", true, 6);  }  SetNextState(stCheckForRegistration);}void ST_DemandANSI(void){  Str255 terminalStr;  Str255 Temp_Str255_1;  NumToString(UserGlobPtr()->thisUser.terminalType, terminalStr);  G_Outln(PStr_Concat(Temp_Str255_1, UserGlobPtr()->thisUser.userName,                       "\p ", terminalStr), true, 1);  G_Outln("\pThis Game Requires ANSI emulation.", true, 3);  G_bCr();  G_YesNoQuestion("\pDoes your Terminal Support ANSI? [Y/n] :", true);  SetNextState(stANSIReply);}void ST_ANSIReply(void){  if (UserGlobPtr()->curPrompt[1] == 'n' || UserGlobPtr()->curPrompt[1] == 'N') {    G_Outln("\pExiting Slycrel...", true, 6);    SetNextState(stQuiting);  } else {    UserGlobPtr()->thisUser.terminalType = 1;    UserGlobPtr()->thisUser.colorTerminal = true;    SetNextState(stGetOpeningANSI);  }}void ST_EnterSlycrel(void){  //--Checks & Updates Player Stat's    Str255 logStr;  Str255 userNameStr;  short randomNum;  Boolean Boo1;  Str255 Temp_Str255_1;  long fileIndex;  Boolean alive = true;    PStr_Set(userNameStr, UserGlobPtr()->thisUser.userName);  PStr_Set(logStr, PStr_Concat(Temp_Str255_1, "\p-=---  ", userNameStr,                                "\p Entered the realm of Slycrel."));  G_LogThis(logStr, 0);  // if not a valid player then create a new one  if (!FindBBSCharacter(UserGlobPtr()->thisUser.userName, &fileIndex)) {    PStr_Set((*gCharacter)->name, UserGlobPtr()->thisUser.userName);    randomNum = RandomBetween(1, 3);    switch (randomNum) {       case 1:        RollChar(*gCharacter, 'F');        break;      case 2:        RollChar(*gCharacter, 'T');        break;      case 3:        RollChar(*gCharacter, 'M');        break;      default:        RollChar(*gCharacter, 'F');        break;    }    SetReturnState(stCreateCharacter);    SetNextState(stViewCharacter);  }  // read char record and see if user can play  else {	    gCharacterFile->Get(fileIndex, **gCharacter);	    // if cosysop make a new day no matter what	    if (UserGlobPtr()->thisUser.coSysop) {	      if ((*gCharacter)->HitPoints < 0 || !(*gCharacter)->Alive) {	        (*gCharacter)->HitPoints = (*gCharacter)->MaxHP;	        NewDayForUser(*gCharacter);	      }	    }	    // else if new day and dead then setup new day	    else if ((*gCharacter)->Laston < TheDate() && !(*gCharacter)->Alive) {	      NewDayForUser(*gCharacter);	    }	    // else if dead today... sorry bud.. can't play	    else if (!(*gCharacter)->Alive && !UserGlobPtr()->thisUser.coSysop) {	      G_Outln("\pSorry, You have been killed today.  Please play again Tomorrow...", 	              true, 6);	      G_bCr();	      alive = false;	    }	  	  // if alive show any daily mail and enter town	  if (alive) {	    if (G_FExist(PStr_Concat(Temp_Str255_1, filesPath(), MailPath, UserGlobPtr()->thisUser.userName, "\p--News"))) {	      Boo1 = G_ReadTextFile(PStr_Concat(Temp_Str255_1, "\pExternals:Sly_Data:Mail:", 	                                        UserGlobPtr()->thisUser.userName, 	                                        "\p--News"), 0, true);	      if (Boo1) {	        FailOSErr(FSDelete(PStr_Concat(Temp_Str255_1, filesPath(), 	                                       MailPath, UserGlobPtr()->thisUser.userName, 	                                       "\p--News"), vRefNum));	        G_bCr();	        SetReturnState(stDoMyPausePrompt);	        SetNextState(stStartListTextFile);	      } else 	        SetNextState(stTown);	    } else	      SetNextState(stTown);	  }	  // else quit and come again another day	  else	    SetNextState(stQuiting);  }            gCharacterFile->Close();}void ST_CreateCharacter(void){  G_bCr();  G_bCr();  PrintMenu("\p ", "\pV", "\p)iew Character.", "\p1;34m", "\p0;31m",             true);  PrintMenu("\p ", "\pN", "\p)ew Name.", "\p1;34m", "\p0;31m", true);  PrintMenu("\p ", "\pF", "\p)avorite Color", "\p1;34m", "\p0;31m",             true);  PrintMenu("\p ", "\pC", "\p)hange Occupation.",             "\p1;34m", "\p0;31m", true);  PrintMenu("\p ", "\pG", "\p)ender Change.", "\p1;34m", "\p0;31m",             true);  PrintMenu("\p ", "\pR", "\p)eroll Attributes. (Caution! Resets to first level)", "\p1;34m", "\p0;31m",             true);  PrintMenu("\p ", "\pS", "\p)how Scale.", "\p1;34m", "\p0;31m", true);  PrintMenu("\p ", "\pE", "\p)nter Town!", "\p1;34m", "\p0;31m", true);  G_bCr();  G_LettersPrompt("\p[V,N,F,C,R,S,E,G]", "\pVNFCRSEG?", 1, true, false,                   true, char(0));  G_bCr();  G_ANSICode("\p36mYour Choice");  G_ANSICode("\p35m - ");  SetNextState(stCreateCharMenu);}void ST_CreateCharMenu(void){  switch (UserGlobPtr()->curPrompt[1]) {     case 'N':      SetNextState(stGetCharName);      break;    case 'F':      SetNextState(stFavoriteColorMenu);      break;    case 'C':      SetNextState(stOccupationMenu);      break;    case 'R':      SetNextState(stSetOccupation);      break;    case 'V':      SetReturnState(stCreateCharacter);      SetNextState(stViewCharacter);      break;    case 'E':      long slyPlayerNum;      long bbsPlayerNum;      Boolean foundSlyChar;      Boolean foundBBSChar;      foundSlyChar = FindCharacter((*gCharacter)->name, &slyPlayerNum);      foundBBSChar = FindBBSCharacter((*gCharacter)->bbsName, &bbsPlayerNum);      // if slycrel name already taken by someone else      if (foundSlyChar && (slyPlayerNum != bbsPlayerNum)) {        // change to stage to choose new name        G_Outln("\pSorry... that name has already been taken.", true, 1);        G_Outln("\pPlease choose another name.", true, 1);        SetNextState(stGetCharName);                    }      // new player - add character record and enter game      else if (!foundBBSChar) {        AddPlayerRec(*gCharacter);        SetNextState(stEnterSlycrel);      }      // old edited player - save character record and enter game      else {        SaveChar(*gCharacter);        SetNextState(stEnterSlycrel);      }      break;    case 'S':      ShowScale();      SetNextState(stCreateCharacter);      break;    case 'G':      CharacterPtr with_1 = *gCharacter;      if ((*gCharacter)->Gender == true) {        G_Outln("\pYou are Now Female.", true, 3);        with_1->Gender = false;        with_1->Strength -= 3;        with_1->MaxPsyche++;        with_1->Dexterity += 2;        with_1->MaxHP -= 2;        with_1->HitPoints = with_1->MaxHP;        with_1->Faith += 2;      } else {        G_Outln("\pYou are Now Male.", true, 3);        (*gCharacter)->Gender = true;        with_1->Strength += 3;        with_1->MaxPsyche--;        with_1->Dexterity -= 2;        with_1->MaxHP += 2;        with_1->HitPoints = with_1->MaxHP;        with_1->Faith -= 2;      }      SetReturnState(stCreateCharacter);      SetNextState(stViewCharacter);      break;    default:      SetNextState(stCreateCharacter);      break;  }}void ST_GetCharName(void){  G_LettersPrompt("\p", "\p", 20, false, false, false, char(0));  G_ANSICode("\p33mWhat is your new Name:");  G_ANSIPrompter(20);  PStr_Set(UserGlobPtr()->curPrompt, (*gCharacter)->name);  G_Outln(UserGlobPtr()->curPrompt, false, 4);  SetNextState(stSaveCharName);}void ST_SaveCharName(void){  PStr_Set((*gCharacter)->name, UserGlobPtr()->curPrompt);  SetNextState(stCreateCharacter);}void ST_OccupationMenu(void){  PrintMenu("\p[", "\pF", "\p]ighter", "\p0;36m", "\p1;5;31m", true);  PrintMenu("\p[", "\pT", "\p]hief", "\p0;36m", "\p1;31m", true);  PrintMenu("\p[", "\pM", "\p]age", "\p0;36m", "\p1;31m", true);  ClrPrompt();  G_LettersPrompt("\p", "\pFTM", 1, true, false, true, char(0));  G_ANSICode("\p1;34mNew class");  G_ANSICode("\p0;35m - ");  SetNextState(stGetOccupation);}void ST_GetOccupation(void){  Str255 st1;    if (!OkPrompt("\pFTM"))     SetNextState(stCreateCharacter);  else {  	st1[0] = 1;  	st1[1] = UserGlobPtr()->curPrompt[1];    PStr_Set((*gCharacter)->CharClass, st1);    SetReturnState(stCreateCharacter);    SetNextState(stViewCharacter);  }}void ST_SetOccupation(void){  RollChar(*gCharacter, (*gCharacter)->CharClass[1]);  SetReturnState(stCreateCharacter);  SetNextState(stViewCharacter);}void ST_FavoriteColorMenu(void){  G_bCr();  G_ANSICode("\p1;30m 1 - Black");  G_bCr();  G_ANSICode("\p1;37m 2 - White");  G_bCr();  G_ANSICode("\p0;34m 3 - Blue");  G_bCr();  G_ANSICode("\p1;31m 4 - Red");  G_bCr();  G_ANSICode("\p1;35m 5 - Purple");  G_bCr();  G_ANSICode("\p1;33m 6 - Yellow");  G_bCr();  G_ANSICode("\p0;33m 7 - Orange");  G_bCr();  G_ANSICode("\p1;32m 8 - Green");  G_bCr();  G_bCr();  G_NumbersPrompt("\p# of Color : ", "\p12345678", 8, 1);  SetNextState(stGetFavoriteColor);}void ST_GetFavoriteColor(void){  switch (UserGlobPtr()->curPrompt[1]) {     case '1':      (*gCharacter)->FavColor = Black;      SetNextState(stCreateCharacter);      break;    case '2':      (*gCharacter)->FavColor = White;      SetNextState(stCreateCharacter);      break;    case '3':      (*gCharacter)->FavColor = Blue;      SetNextState(stCreateCharacter);      break;    case '4':      (*gCharacter)->FavColor = Red;      SetNextState(stCreateCharacter);      break;    case '5':      (*gCharacter)->FavColor = Purple;      SetNextState(stCreateCharacter);      break;    case '6':      (*gCharacter)->FavColor = Yellow;      SetNextState(stCreateCharacter);      break;    case '7':      (*gCharacter)->FavColor = Orange;      SetNextState(stCreateCharacter);      break;    case '8':      (*gCharacter)->FavColor = Green;      SetNextState(stCreateCharacter);      break;    default:      SetNextState(stFavoriteColorMenu);      break;  }}//--Displays Character Rec and Returns to 'Return Stage'void ST_ViewCharacter(void){  PrintCharStats(*gCharacter);  PopReturnState();}void ST_DoMyPausePrompt(void){  Str255 Temp_Str255_1;  myPausePrompt(PStr_Concat(Temp_Str255_1, "\p\x0D", "\p--press a key--",                             "\p\x0D"));  SetNextState(stTown);}void ST_Town(void){  (*gCharacter)->Location = TheTown;  ShowANSIMenu("\pMainMenu", stTownShortPrompt);}void ST_TownShortPrompt(void){  G_Outln("\p[A,B,C,H,I,J,L,S,T,V,W,X,@,?]", true, 1);  G_bCr();  PStr_Set(UserGlobPtr()->curPrompt, "\p ");  G_LettersPrompt("\pYour Choice? ", "\pABCHIJLSTVWX@?~", 1, true, false,                   true, char(0));  SetNextState(stGetTownMenu);}void ST_GetTownMenu(void){  Str255 st1;  switch (UserGlobPtr()->curPrompt[1]) {     case 'A':      (*gCharacter)->Location = TheArenaMenu;      SetNextState(stArena);      break;    case 'B':      (*gCharacter)->Location = TheBank;      SetNextState(stBank);      break;    case 'C':      (*gCharacter)->Location = TheCommonGuild;      SetNextState(stCommonGuild);      break;    case 'H':      (*gCharacter)->Location = TheHerbalist;      SetNextState(stHerbalist);      break;    case 'I':      if (CheckInn()) {        (*gCharacter)->Location = TheInn;        SetNextState(stInn);      } else {        InnKeeperName(st1);        if (UserGlobPtr()->thisUser.coSysop || UCaseEqual((*gCharacter)->name,                                                           st1)) {          G_Outln("\pWarning, Inn is Closed!", true, 6);          (*gCharacter)->Location = TheInn;          SetNextState(stInn);        } else {          G_Outln("\pThe Inn\'s windows are boarded up, with a sign painted on them--KEEP OUT!",                   true, 3);          G_bCr();          G_Outln("\p(This means that it\'s closed...)", true, 1);          SetNextState(stTownShortPrompt);        }      }      break;    case 'J':      (*gCharacter)->Location = TheJail;      SetNextState(stJail);      break;    case 'L':      (*gCharacter)->Location = TheArmory;      SetNextState(stArmory);      break;    case 'S':      (*gCharacter)->Location = TheBlacksmiths;      SetNextState(stBlacksmith);      break;    case 'T':      (*gCharacter)->Location = TheTavern;      SetNextState(stTavern);      break;    case 'V':      (*gCharacter)->Location = TheTown;      SetNextState(stViewCharacter);      SetReturnState(stTownShortPrompt);      break;    case 'W':      (*gCharacter)->Location = TheWildernessMenu;      SetNextState(stWilderness);      break;    case 'X':      (*gCharacter)->Location = TheTown;      SetNextState(stShouldWeQuit);      break;    case '@':      (*gCharacter)->Location = TheTower;      SetNextState(stTower);      break;    case '~':      (*gCharacter)->CoinsHand = (*gCharacter)->CoinsHand + 1;      SetNextState(stTownShortPrompt);      break;    case '?':      (*gCharacter)->Location = TheTown;      SetNextState(stTown);      break;    default:      SetNextState(stTownShortPrompt);      break;  }}void ST_StartListTextFile(void){  UserGlobPtr()->boardAction = ListText;  SetNextState(stFinishListTextFile);}void ST_FinishListTextFile(void){  UserGlobPtr()->boardAction = None;  PopReturnState();}void ST_ShouldWeQuit(void){  G_bCr();  G_bCr();  G_YesNoQuestion("\pAre you SURE you wanna Leave? ", true);  SetNextState(stWillWeQuit);}void ST_WillWeQuit(void){  if (UserGlobPtr()->curPrompt[1] == 'n' || UserGlobPtr()->curPrompt[1] == 'N')     SetNextState(stTownShortPrompt);  else {    SaveChar(*gCharacter);    UpdateGuildLists();    ViewGuildLists();    SetNextState(stSaveAndQuit);  }}void ST_SaveAndQuit(void){  (*gCharacter)->Laston = TheDate();  SaveChar(*gCharacter);  SetNextState(stQuiting);}void ST_Quiting(void){  G_Outln("\pNow Returning to the BBS", true, 5);  UserGlobPtr()->activeUserExternal = -1;}