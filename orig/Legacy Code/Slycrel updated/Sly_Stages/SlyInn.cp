#include "Builtins.h"#include "PStrings.h"#include "SlyInn.h"void ST_Inn(void){  (*gCharacter)->Location = TheInn;  ShowANSIMenu("\pInnMenu", stInnShortPrompt);}void ST_InnShortPrompt(void){  if (Boolean(UserGlobPtr()->thisUser.coSysop))     G_Outln("\p[L,R,T,V,Q,*,?]", true, 1);  else     G_Outln("\p[L,R,T,V,Q,?]", true, 1);  G_bCr();  PStr_Set(UserGlobPtr()->curPrompt, "\p ");  G_LettersPrompt("\pYour choice? ", "\pLQRTV?*", 1, true, false, true,                   char(0));  SetNextState(stInnMenu);}void ST_InnMenu(void){  Str255 st1;  switch (UserGlobPtr()->curPrompt[1]) {     case 'L':      (*gCharacter)->Location = TheTavern;      G_Outln("\pYou look around the lobby of the inn and find it to be", true, 2);      G_Outln("\pin a serious array of disorder.  You wonder if you", true, 2);      G_Outln("\pshould really rent a room here or not.", true, 2);      G_bCr();      SetNextState(stInnShortPrompt);      break;    case 'R':      if (!CheckRegistration()) {        SuggestRegistration();        SetNextState(stInnShortPrompt);      } else {        (*gCharacter)->Location = TheInn;        SetNextState(stRentaRoom);      }      break;    case 'Q':      (*gCharacter)->Location = TheTown;      SetNextState(stTown);      break;    case 'T':      (*gCharacter)->Location = TheTavern;      G_Outln("\pYou ask the innkeep how business has been.  Quickly", true, 2);      G_Outln("\pyou realize you should have never asked such an open", true, 2);      G_Outln("\pended question as the inkeep rambles on and on......", true, 2);      G_Outln("\pand on......", true, 2);      G_bCr();      SetNextState(stInnShortPrompt);      break;    case 'V':      (*gCharacter)->Location = TheTavern;      G_Outln("\pYou look around the inn's lobby and quickly find ", true, 2);      G_Outln("\pthere really isn't anything to view.", true, 2);      G_bCr();      SetNextState(stInnShortPrompt);      break;    case '?':      (*gCharacter)->Location = TheInn;      SetNextState(stInn);      break;    case '*':      (*gCharacter)->Location = TheInn;      InnKeeperName(st1);      if (UCaseEqual(st1, UserGlobPtr()->thisUser.userName) || Boolean(UserGlobPtr()->thisUser.coSysop))         SetNextState(stInnCheatPrompt);      else         SetNextState(stInnShortPrompt);      break;    default:      SetNextState(stInn);      break;  }}void ST_RentaRoom(void){  short int1;  int1 = EmptyRoom((*gCharacter)->name);  if (int1 == 2) {    G_Outln("\pSorry There are no more rooms Avbl. for Rent", true,             3);    SetNextState(stInnShortPrompt);  } else if (int1 == 3) {    G_Outln("\pSorry, you can only have one room.", true, 3);    SetNextState(stInnShortPrompt);  } else {    G_YesNoQuestion("\pWould you like to Rent a room? ", true);    SetNextState(stGetDays);  }}void ST_GetDays(void){  if (UserGlobPtr()->curPrompt[1] == 'N')     SetNextState(stInnShortPrompt);  else {    PStr_Set(UserGlobPtr()->curPrompt, "\p0");    G_NumbersPrompt("\pFor how many days? [0-14] :", "\p0123456789",                     14, 0);    SetNextState(stTestRental);  }}void ST_TestRental(void){  long long1;  Str255 st1;  Str255 Temp_Str255_1;  StringToNum(UserGlobPtr()->curPrompt, &long1);  if (UserGlobPtr()->curPrompt[1] == '0') {    G_Outln("\pFINE!  Don\'t Rent a room, go sleep in the streets!",             true, 3);    SetNextState(stInnShortPrompt);  } else if ((*gCharacter)->CoinsHand < long1 * RoomCostPerDay()) {    G_Outln("\pI\'m not giving the room away, come back when you have enough coins!",             true, 3);    NumToString(RoomCostPerDay(), st1);    G_Outln(PStr_Concat(Temp_Str255_1, "\pNote, it costs ", st1, "\p coins per day to rent a room."), true, 1);    long1 = 0;    //don't charge if they can't afford it, we'll deny them a room if this = 0    SetNextState(stInnShortPrompt);  } else {    gSlyPrivates->rentalCost = long1 * RoomCostPerDay();    //C1 = Total Cost of Rooms for x days    gSlyPrivates->daysRented = long1;    //TempInt = number of days rented    PStr_Set(UserGlobPtr()->curPrompt, "\p0");    G_NumbersPrompt("\pWhat Security Rating would you like on your lock? [0-10] :",                     "\p0123456789", 10, 0);    SetNextState(stSaveRental);  }}void ST_SaveRental(void){  long long1;  Str255 st1;  Str255 st2;  Boolean boo1;  Str255 Temp_Str255_1;  StringToNum(UserGlobPtr()->curPrompt, &long1);  long1 *= 2;  //long1 = cost of the lock  if (PStr_Cmp(UserGlobPtr()->curPrompt, "\p0") == 0)     G_Outln("\p\"Ok, don\'t blame me if Corenne slips in late at night,\" grins the Innkeeper . ",             true, 3);  else if ((*gCharacter)->CoinsHand < long1) {    G_Outln("\pI\'m not giving the Lock away!", true, 3);    G_Outln("\pNote, it costs twice the lock rating for the lock.",             true, 1);    long1 = 0;    //Don't charge em if they don't have enough cash  }    //if room cost = 0 then they didn't buy a room! so don't give it to em  if (gSlyPrivates->rentalCost != 0) {    G_Outln("\pItem:              Days:                  Cost:", true,             2);    NumToString(gSlyPrivates->daysRented, st1);    NumToString(gSlyPrivates->rentalCost, st2);    SpaceOut(st1, 23);    G_Outln(PStr_Concat(Temp_Str255_1, "\p Room               ", st1,                         "\p$", st2), true, 1);    NumToString(long1, st2);    PStr_Set(st1, "\p1");    SpaceOut(st1, 23);    G_Outln(PStr_Concat(Temp_Str255_1, "\p Lock               ", st1,                         "\p$", st2), true, 1);    NumToString(gSlyPrivates->rentalCost + long1, st1);    G_Outln(PStr_Concat(Temp_Str255_1, "\pTotal:                                     $",                         st1), true, 3);        (*gCharacter)->CoinsHand = ((*gCharacter)->CoinsHand - long1) - gSlyPrivates->rentalCost;    //take away their cash dude    boo1 = AddToRooms((*gCharacter)->name, gSlyPrivates->daysRented,                       long1);        if (!boo1)       G_Outln("\pSorry, but the Inn Keeper just robbed you blind.",               true, 3);  }                                               //if, cost = 0    SetNextState(stInnShortPrompt);}void ST_InnCheatPrompt(void){  DisplayInnKeeperMenu();  G_Outln("\p[1,2,3,4,5,6,Q]", true, 1);  G_bCr();  PStr_Set(UserGlobPtr()->curPrompt, "\p ");  G_NumbersPrompt("\pYour choice?  ", "\p123456Q", 6, 1);  SetNextState(stInnCheatMenu);}void ST_InnCheatMenu(void){  switch (UserGlobPtr()->curPrompt[1]) {     case 'Q':      (*gCharacter)->Location = TheTown;      SetNextState(stInn);      break;    case '1':      G_bCr();      G_NumbersPrompt("\pDaily Charge for a Room:  ", "\p", 32000,                       1);      G_ANSIPrompter(5);      SetNextState(stNewDailyCharge);      break;    case '2':      ListRooms();      G_bCr();      SetNextState(stInnCheatPrompt);      break;    case '3':      ListRooms();      G_bCr();      G_NumbersPrompt("\pWhich player? [1-10] ", "\p", 10, 1);      SetNextState(stKickoutPlayer);      break;    case '4':      ViewInnStats();      SetNextState(stInnCheatPrompt);      break;    case '5':      G_YesNoQuestion("\pWould you like to close the Inn to the public? [y/N]",                       false);      SetNextState(stCloseInn);      break;    case '6':      G_Outln("\pWho is to be the new Inn Owner?", true, 7);      G_bCr();      PStr_Set(UserGlobPtr()->curPrompt, "\p0");      G_LettersPrompt("\p: ", "\p", 20, false, false, true, char(0));      SetNextState(stSetInnOwner);      break;    default:      SetNextState(stInnCheatPrompt);      break;  }}void ST_NewDailyCharge(void){  long long1;  G_bCr();  StringToNum(UserGlobPtr()->curPrompt, &long1);  ChangeRate(long1);  SetNextState(stInnCheatPrompt);}void ST_KickoutPlayer(void){  long long1;  G_bCr();  StringToNum(UserGlobPtr()->curPrompt, &long1);  RemovePlayerFromInn(long1);  SetNextState(stInnCheatPrompt);}void ST_CloseInn(void){  G_bCr();  if (UserGlobPtr()->curPrompt[1] == 'Y')     CloseInn(false);  else     CloseInn(true);  SetNextState(stInnCheatPrompt);}void ST_SetInnOwner(void){  if (PStr_Cmp(UserGlobPtr()->curPrompt, "\p0") != 0)     NewInnOwner(UserGlobPtr()->curPrompt);  SetNextState(stInnCheatPrompt);}