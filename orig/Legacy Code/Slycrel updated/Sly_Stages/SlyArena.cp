#include "Builtins.h"#include "PStrings.h"#include "SlyArena.h"void ST_Arena(void){  (*gCharacter)->Location = TheArenaMenu;  ShowANSIMenu("\pArenaMenu", stArenaShortPrompt);}void ST_ArenaShortPrompt(void){  G_Outln("\p[B,C,G,L,Q,V,?]", true, 1);  G_bCr();  PStr_Set(UserGlobPtr()->curPrompt, "\p ");  G_LettersPrompt("\pYour choice?  ", "\pBCGLQV?", 1, true, false,                   true, char(0));  SetNextState(stArenaMenu);}void ST_ArenaMenu(void){  short int1;  switch (UserGlobPtr()->curPrompt[1]) {     case 'B':      if (!CheckRegistration()) {        SuggestRegistration();        SetNextState(stArenaShortPrompt);      } else {        (*gCharacter)->Location = TheArenaMenu;        if (gGCombatFile->Exists()) {          DisplayGCombat(&int1);          PStr_Set(UserGlobPtr()->curPrompt, "\penter");  //needs to be = enter, for later                                                        //in the code          G_NumbersPrompt("\pWhich fight? ", "\p0123456789", int1,                           1);          SetNextState(stBeginBet);        } else {          G_Outln("\pSorry, there are no matches to bet on at this time.",                   true, 3);          G_bCr();          SetNextState(stArenaShortPrompt);        }      }      break;    case 'C':      if (!CheckRegistration()) {        SuggestRegistration();        SetNextState(stArenaShortPrompt);      } else {        (*gCharacter)->Location = TheArenaMenu;        SetNextState(stGetChallenge);      }      break;    case 'G':      if (!CheckRegistration()) {        SuggestRegistration();        SetNextState(stArenaShortPrompt);      } else {        (*gCharacter)->Location = TheArenaMenu;        SetNextState(stGetGladiator);      }      break;    case 'L':      (*gCharacter)->Location = TheArenaMenu;      SetReturnState(stArenaShortPrompt);      SetNextState(stOpenPlayerList);      break;    case 'Q':      (*gCharacter)->Location = TheTown;      SetNextState(stTown);      break;    case '?':      (*gCharacter)->Location = TheArenaMenu;      SetNextState(stArena);      break;    case 'V':      (*gCharacter)->Location = TheArenaMenu;      PrintCharStats(*gCharacter);      SetNextState(stArenaShortPrompt);      break;    default:      SetNextState(stArenaShortPrompt);      break;  } //case}void ST_GetChallenge(void){  if ((*gCharacter)->Spars < 1) {    G_Outln("\pSorry Buddy, but you\'ve fought All that you can Today.",             true, 2);    SetNextState(stArenaShortPrompt);  } else {    PStr_Set(UserGlobPtr()->curPrompt, "\p");    G_LettersPrompt("\pPlayer to Challenge:", "\p", 27, false, false,                     false, char(0));    SetNextState(stBeginChallenge);  }}void ST_BeginChallenge(void){  Str255 st1;  Str255 Temp_Str255_1;    PStr_Set(gSlyPrivates->combatName, UserGlobPtr()->curPrompt);  if (!FindCharacter(UserGlobPtr()->curPrompt, &gSlyPrivates->combatFileIndex)) {    G_Outln("\pPlayer Not Found", true, 6);    SetNextState(stArenaShortPrompt);  } else if (!User2Monster(gSlyPrivates->combatName, &gSlyPrivates->Monster)) {    G_Outln("\pThat Player is Dead, you can\'t fight him!", true, 1);    SetNextState(stArenaShortPrompt);  } else if (PlayerInInn(UserGlobPtr()->curPrompt)) {    G_Outln("\pThat Player is sound asleep in the Inn, you can\'t fight him!", true, 1);    SetNextState(stArenaShortPrompt);  } else if (UCaseEqual(gSlyPrivates->combatName, (*gCharacter)->name)) {    G_Outln("\pYou can not challenge yourself.  Fool!", true, 3);    SetNextState(stArenaShortPrompt);  } else {    (*gCharacter)->Location = TheArenaCombat;    NumToString(RandomBetween(1, 3), st1);    PStr_Set(st1, PStr_Concat(Temp_Str255_1, "\pArena-", st1));    GetTerrain(st1, &gSlyPrivates->Terrain);    gSlyPrivates->userR = RandomBetween(1, 12);    gSlyPrivates->userC = RandomBetween(1, 48);    gSlyPrivates->monsR = RandomBetween(1, 12);    gSlyPrivates->monsC = RandomBetween(1, 48);    CharacterPtr with_1 = *gCharacter;    with_1->Movement = RandomBetween(with_1->Speed - with_1->Speed / 5, with_1->Speed + with_1->Speed / 5);    (*gCharacter)->Spars = (*gCharacter)->Spars - 1;    (*gCharacter)->TotalFights = (*gCharacter)->TotalFights + 1;    gSlyPrivates->TextOutln = 0;        SetNextState(stCombatPlace);  }}void ST_ChallengeWon(void){  short int1;  Str255 st1;  Str255 st2;  Str255 Temp_Str255_1;  G_bCr();  int1 = RandomBetween(1, gSlyPrivates->Monster.Coins);  G_Outln(PStr_Concat(Temp_Str255_1, "\pYou have Defeated ", gSlyPrivates->Monster.name,                       "\p!!"), true, 7);  (*gCharacter)->TotalExperience = (*gCharacter)->TotalExperience + gSlyPrivates->Monster.Experience;  (*gCharacter)->SpendingExperience = (*gCharacter)->SpendingExperience + gSlyPrivates->Monster.Experience;  (*gCharacter)->CoinsHand = (*gCharacter)->CoinsHand + int1;  gSlyPrivates->Monster.Coins = int1;  (*gCharacter)->FightsWon = (*gCharacter)->FightsWon + 1;  G_bCr();  NumToString(int1, st1);  NumToString(gSlyPrivates->Monster.Experience, st2);  G_bCr();  G_ANSICode("\p1;34mYou recieve ");  G_ANSICode(PStr_Concat(Temp_Str255_1, "\p0;35m", st2));  G_ANSICode("\p1;34m Experience points.");  G_bCr();  G_ANSICode("\p1;34mYou recieve ");  G_ANSICode(PStr_Concat(Temp_Str255_1, "\p0;35m", st1));  G_ANSICode("\p1;34m Coins.");  G_bCr();  G_bCr();  UserGlobPtr()->boardAction = None;  myPausePrompt("\p-=Press A Key=-");    KillFoe(&gSlyPrivates->Monster);    SetNextState(stArena);}void ST_ChallengeLost(void){  KillUserArena(*gCharacter, &gSlyPrivates->Monster);  SetNextState(stSaveAndQuit);}void ST_OpenPlayerList(void){  UserGlobPtr()->boardAction = Repeating;  gSlyPrivates->playerListCount = 0;    // use as counter for players file  SetNextState(stListPlayers);}void ST_ListPlayers(void){  Str255 st1;  CharacterRec SlyPlayers;  Str255 Temp_Str255_1;  if (UserGlobPtr()->aborted || gSlyPrivates->playerListCount >= gCharacterFile->NumItems()) {    G_bCr();    if (UserGlobPtr()->aborted)       G_Outln("\p-Aborted-", true, 3);    gCharacterFile->Close();    PopReturnState();  } else {    gCharacterFile->Get(gSlyPrivates->playerListCount, SlyPlayers);    gSlyPrivates->playerListCount++;        G_bCr();    PStr_Set(st1, SlyPlayers.name);    SpaceOut(st1, 32);    G_ANSICode(PStr_Concat(Temp_Str255_1, "\p0;36;40m", st1));        NumToString(SlyPlayers.scoreVal, st1);    SpaceOut(st1, 5);    G_ANSICode(PStr_Concat(Temp_Str255_1, "\p0;36;40m", st1));        if (SlyPlayers.Alive)       G_ANSICode("\p0;31;40mAlive      ");    else       G_ANSICode("\p0;31;40mDead       ");    DateToString(SlyPlayers.Laston, st1);    G_ANSICode(PStr_Concat(Temp_Str255_1, "\p[0;36;40m", st1, "\p      "));    G_ANSICode(PStr_Concat(Temp_Str255_1, "\p0;32;40m", SlyPlayers.CharClass));  }}void ST_GetGladiator(void){  if ((*gCharacter)->Spars < 1) {    G_Outln("\pSorry Buddy, but you\'ve fought All that you can Today.",             true, 2);    SetNextState(stArenaShortPrompt);  } else {    PStr_Set(UserGlobPtr()->curPrompt, "\p");    G_LettersPrompt("\pPlayer to Challenge:", "\p", 27, false, false,                     false, char(0));    SetNextState(stGladiatorSure);  }}void ST_GaldiatorSure(void){  PStr_Set(gSlyPrivates->combatName, UserGlobPtr()->curPrompt);    if (!FindCharacter(gSlyPrivates->combatName, &gSlyPrivates->combatFileIndex)) {    G_Outln("\pPlayer Not Found", true, 6);    SetNextState(stArenaShortPrompt);  } else if (!User2Monster(gSlyPrivates->combatName, &gSlyPrivates->Monster)) {    G_Outln("\pThat Player is Dead, you can\'t fight him!", true,             1);    SetNextState(stArenaShortPrompt);  } else if (PlayerInInn(gSlyPrivates->combatName)) {    G_Outln("\pThat Player is sound asleep in the Inn, you can\'t fight him!",             true, 1);    SetNextState(stArenaShortPrompt);  } else if (UCaseEqual(gSlyPrivates->combatName, (*gCharacter)->name)) {    G_Outln("\pYou can not challenge yourself.  Fool!", true, 3);    SetNextState(stArenaShortPrompt);  } else {    G_Outln("\pAre you sure you want to go through with this? [Y/n]",             true, 2);    G_YesNoQuestion("\p", true);    SetNextState(stSetGladiator);  }}void ST_SetGladiator(void){  Str255 Temp_Str255_1;    if (UCaseEqual(PStr_FromChar(Temp_Str255_1, UserGlobPtr()->curPrompt[1]), "\pN")) {    G_bCr();    G_Outln("\pYou regretfully decide not to go through with this.",             true, 1);    G_bCr();    SetNextState(stArenaShortPrompt);  } else {    (*gCharacter)->Spars = (*gCharacter)->Spars - 1;    SetUpGCombat(*gCharacter, gSlyPrivates->combatName);    SetNextState(stArenaShortPrompt);  }}void ST_BeginBet(void){  long long2;  if (!(PStr_Cmp(UserGlobPtr()->curPrompt, "\penter") == 0)) {    StringToNum(UserGlobPtr()->curPrompt, &long2);    gSlyPrivates->combatBetNum = long2;    if (long2 > 0 && long2 <= gGCombatFile->NumItems()) {      GetFightInfo(&gSlyPrivates->GladiatorCombatPrefs, gSlyPrivates->combatBetNum);      if ((!PStr_Cmp(gSlyPrivates->GladiatorCombatPrefs.Challenger, (*gCharacter)->name) == 0) &&          (!PStr_Cmp(gSlyPrivates->GladiatorCombatPrefs.Opponent, (*gCharacter)->name) == 0)) {        PStr_Set(UserGlobPtr()->curPrompt, "\p");        G_LettersPrompt("\pDo you wish to bet for or against the challenger (Q=Quit)?  [F,A,Q] ",                         "\pFAQ", 1, true, false, true, char(0));        SetNextState(stGetBet);      } else {        G_Outln("\pSorry, you can't bet when your already busy fighting.", true, 3);        SetNextState(stArenaShortPrompt);      }    } else {      G_Outln("\pInvalid number", true, 3);      SetNextState(stArenaShortPrompt);    }  } else {    G_Outln("\pAborted", true, 3);    SetNextState(stArenaShortPrompt);  }  gGCombatFile->Close();}void ST_GetBet(void){  switch (UserGlobPtr()->curPrompt[1]) {     case 'F':      gSlyPrivates->combatForChallenger = true;      G_bCr();      G_NumbersPrompt("\pHow much do you wish to bet? [1..1000] ",                       "\p1234567890", 1000, 1);      SetNextState(stSaveBet);      break;    case 'A':      gSlyPrivates->combatForChallenger = false;      G_bCr();      G_NumbersPrompt("\pHow much do you wish to bet? [1..1000] ",                       "\p1234567890", 1000, 1);      SetNextState(stSaveBet);      break;    case 'Q':      SetNextState(stArenaShortPrompt);      break;    default:      SetNextState(stArenaShortPrompt);      break;  }}void ST_SaveBet(void){  long long2;  Str255 st1;  StringToNum(UserGlobPtr()->curPrompt, &long2);  PStr_Set(st1, gSlyPrivates->combatName);  if (long2 > (*gCharacter)->CoinsHand) {    G_Outln("\pSorry, you don\'t have enough cash.", true, 1);    G_bCr();  } else {    (*gCharacter)->CoinsHand = (*gCharacter)->CoinsHand - long2;    AddGambler((*gCharacter)->name, gSlyPrivates->combatForChallenger, long2, gSlyPrivates->combatBetNum);    G_Outln("\pOkay, you now are in the pool!", true, 2);    G_bCr();    myPausePrompt("\p-Any Key-");  }  SetNextState(stArenaShortPrompt);}