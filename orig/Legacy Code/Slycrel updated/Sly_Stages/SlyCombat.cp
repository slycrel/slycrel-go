#include "Builtins.h"#include "PStrings.h"#include "SlyCombat.h"void ST_Wilderness(void){  (*gCharacter)->Location = TheWildernessMenu;  ShowANSIMenu("\pWildernessMenu", stWildernessShortPrompt);}void ST_WildernessShortPrompt(void){  G_Outln("\p[A,F,M,S,Q,?]", true, 1);  G_bCr();  G_LettersPrompt("\pYour selection? ", "\pAFMSQ?", 1, true, false,                   true, char(0));  SetNextState(stWildernessMenu);}void ST_WildernessMenu(void){  switch (UserGlobPtr()->curPrompt[1]) {     case 'A':      (*gCharacter)->Location = TheHealersHut;      SetNextState(stHealer);      break;    case 'F':    case 'M':    case 'S':      (*gCharacter)->Location = TheWildernessCombat;      SetNextState(stSetupCombat);      break;    case 'Q':      (*gCharacter)->Location = TheTown;      SetNextState(stTown);      break;    case '?':      (*gCharacter)->Location = TheWildernessMenu;      SetNextState(stWilderness);      break;    default:      SetNextState(stWildernessShortPrompt);      break;  }}void ST_SetupCombat(void){  //--Reads Terrain and Reads the Monstor into Memory    short fileNum;  Str255 MonStr;  Str255 FileName;  long long1;  Str255 Temp_Str255_1;  (*gCharacter)->TotalFights = (*gCharacter)->TotalFights + 1;  if ((*gCharacter)->Exploration <= 0) {    G_Outln("\pYou just can\'t find any more monsters today...  Try again tomorrow.",             true, 3);    G_bCr();    myPausePrompt("\p-=Press A Key=-");    SetNextState(stWilderness);  } else {    (*gCharacter)->Exploration = (*gCharacter)->Exploration - 1;    (*gCharacter)->TotalFights = (*gCharacter)->TotalFights + 1;        gSlyPrivates->TextOutln = 0;        fileNum = RandomBetween(1, 3);    switch (UserGlobPtr()->curPrompt[1]) {       case 'M':        PStr_Set(MonStr, "\pMountain");        break;      case 'F':        PStr_Set(MonStr, "\pForest");        break;      case 'S':        PStr_Set(MonStr, "\pSwamp");        break;    }        //case        NumToString(fileNum, FileName);    if (UserGlobPtr()->curPrompt[1] == 'F')       PStr_Set(FileName, PStr_Concat(Temp_Str255_1, "\pForest-", FileName));    else if (UserGlobPtr()->curPrompt[1] == 'S')       PStr_Set(FileName, PStr_Concat(Temp_Str255_1, "\pSwamp-", FileName));    else       PStr_Set(FileName, PStr_Concat(Temp_Str255_1, "\pMountain-",                                      FileName));        switch ((*gCharacter)->CharClass[1]) {       case 'F':        long1 = (*gCharacter)->FighterLvl;        break;      case 'T':        long1 = (*gCharacter)->ThiefLvl;        break;      case 'M':        long1 = (*gCharacter)->MageLvl;        break;    }    if (long1 < 1)       long1 = 1;    if (long1 > 60)       long1 = 60;    long1 = long1 * 5 - RandomBetween(0, 4);        GetTerrain(FileName, &gSlyPrivates->Terrain);    GetMonster(MonStr, long1, &gSlyPrivates->Monster);        //This gets and saves our monster Max Hitpoints for text combat    gSlyPrivates->monHitPoints = gSlyPrivates->Monster.HitPoints;        gSlyPrivates->userR = RandomBetween(1, 12);    gSlyPrivates->userC = RandomBetween(1, 48);    gSlyPrivates->monsR = RandomBetween(1, 12);    gSlyPrivates->monsC = RandomBetween(1, 48);    CharacterPtr with_1 = *gCharacter;    with_1->Movement = RandomBetween(with_1->Speed - with_1->Speed / 5, with_1->Speed + with_1->Speed / 5);    SetNextState(stCombatPlace);  }}void ST_CombatPlace(void){  Str255 st1;  Str255 Temp_Str255_1;    gSlyPrivates->userR = RandomBetween(1, 12);  gSlyPrivates->userC = RandomBetween(1, 48);    gSlyPrivates->monsR = RandomBetween(1, 12);  gSlyPrivates->monsC = RandomBetween(1, 48);    if (!(gSlyPrivates->userR == gSlyPrivates->monsR && gSlyPrivates->userC == gSlyPrivates->monsC))     if (NumMovePoints(gSlyPrivates->userR, gSlyPrivates->userC, &gSlyPrivates->Terrain) < (*gCharacter)->Movement)       if (NumMovePoints(gSlyPrivates->monsR, gSlyPrivates->monsC, &gSlyPrivates->Terrain) < gSlyPrivates->Monster.Movement)         SetNextState(stGetCombatANSI);          WriteDebugText("\pGoing through a loop to place our people...");  NumToString((*gCharacter)->Movement, st1);  WriteDebugText(PStr_Concat(Temp_Str255_1, "\pCharacter Movement: ", st1));  NumToString(gSlyPrivates->Monster.Movement, st1);  WriteDebugText(PStr_Concat(Temp_Str255_1, "\pMonster Movement: ", st1));}void ST_GetCombatANSI(void){  Boolean gotTextFile;  Str255 Temp_Str255_1;  gotTextFile = G_ReadTextFile(PStr_Concat(Temp_Str255_1, ANSIPath,                                            "\pCombatANSI"),                                0, true);  if (!gotTextFile) {    G_Outln(PStr_Concat(Temp_Str255_1, "\pError in Reading \'", filesPath(),                         ANSIPath, "\pCombatANSI\' file!"), true,             6);    G_Outln("\pAborted", true, 3);    SetNextState(stWilderness);  } else {    UserGlobPtr()->boardAction = ListText;    SetNextState(stDrawCombatField);  }}void ST_DrawCombatField(void){  DrawCombatField(&gSlyPrivates->Terrain);  SetNextState(stDrawCombatStats);}void ST_DrawCombatStats(void){  Str255 st1;  Str255 st2;  Str255 Temp_Str255_1;  NumToString(gSlyPrivates->userR + 2, st1);  NumToString(gSlyPrivates->userC + 2, st2);  G_ANSICode(PStr_Concat(Temp_Str255_1, st1, "\p;", st2, "\pH"));  G_ANSICode("\p1;34mè");    NumToString(gSlyPrivates->monsR + 2, st1);  NumToString(gSlyPrivates->monsC + 2, st2);  G_ANSICode(PStr_Concat(Temp_Str255_1, st1, "\p;", st2, "\pH"));  G_ANSICode("\p0;31mœ");    DrawCharInfo(*gCharacter);  UpdateMovement((*gCharacter)->Movement);  TextOut(PStr_Concat(Temp_Str255_1, "\pYou Encounter a ", gSlyPrivates->Monster.name));  SetNextState(stCombat);}//Prompt combat movementvoid ST_Combat(void){  if (!(*gCharacter)->Alive || (*gCharacter)->HitPoints <= 0) {    if ((*gCharacter)->Location == TheArenaCombat) {      (*gCharacter)->Location = TheArenaMenu;      SetNextState(stChallengeLost);    } else {      (*gCharacter)->Alive = false;      (*gCharacter)->Location = TheTown;	  SaveChar(*gCharacter);      G_ANSICode("\p2J");      G_ANSICode("\pH");      G_Outln("\pYou\'re outta life buddy...", true, 6);      SetNextState(stSaveAndQuit);    }  } else if (gSlyPrivates->Monster.HitPoints <= 0) {    G_ANSICode("\p2J");    G_ANSICode("\pH");    SetNextState(stOpponentAttackStage);  } else {    if (!CanMove(gSlyPrivates->userR, gSlyPrivates->userC, (*gCharacter)->Movement,                  &gSlyPrivates->Terrain))       SetNextState(stMoveMonster);    else {      PStr_Set(UserGlobPtr()->curPrompt, "\p");      G_LettersPrompt("\p", "\pAEFIJKLRPSU*", 1, true, false, true, char(46));      G_ANSICode("\p16;23H");      SetNextState(stMovePlayer);    }  }}void ST_MovePlayer(void){  Str255 st1;  if ((*gCharacter)->Movement < 3 && (UserGlobPtr()->curPrompt[1] == 'A' || UserGlobPtr()->curPrompt[1] == 'F')) {    TextOut("\pNot \'nuff Movement Pts. Left!");    SetNextState(stCombat);  } else     switch (UserGlobPtr()->curPrompt[1]) {       case 'I':      case 'J':      case 'K':      case 'L':        PStr_Set(st1, PStr_FromChar(st1, UserGlobPtr()->curPrompt[1]));        MovePlayer(st1[1], &gSlyPrivates->userR, &gSlyPrivates->userC, &(*gCharacter)->Movement,                    &gSlyPrivates->Terrain);                if ((*gCharacter)->Alive)           SetNextState(stCombat);        else           SetNextState(stSaveAndQuit);        break;      case 'E':        TextOut("\pYou can't find anything to examine");        SetNextState(stCombat);        break;      case 'F':        DoShoot(gSlyPrivates->userR, gSlyPrivates->userC, gSlyPrivates->monsR, gSlyPrivates->monsC);        SetNextState(stCombat);        break;      case 'P':        TextOut("\pYou pass your remaining moves");        SetNextState(stMoveMonster);        break;      case 'R':        if ((*gCharacter)->Location == TheArenaCombat) {          (*gCharacter)->Location = TheArenaMenu;          SetNextState(stArena);        } else {          (*gCharacter)->Location = TheWildernessMenu;          SetNextState(stWilderness);        }        break;      case 'S':        TextOut("\pYou feel special while passing your moves");        SetNextState(stMoveMonster);        break;      case 'U':        TextOut("\pYou can't find anything to use");        SetNextState(stCombat);        break;      case '*':        SetNextState(stGetCombatANSI);        break;      case 'A':        (*gCharacter)->Movement = (*gCharacter)->Movement - 3;        if (RandomBetween(1, 50) < 8)           SetNextState(stSetupTextCombat);        else {          TextOut("\pYou Attempt to Attack the Creature, & you fail.");          SetNextState(stCombat);        }        break;      default:        SetNextState(stCombat);        break;    } //Case    // Quits to Text Combat if User is on Monster   if (gSlyPrivates->userR == gSlyPrivates->monsR && gSlyPrivates->userC == gSlyPrivates->monsC)     SetNextState(stSetupTextCombat);    UpdateMovement((*gCharacter)->Movement);}void ST_MoveMonster(void){  MoveMonster(&gSlyPrivates->monsR, &gSlyPrivates->monsC, &gSlyPrivates->userR,               &gSlyPrivates->userC, &gSlyPrivates->Monster, &gSlyPrivates->Terrain);  CharacterPtr with_2 = *gCharacter;  with_2->Movement = RandomBetween(with_2->Speed - with_2->Speed / 5, with_2->Speed + with_2->Speed / 5);  if (gSlyPrivates->userR == gSlyPrivates->monsR && gSlyPrivates->userC == gSlyPrivates->monsC)     SetNextState(stSetupTextCombat);  else     SetNextState(stCombat);    UpdateMovement((*gCharacter)->Movement);        //redisplay char move}