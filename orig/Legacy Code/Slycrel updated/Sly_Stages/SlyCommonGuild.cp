#include "Builtins.h"#include "PStrings.h"#include "SlyCommonGuild.h"void ST_CommonGuild(void){  (*gCharacter)->Location = TheCommonGuild;  ShowANSIMenu("\pCommonGuildMenu", stGuildShortPrompt);}void ST_GuildShortPrompt(void){  G_Outln("\p[L,Q,?]", true, 1);  G_bCr();  PStr_Set(UserGlobPtr()->curPrompt, "\p ");  G_LettersPrompt("\pYour choice?  ", "\pLQ?", 1, true, false, true,                   char(0));  SetNextState(stGuildMenu);}void ST_GuildMenu(void){  switch (UserGlobPtr()->curPrompt[1]) {     case 'L':      if (CheckRegistration()) {        (*gCharacter)->Location = TheCommonGuild;        SetNextState(stTryNewLevel);      } else {        SuggestRegistration();        SetNextState(stGuildShortPrompt);      }      break;    case 'Q':      (*gCharacter)->Location = TheTown;      SetNextState(stTown);      break;    case '?':      (*gCharacter)->Location = TheCommonGuild;      SetNextState(stCommonGuild);      break;    default:      SetNextState(stGuildShortPrompt);      break;  }}void ST_TryNewLevel(void){  Str255 st1;  long long1;  Str255 Temp_Str255_1;  G_bCr();  G_ANSICode("\p0;33mYour Current Level");  G_ANSICode("\p1;30m: ");  switch ((*gCharacter)->CharClass[1]) {     case 'F':      NumToString((*gCharacter)->FighterLvl, st1);      break;    case 'T':      NumToString((*gCharacter)->ThiefLvl, st1);      break;    case 'M':      NumToString((*gCharacter)->MageLvl, st1);      break;  }  G_ANSICode(PStr_Concat(Temp_Str255_1, "\p0;34m", st1));    G_bCr();  G_ANSICode("\p0;33mYour Total Experience");  G_ANSICode("\p1;30m: ");  NumToString((*gCharacter)->TotalExperience, st1);  G_ANSICode(PStr_Concat(Temp_Str255_1, "\p0;34m", st1));    G_bCr();  G_ANSICode("\p0;33mRequired Experience");  G_ANSICode("\p1;30m: ");  switch ((*gCharacter)->CharClass[1]) {     case 'F':      long1 = NextLevelUp((*gCharacter)->FighterLvl + 1);      break;    case 'T':      long1 = NextLevelUp((*gCharacter)->ThiefLvl + 1);      break;    case 'M':      long1 = NextLevelUp((*gCharacter)->MageLvl + 1);      break;  }  NumToString(long1, st1);  G_ANSICode(PStr_Concat(Temp_Str255_1, "\p0;34m", st1));    if (long1 <= (*gCharacter)->TotalExperience) {    G_Outln("\p\"Finally someone who is ready to go up,\" grins the GuildMaster",             true, 5);    GiveNewLevel(*gCharacter, (*gCharacter)->CharClass[1]);    G_Outln("\pYou have gained one level!", true, 0);  } else if (long1 > NextLevelUp(60))     G_Outln("\pThe GuildMaster uncomfortably says, \"I\'m sorry, you\'ve maxed out.",             true, 2);  else     G_Outln("\pThe GuildMaster looks and you and Laughs.", true, 6);  SetNextState(stGuildShortPrompt);}