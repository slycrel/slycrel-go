#include "Builtins.h"#include "PStrings.h"#include "SlyBank.h"void ST_Bank(void){  (*gCharacter)->Location = TheBank;  ShowANSIMenu("\pBankMenu", stBankPrompt);}void ST_BankPrompt(void){  Str255 st1;  Str255 st2;  Str255 Temp_Str255_1;  NumToString((*gCharacter)->CoinsBank, st1);  NumToString((*gCharacter)->CoinsHand, st2);  G_ANSICode(PStr_Concat(Temp_Str255_1, "\p1;34m", "\pYou have "));  G_ANSICode(PStr_Concat(Temp_Str255_1, "\p1;30m", st1));  G_ANSICode(PStr_Concat(Temp_Str255_1, "\p1;34m", "\p Coins in Bank and "));  G_ANSICode(PStr_Concat(Temp_Str255_1, "\p1;30m", st2));  G_ANSICode(PStr_Concat(Temp_Str255_1, "\p1;34m", "\p Coins on Hand."));  G_Outln("\p[D,W,Q,?]", true, 1);  G_bCr();  PStr_Set(UserGlobPtr()->curPrompt, "\p");  G_LettersPrompt("\pYour choice?  ", "\pDWQ?", 1, true, false, true,                   char(0));  SetNextState(stBankMenu);}void ST_BankMenu(void){  switch (UserGlobPtr()->curPrompt[1]) {     case 'D':      (*gCharacter)->Location = TheBank;      SetNextState(stGetDeposit);      break;    case 'W':      (*gCharacter)->Location = TheBank;      SetNextState(stGetWithdrawl);      break;    case 'Q':      (*gCharacter)->Location = TheTown;      SetNextState(stTown);      break;    case '?':      (*gCharacter)->Location = TheBank;      SetNextState(stBank);      break;    default:      SetNextState(stBankPrompt);      break;  } //case}void ST_GetDeposit(void){  Str255 st1;  Str255 Temp_Str255_1;  PStr_Set(UserGlobPtr()->curPrompt, "\p");  NumToString((*gCharacter)->CoinsHand, st1);  PStr_Set(st1, PStr_Concat(Temp_Str255_1, "\p[> = ", st1, "\p <cr> = Abort]"));  G_Outln(st1, true, 5);  G_bCr();  PStr_Set(UserGlobPtr()->curPrompt, "\p");  G_NumbersPrompt("\pDeposit :", "\p>0123456789", (*gCharacter)->CoinsHand,                   0);  SetNextState(stSaveDeposit);}void ST_SaveDeposit(void){  Str255 st1;  Str255 st2;  long long1;  PStr_Set(st1, UserGlobPtr()->curPrompt);  if (PStr_Cmp(st1, "\p") != 0) {    if (PStr_Cmp(st1, "\p>") == 0) {      NumToString((*gCharacter)->CoinsHand, st2);      (*gCharacter)->CoinsBank = (*gCharacter)->CoinsBank + (*gCharacter)->CoinsHand;      (*gCharacter)->CoinsHand = 0;    } else if (PStr_Cmp(st1, "\p") != 0 && PStr_Cmp(st1, "\p>") != 0) {      StringToNum(st1, &long1);      if (long1 <= (*gCharacter)->CoinsHand) {        NumToString(long1, st2);        (*gCharacter)->CoinsBank = (*gCharacter)->CoinsBank + long1;        (*gCharacter)->CoinsHand = (*gCharacter)->CoinsHand - long1;      }    }    G_Outln("\pYou give the banker ", true, 7);    G_Outln(st2, false, 5);    G_Outln("\p coins.", false, 7);    G_bCr();    G_bCr();    G_bCr();  }  SaveChar(*gCharacter);  SetNextState(stBankPrompt);}void ST_GetWithdrawl(void){  Str255 st1;  Str255 Temp_Str255_1;  PStr_Set(UserGlobPtr()->curPrompt, "\p");  NumToString((*gCharacter)->CoinsBank, st1);  PStr_Set(st1, PStr_Concat(Temp_Str255_1, "\p[> = ", st1, "\p <cr> = Abort]"));  G_Outln(st1, true, 5);  G_bCr();  G_NumbersPrompt("\pWithDraw :", "\p>0123456789", (*gCharacter)->CoinsBank,                   0);  SetNextState(stSaveWithdrawl);}void ST_SaveWithdrawl(void){  Str255 st1;  Str255 st2;  long long1;  PStr_Set(st1, UserGlobPtr()->curPrompt);  if (PStr_Cmp(st1, "\p") != 0) {    if (PStr_Cmp(st1, "\p>") == 0) {      NumToString((*gCharacter)->CoinsBank, st2);      (*gCharacter)->CoinsHand = (*gCharacter)->CoinsHand + (*gCharacter)->CoinsBank;      (*gCharacter)->CoinsBank = 0;    } else if (PStr_Cmp(st1, "\p") != 0 && PStr_Cmp(st1, "\p>") != 0) {      StringToNum(st1, &long1);      if (long1 <= (*gCharacter)->CoinsBank) {        NumToString(long1, st2);        (*gCharacter)->CoinsHand = (*gCharacter)->CoinsHand + long1;        (*gCharacter)->CoinsBank = (*gCharacter)->CoinsBank - long1;      }    }    NumToString(long1, st1);    G_Outln("\pThe Banker hands you ", true, 7);    G_Outln(st2, false, 5);    G_Outln("\p coins.", false, 7);    G_bCr();    G_bCr();    G_bCr();  }  SaveChar(*gCharacter);  SetNextState(stBankPrompt);}