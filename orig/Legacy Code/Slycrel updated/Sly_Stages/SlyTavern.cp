#include "Builtins.h"#include "PStrings.h"#include "SlyTavern.h"void ST_Tavern(void){  (*gCharacter)->Location = TheTavern;  ShowANSIMenu("\pTavernMenu", stTavernShortPrompt);}void ST_TavernShortPrompt(void){  G_Outln("\p[F,H,L,O,Q,T,V,?]", true, 1);  G_bCr();  PStr_Set(UserGlobPtr()->curPrompt, "\p ");  G_LettersPrompt("\pWell? :", "\pFHLOQTV?", 1, true, false, true,                   char(0));  SetNextState(stTavernMenu);}void ST_TavernMenu(void){  switch (UserGlobPtr()->curPrompt[1]) {     case '?':      (*gCharacter)->Location = TheTavern;      SetNextState(stTavern);      break;    case 'F':      (*gCharacter)->Location = TheTavern;      SetNextState(stCorennePrompt);      break;    case 'H':      (*gCharacter)->Location = TheTavern;      SetNextState(stHangAround);      break;    case 'L':      (*gCharacter)->Location = TheTavern;      G_Outln("\pYou sit on a bar stool for a while trying to listen", true, 2);      G_Outln("\pto every wisper from across the room.  After some time", true, 2);      G_Outln("\pyou decide you can't hear anything and wonder if you ", true, 2);      G_Outln("\pshould just leave the tavern.", true, 2);      G_bCr();      SetNextState(stTavernShortPrompt);      break;    case 'O':      (*gCharacter)->Location = TheTavern;      SetNextState(stOrderDrinkPrompt);      break;    case 'Q':      (*gCharacter)->Location = TheTown;      SetNextState(stTown);      break;    case 'T':      (*gCharacter)->Location = TheTavern;      SetNextState(stTalkToLynx);      break;    case 'V':      (*gCharacter)->Location = TheTavern;      SetNextState(stViewGuilds);      break;    default:      SetNextState(stTavernShortPrompt);      break;  }}void ST_OrderDrinkPrompt(void){  Str255 numCoinsStr;  Str255 Temp_Str255_1;  G_bCr();  G_Outln("\pWhaddya want?", true, 1);  G_bCr();  G_Outln("\p 1- Fruit Juice                  0", true, 2);  G_Outln("\p 2- Elven Ale                    1", true, 2);  G_Outln("\p 3- Ale                          2", true, 2);  G_Outln("\p 4- Mead                         2", true, 2);  G_Outln("\p 5- Cocktail                     3", true, 2);  G_Outln("\p 6- Faery Water                  3", true, 2);  G_Outln("\p 7- Fine Wine                    4", true, 2);  G_Outln("\p 8- Whiskey                      4", true, 2);  G_Outln("\p 9- Ogre Sweat                   5", true, 2);  G_Outln("\p10- Dwarf Spirits                5", true, 2);  G_Outln("\p11- Dragon Blood                 6", true, 2);  G_Outln("\p12- Potency                      7", true, 2);  G_Outln("\p13- Kwick                        9", true, 2);  G_Outln("\p14- Josepi\'s Molotov Cocktail   10", true, 2);  G_Outln("\p15- Auneletho\'s Surprise        10", true, 2);  G_bCr();  G_bCr();  NumToString((*gCharacter)->CoinsHand, numCoinsStr);  G_ANSICode(PStr_Concat(Temp_Str255_1, "\p1;32m$", numCoinsStr));  G_ANSICode("\p0;36m in Hand");  G_bCr();  G_NumbersPrompt("\p [1-15,Q]:", "\pQ", 16, 1);  SetNextState(stOrderDrinkMenu);}void ST_OrderDrinkMenu(void){  long drinkNum;  if (UserGlobPtr()->curPrompt[1] == 'Q')     SetNextState(stTavernShortPrompt);  else {    StringToNum(UserGlobPtr()->curPrompt, &drinkNum);    G_bCr();    OrderDrink(drinkNum);    G_bCr();    G_bCr();    if (PStr_Cmp(UserGlobPtr()->curPrompt, "\p16") == 0) {	  SaveChar(*gCharacter);      SetNextState(stSaveAndQuit);    } else       SetNextState(stTavernShortPrompt);  }}void ST_TalkToLynx(void){  G_Outln("\pSorry, Lynx doesn\'t feel up to talking right now.  He\'s busy",           true, RandomBetween(0, 7));  G_Outln("\pplaying with the barmaid...", true, RandomBetween(0, 7));  G_bCr();  G_bCr();  SetNextState(stTavernShortPrompt);}void ST_HangAround(void){  short x;  if (RandomBetween(1, 100) <= 50) {    G_Outln("\pYou lounge around the bar for a while.", true, RandomBetween(0,                                                                   7));    G_bCr();    G_bCr();    G_Outln("\pThis is boring.  Let\'s do something else.", true,             RandomBetween(0, 7));    G_bCr();    G_bCr();    UserGlobPtr()->boardAction = None;    myPausePrompt("\pZZZZZzzzzzz...");  } else {    G_Outln("\pYou lounge around the bar for a while.", true, RandomBetween(0,                                                                   7));    G_bCr();    G_bCr();    G_Outln("\pYou nod off after a while....", true, RandomBetween(0, 7));    G_bCr();    G_bCr();    UserGlobPtr()->boardAction = None;    for (x = 1; x <= 100; ++x)       if (x % 30 == 0)         G_Outln("\pZZ", true, 1);      else if (x % 10 == 0)         G_Outln("\pzzz", false, 1);    G_bCr();    G_Outln("\pAs you wake up, your money purse feels lighter...  You must have spent more than you thought...",             true, 2);    CharacterPtr with_1 = *gCharacter;    with_1->CoinsHand -= with_1->CoinsHand / RandomBetween(10, 25);  }  SetNextState(stTavernShortPrompt);}void ST_CorennePrompt(void){  if ((*gCharacter)->Flirt1 < 0) {    G_Outln("\pCorenne will probably think you\'re desperate, and you wouldn\'t want that.",             true, 3);    SetNextState(stTavernShortPrompt);  } else {    G_bCr();    G_Outln("\p1] Grin Foolishly", true, 6);    G_Outln("\p2] Kiss her hand", true, 6);    G_Outln("\p3] Compliment and tip her", true, 6);    G_Outln("\p4] Brag about yourself", true, 6);    G_Outln("\p5] Wink seductively", true, 6);    G_Outln("\p6] Compliment her", true, 6);    G_Outln("\p7] Ask her to dance", true, 6);    G_Outln("\p8] Share a meal", true, 6);    G_bCr();    G_bCr();    G_NumbersPrompt("\pWhats it gonna be Cutie? ", "\p12345678", 8,                     1);    SetNextState(stCorenneMenu);  }}void ST_CorenneMenu(void){  long flirtSelection;  StringToNum(UserGlobPtr()->curPrompt, &flirtSelection);  G_bCr();  FlirtEffects(flirtSelection);  (*gCharacter)->Flirt1 = ((*gCharacter)->Flirt1) * -1;  SetNextState(stTavernShortPrompt);}void ST_ViewGuilds(void){  SaveChar(*gCharacter);  UpdateGuildLists();  ViewGuildLists();  SetNextState(stTavernShortPrompt);}