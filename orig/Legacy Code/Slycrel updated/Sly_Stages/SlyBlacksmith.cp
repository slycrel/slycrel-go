#include "Builtins.h"#include "PStrings.h"#include "SlyBlacksmith.h"void ST_Blacksmith(void){  Str255 st1;  short randomNum = RandomBetween(0, 2);  switch (randomNum) {    case 0:      G_Outln("\pYou enter the blacksmith's shop and Smith immediately", true, 3);      G_Outln("\pbegins laughing.  Smith picks you up by the britches,", true, 3);      G_Outln("\pbiceps bulging, and throws you back out on the road.", true, 3);      G_bCr();      myPausePrompt("\p-=Press A Key=-");      SetNextState(stTown);      break;    case 1:      G_Outln("\pYou enter the blacksmith's shop and Smith gives you", true, 3);      G_Outln("\pa pat on the back.  After you get back off the ground", true, 3);      G_Outln(PStr_Concat(st1, "\pand dust yourself off, Smith takes your ", (*gCharacter)->Weapons[0].name), true, 3);      G_Outln("\pand begins to work on it.  When he returns the weapon,", true, 3);      G_Outln("\pyou can't help but notice its fine craftmanship.  You", true, 3);      G_Outln("\pimmediatly head for the door, thanking Smith as you leave.", true, 3);      G_bCr();      myPausePrompt("\p-=Press A Key=-");      (*gCharacter)->Weapons[0].Strike += RandomBetween(1, 3);      SetNextState(stTown);      break;    case 2:      G_Outln("\pYou enter the blacksmith's shop and Smith wallows up", true, 3);      G_Outln("\pto shake your hand.  After you get back off the ground", true, 3);      G_Outln(PStr_Concat(st1, "\pand dust yourself off, Smith takes your ", (*gCharacter)->Weapons[0].name), true, 3);      G_Outln("\pand begins to work on it.  When he returns the weapon,", true, 3);      G_Outln("\pyou can't help but notice it has several new dents.", true, 3);      G_Outln("\pYou slowly head for the door.  Smith smiles, and asks", true, 3);      G_Outln("\pyou to come again soon.", true, 3);      G_bCr();      myPausePrompt("\p-=Press A Key=-");      (*gCharacter)->Weapons[0].Strike -= RandomBetween(1, 2);      SetNextState(stTown);      break;  }}