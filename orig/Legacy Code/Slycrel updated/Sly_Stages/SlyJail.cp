#include "Builtins.h"#include "PStrings.h"#include "SlyJail.h"void ST_Jail(void){  Str255 st1;  short randomNum = RandomBetween(0, 2);  switch (randomNum) {    case 0:      G_Outln("\pAs you enter the jail, in a cell you see your fellow", true, 3);      G_Outln("\phero Night Hawk.  Quickly realizing this is no place", true, 3);      G_Outln("\pfor a hero such as yourself, you head right back out", true, 3);      G_Outln("\pthe door.", true, 3);      G_bCr();      myPausePrompt("\p-=Press A Key=-");      SetNextState(stTown);      break;    case 1:      G_Outln("\pAs you enter the jail, the jailor walks up and shakes", true, 3);      G_Outln("\pyour hand, saying he's always glad to see a hero visit.", true, 3);      G_Outln("\pthe next thing you know you find yourself locked in a", true, 3);      G_Outln("\pcell with the jailor laughing at you from outside.", true, 3);      G_Outln("\pLooks like you'll have to spend the night.", true, 3);      G_bCr();      (*gCharacter)->Alive = false;      (*gCharacter)->Location = TheTown;	  SaveChar(*gCharacter);      myPausePrompt("\p-=Press A Key=-");      SetNextState(stSaveAndQuit);      break;    case 2:      G_Outln("\pAs you enter the jail, the jailor walks up and shakes", true, 3);      G_Outln("\pyour hand, saying he's glad to see such a fine hero", true, 3);      G_Outln("\pvisit.  The jailor takes you over to his weapon rack.", true, 3);      G_Outln(PStr_Concat(st1, "\pYou can't help but notice the jailors ", (*gCharacter)->Weapons[0].name), true, 3);      G_Outln("\pis in much better shape than your own.  The jailor can't", true, 3);      G_Outln("\phelp but notice your envy, and offers to loan you the", true, 3);      G_Outln("\pweapon.  Before he can change his mind, you grab the", true, 3);      G_Outln("\pweapon and head out the door.", true, 3);      G_bCr();      (*gCharacter)->Weapons[0].Strike += RandomBetween(1, 3);      myPausePrompt("\p-=Press A Key=-");      SetNextState(stTown);      break;  }}