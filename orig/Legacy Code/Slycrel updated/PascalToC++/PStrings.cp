n (n ? *s1 - *s2 : 0);}/*-----------------------------------------------* | PStr_Pos - Find 1st occurrence of a substring | *-----------------------------------------------* Find the first occurrence of Pascal string sub in the Pascal string src and	return the index of the first occurrence.*/short PStr_Pos(const unsigned char *sub, const unsigned char *src){		register int sublen, limit;		register unsigned char n;		register const unsigned char *q;		register const unsigned char *p;		const unsigned char *origSrc = src;			sublen = (unsigned char)*sub++;		if (sublen == 0) return (0);				limit = (unsigned char)*src++ - sublen;		if (limit < 0) return (0);				while (limit-- >= 0) {			q = src;			p = sub;			n = sublen;			while (n--) if (*p++ != *q++) goto next;			return ((short)(src - origSrc));next: src++; 		}		return (0);}short PStr_Pos(unsigned char sub, const unsigned char *src){		register int sublen, limit;		register const unsigned char *q;		const unsigned char *origSrc = src;			sublen = 1;		if (sublen == 0) return (0);				limit = (unsigned char)*src++ - sublen;		if (limit < 0) return (0);				while (limit-- >= 0) {			q = src;			if (sub != *q++) goto next;			return ((short)(src - origSrc));next: src++; 		}		return (0);}/*--------------------------------------------------* | PStr_Copy - Copy a (sub)string to another string | *--------------------------------------------------*	Copy amount characters (or up to the last character of the src Pascal string)	from the src Pascal string starting at startPos in src to the dst Pascal string	and return a pointer to the dst Pascal string.  It is up to the caller to make	sure enough space is reserved in the dst string.*/unsigned char *PStr_Copy(unsigned char *dst, const unsigned char *src,											 	int startPos, int amount){	const unsigned char *start = src + startPos;	unsigned char *p = dst++;	const unsigned char *q = src + *src + 1;	if (start >= q) {		*p = '\0';		return(p);	}		if (start+amount > q)		amount = q - start;		while (amount--)		*dst++ = *start++;	*p = dst - p - 1;	return (p);}/*----------------------------------------------* | PStr_Insert - Insert one string into another | *----------------------------------------------* Insert the ins Pascal string into the dst string starting at position startPos in the dst string.  The function returns original dst Pascal string with the insert as its value.  It is up to the caller to make sure enough space is reserved in the dst string for the insertion.*/unsigned char *PStr_Insert(const unsigned char *ins, unsigned char *dst,													int startPos){	unsigned char *start = dst + startPos;	register unsigned char *q, *p = dst + (unsigned char)*dst + 1;	register int inslen;	*dst += inslen = (unsigned char)*ins;		q = p + inslen;	while (--p >= start) *--q = *p;		while (inslen--) *++p = *++ins;	return (dst);}/*-----------------------------------------------* | PStr_Delete - Delete characters from a string | *-----------------------------------------------* Delete amount characters (or all remaining characters) from the Pascal string starting at the character indicated by startPos.*/unsigned char *PStr_Delete(unsigned char *dst, int startPos, int amount){	unsigned char *start = dst + startPos;	register unsigned char *p;	register int n;		if (amount <= 0) return (dst);		p = start + amount;	n = dst + (unsigned char)*dst - p + 1;		if (n <= 0) {		*dst = start - dst - 1;	} else {		while (n--) *start++ = *p++;		*dst -= amount;	}	return (dst);}/*-----------------------------------* | PStr_Concat - Concatenate strings | *-----------------------------------* Concatenate all the Pascal strings specified in the argument list together with the dst Pascal string and return a pointer to the dst string.  It is up to the caller to make sure enough space is reserved in the dst string for all the concatenations.	No check is made to see that the string length exceeds 255 characters.*/static unsigned char *PStr_AddOne(unsigned char *dst, const unsigned char *src2){	unsigned char *q = dst + *dst + 1;	short n;		n = *src2++;	*dst += n;	while (n > 0) { 		*q++ = *src2++;		n--;	}	return dst;}unsigned char *PStr_Concat(unsigned char *dst, const unsigned char *src1, const unsigned char *src2){		PStr_Set(dst, src1);	return PStr_AddOne(dst, src2);}unsigned char *PStr_Concat(unsigned char *dst,																	const unsigned char *src1,																	const unsigned char *src2,																	const unsigned char *src3																	){	PStr_Set(dst, src1);	PStr_AddOne(dst, src2);	return PStr_AddOne(dst, src3);}extern unsigned char *PStr_Concat(unsigned char *dst,																	const unsigned char *src1,																	const unsigned char *src2,																	const unsigned char *src3,																	const unsigned char *src4																	){	PStr_Set(dst, src1);	PStr_AddOne(dst, src2);	PStr_AddOne(dst, src3);	return PStr_AddOne(dst, src4);}extern unsigned char *PStr_Concat(unsigned char *dst,																	const unsigned char *src1,																	const unsigned char *src2,																	const unsigned char *src3,																	const unsigned char *src4,																	const unsigned char *src5																	){	PStr_Set(dst, src1);	PStr_AddOne(dst, src2);	PStr_AddOne(dst, src3);	PStr_AddOne(dst, src4);	return PStr_AddOne(dst, src5);}extern unsigned char *PStr_Concat(unsigned char *dst,																	const unsigned char *src1,																	const unsigned char *src2,																	const unsigned char *src3,																	const unsigned char *src4,																	const unsigned char *src5,																	const unsigned char *src6																	){	PStr_Set(dst, src1);	PStr_AddOne(dst, src2);	PStr_AddOne(dst, src3);	PStr_AddOne(dst, src4);	PStr_AddOne(dst, src5);	return PStr_AddOne(dst, src6);}extern unsigned char *PStr_Concat(unsigned char *dst,																	const unsigned char *src1,																	const unsigned char *src2,																	const unsigned char *src3,																	const unsigned char *src4,																	const unsigned char *src5,																	const unsigned char *src6,																	const unsigned char *src7																	){	PStr_Set(dst, src1);	PStr_AddOne(dst, src2);	PStr_AddOne(dst, src3);	PStr_AddOne(dst, src4);	PStr_AddOne(dst, src5);	PStr_AddOne(dst, src6);	return PStr_AddOne(dst, src7);}extern unsigned char *PStr_Concat(unsigned char *dst,																	const unsigned char *src1,																	const unsigned char *src2,																	const unsigned char *src3,																	const unsigned char *src4,																	const unsigned char *src5,																	const unsigned char *src6,																	const unsigned char *src7,																	const unsigned char *src8																	){	PStr_Set(dst, src1);	PStr_AddOne(dst, src2);	PStr_AddOne(dst, src3);	PStr_AddOne(dst, src4);	PStr_AddOne(dst, src5);	PStr_AddOne(dst, src6);	PStr_AddOne(dst, src7);	return PStr_AddOne(dst, src8);}