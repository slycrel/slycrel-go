#include <stddef.h>#include <types.h>#include "Builtins.h"#include "PStrings.h"#include "TerrainFunctions.h"#define privs (gTerrainPrivates)//-------------------------------------------------Boolean CheckRegistration(UserXIPtr ){  return true;}//-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-void PosCursor(short r, short c, UserXIPtr HermSetup){  Str255 Rstr;  Str255 Cstr;  Str255 where;  Str255 Temp_Str255_1;  NumToString(r + 3, Rstr);  NumToString(c + 5, Cstr);  PStr_Set(where, PStr_Concat(Temp_Str255_1, Rstr, "\p;", Cstr, "\pH"));  ANSICode(where, HermSetup->procs[vANSICode]);}//-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-void BufferANSI(StringPtr TheANSI, Boolean bCrBefore, UserXIPtr HermSetup){  Str255 Temp_Str255_1;  BufferIt(PStr_Concat(Temp_Str255_1, "\p\033", "\p[", TheANSI),            bCrBefore, 0, HermSetup->procs[vBufferIt]);}//-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-char GetTerrChar(short TheByte){  char value_GetTerrChar;  switch (TheByte) {     case Nothing:      value_GetTerrChar = NoneChar;      break;        case FlatPlainGr:      value_GetTerrChar = PlainsGreenChar;      break;        case FlatPlainBr:      value_GetTerrChar = PlainsBrownChar;      break;        case Water:      value_GetTerrChar = WaterChar;      break;        case Bridge:      value_GetTerrChar = BridgeChar;      break;        case Boulder:      value_GetTerrChar = BoulderChar;      break;        case Forest:      value_GetTerrChar = ForestLightChar;      break;        case DeepForest:      value_GetTerrChar = ForestDeepChar;      break;        case Swamp:      value_GetTerrChar = SwampLightChar;      break;        case DeepSwamp:      value_GetTerrChar = SwampDeepChar;      break;        default:      value_GetTerrChar = VoidChar;      break;  }  return value_GetTerrChar;}//-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-void DrawPoint(short R, short C, TerrainType TheTerrain, UserXIPtr HermSetup){  Str255 GetTerrChar;  Str255 Temp_Str255_1;  switch (TheTerrain[R - 1][2*C - 1]) {     case 0:      PStr_Set(GetTerrChar, PStr_Concat(Temp_Str255_1, "\p0;37;40m",                                         "\p "));      break;    case 1:      PStr_Set(GetTerrChar, PStr_Concat(Temp_Str255_1, "\p0;32;40m",                                         "\p°"));      break;    case 2:      PStr_Set(GetTerrChar, PStr_Concat(Temp_Str255_1, "\p0;33;40m",                                         "\p°"));      break;    case 3:      PStr_Set(GetTerrChar, PStr_Concat(Temp_Str255_1, "\p0;34;40m",                                         "\p÷"));      break;    case 4:      PStr_Set(GetTerrChar, PStr_Concat(Temp_Str255_1, "\p0;34;43m",                                         "\pð"));      break;    case 5:      PStr_Set(GetTerrChar, PStr_Concat(Temp_Str255_1, "\p1;30;40m",                                         "\pí"));      break;    case 6:      PStr_Set(GetTerrChar, PStr_Concat(Temp_Str255_1, "\p1;32;40m",                                         "\p\006"));      break;    case 7:      PStr_Set(GetTerrChar, PStr_Concat(Temp_Str255_1, "\p0;32;40m",                                         "\p\006"));      break;    case 8:      PStr_Set(GetTerrChar, PStr_Concat(Temp_Str255_1, "\p1;30;47m",                                         "\p±"));      break;    case 9:      PStr_Set(GetTerrChar, PStr_Concat(Temp_Str255_1, "\p1;30;40m",                                         "\p²"));      break;    default:      PStr_Set(GetTerrChar, PStr_Concat(Temp_Str255_1, "\p1;31;40m",                                         "\p"));      break;  }  ANSICode(GetTerrChar, HermSetup->procs[vANSICode]);}//-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-void UpDateX(short R, short C, TerrainType TheTerrain, UserXIPtr HermSetup){  PosCursor(0, 58, HermSetup);  DrawPoint(R, C, TheTerrain, HermSetup);}//-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-void UpDateTT(Byte TheByte, UserXIPtr HermSetup){  unsigned char GetTerrChar [256];  Str255 Temp_Str255_1;  PosCursor(-1, 58, HermSetup);  switch (TheByte) {     case 0:      PStr_Set(GetTerrChar, PStr_Concat(Temp_Str255_1, "\p0;37;40m",                                         "\p "));      break;    case 1:      PStr_Set(GetTerrChar, PStr_Concat(Temp_Str255_1, "\p0;32;40m",                                         "\p°"));      break;    case 2:      PStr_Set(GetTerrChar, PStr_Concat(Temp_Str255_1, "\p0;33;40m",                                         "\p°"));      break;    case 3:      PStr_Set(GetTerrChar, PStr_Concat(Temp_Str255_1, "\p0;34;40m",                                         "\p÷"));      break;    case 4:      PStr_Set(GetTerrChar, PStr_Concat(Temp_Str255_1, "\p0;34;43m",                                         "\pð"));      break;    case 5:      PStr_Set(GetTerrChar, PStr_Concat(Temp_Str255_1, "\p1;30;40m",                                         "\pí"));      break;    case 6:      PStr_Set(GetTerrChar, PStr_Concat(Temp_Str255_1, "\p1;32;40m",                                         "\p\006"));      break;    case 7:      PStr_Set(GetTerrChar, PStr_Concat(Temp_Str255_1, "\p0;32;40m",                                         "\p\006"));      break;    case 8:      PStr_Set(GetTerrChar, PStr_Concat(Temp_Str255_1, "\p1;30;47m",                                         "\p±"));      break;    case 9:      PStr_Set(GetTerrChar, PStr_Concat(Temp_Str255_1, "\p1;30;40m",                                         "\p²"));      break;    default:      PStr_Set(GetTerrChar, PStr_Concat(Temp_Str255_1, "\p1;31;40m",                                         "\p"));      break;  }  ANSICode(GetTerrChar, HermSetup->procs[vANSICode]);}//-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-void UpDateTOn(Boolean On, UserXIPtr HermSetup){  if (On) {    PosCursor(-1, 60, HermSetup);    ANSICode("\p1;37;41m-ON!-", HermSetup->procs[vANSICode]);  } else {    PosCursor(-1, 60, HermSetup);    ANSICode("\p0;37;44m<Off>", HermSetup->procs[vANSICode]);  }}//-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-void UpDateFileName(StringPtr fileName, UserXIPtr HermSetup){  Str255 st1;    PosCursor(2, 58, HermSetup);  PStr_Concat(st1, "\p1;37;41m", fileName);  ANSICode(st1, HermSetup->procs[vANSICode]);}//-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-void DrawCombatField(TerrainType TheTerrain, UserXIPtr HermSetup){  short Current;  short Last;  short R;  short C;  Str255 st1;  Str255 TheLine;  Str255 Temp_Str255_1;  Str255 Temp_Str255_2;  for (R = 1; R <= 12; ++R) {    Current = -1;    Last = -1;    PStr_Set(TheLine, "\p");    NumToString(R + 3, st1);    BufferANSI(PStr_Concat(Temp_Str255_1, st1, "\p;6H"), false,                HermSetup);    for (C = 1; C <= 48; ++C) {      Last = Current;      Current = TheTerrain[R - 1][2*C - 1];      if (Last != Current) {                if (PStr_Cmp(TheLine, "\p") != 0)           BufferANSI(TheLine, false, HermSetup);        //Buffer the ANSI if the Color Changes 'cause theline w/ ansi codes exceeds 255 chars                switch (TheTerrain[R - 1][2*C - 1]) {           case 0:            PStr_Set(TheLine, "\p0;37;40m");            break;          case 1:            PStr_Set(TheLine, "\p0;32;40m");            break;          case 2:            PStr_Set(TheLine, "\p0;33;40m");            break;          case 3:            PStr_Set(TheLine, "\p0;34;40m");            break;          case 4:            PStr_Set(TheLine, "\p0;34;43m");            break;          case 5:            PStr_Set(TheLine, "\p1;30;40m");            break;          case 6:            PStr_Set(TheLine, "\p1;32;40m");            break;          case 7:            PStr_Set(TheLine, "\p0;32;40m");            break;          case 8:            PStr_Set(TheLine, "\p1;30;47m");            break;          case 9:            PStr_Set(TheLine, "\p1;30;40m");            break;        } // Case       } // If       PStr_Set(TheLine, PStr_Concat(Temp_Str255_1, TheLine, PStr_FromChar(Temp_Str255_2, GetTerrChar(TheTerrain[R - 1][2*C - 1]))));    } // for c     BufferANSI(TheLine, false, HermSetup);        //Buffer ANSI at the End of the Line  } // for r   ReleaseBuffer(HermSetup->procs[vReleaseBuffer]);} // procedure //-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-void DisplayMap(TerrainType TheTerrain, UserXIPtr HermSetup){  ANSICode("\p2J", HermSetup->procs[vANSICode]);  ANSICode("\pH", HermSetup->procs[vANSICode]);  Outln("\pC  >³123456789012345678901234567890123456789012345678³  T.T. =",         true, 0, HermSetup->procs[vOutln]);  Outln("\p    ÃÁÁÁÁÅÁÁÁÁÅÁÁÁÁÅÁÁÁÁÅÁÁÁÁÅÁÁÁÁÅÁÁÁÁÅÁÁÁÁÅÁÁÁÁÅÁÁÁ´     ú =",         true, 0, HermSetup->procs[vOutln]);  Outln("\pR 1>³                                                ³",         true, 0, HermSetup->procs[vOutln]);  Outln("\pR 2>³                                                ³",         true, 0, HermSetup->procs[vOutln]);  Outln("\pR 3>³                                                ³",         true, 0, HermSetup->procs[vOutln]);  Outln("\pR 4>³                                                ³",         true, 0, HermSetup->procs[vOutln]);  Outln("\pR 5>³                                                ³",         true, 0, HermSetup->procs[vOutln]);  Outln("\pR 6>³                                                ³",         true, 0, HermSetup->procs[vOutln]);  Outln("\pR 7>³                                                ³",         true, 0, HermSetup->procs[vOutln]);  Outln("\pR 8>³                                                ³",         true, 0, HermSetup->procs[vOutln]);  Outln("\pR 9>³                                                ³",         true, 0, HermSetup->procs[vOutln]);  Outln("\pR10>³                                                ³",         true, 0, HermSetup->procs[vOutln]);  Outln("\pR11>³                                                ³",         true, 0, HermSetup->procs[vOutln]);  Outln("\pR12>³                                                ³",         true, 0, HermSetup->procs[vOutln]);  Outln("\p    ÀÂÂÂÂÅÂÂÂÂÅÂÂÂÂÅÂÂÂÂÅÂÂÂÂÅÂÂÂÂÅÂÂÂÂÅÂÂÂÂÅÂÂÂÂÅÂÂÂÙ",         true, 0, HermSetup->procs[vOutln]);  Outln("\pI,J,K,L-Move Cursor, R-Retrieve, S-Save, T-Trace, C-ClearMemory, Q-Quit",         true, 1, HermSetup->procs[vOutln]);  Outln("\p 0-Nothing, 1-Plains,   2-Road/Trail, 3-Water,    4-Bridge",         true, 3, HermSetup->procs[vOutln]);  Outln("\p 5-Boulder, 6-Lt.Forest 7-Drk.Forest, 8-Lt.Swamp, 9-Drk.Swamp",         true, 3, HermSetup->procs[vOutln]);  DrawCombatField(TheTerrain, HermSetup);  }//--=--=--=--=--=--=--=--=--=--=--=--=--void parseerr(OSErr err, UserXIPtr HermSetup     //check for an error              ){  Str255 st1;  Str255 st2;  Str255 Temp_Str255_1;  if (err != noErr) {    NumToString(err, st1);    NumToString(privs->stage, st2);    Outln(PStr_Concat(Temp_Str255_1, "\pError #", st1, "\p in stage #",                       st2), true, 6, HermSetup->procs[vOutln]);  }}//--=--=--=--=--=--=--=--=--=--=--=--=--void FOpen(StringPtr FileName, PtrToWord fRefNum, UserXIPtr HermSetup){  OSErr err;  err = FSOpen(FileName, 0, fRefNum);  parseerr(err, HermSetup);}//--=--=--=--=--=--=--=--=--=--=--=--=--void myFClose(PtrToWord fRefNum, UserXIPtr HermSetup){  OSErr err;  err = FSClose(*fRefNum);  parseerr(err, HermSetup);}//--=--=--=--=--=--=--=--=--=--=--=--=--void FCreate(StringPtr FileName, UserXIPtr HermSetup){  OSErr err;  err = Create(FileName, 0, 'HRMS', 'DATA');  parseerr(err, HermSetup);}//--=--=--=--=--=--=--=--=--=--=--=--=--void FReadTerrain(TTerrainFile *terrainFile, TerrainType TheTerr){  terrainFile->Get(TheTerr);}//--=--=--=--=--=--=--=--=--=--=--=--=--void FWriteTerrain(TTerrainFile *terrainFile, TerrainType TheTerr){  terrainFile->Set(TheTerr);}//--=--=--=--=--=--=--=--=--=--=--=--=--void DoExitExternal(UserXIPtr){/*  switch (privs->WhereFrom) {     case 1:      privs->activeOn = false;      privs->stage = 0;      HermSetup->n[*HermSetup->curNode - 1]->activeUserExternal = -1;      GoHome(HermSetup->procs[vGoHome]);      break;    case 2:      privs->activeOn = false;      privs->stage = 0;      HermSetup->n[*HermSetup->curNode - 1]->activeUserExternal = -1;      HermSetup->n[*HermSetup->curNode - 1]->LogonStage = Trans1;      HermSetup->n[*HermSetup->curNode - 1]->boardAction = None;      HermSetup->n[*HermSetup->curNode - 1]->BoardSection = Logon;      HermSetup->n[*HermSetup->curNode - 1]->crossint9 = HermSetup->extID + 1;      break;    default:      privs->activeOn = false;      privs->stage = 0;      HermSetup->n[*HermSetup->curNode - 1]->activeUserExternal = -1;      break;  } //case    if (privs != NULL) {    DisposeHandle(Handle(privs));    privs = NULL;  }*/}//--=--=--=--=--=--=--=--=--=--=--=--=--