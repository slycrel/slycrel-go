#include <stddef.h>#include <types.h>#include "Builtins.h"#include "PStrings.h"#include "UTerrain.h"#include "TerrainFunctions.h"TTerrainPrivates *gTerrainPrivates;void HandleDoInitialize(void){  TTerrainExternal *slyExternal;  try {    slyExternal = new TTerrainExternal("\pSlyTerrain");    FailNIL(slyExternal);    gExternal = slyExternal;    gHermSetup->prefs = Handle(gExternal);  } catch (...) {    G_Outln("\pError: Unable to initialize ", false, 5);    G_Outln("\pSlyTerrain", true, 5);    gExternal = NULL;    gHermSetup->prefs = Handle(NULL);  }}TTerrainPrivates::TTerrainPrivates(void)  : TPrivates(){  gTerrainPrivates = this;    gUtilPrivates->stage = 0;      for (short x = 1; x <= 12; ++x)     for (short y = 1; y <= 48; ++y)       Terrain[x-1][2*y - 1] = 0;  R = 1;  C = 1;  Trace = false;  }TTerrainPrivates::~TTerrainPrivates(void){  gTerrainPrivates = NULL;}TTerrainExternal::TTerrainExternal(StringPtr inName)  : TExternal(inName){}TTerrainExternal::~TTerrainExternal(void){}void TTerrainExternal::AllocatePreferences(void){}void TTerrainExternal::AllocatePrivates(void){  TTerrainPrivates *terrainPrivates;  try {    gUtilPrivates = NULL;    gTerrainPrivates = NULL;        terrainPrivates = new TTerrainPrivates;    FailNIL(terrainPrivates);    gHermSetup->privates = Handle(terrainPrivates);  } catch (...) {    if (gUtilPrivates != NULL)       delete gUtilPrivates;    gUtilPrivates = NULL;    gTerrainPrivates = NULL;    ReportFatalError("\pUnable to allocate enough memory.");  }}void TTerrainExternal::DeletePreferences(void){}void TTerrainExternal::DeletePrivates(void){  if (gUtilPrivates != NULL)     delete gUtilPrivates;}void TTerrainExternal::HandleDoMaintenance(void){}void TTerrainExternal::HandleCallLogon(void){}void TTerrainExternal::HandleCallMenu(void){}void TTerrainExternal::HandleActiveExternal(void){  short x;  short y;    switch (gUtilPrivates->stage) {     case 0:      DisplayMap(gTerrainPrivates->Terrain, gHermSetup);      PosCursor(gTerrainPrivates->R, gTerrainPrivates->C, gHermSetup);      OutChr('ú', gHermSetup->procs[vOutChr]);      UpDateX(gTerrainPrivates->R, gTerrainPrivates->C, gTerrainPrivates->Terrain,               gHermSetup);      UpDateTT(gTerrainPrivates->TraceType, gHermSetup);      UpDateTOn(gTerrainPrivates->Trace, gHermSetup);      UpDateFileName(gTerrainPrivates->fileName, gHermSetup);            SetNextState(2);      break;        case 2:      PStr_Set(gHermSetup->n[*gHermSetup->curNode - 1]->curPrompt, "\p");      ANSICode("\p21;1H", gHermSetup->procs[vANSICode]);      NumbersPrompt("\p>", "\pIJKLRSTCQ?0123456789", 9, 0, gHermSetup->procs[vNumbersPrompt]);      SetNextState(3);      break;        case 3:      switch (gHermSetup->n[*gHermSetup->curNode - 1]->curPrompt[1]) {         case 'I':          PosCursor(gTerrainPrivates->R, gTerrainPrivates->C, gHermSetup);          DrawPoint(gTerrainPrivates->R, gTerrainPrivates->C, gTerrainPrivates->Terrain,                     gHermSetup);                    gTerrainPrivates->R = gTerrainPrivates->R - 1;          if (gTerrainPrivates->R <= 1)             gTerrainPrivates->R = 1;                    PosCursor(gTerrainPrivates->R, gTerrainPrivates->C, gHermSetup);          OutChr('ú', gHermSetup->procs[vOutChr]);          UpDateX(gTerrainPrivates->R, gTerrainPrivates->C, gTerrainPrivates->Terrain,                   gHermSetup);                    if (gTerrainPrivates->Trace) {            gTerrainPrivates->dirty = true;            gTerrainPrivates->Terrain[gTerrainPrivates->R - 1][2*gTerrainPrivates->C - 1] = gTerrainPrivates->TraceType;          }          SetNextState(2);          break;        case 'J':          PosCursor(gTerrainPrivates->R, gTerrainPrivates->C, gHermSetup);          DrawPoint(gTerrainPrivates->R, gTerrainPrivates->C, gTerrainPrivates->Terrain,                     gHermSetup);                    gTerrainPrivates->C = gTerrainPrivates->C - 1;          if (gTerrainPrivates->C <= 1)             gTerrainPrivates->C = 1;                    PosCursor(gTerrainPrivates->R, gTerrainPrivates->C, gHermSetup);          OutChr('ú', gHermSetup->procs[vOutChr]);          UpDateX(gTerrainPrivates->R, gTerrainPrivates->C, gTerrainPrivates->Terrain,                   gHermSetup);                    if (gTerrainPrivates->Trace) {            gTerrainPrivates->dirty = true;            gTerrainPrivates->Terrain[gTerrainPrivates->R - 1][2*gTerrainPrivates->C - 1] = gTerrainPrivates->TraceType;          }          SetNextState(2);          break;        case 'K':          PosCursor(gTerrainPrivates->R, gTerrainPrivates->C, gHermSetup);          DrawPoint(gTerrainPrivates->R, gTerrainPrivates->C, gTerrainPrivates->Terrain,                     gHermSetup);                    gTerrainPrivates->R = gTerrainPrivates->R + 1;          if (gTerrainPrivates->R >= 12)             gTerrainPrivates->R = 12;                    PosCursor(gTerrainPrivates->R, gTerrainPrivates->C, gHermSetup);          OutChr('ú', gHermSetup->procs[vOutChr]);          UpDateX(gTerrainPrivates->R, gTerrainPrivates->C, gTerrainPrivates->Terrain,                   gHermSetup);                    if (gTerrainPrivates->Trace) {            gTerrainPrivates->dirty = true;            gTerrainPrivates->Terrain[gTerrainPrivates->R - 1][2*gTerrainPrivates->C - 1] = gTerrainPrivates->TraceType;          }          SetNextState(2);          break;        case 'L':          PosCursor(gTerrainPrivates->R, gTerrainPrivates->C, gHermSetup);          DrawPoint(gTerrainPrivates->R, gTerrainPrivates->C, gTerrainPrivates->Terrain,                     gHermSetup);                    gTerrainPrivates->C = gTerrainPrivates->C + 1;          if (gTerrainPrivates->C >= 48)             gTerrainPrivates->C = 48;                    PosCursor(gTerrainPrivates->R, gTerrainPrivates->C, gHermSetup);          OutChr('ú', gHermSetup->procs[vOutChr]);          UpDateX(gTerrainPrivates->R, gTerrainPrivates->C, gTerrainPrivates->Terrain,                   gHermSetup);                    if (gTerrainPrivates->Trace) {            gTerrainPrivates->dirty = true;            gTerrainPrivates->Terrain[gTerrainPrivates->R - 1][2*gTerrainPrivates->C - 1] = gTerrainPrivates->TraceType;          }          SetNextState(2);          break;        case '0':          if (gTerrainPrivates->Trace) {            gTerrainPrivates->TraceType = 0;            UpDateTT(gTerrainPrivates->TraceType, gHermSetup);          } else {            gTerrainPrivates->dirty = true;            gTerrainPrivates->Terrain[gTerrainPrivates->R - 1][2*gTerrainPrivates->C - 1] = 0;            UpDateX(gTerrainPrivates->R, gTerrainPrivates->C, gTerrainPrivates->Terrain,                     gHermSetup);          }          SetNextState(2);          break;        case '1':          if (gTerrainPrivates->Trace) {            gTerrainPrivates->TraceType = 1;            UpDateTT(gTerrainPrivates->TraceType, gHermSetup);          } else {            gTerrainPrivates->dirty = true;            gTerrainPrivates->Terrain[gTerrainPrivates->R - 1][2*gTerrainPrivates->C - 1] = 1;            UpDateX(gTerrainPrivates->R, gTerrainPrivates->C, gTerrainPrivates->Terrain,                     gHermSetup);          }          SetNextState(2);          break;        case '2':          if (gTerrainPrivates->Trace) {            gTerrainPrivates->TraceType = 2;            UpDateTT(gTerrainPrivates->TraceType, gHermSetup);          } else {            gTerrainPrivates->dirty = true;            gTerrainPrivates->Terrain[gTerrainPrivates->R - 1][2*gTerrainPrivates->C - 1] = 2;            UpDateX(gTerrainPrivates->R, gTerrainPrivates->C, gTerrainPrivates->Terrain,                     gHermSetup);          }          SetNextState(2);          break;        case '3':          if (gTerrainPrivates->Trace) {            gTerrainPrivates->TraceType = 3;            UpDateTT(gTerrainPrivates->TraceType, gHermSetup);          } else {            gTerrainPrivates->dirty = true;            gTerrainPrivates->Terrain[gTerrainPrivates->R - 1][2*gTerrainPrivates->C - 1] = 3;            UpDateX(gTerrainPrivates->R, gTerrainPrivates->C, gTerrainPrivates->Terrain,                     gHermSetup);          }          SetNextState(2);          break;        case '4':          if (gTerrainPrivates->Trace) {            gTerrainPrivates->TraceType = 4;            UpDateTT(gTerrainPrivates->TraceType, gHermSetup);          } else {            gTerrainPrivates->dirty = true;            gTerrainPrivates->Terrain[gTerrainPrivates->R - 1][2*gTerrainPrivates->C - 1] = 4;            UpDateX(gTerrainPrivates->R, gTerrainPrivates->C, gTerrainPrivates->Terrain,                     gHermSetup);          }          SetNextState(2);          break;        case '5':          if (gTerrainPrivates->Trace) {            gTerrainPrivates->TraceType = 5;            UpDateTT(gTerrainPrivates->TraceType, gHermSetup);          } else {            gTerrainPrivates->dirty = true;            gTerrainPrivates->Terrain[gTerrainPrivates->R - 1][2*gTerrainPrivates->C - 1] = 5;            UpDateX(gTerrainPrivates->R, gTerrainPrivates->C, gTerrainPrivates->Terrain,                     gHermSetup);          }          SetNextState(2);          break;        case '6':          if (gTerrainPrivates->Trace) {            gTerrainPrivates->TraceType = 6;            UpDateTT(gTerrainPrivates->TraceType, gHermSetup);          } else {            gTerrainPrivates->dirty = true;            gTerrainPrivates->Terrain[gTerrainPrivates->R - 1][2*gTerrainPrivates->C - 1] = 6;            UpDateX(gTerrainPrivates->R, gTerrainPrivates->C, gTerrainPrivates->Terrain,                     gHermSetup);          }          SetNextState(2);          break;        case '7':          if (gTerrainPrivates->Trace) {            gTerrainPrivates->TraceType = 7;            UpDateTT(gTerrainPrivates->TraceType, gHermSetup);          } else {            gTerrainPrivates->dirty = true;            gTerrainPrivates->Terrain[gTerrainPrivates->R - 1][2*gTerrainPrivates->C - 1] = 7;            UpDateX(gTerrainPrivates->R, gTerrainPrivates->C, gTerrainPrivates->Terrain,                     gHermSetup);          }          SetNextState(2);          break;        case '8':          if (gTerrainPrivates->Trace) {            gTerrainPrivates->TraceType = 8;            UpDateTT(gTerrainPrivates->TraceType, gHermSetup);          } else {            gTerrainPrivates->dirty = true;            gTerrainPrivates->Terrain[gTerrainPrivates->R - 1][2*gTerrainPrivates->C - 1] = 8;            UpDateX(gTerrainPrivates->R, gTerrainPrivates->C, gTerrainPrivates->Terrain,                     gHermSetup);          }          SetNextState(2);          break;        case '9':          if (gTerrainPrivates->Trace) {            gTerrainPrivates->TraceType = 9;            UpDateTT(gTerrainPrivates->TraceType, gHermSetup);          } else {            gTerrainPrivates->dirty = true;            gTerrainPrivates->Terrain[gTerrainPrivates->R - 1][2*gTerrainPrivates->C - 1] = 9;            UpDateX(gTerrainPrivates->R, gTerrainPrivates->C, gTerrainPrivates->Terrain,                     gHermSetup);          }          SetNextState(2);          break;        case 'C':          SetNextState(40);          break;        case 'R':          SetReturnState(1);          SetNextState(42);          break;        case 'S':          if (CheckRegistration(gHermSetup))             SetNextState(35);          else {            Outln("\pSorry, Cannot Save Map, Slycrel is not yet Registered!",                   true, 6, gHermSetup->procs[vOutln]);            SetNextState(2);          }          break;        case 'T':          SetNextState(10);          break;        case 'Q':          SetNextState(ShutDown);          break;        case '?':          SetNextState(0);          break;        default:          SetNextState(2);          break;      } //Prompt Case      break;        case 10:      if (gTerrainPrivates->Trace)         SetNextState(15);      else         SetNextState(20);      break;        case 15:      gTerrainPrivates->Trace = false;      UpDateTOn(false, gHermSetup);      SetNextState(2);      break;        case 20:      PStr_Set(gHermSetup->n[*gHermSetup->curNode - 1]->curPrompt, "\p");      ANSICode("\p22;1H", gHermSetup->procs[vANSICode]);      Outln("\pPlease Choose a Terrain Type to Trace(trail/follow) the Cursor.",             false, 3, gHermSetup->procs[vOutln]);      bCr(gHermSetup->procs[vbCr]);      NumbersPrompt("\p>", "\p0123456789", 9, 0, gHermSetup->procs[vNumbersPrompt]);      SetNextState(21);      break;        case 21:      switch (gHermSetup->n[*gHermSetup->curNode - 1]->curPrompt[1]) {         case '0':          gTerrainPrivates->Trace = true;          gTerrainPrivates->TraceType = 0;          UpDateTT(gTerrainPrivates->TraceType, gHermSetup);          UpDateTOn(true, gHermSetup);          SetNextState(2);          break;        case '1':          gTerrainPrivates->Trace = true;          gTerrainPrivates->TraceType = 1;          UpDateTT(gTerrainPrivates->TraceType, gHermSetup);          UpDateTOn(true, gHermSetup);          SetNextState(2);          break;        case '2':          gTerrainPrivates->Trace = true;          gTerrainPrivates->TraceType = 2;          UpDateTT(gTerrainPrivates->TraceType, gHermSetup);          UpDateTOn(true, gHermSetup);          SetNextState(2);          break;        case '3':          gTerrainPrivates->Trace = true;          gTerrainPrivates->TraceType = 3;          UpDateTT(gTerrainPrivates->TraceType, gHermSetup);          UpDateTOn(true, gHermSetup);          SetNextState(2);          break;        case '4':          gTerrainPrivates->Trace = true;          gTerrainPrivates->TraceType = 4;          UpDateTT(gTerrainPrivates->TraceType, gHermSetup);          UpDateTOn(true, gHermSetup);          SetNextState(2);          break;        case '5':          gTerrainPrivates->Trace = true;          gTerrainPrivates->TraceType = 5;          UpDateTT(gTerrainPrivates->TraceType, gHermSetup);          UpDateTOn(true, gHermSetup);          SetNextState(2);          break;        case '6':          gTerrainPrivates->Trace = true;          gTerrainPrivates->TraceType = 6;          UpDateTT(gTerrainPrivates->TraceType, gHermSetup);          UpDateTOn(true, gHermSetup);          SetNextState(2);          break;        case '7':          gTerrainPrivates->Trace = true;          gTerrainPrivates->TraceType = 7;          UpDateTT(gTerrainPrivates->TraceType, gHermSetup);          UpDateTOn(true, gHermSetup);          SetNextState(2);          break;        case '8':          gTerrainPrivates->Trace = true;          gTerrainPrivates->TraceType = 8;          UpDateTT(gTerrainPrivates->TraceType, gHermSetup);          UpDateTOn(true, gHermSetup);          SetNextState(2);          break;        case '9':          gTerrainPrivates->Trace = true;          gTerrainPrivates->TraceType = 9;          UpDateTT(gTerrainPrivates->TraceType, gHermSetup);          UpDateTOn(true, gHermSetup);          SetNextState(2);          break;                default:          gTerrainPrivates->Trace = false;          UpDateTT(gTerrainPrivates->TraceType, gHermSetup);          UpDateTOn(false, gHermSetup);          SetNextState(2);          break;      }      ANSICode("\p22;1H", gHermSetup->procs[vANSICode]);      Outln("\p                                                 ",             false, 0, gHermSetup->procs[vOutln]);      bCr(gHermSetup->procs[vbCr]);      Outln("\p   ", false, 0, gHermSetup->procs[vOutln]);      break;        case 1:      ANSICode("\p22;1H", gHermSetup->procs[vANSICode]);      Outln("\pEnter Terrain File To Edit.", true, 3, gHermSetup->procs[vOutln]);      Outln("\p 1 - Arena-1", true, 3, gHermSetup->procs[vOutln]);      Outln("\p 2 - Arena-2", true, 3, gHermSetup->procs[vOutln]);      Outln("\p 3 - Arena-3", true, 3, gHermSetup->procs[vOutln]);      Outln("\p 4 - Forest-1", true, 3, gHermSetup->procs[vOutln]);      Outln("\p 5 - Forest-2", true, 3, gHermSetup->procs[vOutln]);      Outln("\p 6 - Forest-3", true, 3, gHermSetup->procs[vOutln]);      Outln("\p 7 - Mountain-1", true, 3, gHermSetup->procs[vOutln]);      Outln("\p 8 - Mountain-2", true, 3, gHermSetup->procs[vOutln]);      Outln("\p 9 - Mountain-3", true, 3, gHermSetup->procs[vOutln]);      Outln("\p10 - Swamp-1", true, 3, gHermSetup->procs[vOutln]);      Outln("\p11 - Swamp-2", true, 3, gHermSetup->procs[vOutln]);      Outln("\p12 - Swamp-3", true, 3, gHermSetup->procs[vOutln]);      Outln("\p 0 - Quit", true, 3, gHermSetup->procs[vOutln]);      bCr(gHermSetup->procs[vbCr]);      G_NumbersPrompt("\pFile:", "\p", 12, 0);      SetNextState(31);      break;        case 31:      long menuNum;      gTerrainPrivates->dirty = false;      StringToNum(gHermSetup->n[*gHermSetup->curNode - 1]->curPrompt, &menuNum);      switch (menuNum) {        case 0:          SetNextState(ShutDown);          return;          break;        case 1:          PStr_Set(gTerrainPrivates->fileName, "\pArena-1");          break;        case 2:          PStr_Set(gTerrainPrivates->fileName, "\pArena-2");          break;        case 3:          PStr_Set(gTerrainPrivates->fileName, "\pArena-3");          break;        case 4:          PStr_Set(gTerrainPrivates->fileName, "\pForest-1");          break;        case 5:          PStr_Set(gTerrainPrivates->fileName, "\pForest-2");          break;        case 6:          PStr_Set(gTerrainPrivates->fileName, "\pForest-3");          break;        case 7:          PStr_Set(gTerrainPrivates->fileName, "\pMountain-1");          break;        case 8:          PStr_Set(gTerrainPrivates->fileName, "\pMountain-2");          break;        case 9:          PStr_Set(gTerrainPrivates->fileName, "\pMountain-3");          break;        case 10:          PStr_Set(gTerrainPrivates->fileName, "\pSwamp-1");          break;        case 11:          PStr_Set(gTerrainPrivates->fileName, "\pSwamp-2");          break;        case 12:          PStr_Set(gTerrainPrivates->fileName, "\pSwamp-3");          break;        default:          SetNextState(1);          return;          break;      }                {        TTerrainFile terrainFile(TerrainPath, gTerrainPrivates->fileName);        terrainFile.Get(gTerrainPrivates->Terrain);        terrainFile.Close();      }      SetNextState(0);      break;            case 35:      PStr_Set(gHermSetup->n[*gHermSetup->curNode - 1]->curPrompt, "\p");      ANSICode("\p22;1H", gHermSetup->procs[vANSICode]);      Outln("\pSave As...  [EnterFileName]", false, 3, gHermSetup->procs[vOutln]);      bCr(gHermSetup->procs[vbCr]);      LettersPrompt("\p>", "\p", 31, false, false, false, char(0),                     gHermSetup->procs[vLettersPrompt]);      ANSIPrompter(31, gHermSetup->procs[vANSIPrompter]);      SetNextState(36);      break;        case 36:      if (PStr_Cmp(gTerrainPrivates->fileName, "\p") != 0) {        TTerrainFile terrainFile(TerrainPath, gTerrainPrivates->fileName);        if (!terrainFile.Exists())           terrainFile.Create();        terrainFile.Set(gTerrainPrivates->Terrain);        terrainFile.Close();        gTerrainPrivates->dirty = false;      }      SetNextState(0);      break;        case 40:      PStr_Set(gHermSetup->n[*gHermSetup->curNode - 1]->curPrompt, "\p");      ANSICode("\p22;1H", gHermSetup->procs[vANSICode]);      YesNoQuestion("\pRe-Set Terrain? ", false, gHermSetup->procs[vYesNoQuestion]);      SetNextState(41);      break;        case 41:      if (PStr_Cmp(gHermSetup->n[*gHermSetup->curNode - 1]->curPrompt, "\pY") == 0) {        for (x = 1; x <= 12; ++x)           for (y = 1; y <= 48; ++y)             gTerrainPrivates->Terrain[x-1][2*y - 1] = 0;        gTerrainPrivates->R = 1;        gTerrainPrivates->C = 1;        gTerrainPrivates->Trace = false;      }      SetNextState(0);      break;        case 42:      if (gTerrainPrivates->dirty) {        ANSICode("\p22;1H", gHermSetup->procs[vANSICode]);        YesNoQuestion("\pSave Terrain? ", false, gHermSetup->procs[vYesNoQuestion]);        SetNextState(43);      }      else        PopReturnState();      break;        case 43:      if (PStr_Cmp(gHermSetup->n[*gHermSetup->curNode - 1]->curPrompt, "\pY") == 0) {        TTerrainFile terrainFile(TerrainPath, gTerrainPrivates->fileName);        if (!terrainFile.Exists())           terrainFile.Create();        terrainFile.Set(gTerrainPrivates->Terrain);        terrainFile.Close();      }      PopReturnState();      break;            case ShutDown:      SetReturnState(ShutDown2);      SetNextState(42);      break;          case ShutDown2:      Outln("\pNow Returning to the BBS", true, 5, gHermSetup->procs[vOutln]);      gHermSetup->n[*gHermSetup->curNode - 1]->activeUserExternal = -1;      break;            default:      ReportFatalError("\pError: reached unprogrammed stage");      break;  }}void TTerrainExternal::SetupGlobalVariables(void){  // first setup framework globals  TExternal::SetupGlobalVariables();    // then setup our own  gTerrainPrivates = (TTerrainPrivates *)gHermSetup->privates;}void TTerrainExternal::SaveGlobalVariables(void){  TExternal::SaveGlobalVariables();}