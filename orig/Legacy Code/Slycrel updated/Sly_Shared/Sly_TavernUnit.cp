#include "Builtins.h"#include "Sly_TavernUnit.h"//-***********-Utils-***********-//-------------------------------------------------void OrderDrink(short Long1){  short int1;  int1 = RandomBetween(0, 7);  switch (Long1) {     case 1:      G_Outln("\pLynx gives you a hard look and shifts his eyes slightly.",               true, int1);      G_Outln("\p\"Here.  But don\'t let anyone know I still have this stuff...",               true, int1);      (*gCharacter)->Flirt1 = (*gCharacter)->Flirt1 - 1;      if ((*gCharacter)->Flirt1 < 1)         (*gCharacter)->Flirt1 = 1;      break;    case 2:      if (!((*gCharacter)->CoinsHand < 1)) {        (*gCharacter)->CoinsHand = (*gCharacter)->CoinsHand - 1;        G_Outln("\pThe bartender supresses a smile as he hands you the drink.",                 true, int1);        //GetRandomEffect(light);      }      break;    case 3:      if (!((*gCharacter)->CoinsHand < 2)) {        (*gCharacter)->CoinsHand = (*gCharacter)->CoinsHand - 2;        G_Outln("\pLynx hands you an ale.  When you don\'t tip him, he gets an",                 true, int1);        G_Outln("\pangry look on his face, and stalks off.", true,                 1);      }      //Make sure you get people drunk here.  =)       break;    case 4:      if (!((*gCharacter)->CoinsHand < 2)) {        (*gCharacter)->CoinsHand = (*gCharacter)->CoinsHand - 2;        G_Outln("\pLynx hands you the drink.  You think he winks as you turn,",                 true, int1);        G_Outln("\pbut you can\'t be certain.", true, 7);        //Love potion?      }      break;    case 5:      if (!((*gCharacter)->CoinsHand < 3)) {        (*gCharacter)->CoinsHand = (*gCharacter)->CoinsHand - 3;        G_Outln("\pLynx stirs the cocktail slightly and hands it to you.",                 true, int1);        G_bCr();        G_bCr();        G_Outln("\pEWW!!!  He licked the spoon and stuck it in that guy\'s drink!",                 true, int1);      }      // GetRandomEffect(light)      break;    case 6:      if (!((*gCharacter)->CoinsHand < 3)) {        (*gCharacter)->CoinsHand = (*gCharacter)->CoinsHand - 3;        G_Outln("\pMmmm!  Delicious.  (You hope no faeries were still in it...)",                 true, int1);        //GetRandomEffect(medium);      }      break;    case 7:      if (!((*gCharacter)->CoinsHand < 4)) {        (*gCharacter)->CoinsHand = (*gCharacter)->CoinsHand - 4;        G_Outln("\pThe Bartender hands you the wine, and tells you:",                 true, int1);        G_Outln("\p\"That woman over in the corner...  I think she likes you!\"",                 true, RandomBetween(0, 7));        //GetRandomEffect(medium);      }      break;    case 8:      if (!((*gCharacter)->CoinsHand < 4)) {        (*gCharacter)->CoinsHand = (*gCharacter)->CoinsHand - 4;        G_Outln("\pLynx pours whiskey into a small glass.  He licks the rim of",                 true, int1);        G_Outln("\pthe bottle as he walks off.", true, int1);        //GetRandomEffect(Medium)      }      break;    case 9:      if (!((*gCharacter)->CoinsHand < 5)) {        (*gCharacter)->CoinsHand = (*gCharacter)->CoinsHand - 5;        G_Outln("\pThe bartender tells you this stuff\'s expensive, and how hard it\'s",                 true, int1);        G_Outln("\pgoing to be to replace.", true, int1);        G_bCr();        G_bCr();        G_Outln("\pYou just shrug, and gleefully chug down your drink.",                 true, RandomBetween(0, 7));        //GetRandomEffect(medium)      }      break;    case 10:      if (!((*gCharacter)->CoinsHand < 5)) {        (*gCharacter)->CoinsHand = (*gCharacter)->CoinsHand - 5;        G_Outln("\pYou shudder as the life essence of the poor, innocent,",                 true, int1);        G_Outln("\punsuspecting little dwarf rolls down your throat.",                 true, int1);        //GetMagicEffect(medium);      }      break;    case 11:      if (!((*gCharacter)->CoinsHand < 6)) {        (*gCharacter)->CoinsHand = (*gCharacter)->CoinsHand - 6;        G_Outln("\pThe bartender steps into the back for a moment.  When he",                 true, int1);        G_Outln("\preturns, he is carrying a slightly thicker mug with a lid.",                 true, int1);        G_Outln("\p\"I ain\'t responsible \", he tells you as he hands it over. ",                 true, int1);        G_bCr();        G_bCr();        G_Outln("\pThe drink oozes down your throat, nearly suffocating you",                 true, RandomBetween(0, 7));        //GetRandomEffect(Heavy);      }      break;    case 12:      if (!((*gCharacter)->CoinsHand < 7)) {        (*gCharacter)->CoinsHand = (*gCharacter)->CoinsHand - 7;        G_Outln("\pThe barkeep reaches under the counter, and pulls out a large, black",                 true, int1);        G_Outln("\pjug.  He pours you a tiny glass.", true, int1);        G_bCr();        G_bCr();        G_Outln("\pThe drink burns as it goes down.", true, RandomBetween(0,                                                                 7));        //GetRandomEffect(Heavy);      }      break;    case 13:      if (!((*gCharacter)->CoinsHand < 9)) {        (*gCharacter)->CoinsHand = (*gCharacter)->CoinsHand - 9;        G_Outln("\pThe bartender hands you a steaming glass of amber liquid.",                 true, int1);        G_bCr();        G_bCr();        G_Outln("\pThe drink runs smoothly down your throat.", true,                 int1);        G_Outln("\pYou suddenly feel the need to use the restroom.",                 true, RandomBetween(0, 7));        //GetRandomEffect(Heavy);      }      break;    case 14:      if (!((*gCharacter)->CoinsHand < 10)) {        (*gCharacter)->CoinsHand = (*gCharacter)->CoinsHand - 10;        G_Outln("\pThe bartender laughs, and says, \"You HONESTLY thought that",                 true, int1);        G_Outln("\pI\'d even let Josepi IN here??\"  He throws back his head and laughs.",                 true, int1);        G_bCr();        G_bCr();        G_Outln("\pwell, you DID ask...  (And pay, too!)", true, RandomBetween(0,                                                                      7));        //GetRandomEffect(heavy)      }      break;    case 15:      if (!((*gCharacter)->CoinsHand < 10)) {        (*gCharacter)->CoinsHand = (*gCharacter)->CoinsHand - 10;        G_Outln("\pLynx shrugs as if to say \"hey, it\'s not my life\" and",                 true, int1);        G_Outln("\phands it to you.", true, int1);        G_bCr();        G_bCr();        G_Outln("\pYou suddenly feel as if the world turns upside down.",                 true, RandomBetween(0, 7));        G_Outln("\pYou sway and pass out...", true, RandomBetween(0, 7));        G_bCr();        G_Outln("\pYou\'d better check your stats bud!!!", true, RandomBetween(0,                                                                      7));        //GetMagicEffect(Heavy)      }      break;    case 16:      SetReturnState(stShouldWeQuit);      G_Outln("\pYou just can\'t follow directions, can you?  I said 1 to 15, NOT 16...",               true, 6);      G_Outln("\pBut that\'s okay.  I won\'t mind killing you.", true,               2);      G_bCr();      G_bCr();      G_Outln("\p                   <ZZZZZZZZZZZZZZZT!!!>", true,               4);      (*gCharacter)->Alive = false;      break;  }}//-------------------------------------------------void FlirtEffects(short FlirtNum){  if (RandomBetween(1, 100) < 18 + (*gCharacter)->Flirt1) {    G_Outln("\pCorenne smiles at you as she serves you...", true,             5);    G_bCr();    G_Outln("\pSuccess!", true, 5);    (*gCharacter)->Flirt1 = (*gCharacter)->Flirt1 + 1;  } else {    switch (FlirtNum) {       case 1:        G_Outln("\pCorenne doesn\'t seem to see you, but Grego perks right up",                 true, 2);        G_Outln("\pand runs over, eagerly awaiting your order...",                 true, 2);        break;      case 2:        G_Outln("\pYou take her hand as she turns away, but just as you lift it to your",                 true, 2);        G_Outln("\plips, she jerks free, quickly walking to a much better looking customer.",                 true, 2);        break;      case 3:        G_Outln("\pYou bravely announce that Corenne has the best looking elbows that",                 true, 2);        G_Outln("\pyou have ever seen.  She goes red all over and you congratulate",                 true, 2);        G_Outln("\pyourself.  You do wonder, however, why Lynx and the other bar",                 true, 2);        G_Outln("\ppatrons are laughing at you...", true, 2);        (*gCharacter)->Honor = (*gCharacter)->Honor - 1;        break;      case 4:        G_Outln("\pYou stand, gathering everyones attention with a manly <ahem>.",                 true, 2);        G_Outln("\pSomeone in the back snickers as the bar goes silent.  You start",                 true, 2);        G_Outln("\prambling off miscellaneous heroic deeds that you have done.  After",                 true, 2);        G_Outln("\pless than a minute, you feel slightly sick.  You wonder at fate,",                 true, 2);        G_Outln("\pand all it\'s quirks as you spill your lunch on the floor...",                 true, 2);        (*gCharacter)->Honor = (*gCharacter)->Honor - 1;        break;      case 5:        G_Outln("\pYou very obviously wink seductively at Corenne several times.",                 true, 2);        G_Outln("\pShe hurries over to you and asks if your eye is okay.  You",                 true, 2);        G_Outln("\pnearly choke as you mumble you\'re fine...", true,                 2);        break;      case 6:        G_Outln("\pYou compliment Corenne\'s attributes and how bouncy they are.",                 true, 2);        G_Outln("\pYou suddenly find yourself staring at the ceiling with a",                 true, 2);        G_Outln("\psplit lip.", true, 2);        (*gCharacter)->HitPoints = (*gCharacter)->HitPoints - RandomBetween(1,                                                                   ((*gCharacter)->HitPoints) / 4);        break;      case 7:        G_Outln("\pAs Corenne walks by, you ask her to dance.  She stares at you",                 true, 2);        G_Outln("\pfor a moment, and reminds you that there is no music playing.",                 true, 2);        G_Outln("\pGrego quickly snakes in, and informs you he will dance.",                 true, 2);        G_bCr();        G_Outln("\pYou shudder at the thought...", true, 3);        break;      case 8:        G_Outln("\pYou ask Corenne if she would like to sit a while and share a meal.",                 true, 2);        G_Outln("\pShe replies that she is on a diet, and that she needs to keep",                 true, 2);        G_Outln("\pher figure for the MEN...", true, 2);        G_bCr();        G_Outln("\pYour pride is hurt....", true, 3);        (*gCharacter)->Honor = (*gCharacter)->Honor - 1;        break;    } //Case    (*gCharacter)->Flirt1 = (*gCharacter)->Flirt1 - 2;    if ((*gCharacter)->Flirt1 <= 0)       (*gCharacter)->Flirt1 = 1;  }}//-------------------------------------------------//-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-