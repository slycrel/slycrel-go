#include "Builtins.h"#include "PStrings.h"#include "Sly_ArenaUnit.h"//-------------------------------------------------Boolean User2Monster(StringPtr Name, MonsterRec *Monster){  CharacterRec TheUser;  Boolean value_User2Monster;  ReadSlyChar(Name, &TheUser);//  boo1 = FindUser(Name, &UserGlobPtr()->tempUser, gHermSetup->procs[vFindUser]);//  causes a type 2 error for 68000 machines//  PStr_Set(Monster->name, TheUser.name);  Monster->Level = (TheUser.ThiefLvl + TheUser.MageLvl + TheUser.FighterLvl) / 3;//  Monster->MonsterNum = UserGlobPtr()->tempUser.userNum;//  ----see comment above//  ----replacement:  Monster->MonsterNum = RandomBetween(1, 300);  Monster->HitPoints = TheUser.HitPoints;  Monster->Offense = TheUser.Strength / 2 + TheUser.Weapons[0].Strike;  Monster->RangeOffense = TheUser.Strength / 2 + TheUser.Weapons[1].Strike;  Monster->Range = TheUser.Weapons[1].Range;  Monster->Defense = (TheUser.Dexterity + TheUser.Speed) / 3 + (TheUser.Armor[0].Defense + TheUser.Armor[1].Defense) / 2;  Monster->Movement = RandomBetween(TheUser.Speed - TheUser.Speed / 5, TheUser.Speed + TheUser.Speed / 5);  Monster->Disposition = 1;  Monster->Experience = TheUser.TotalExperience / 10;  PStr_Set(Monster->AttackStr1, TheUser.Weapons[0].name);  PStr_Set(Monster->AttackStr2, TheUser.Weapons[1].name);  PStr_Set(Monster->DefenseStr, TheUser.Weapons[1].name);  Monster->MonType = Humanoid;  Monster->Coins = TheUser.CoinsHand / 1.5;  value_User2Monster = TheUser.Alive;  return value_User2Monster;}//-------------------------------------------------void KillFoe(MonsterRec *DeadMonster){  CharacterRec DeadUser;  Str255 Temp_Str255_1;    ReadSlyChar(DeadMonster->name, &DeadUser);    DeadUser.CoinsHand = DeadUser.CoinsHand - DeadMonster->Coins;  //!!!!!--- This Can cause problems, because it will resurct the user  //Causing Them to loose Experience & coins as if they have died (killed themselves)  DeadUser.Alive = false;  DeadUser.HitPoints = DeadMonster->HitPoints;  DeadUser.TotalExperience = DeadUser.TotalExperience - 20;  DeadUser.SpendingExperience = DeadUser.SpendingExperience - 20;  //Should we add 1 to the Foe's # of Fights?    WriteNewsToPlayer(PStr_Concat(Temp_Str255_1, "\pYou have been slaughtered by ",                                 (*gCharacter)->name, "\p!"), &DeadUser,                    false);  SaveChar(&DeadUser);  //Add 'Killer' Killed 'DeadMonster' to the News or whatever}//-------------------------------------------------void KillUserArena(CharacterPtr DeadUser, MonsterRec *WinningFoe){  short int1;  CharacterRec WinningUser;  Str255 Temp_Str255_1;    ReadSlyChar(WinningFoe->name, &WinningUser);  int1 = RandomBetween(1, Round(((*gCharacter)->CoinsHand) / 1.5) + 1);  WinningUser.CoinsHand = WinningUser.CoinsHand + int1;  DeadUser->CoinsHand = DeadUser->CoinsHand - int1;  WinningUser.TotalExperience = WinningUser.TotalExperience + Round((DeadUser->TotalExperience) * 0.3);  WinningUser.SpendingExperience = WinningUser.SpendingExperience + Round((DeadUser->TotalExperience) * 0.3);  WinningUser.FightsWon = WinningUser.FightsWon + 1;  WinningUser.TotalFights = WinningUser.TotalFights + 1;  DeadUser->Alive = false;  DeadUser->TotalExperience = DeadUser->TotalExperience + 20;  DeadUser->TotalFights = DeadUser->TotalFights + 1;    G_Outln("\pYou\'re outta life buddy...", true, 6);  WriteNewsToPlayer(PStr_Concat(Temp_Str255_1, "\pYou have slaughtered ",                                 DeadUser->name, "\p!"), &WinningUser,                    false);  SaveChar(&WinningUser);  SaveChar(DeadUser);  //Add 'Killer' Killed 'DeadFoe' to the News or whatever}//-------------------------------------------------void SetUpGCombat(CharacterPtr TheChar, StringPtr Opponent){  GCombatPrefs combPrefs;  CharacterRec TheOpponent;  short int1;  short int2;  double ratio;  Str255 Temp_Str255_1;  ReadSlyChar(Opponent, &TheOpponent);  int1 = Arena_Appraisal(&TheOpponent);  int2 = Arena_Appraisal(TheChar);  if (int2 != 0)  	ratio = int1 / int2;  else  	ratio = 0;  if (ratio < 1 && ratio > 0) {    ratio = int2 / int1;    combPrefs.Odds[1] = Round(ratio);    combPrefs.Odds[0] = 1;  } else {    combPrefs.Odds[0] = Round(ratio);    combPrefs.Odds[1] = 1;  }                                               //else  PStr_Set(combPrefs.Challenger, TheChar->name);  PStr_Set(combPrefs.Opponent, TheOpponent.name);    if (!gGCombatFile->Exists())     gGCombatFile->Create();  gGCombatFile->Add(combPrefs);  gGCombatFile->Close();    G_Outln(PStr_Concat(Temp_Str255_1, "\pYou have entered into the Gladiator competition against ",                       TheOpponent.name, "\p(", TheOpponent.bbsName, "\p)!"), true, 1);  G_bCr();}//-------------------------------------------------void DisplayGCombat(PtrToWord Number){  GCombatPrefs combPrefs;  Str255 st1;  Str255 st2;  Str255 Temp_Str255_1;  short combNum;    for (combNum = 0; combNum < gGCombatFile->NumItems(); combNum++) {    gGCombatFile->Get(combNum, combPrefs);    NumToString(combNum + 1, st1);    G_Outln(st1, true, 1);    NumToString(combPrefs.Odds[0], st1);    NumToString(combPrefs.Odds[1], st2);    G_Outln(PStr_Concat(Temp_Str255_1, "\p    Challenger: ", combPrefs.Challenger), false, 1);    G_Outln(PStr_Concat(Temp_Str255_1, "\p     Opponent: ", combPrefs.Opponent), true, 1);    G_Outln(PStr_Concat(Temp_Str255_1, "\pOdds (C:P) : ", st1, "\p:", st2), true, 1);    G_bCr();  }  *Number = combNum;  gGCombatFile->Close();}//-------------------------------------------------void GetFightInfo(GCombatPrefs *combPrefs, long Number){  gGCombatFile->Get(Number - 1, *combPrefs);  gGCombatFile->Close();}//-------------------------------------------------void AddGambler(StringPtr UserFileName, Boolean ForOrAgainst, long Bet, short FightNum){  GCombatList List;  PStr_Set(List.FileName, UserFileName);  List.FightNum = FightNum;  List.Bet = Bet;  if (ForOrAgainst)     List.ForChallenger = true;  else     List.ForChallenger = false;  PStr_Set(List.Challenger, gSlyPrivates->GladiatorCombatPrefs.Challenger);  PStr_Set(List.Opponent, gSlyPrivates->GladiatorCombatPrefs.Opponent);  if (!gCombatListFile->Exists())     gCombatListFile->Create();  gCombatListFile->Add(List);  gCombatListFile->Close();}//-------------------------------------------------