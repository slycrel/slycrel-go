#include "Builtins.h"#include "PStrings.h"#include "PSets.h"#include "General_Unit.h"inline long abs(long a){	return (a >= 0) ? a : -a;}void ShowANSIMenu(StringPtr menuName, short returnState){  Boolean gotFile;  Str255 FileName;  Str255 Temp_Str255_1;  PStr_Set(FileName, PStr_Concat(Temp_Str255_1, ANSIPath, menuName));  gotFile = G_ReadTextFile(FileName, 0, true);  if (gotFile) {    SetReturnState(returnState);    SetNextState(stStartListTextFile);  } else {    G_Outln(PStr_Concat(Temp_Str255_1, "\pError in Reading \'", menuName,                         "\p\', please inform Sysop"), true,             6);    SetNextState(returnState);  }}void SuggestRegistration(void){  G_Outln("\pSlycrel is not Registered!", true, 6);  G_Outln("\pSlycrel only costs $20.00 (USA).", true, 6);  G_Outln("\pDonate to this BBS so the SysOp can register this game!",           true, 6);}void SpaceOut(StringPtr TheStr, short HowLong){  short x;  Str255 Temp_Str255_1;  for (x = PStr_Length(TheStr); x <= HowLong; ++x)     PStr_Set(TheStr, PStr_Concat(Temp_Str255_1, TheStr, "\p "));}//-------------------------------------------------void myPausePrompt(StringPtr OurPromptLine){  PStr_Set(UserGlobPtr()->myPrompt.promptLine, OurPromptLine);  PStr_Set(UserGlobPtr()->myPrompt.allowedChars, "\pabcdefghijklmnopqrstuvwxyz`1234567890-=[]\\;\',./ ");  UserGlobPtr()->myPrompt.replaceChar = char(32);  UserGlobPtr()->myPrompt.capitalize = false;  UserGlobPtr()->myPrompt.enforceNumeric = false;  UserGlobPtr()->myPrompt.autoAccept = true;  UserGlobPtr()->myPrompt.wrapAround = false;  UserGlobPtr()->myPrompt.wrapsonCR = true;  UserGlobPtr()->myPrompt.breakChar = char(0);  UserGlobPtr()->myPrompt.hermesColor = 3;  UserGlobPtr()->myPrompt.inputColor = 0;  UserGlobPtr()->myPrompt.numericLow = -1;  UserGlobPtr()->myPrompt.numericHigh = -1;  UserGlobPtr()->myPrompt.maxChars = 1;  PStr_Set(UserGlobPtr()->myPrompt.keyString1, "\p");  PStr_Set(UserGlobPtr()->myPrompt.keyString2, "\p");  PStr_Set(UserGlobPtr()->myPrompt.keyString3, "\p");  PromptUser(*gHermSetup->curNode, gHermSetup->procs[vPromptUser]);}//-------------------------------------------------Boolean OkPrompt(StringPtr Accepted){  Boolean found;  short y;  Boolean value_OkPrompt;  found = false;  y = PStr_Pos(UserGlobPtr()->curPrompt[1], Accepted);  if (y != 0)     found = true;  if (found)     value_OkPrompt = true;  else     value_OkPrompt = false;  return value_OkPrompt;}//-------------------------------------------------void ClrPrompt(void){  PStr_Set(UserGlobPtr()->curPrompt, "\pþ");}//-------------------------------------------------long TheDate(void)                                //returns date in the format of yyyymmdd{  DateTimeRec TempRec;  long TempInt;  GetTime(&TempRec);  TempInt = (TempRec.year * 100000 + TempRec.month * 1000 + TempRec.day * 10) / 10;  return TempInt;}//-------------------------------------------------void DateToString(long ADate, StringPtr dateStr)       //The date variable is in the format yyyymmdd{  //converts to 'mm/dd/yy'  Str255 TempStr;  Str255 yearStr;  Str255 monthStr;  Str255 dayStr;  NumToString(ADate, TempStr);  PStr_Copy(yearStr, TempStr, 3, 2);  PStr_Copy(monthStr, TempStr, 5, 2);  PStr_Copy(dayStr, TempStr, 7, 2);  PStr_Concat(dateStr, monthStr, "\p/", dayStr, "\p/", yearStr);}//-------------------------------------------------/*short rnd(short Min, short Max){  //This function will put out a random # between the Max and Min that is specified    long QdRandom;  QdRandom = Random() + 32768;  QdRandom = (QdRandom * (Max - Min + 1)) / 65536 + Min;  return QdRandom;}*/short UnitRandom(void){	if (Random() > 0)		return 1;	else		return -1;}short RandomUpTo(short value){	register long answer;		answer = Random() + 32768;	answer = answer % (value + 1);	return answer;}short RandomBetween(short lower, short upper){	register long answer;		answer = Random() + 32768;	answer = (answer % (upper - lower + 1)) + lower;	return answer;}Boolean RandomBoolean(void){	if (Random() > 0)		return 1;	else		return 0;}//-------------------------------------------------void BufferANSI(StringPtr TheANSI, Boolean bCrBefore){  Str255 Temp_Str255_1;  BufferIt(PStr_Concat(Temp_Str255_1, "\p\033", "\p[", TheANSI),            bCrBefore, 0, gHermSetup->procs[vBufferIt]);}//-------------------------------------------------void ucase(StringPtr the_string                   //convert lowercase string to uppercase string           ){  short i;  short forEnd_1 = PStr_Length(the_string);  for (i = 1; i <= forEnd_1; ++i) {    char temp_1 = the_string[i];    if (temp_1 >= 'a' && temp_1 <= 'z')       the_string[i] = char(the_string[i] - 'a' + 'A');  }}//-------------------------------------------------Boolean UCaseEqual(StringPtr st1, StringPtr st2){  Str255 s1;  Str255 s2;  PStr_Set(s1, st1);  PStr_Set(s2, st2);  ucase(s1);  ucase(s2);  return PStr_Cmp(s1, s2) == 0;}//-------------------------------------------------void EncodeString(StringPtr ToEncode, StringPtr result){  short x;  Str255 TempStr;  short tempChar;  Str255 Temp_Str255_1;  Str255 Temp_Str255_2;  Str255 str1;  PStr_Set(TempStr, "\p");  PStr_Set(result, "\p");  short forEnd_2 = PStr_Length(ToEncode);  for (x = 1; x <= forEnd_2; ++x) {    tempChar = short(ToEncode[x] + CharShift);    tempChar = short(BRotL(tempChar, BitRollVal));    tempChar = short((tempChar + SlyVersion) % ModNumber);    tempChar = short(tempChar + MinTypeable);    str1[0] = 1;    str1[1] = tempChar;    switch (tempChar) {       case 32:      case 33:       case 34:       case 35:       case 36:       case 37:         PStr_Set(TempStr, PStr_Concat(Temp_Str255_1, TempStr, str1,                                       "\p8F", str1));        break;      case 38:      case 39:       case 40:       case 41:       case 42:       case 43:       case 44:       case 45:         PStr_Set(TempStr, PStr_Concat(Temp_Str255_1, TempStr, str1,                                       "\p28E"));        break;      case 46:      case 47:       case 48:       case 49:       case 50:         PStr_Set(TempStr, PStr_Concat(Temp_Str255_1, TempStr, "\pC93AF"));        break;      case 51:      case 52:       case 53:       case 54:       case 55:       case 56:         PStr_Set(TempStr, PStr_Concat(Temp_Str255_1, TempStr, str1,                                       "\p48FF0"));        break;      case 57:      case 58:       case 59:       case 60:       case 61:       case 62:         PStr_Set(TempStr, PStr_Concat(Temp_Str255_1, TempStr, "\pFq_;",                                       str1));        break;      case 63:      case 64:       case 65:       case 66:       case 67:       case 68:         PStr_Set(TempStr, PStr_Concat(Temp_Str255_1, TempStr, str1,                                       "\pj39Fbh", str1));        break;      case 69:      case 70:       case 71:       case 72:       case 73:         PStr_Set(TempStr, PStr_Concat(Temp_Str255_1, TempStr, "\pDEA",                                       str1));        break;      case 74:      case 75:       case 76:       case 77:       case 78:       case 79:         PStr_Set(TempStr, PStr_Concat(Temp_Str255_1, TempStr, str1,                                       "\pghF#@8"));        break;      case 80:      case 81:       case 82:       case 83:       case 84:       case 85:       case 86:         PStr_Set(TempStr, PStr_Concat(Temp_Str255_1, TempStr, "\p3CPsv",                                       str1));        break;      case 87:      case 88:       case 89:       case 90:       case 91:       case 92:       case 93:       case 94:       case 95:         PStr_Set(TempStr, PStr_Concat(Temp_Str255_1, TempStr, str1,                                       "\p;hF582"));        break;      case 96:      case 97:       case 98:       case 99:         PStr_Set(TempStr, PStr_Concat(Temp_Str255_1, TempStr, str1,                                       str1, "\pT8b%T"));        break;      case 100:      case 101:       case 102:       case 103:       case 104:       case 105:       case 106:       case 107:         PStr_Set(TempStr, PStr_Concat(Temp_Str255_1, TempStr, str1,                                       "\pxFFf_*"));        break;      case 108:      case 109:       case 110:       case 111:       case 112:       case 113:       case 114:         PStr_Set(TempStr, PStr_Concat(Temp_Str255_1, TempStr, str1,                                       "\p*h3f8ng", str1));        break;      case 115:      case 116:       case 117:       case 118:       case 119:       case 120:       case 121:         PStr_Set(TempStr, PStr_Concat(Temp_Str255_1, TempStr, str1,                                       "\p13Fa2d"));        break;      case 122:      case 123:       case 124:       case 125:       case 126:         PStr_Set(TempStr, PStr_Concat(Temp_Str255_1, TempStr, "\p4fC32bE",                                       str1, str1));        break;    } //case      }  short forEnd_3 = PStr_Length(TempStr);  //now take ever few characters out of the Encoded stuff  //it should be somewhat randomish because of the mod  for (x = 1; x <= forEnd_3; ++x) {    PStr_Set(result, PStr_Concat(Temp_Str255_1, result, PStr_FromChar(Temp_Str255_2, TempStr[x])));    //????-Bad news here... loop variable changed-????    x += x % 4;  }}//-------------------------------------------------void MakeRegString(StringPtr bbsName, StringPtr BBSSerialNumber, StringPtr SysOpName, StringPtr result){  Str255 st1;  Str255 st2;  short x;  Str255 Temp_Str255_1;  Str255 Temp_Str255_2;  PStr_Set(st1, "\p");  PStr_Set(st2, "\p");    EncodeString(bbsName, st1);  if (PStr_Length(st1) < bbsNameLength)     for (x = PStr_Length(st1); x <= bbsNameLength; ++x)       PStr_Set(st1, PStr_Concat(Temp_Str255_2, st1, PStr_Copy(Temp_Str255_1,                                                               FillerCharacters,                                                               1, bbsNameLength - PStr_Length(st1))));  if (PStr_Length(st1) >= bbsNameLength)     PStr_Set(st1, PStr_Copy(Temp_Str255_1, st1, 1, bbsNameLength));  PStr_Set(st2, PStr_Concat(Temp_Str255_1, st2, st1));    EncodeString(BBSSerialNumber, st1);  if (PStr_Length(st1) < BBSSerialLength)     for (x = PStr_Length(st1); x <= BBSSerialLength; ++x)       PStr_Set(st1, PStr_Concat(Temp_Str255_2, st1, PStr_Copy(Temp_Str255_1,                                                               FillerCharacters2,                                                               1, BBSSerialLength - PStr_Length(st1))));  if (PStr_Length(st1) >= BBSSerialLength)     PStr_Set(st1, PStr_Copy(Temp_Str255_1, st1, 1, BBSSerialLength));  PStr_Set(st2, PStr_Concat(Temp_Str255_1, st2, st1));    EncodeString(SysOpName, st1);  if (PStr_Length(st1) < SysOpNameLength)     for (x = PStr_Length(st1); x <= SysOpNameLength; ++x)       PStr_Set(st1, PStr_Concat(Temp_Str255_2, st1, PStr_Copy(Temp_Str255_1,                                                               FillerCharacters3,                                                               1, SysOpNameLength - PStr_Length(st1))));  if (PStr_Length(st1) >= SysOpNameLength)     PStr_Set(st1, PStr_Copy(Temp_Str255_1, st1, 1, SysOpNameLength));  PStr_Set(st2, PStr_Concat(Temp_Str255_1, st2, st1));    EncodeString("\p~", st1);                       //inserted so that we can 'verify' valid serial numbers  PStr_Insert(st1, st2, 10);    EncodeString("\p\\", st1);                      //tacked on so that we can 'verify' valid serial numbers  PStr_Set(st2, PStr_Concat(Temp_Str255_1, st2, st1));    PStr_Set(result, st2);}//-------------------------------------------------Boolean CheckRegistration(void){  Str255 st3;  RegistrationRec RegInfo;  Boolean value_CheckRegistration;  Str255 Temp_Str255_1;    try {  	if (gRegistrationFile->Exists()) {  	  gRegistrationFile->Get(RegInfo);  	  gRegistrationFile->Close();      MakeRegString(HSystPtr()->bbsName, PStr_Copy(Temp_Str255_1, HSystPtr()->realSerial,                                                  1, 8), RegInfo.SysOpName, st3);          if (PStr_Cmp(st3, RegInfo.RegistrationString) == 0)         value_CheckRegistration = true;      else         value_CheckRegistration = false;    } else      value_CheckRegistration = false;  } catch (...) {    value_CheckRegistration = false;  }    return value_CheckRegistration;}//-------------------------------------------------void RegisterGame(StringPtr SysOpName, StringPtr RegistrationKey){  RegistrationRec RegInfo;  if (!gRegistrationFile->Exists()) {    try {      gRegistrationFile->Create();            PStr_Set(RegInfo.SysOpName, SysOpName);      PStr_Set(RegInfo.RegistrationString, RegistrationKey);      RegInfo.RegistrationDate = TheDate();            gRegistrationFile->Set(RegInfo);      gRegistrationFile->Close();    } catch (...) {      ReportKindError("\pError: Unable to save registration information");    }  } else {    G_Outln("\pRegistration file already exists!", true, 6);    G_Outln("\pDelete \"Registraion File\" if you want to re-register game.",             true, 0);  }}//-------------------------------------------------const StringPtr ConvertStats(short Value){  switch (Value) {     case 1:    case 2:     case 3:       return "\pInfant";      break;    case 4:    case 5:     case 6:     case 7:       return "\pPuny";      break;    case 8:    case 9:     case 10:       return "\pWeak";      break;    case 11:    case 12:     case 13:     case 14:       return "\pLacking";      break;    case 15:    case 16:     case 17:     case 18:     case 19:     case 20:     case 21:     case 22:     case 23:     case 24:     case 25:       return "\pTypical";      break;    case 26:    case 27:     case 28:     case 29:     case 30:     case 31:     case 32:     case 33:     case 34:     case 35:       return "\pFair";      break;    case 36:    case 37:     case 38:     case 39:     case 40:     case 41:     case 42:     case 43:     case 44:     case 45:       return "\pAdequate";      break;    case 46:    case 47:     case 48:     case 49:     case 50:     case 51:     case 52:     case 53:     case 54:     case 55:       return "\pCommendable";      break;    case 56:    case 57:     case 58:     case 59:     case 60:     case 61:     case 62:     case 63:     case 64:     case 65:       return "\pAdmirable";      break;    case 66:    case 67:     case 68:     case 69:     case 70:     case 71:     case 72:     case 73:     case 74:     case 75:       return "\pExceptional";      break;    case 76:    case 77:     case 78:     case 79:     case 80:     case 81:     case 82:     case 83:     case 84:     case 85:     case 86:     case 87:     case 88:     case 89:     case 90:       return "\pSuperior";      break;    case 91:    case 92:     case 93:     case 94:     case 95:     case 96:     case 97:     case 98:     case 99:       return "\pInvincible";      break;    case 100:      return "\pKickin\'!";      break;  }  return "\pKickin\'!";}//-------------------------------------------------void GetApprValue(CharacterPtr theChar){  theChar->scoreVal = theChar->TotalExperience +                     (theChar->ThiefLvl + theChar->MageLvl + theChar->FighterLvl) * 100 +                     theChar->CoinsHand + theChar->CoinsBank + abs(theChar->Fame * 100) +                     abs(theChar->Honor * 100) + abs(theChar->Faith * 100) +                     abs((theChar->Flirt1 + theChar->Flirt2) * 100);}//-------------------------------------------------void WriteLineToFile(StringPtr TheString, short FNum){  long byteCount;  Str255 str1;  PStr_Concat(str1, TheString, "\p\x0D", "\p\x0A");  byteCount = PStr_Length(str1);  FailOSErr(FSWrite(FNum, &byteCount, &str1[1]));}//-------------------------------------------------Boolean FindCharacter(StringPtr slyName, long *playerNum){  CharacterRec SlyPlayers;  long playerCount;    if (gCharacterFile->Exists()) {	  for (playerCount = 0; playerCount < gCharacterFile->NumItems(); playerCount++) {	    gCharacterFile->Get(playerCount, SlyPlayers);	    if (PStr_Cmp(SlyPlayers.name, slyName) == 0) {	      *playerNum = playerCount;	      return true;	    }	  }      *playerNum = gCharacterFile->NumItems();      gCharacterFile->Close();      return false;  }    *playerNum = -1;  return false;}//-------------------------------------------------Boolean FindBBSCharacter(StringPtr bbsName, long *playerNum)// UserGlobPtr()->thisUser.userName{  CharacterRec SlyPlayers;  long playerCount;    if (gCharacterFile->Exists()) {	  for (playerCount = 0; playerCount < gCharacterFile->NumItems(); playerCount++) {	    gCharacterFile->Get(playerCount, SlyPlayers);	    if (PStr_Cmp(SlyPlayers.bbsName, bbsName) == 0) {	      *playerNum = playerCount;	      return true;	    }	  }      *playerNum = gCharacterFile->NumItems();      gCharacterFile->Close();      return false;  }    *playerNum = -1;  return false;}void GetBBSName(StringPtr bbsName, StringPtr slyName){  CharacterRec charRec;  ReadSlyChar(slyName, &charRec);  PStr_Set(bbsName, charRec.bbsName);}//-------------------------------------------------Boolean FindCharacter(StringPtr slyName){  CharacterRec SlyPlayers;  long playerCount;    if (gCharacterFile->Exists()) {	  for (playerCount = 0; playerCount < gCharacterFile->NumItems(); playerCount++) {	    gCharacterFile->Get(playerCount, SlyPlayers);	    if (PStr_Cmp(SlyPlayers.name, slyName) == 0) {	      return true;	    }	  }      gCharacterFile->Close();      return false;  }  return false;}//-------------------------------------------------void AddPlayerRec(CharacterPtr TheChar){  if (!gCharacterFile->Exists())    gCharacterFile->Create();  PStr_Set(TheChar->bbsName, UserGlobPtr()->thisUser.userName);  TheChar->Laston = TheDate();  GetApprValue(TheChar);  TheChar->fileIndex = gCharacterFile->NumItems();  gCharacterFile->Add(*TheChar);  gCharacterFile->Close();}void SaveChar(CharacterPtr theChar){  GetApprValue(theChar);  gCharacterFile->Set(theChar->fileIndex, *theChar);  gCharacterFile->Close();}void ReadBBSChar(Str255 name, CharacterPtr theChar){  long fileIndex;    if (FindBBSCharacter(name, &fileIndex))    gCharacterFile->Get(fileIndex, *theChar);  else  	throw TMacOSErr(fnfErr);  gCharacterFile->Close();}void ReadSlyChar(Str255 name, CharacterPtr theChar){  long fileIndex;    if (FindCharacter(name, &fileIndex))    gCharacterFile->Get(fileIndex, *theChar);  else  	throw TMacOSErr(fnfErr);  gCharacterFile->Close();}//-------------------------------------------------void WriteNewsToPlayer(StringPtr TheString, CharacterPtr ThePlayer, Boolean WriteMail){  Str255 st1;  Str255 FName;  Str255 StrDate;  UserRec TempUser;  short FNum;  Str255 Temp_Str255_1;    PStr_Set(FName, PStr_Concat(Temp_Str255_1, gHermSetup->filesPath,                               MailPath, ThePlayer->bbsName, "\p--News"));  NumToString(TheDate(), st1);  DateToString(TheDate(), StrDate);  try {    FailOSErr(FSOpen(FName, vRefNum, &FNum));  } catch(...) {  	FailOSErr(Create(FName, vRefNum, HermesType, 'TEXT'));    FailOSErr(FSOpen(FName, vRefNum, &FNum));  }  FailOSErr(SetFPos(FNum, fsFromLEOF, 0));  WriteLineToFile("\p   ", FNum);  WriteLineToFile("\p-=-=-=-=-=-=-=-=-=-=-", FNum);  WriteLineToFile(PStr_Concat(Temp_Str255_1, "\p     ", StrDate, "\p:"), FNum);  WriteLineToFile(TheString, FNum);  WriteLineToFile("\p   ", FNum);  FailOSErr(FSClose(FNum));    //BBS E-Mail  if (WriteMail) {    if (FindUser(ThePlayer->bbsName, &TempUser, gHermSetup->procs[vFindUser])) {            PStr_Set(UserGlobPtr()->curEmailRec.title, ThePlayer->name);  //the title of the message      UserGlobPtr()->curEmailRec.fromUser = UserGlobPtr()->thisUser.userNum;  //what user number this is from      UserGlobPtr()->curEmailRec.toUser = TempUser.userNum;  //what number user you want to send to      UserGlobPtr()->curEmailRec.anonyFrom = false;  //if you want the message to be anonymous from      UserGlobPtr()->curEmailRec.anonyTo = false;   //If you want the message to be anonymous TO      GetDateTime((unsigned long *)&UserGlobPtr()->curEmailRec.dateSent);  //Getting the exact time and date the email is being sent      UserGlobPtr()->curEmailRec.mType = 1;         //mType = 1, normal mail, other mType's are 0 which would be a notification (someone downloaded, etc)      UserGlobPtr()->curEmailRec.multiMail = false;      try {        UserGlobPtr()->curWriting = TextHand(NewHandle(0));        FailNIL((Ptr)UserGlobPtr()->curWriting);        UserGlobPtr()->curEmailRec.fileAttached = false;  //there's NOT a file here...        UserGlobPtr()->curEmailRec.hasRead = false;  //Has not ben read yet.        //UserGlobPtr^.CurEmailRec.StoredAs := 0;  ???                AddLine(TheString, gHermSetup->procs[vAddLine]);  //The char(3)'s are for color, following is the color #        AddLine("\p", gHermSetup->procs[vAddLine]);        AddLine("\pSlycrel note:", gHermSetup->procs[vAddLine]);        (*(*UserGlobPtr()->curWriting))[GetHandleSize(Handle(UserGlobPtr()->curWriting)) - 1] = char(26);        if (!SaveMessAsEmail(gHermSetup->procs[vSaveMessAsEmail]))   //with the                                                                     //new procedures, save the email immediately, if there is                                                                     //an error, it will report it          OutLineC("\pError: Email database full.", true, 6, gHermSetup->procs[vOutLineC]);        else {          OutLineC("\pEmail Sent.", true, 1, gHermSetup->procs[vOutLineC]);          G_bCr();        }      } catch (...) {        OutLineC("\pError: Not enough memory to save email", true, 6,                gHermSetup->procs[vOutLineC]);      }    } else       OutLineC(PStr_Concat(Temp_Str255_1, "\pError: Email not sent. Unable to find user ",                          ThePlayer->bbsName, "\p."), true, 6, gHermSetup->procs[vOutLineC]);  }                                               //writeMail}//-------------------------------------------------void UpdateGuildLists(void){  HighScoreType charScore;  HighScoreType saveScore;  HighScoreType scoreArray[11];  CharacterRec charRec;  long scoreIndex;  long charIndex;  long numChars;    if (!gHighScoreFile->Exists()) {    gHighScoreFile->Create();    for (scoreIndex = 0; scoreIndex < 11; scoreIndex++)      gHighScoreFile->Add(charScore);  }  PStr_Set(charScore.name, "\p>>>>> None <<<<<");  charScore.LastDate = TheDate();  charScore.Value = 0;  for (scoreIndex = 0; scoreIndex < 11; scoreIndex++)    scoreArray[scoreIndex] = charScore;    if (gCharacterFile->Exists()) {    numChars = gCharacterFile->NumItems();    for (charIndex = 0; charIndex < numChars; charIndex++) {      gCharacterFile->Get(charIndex, charRec);      charScore.Value = charRec.scoreVal;      charScore.LastDate = charRec.Laston;      PStr_Set(charScore.name, charRec.name);      for (scoreIndex = 0; scoreIndex < 11; scoreIndex++) {        if (charScore.Value > scoreArray[scoreIndex].Value) {          saveScore = scoreArray[scoreIndex];          scoreArray[scoreIndex] = charScore;          charScore = saveScore;        }      }    }  }    for (scoreIndex = 0; scoreIndex < 11; scoreIndex++)    gHighScoreFile->Set(scoreIndex, scoreArray[scoreIndex]);    gHighScoreFile->Close();}//-------------------------------------------------void ViewGuildLists(void){  HighScoreType temparr[11];  short x;  short y;  Str255 st1;  Str255 Temp_Str255_1;  for (x = 0; x < 11; x++)  	gHighScoreFile->Get(x, temparr[x]);    G_Outln("\p##  Name:                           Score:                    Last On:",           true, 0);  G_Outln("\p-=-.-=-.-=-.-=-.-=-.-=-.-=-.-=-.-=-.-=-.-=-.-=-.-=-.-=-.-=-.-=-.-=-.-=-.-=-.-=-",           true, 5);  for (x = 1; x <= 11; ++x) {    BufferbCr(gHermSetup->procs[vBufferbCr]);        NumToString(x, st1);    for (y = PStr_Length(st1); y <= 4; ++y)       PStr_Set(st1, PStr_Concat(Temp_Str255_1, st1, "\p "));    BufferIt(st1, false, 0, gHermSetup->procs[vBufferIt]);        PStr_Set(st1, temparr[x - 1].name);    for (y = PStr_Length(st1); y <= 32; ++y)       PStr_Set(st1, PStr_Concat(Temp_Str255_1, st1, "\p "));    BufferIt(st1, false, 6, gHermSetup->procs[vBufferIt]);        NumToString(temparr[x - 1].Value, st1);    for (y = PStr_Length(st1); y <= 25; ++y)       PStr_Set(st1, PStr_Concat(Temp_Str255_1, st1, "\p "));    BufferIt(st1, false, 2, gHermSetup->procs[vBufferIt]);        DateToString(temparr[x - 1].LastDate, st1);    BufferIt(st1, false, 3, gHermSetup->procs[vBufferIt]);  }    ReleaseBuffer(gHermSetup->procs[vReleaseBuffer]);    gHighScoreFile->Close();    G_bCr();  UserGlobPtr()->boardAction = None;  myPausePrompt("\p-=Press A Key=-");}//-------------------------------------------------void PrintCharStats(CharacterPtr TheStats){  // Adds the Character Sheet to   // the Buffer then RELEASES it    Str255 C1;  Str255 C2;  Str255 C3;  Str255 TempStr;  Str255 st1;  Str255 st2;  Str255 st3;  short x;  short int1;  short ColorNum;  Str255 Temp_Str255_1;  Str255 Temp_Str255_2;  ColorNum = RandomBetween(31, 37);  NumToString(ColorNum, C1);  PStr_Set(C1, PStr_Concat(Temp_Str255_1, C1, "\pm"));  ColorNum = RandomBetween(31, 37);  NumToString(ColorNum, C2);  PStr_Set(C2, PStr_Concat(Temp_Str255_1, C2, "\pm"));  ColorNum = RandomBetween(31, 37);  NumToString(ColorNum, C3);  PStr_Set(C3, PStr_Concat(Temp_Str255_1, C3, "\pm"));    G_ANSICode("\p2J");  G_ANSICode("\pH");    BufferANSI("\p1;28H", false);  BufferANSI(PStr_Concat(Temp_Str255_1, C2, "\pÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ"), false);  BufferANSI("\p1;32H", false);  BufferANSI(PStr_Concat(Temp_Str255_1, C1, "\pCharacter"),              false);  BufferANSI("\p1;43H", false);  BufferANSI(PStr_Concat(Temp_Str255_1, C1, "\pInfo"), false);    BufferANSI(C1, false);  BufferANSI("\p2HName", false);  BufferANSI("\p2;40HClass", false);    BufferANSI("\p3;5HHitPoints", false);  BufferANSI("\p3;45HLevels F-T-M", false);  BufferANSI("\p4;5HExploration", false);  BufferANSI("\p4;45HWon / Total", false);  BufferANSI("\p5;5HSpars", false);  BufferANSI("\p5;45HAmmo", false);  BufferANSI("\p6;5HDexterity", false);  BufferANSI("\p6;45HPsyche", false);  BufferANSI("\p7;5HStrength", false);  BufferANSI("\p7;45HSpeed", false);  BufferANSI("\p8;5HCoins Hand", false);  BufferANSI("\p8;45HCoins Bank", false);  BufferANSI("\p9;5HGender", false);    BufferANSI(C3, false);  BufferANSI("\p2;5H-", false);  BufferANSI("\p2;45H-", false);  for (x = 3; x <= 9; ++x) {    NumToString(x, TempStr);    BufferANSI(PStr_Concat(Temp_Str255_1, TempStr, "\p;17H", "\p:"), false);    BufferANSI(PStr_Concat(Temp_Str255_1, TempStr, "\p;57H", "\p:"), false);  }    BufferANSI("\p2;7H", false);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p1;36m", TheStats->name), false);  BufferANSI("\p0;37m", false);  BufferANSI("\p2;47H", false);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p1;36m", TheStats->CharClass), false);  BufferANSI("\p0;37m", false);    BufferANSI(C2, false);  NumToString(TheStats->HitPoints, TempStr);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p3;18H", TempStr),              false);  BufferANSI(PStr_Concat(Temp_Str255_1, C1, "\p/"), false);  BufferANSI(C3, false);  NumToString(TheStats->MaxHP, TempStr);  BufferANSI(PStr_Concat(Temp_Str255_1, C2, TempStr), false);    NumToString(TheStats->FighterLvl, st1);  NumToString(TheStats->ThiefLvl, st2);  NumToString(TheStats->MageLvl, st3);  PStr_Set(TempStr, PStr_Concat(Temp_Str255_1, st1, "\p - ", st2,                                 "\p - ", st3));    BufferANSI(PStr_Concat(Temp_Str255_1, "\p3;58H", TempStr),              false);  NumToString(TheStats->Exploration, TempStr);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p4;18H", TempStr),              false);  NumToString(TheStats->FightsWon, TempStr);  NumToString(TheStats->TotalFights - TheStats->FightsWon, st2);  PStr_Set(TempStr, PStr_Concat(Temp_Str255_1, TempStr, "\p/", st2));  BufferANSI(PStr_Concat(Temp_Str255_1, "\p4;58H", TempStr),              false);  if (TheStats->TotalFights - TheStats->FightsWon == 0)  	int1 = 0;  else  	int1 = Round((double(TheStats->FightsWon) / double(TheStats->TotalFights - TheStats->FightsWon)) * 100);  NumToString(int1, TempStr);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p4;64H", "\p(", TempStr,                          "\p%)"), false);  NumToString(TheStats->Spars, TempStr);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p5;18H", TempStr),              false);  NumToString(TheStats->Ammo, TempStr);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p5;58H", TempStr),              false);  BufferANSI(PStr_Concat(Temp_Str255_2, "\p6;18H", ConvertStats(TheStats->Dexterity)), false);  BufferANSI(PStr_Concat(Temp_Str255_2, "\p6;58H", ConvertStats(TheStats->Psyche)), false);  BufferANSI(PStr_Concat(Temp_Str255_2, "\p7;18H", ConvertStats(TheStats->Strength)), false);  BufferANSI(PStr_Concat(Temp_Str255_2, "\p7;58H", ConvertStats(TheStats->Speed)), false);  NumToString(TheStats->CoinsHand, TempStr);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p8;18H", TempStr),              false);  NumToString(TheStats->CoinsBank, TempStr);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p8;58H", TempStr),              false);  if (TheStats->Gender)     PStr_Set(TempStr, "\pMale");  else     PStr_Set(TempStr, "\pFemale");  BufferANSI(PStr_Concat(Temp_Str255_1, "\p9;18H", TempStr),              false);  ReleaseBuffer(gHermSetup->procs[vReleaseBuffer]);}//-------------------------------------------------short Arena_Appraisal(CharacterPtr TheChar){  short value_Arena_Appraisal;  value_Arena_Appraisal = TheChar->Strength + TheChar->Speed + TheChar->TotalExperience + TheChar->HitPoints + TheChar->Dexterity + TheChar->Weapons[0].Strike + TheChar->Weapons[1].Strike + TheChar->Armor[0].Defense + TheChar->Armor[1].Defense;  return value_Arena_Appraisal;}//-------------------------------------------------Boolean PlayerInInn(StringPtr PlayerName){  InnRec InnData;  short x;  Boolean found;  Boolean value_PlayerInInn;  gInnFile->Get(InnData);  gInnFile->Close();    found = false;  x = 0;  while (x < 10 && !found) {    x++;    if (UCaseEqual(InnData.Rooms[x - 1].Who, PlayerName))       found = true;  }    value_PlayerInInn = found;  return value_PlayerInInn;}//-------------------------------------------------void InnUpkeep(void){  InnRec InnData;  short x;  for (x = 0; x < 10; ++x) {    PStr_Set(InnData.Rooms[x].Who, "\pEmpty");    InnData.Rooms[x].DaysLeft = 0;    InnData.Rooms[x].Lock = 255;  }  PStr_Set(InnData.Owner, "\pNate Muhlestein");  InnData.CurRate = 5;  InnData.Safe = 150;  InnData.Open = true;    if (!gInnFile->Exists()) {    gInnFile->Create();    gInnFile->Add(InnData);  }    gInnFile->Get(InnData);    for (x = 0; x < 10; ++x) {    if (PStr_Cmp(InnData.Rooms[x].Who, "\pEmpty") != 0)   //one day passes      InnData.Rooms[x].DaysLeft = InnData.Rooms[x].DaysLeft - 1;    if (InnData.Rooms[x].DaysLeft < 1) {  //kick user out of inn      InnData.Rooms[x].DaysLeft = 0;      PStr_Set(InnData.Rooms[x].Who, "\pEmpty");      InnData.Rooms[x].Lock = 0;    }  }    gInnFile->Set(InnData);  gInnFile->Close();}//-------------------------------------------------Boolean CheckInn(void){  InnRec InnData;  Boolean value_CheckInn;  if (!gInnFile->Exists())    InnUpkeep();  gInnFile->Get(InnData);  gInnFile->Close();  if (InnData.Open == true)     value_CheckInn = true;  else     value_CheckInn = false;  return value_CheckInn;}//-------------------------------------------------void InnKeeperName(StringPtr name){  InnRec InnData;  gInnFile->Get(InnData);  gInnFile->Close();  PStr_Set(name, InnData.Owner);  ucase(name);}//-------------------------------------------------