#include "Builtins.h"#include "PStrings.h"#include "Sly_MainUnit.h"//-***********-Utils-***********-//-------------------------------------------------void RollChar(CharacterPtr TheChar, char Ch1){  short x;  TheChar->Laston = TheDate();  TheChar->Alive = true;  TheChar->Ammo = RandomBetween(1, 10);  TheChar->CoinsHand = 15;  TheChar->CoinsBank = 5;  TheChar->TotalExperience = RandomBetween(1, 100);  TheChar->SpendingExperience = TheChar->TotalExperience;  TheChar->ThiefLvl = 0;  TheChar->MageLvl = 0;  TheChar->FighterLvl = 0;    switch (Ch1) {     case 'F':      PStr_Set(TheChar->CharClass, "\pFighter");      TheChar->Strength = RandomBetween(4, 12);      TheChar->Speed = RandomBetween(8, 12);      TheChar->MaxPsyche = 1;      TheChar->Psyche = TheChar->MaxPsyche;      TheChar->Fame = RandomBetween(0, 2);      TheChar->Dexterity = RandomBetween(4, 15);      TheChar->HitPoints = RandomBetween(15, 35);      TheChar->MaxHP = TheChar->HitPoints;      TheChar->Movement = RandomBetween(TheChar->Speed - TheChar->Speed / 5,                               TheChar->Speed + TheChar->Speed / 5);      TheChar->Exploration = 15;      TheChar->Spars = 3;      TheChar->Honor = RandomBetween(1, 15);      TheChar->Faith = RandomBetween(1, 7);      TheChar->Flirt1 = 1;      TheChar->Flirt2 = 1;      break;    case 'T':      PStr_Set(TheChar->CharClass, "\pThief");      TheChar->Strength = RandomBetween(3, 12);      TheChar->Speed = RandomBetween(10, 16);      TheChar->MaxPsyche = 1;      TheChar->Psyche = TheChar->MaxPsyche;      TheChar->Fame = RandomBetween(0, 2);      TheChar->Dexterity = RandomBetween(4, 20);      TheChar->HitPoints = RandomBetween(13, 26);      TheChar->MaxHP = TheChar->HitPoints;      TheChar->Movement = RandomBetween(TheChar->Speed - TheChar->Speed / 5,                               TheChar->Speed + TheChar->Speed / 5);      TheChar->Exploration = 15;      TheChar->Spars = 3;      TheChar->Honor = RandomBetween(1, 12);      TheChar->Faith = RandomBetween(1, 5);      TheChar->Flirt1 = 1;      TheChar->Flirt2 = 1;      break;    case 'M':      PStr_Set(TheChar->CharClass, "\pMage");      TheChar->Strength = RandomBetween(2, 10);      TheChar->Speed = RandomBetween(8, 16);      TheChar->MaxPsyche = RandomBetween(2, 4);      TheChar->Psyche = TheChar->MaxPsyche;      TheChar->Fame = RandomBetween(0, 2);      TheChar->Dexterity = RandomBetween(4, 15);      TheChar->HitPoints = RandomBetween(4, 17);      TheChar->MaxHP = TheChar->HitPoints;      TheChar->Movement = RandomBetween(TheChar->Speed - TheChar->Speed / 5,                               TheChar->Speed + TheChar->Speed / 5);      TheChar->Exploration = 15;      TheChar->Spars = 3;      TheChar->Honor = RandomBetween(4, 15);      TheChar->Faith = RandomBetween(0, 5);      TheChar->Flirt1 = 1;      TheChar->Flirt2 = 1;      break;    default:      PStr_Set(TheChar->CharClass, "\pNone");      TheChar->Strength = 0;      TheChar->Speed = 0;      TheChar->MaxPsyche = 0;      TheChar->Psyche = 0;      TheChar->Fame = 0;      TheChar->Dexterity = 0;      TheChar->HitPoints = 0;      TheChar->MaxHP = 0;      TheChar->Movement = 0;      TheChar->Exploration = 0;      TheChar->Spars = 0;      TheChar->Honor = 0;      TheChar->Faith = 0;      TheChar->Flirt1 = 0;      TheChar->Flirt2 = 0;      TheChar->CoinsHand = 0;      TheChar->CoinsBank = 0;      TheChar->TotalExperience = 0;      TheChar->SpendingExperience = 0;      TheChar->ThiefLvl = 0;      TheChar->MageLvl = 0;      TheChar->FighterLvl = 0;      break;      } //Case    TheChar->TotalFights = 0;  TheChar->FightsWon = 0;  TheChar->Location = TheTown;    //if they are female then 'Adjust' the Stats a little  if (!(TheChar->Gender == true)) {    TheChar->Strength -= 3;    TheChar->MaxPsyche += 2;    TheChar->Dexterity += 2;    TheChar->MaxHP--;    TheChar->HitPoints = TheChar->MaxHP;  }    for (x = 1; x <= 3; ++x) {    PStr_Set(TheChar->Weapons[x - 1].name, "\pHands");    TheChar->Weapons[x - 1].Strike = TheChar->Strength / 4;    TheChar->Weapons[x - 1].Range = 0;    TheChar->Weapons[x - 1].Cost = 0;    TheChar->Weapons[x - 1].Ability = 0;    if (x == 2) {      PStr_Set(TheChar->Weapons[x - 1].name, "\procks");      TheChar->Weapons[x - 1].Strike = 1;      TheChar->Weapons[x - 1].Range = 2;    }  }  PStr_Set(TheChar->Armor[0].name, "\pClothing");  TheChar->Armor[0].Defense = 1;  TheChar->Armor[0].Cost = 0;  TheChar->Armor[0].Ability = 0;  PStr_Set(TheChar->Armor[1].name, "\pNone");  TheChar->Armor[1].Defense = 1;  TheChar->Armor[1].Cost = 0;  TheChar->Armor[1].Ability = 0;  }//-------------------------------------------------void ResurrectUser(CharacterPtr TheChar){  TheChar->Alive = true;  TheChar->HitPoints = TheChar->MaxHP;  TheChar->Psyche = TheChar->MaxPsyche;  TheChar->TotalExperience -= Round(TheChar->TotalExperience * 0.02);  TheChar->SpendingExperience -= Round(TheChar->SpendingExperience * 0.02);  TheChar->Fame--;  TheChar->Faith++;  TheChar->CoinsHand -= TheChar->CoinsHand / 5;}//-------------------------------------------------void NewDayForUser(CharacterPtr TheChar){  TheChar->Psyche = TheChar->MaxPsyche;  TheChar->TotalExperience += 15;  TheChar->SpendingExperience += 15;  TheChar->Movement = RandomBetween(TheChar->Speed - TheChar->Speed / 5, TheChar->Speed + TheChar->Speed / 5);  TheChar->Exploration = 15;  TheChar->Spars = 4;  if (TheChar->Flirt1 < 0)     TheChar->Flirt1 = -TheChar->Flirt1;  if (TheChar->Flirt2 < 0)     TheChar->Flirt2 = -TheChar->Flirt2;  if (!TheChar->Alive)     ResurrectUser(TheChar);  SaveChar(TheChar);}//-------------------------------------------------void CalcFight(StringPtr value_CalcFight, short ChOdds, short OppOdds, StringPtr loser){  short result;  if (ChOdds > OppOdds) {    result = RandomBetween(1, ChOdds + 1);    if (result == 1) {      PStr_Set((unsigned char *)value_CalcFight, "\pOpponent");      PStr_Set(loser, "\pChallenger");    } else {      PStr_Set((unsigned char *)value_CalcFight, "\pChallenger");      PStr_Set(loser, "\pOpponent");    }  } else {    result = RandomBetween(1, OppOdds + 1);    if (result == 1) {      PStr_Set((unsigned char *)value_CalcFight, "\pChallenger");      PStr_Set(loser, "\pOpponent");    } else {      PStr_Set((unsigned char *)value_CalcFight, "\pOpponent");      PStr_Set(loser, "\pChallenger");    }  }                                               //else}//-------------------------------------------------void PayOffUsers(GCombatList *List, GCombatPrefs *combPrefs, StringPtr Winner){  CharacterRec TheChar;  Str255 st1;  Boolean boo1;  Str255 Temp_Str255_1;  long fileIndex;  boo1 = FindCharacter(List->FileName, &fileIndex);  if (List->ForChallenger && UCaseEqual(Winner, List->Challenger)) {    List->Bet = (List->Bet) * (combPrefs->Odds[0] + 1);        gCharacterFile->Get(fileIndex, TheChar);        TheChar.CoinsHand = TheChar.CoinsHand + List->Bet;    NumToString(List->Bet, st1);        WriteNewsToPlayer(PStr_Concat(Temp_Str255_1, "\pYou profit on your betting (Gladiator combat: ",                                   Winner, "\p$", st1, "\p."),                       &TheChar, false);        SaveChar(&TheChar);  }    if (!List->ForChallenger && UCaseEqual(Winner, List->Opponent)) {    List->Bet = (List->Bet) * (combPrefs->Odds[0] + 1);        gCharacterFile->Get(fileIndex, TheChar);        TheChar.CoinsHand = TheChar.CoinsHand + List->Bet;    NumToString(List->Bet, st1);        WriteNewsToPlayer(PStr_Concat(Temp_Str255_1, "\pYou profit on your betting (Gladiator combat: ",                                   Winner, "\p $", st1, "\p."),                       &TheChar, false);        SaveChar(&TheChar);  }    if (List->ForChallenger && UCaseEqual(Winner, List->Opponent)) {    WriteNewsToPlayer(PStr_Concat(Temp_Str255_1, "\pYou lost on your betting (Gladiator combat: ",                                   Winner, "\p."), &TheChar, false);  }    if (!List->ForChallenger && UCaseEqual(Winner, List->Challenger)) {    WriteNewsToPlayer(PStr_Concat(Temp_Str255_1, "\pYou lost on your betting (Gladiator combat: ",                                   Winner, "\p."), &TheChar, false);  }  gCharacterFile->Close();}//-------------------------------------------------void DoFightUpkeep(void){  short currentFightNum;  GCombatPrefs combPrefs;  GCombatList List;  Str255 Winner;  Str255 loser;  CharacterRec Character1;  CharacterRec Character2;  Str255 Temp_Str255_1;  currentFightNum = 0;  if (gGCombatFile->Exists()) {  	for (long combatNum = 0; combatNum < gGCombatFile->NumItems(); combatNum++) {      gGCombatFile->Get(combatNum, combPrefs);      currentFightNum++;            if (PStr_Cmp(combPrefs.Opponent, combPrefs.Challenger) != 0) {        //if not same person then determine the winner here & put winner's name in winner                CalcFight(Temp_Str255_1, combPrefs.Odds[0], combPrefs.Odds[1], loser);        PStr_Set(Winner, Temp_Str255_1);        if (PStr_Cmp(Winner, "\pChallenger") == 0) {          PStr_Set(Winner, combPrefs.Challenger);          PStr_Set(loser, combPrefs.Opponent);        } else {          PStr_Set(Winner, combPrefs.Opponent);          PStr_Set(loser, combPrefs.Challenger);        }                //get the combatants charrec here & write it to the E-mail/Sly Announcements                ReadSlyChar(Winner, &Character1);        ReadSlyChar(loser, &Character2);                Character1.TotalExperience += Round(Character2.SpendingExperience * 0.1);        Character1.CoinsHand += 25;        Character1.TotalFights++;        Character1.FightsWon++;                SaveChar(&Character1);                WriteNewsToPlayer(PStr_Concat(Temp_Str255_1, "\pYou have lost Gladiator combat with ",                                       Character1.bbsName), &Character2, false);        WriteNewsToPlayer(PStr_Concat(Temp_Str255_1, "\pYou have won Gladiator Combat with ",                                       Character2.bbsName), &Character1, false);                if (gCombatListFile->Exists()) {          for (long itemNum = 0; itemNum < gCombatListFile->NumItems(); itemNum++) {            gCombatListFile->Get(List);            if (List.FightNum == currentFightNum)               PayOffUsers(&List, &combPrefs, Winner);          }          gCombatListFile->Close();        }              } //if not the same person    } //While not EOF(Gcombat)    gGCombatFile->Close();    gGCombatFile->Delete();    if (gCombatListFile->Exists())    	gCombatListFile->Delete();  }}//-------------------------------------------------void DoUpkeep(void){  CharacterRec thePlayer;  InnUpkeep();    if (gCharacterFile->Exists()) {    for (long playerNum = 0; playerNum < gCharacterFile->NumItems(); playerNum++) {      gCharacterFile->Get(playerNum, thePlayer);      NewDayForUser(&thePlayer);        gCharacterFile->Set(playerNum, thePlayer);    }        gCharacterFile->Close();        DoFightUpkeep();      } else {    G_Outln("\pWarning, Player upkeep skipped, PlayerList file not found.",             true, 6);  }  }//-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-//-***********-Screen-***********-//-------------------------------------------------void PrintMenu(StringPtr Div1, StringPtr Command, StringPtr Div2, StringPtr DivColor, StringPtr ComColor, Boolean Cr){  Str255 Temp_Str255_1;  G_ANSICode(PStr_Concat(Temp_Str255_1, DivColor, Div1));  G_ANSICode(PStr_Concat(Temp_Str255_1, ComColor, Command));  G_ANSICode(PStr_Concat(Temp_Str255_1, DivColor, Div2));  if (Cr)     G_bCr();}//-------------------------------------------------void ShowScale(void){  G_Outln("\pScale:", true, 7);  G_bCr();  G_Outln("\p 1 - Infant              ", true, 1);  G_Outln("\p 2 - Puny", false, 1);  G_Outln("\p 3 - Weak                ", true, 1);  G_Outln("\p 4 - Lacking", false, 1);  G_Outln("\p 5 - Typical             ", true, 1);  G_Outln("\p 6 - Fair", false, 1);  G_Outln("\p 7 - Adequate            ", true, 1);  G_Outln("\p 8 - Commendable", false, 1);  G_Outln("\p 9 - Admirable           ", true, 1);  G_Outln("\p10 - Exceptional", false, 1);  G_Outln("\p11 - Superior            ", true, 1);  G_Outln("\p12 - Invincible", false, 1);  G_bCr();  G_Outln("\p ** Note:  Based on 10 as being Human mortal maximum value",           true, 3);}//-------------------------------------------------//-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-