#include "Builtins.h"#include "PStrings.h"#include "Sly_ArmoryUnit.h"//-------------------------------------------------void DisplayWeaponList(short weaponNum, short Coins){  Str255 st1;  long long1;  short int1;  WeaponRec AWeapon;  Str255 Temp_Str255_1;  gWeaponFile->Get(weaponNum, AWeapon);  gWeaponFile->Close();    long1 = weaponNum + 1;  NumToString(long1, st1);    SpaceOut(st1, 4);  G_Outln(st1, true, 1);  PStr_Set(st1, PStr_Concat(Temp_Str255_1, "\p - ", AWeapon.name));  SpaceOut(st1, 22);  G_Outln(st1, false, 3);  NumToString(AWeapon.Strike, st1);  SpaceOut(st1, 8);  G_Outln(st1, false, 0);  if (AWeapon.Cost > Coins)     int1 = 5;  else     int1 = 3;  NumToString(AWeapon.Cost, st1);  G_Outln(PStr_Concat(Temp_Str255_1, "\p$ ", st1), false, int1);}//-------------------------------------------------void DisplayArmorList(short itemNum, short Coins){  Str255 st1;  long long1;  short int1;  ArmorRec AArmor;  Str255 Temp_Str255_1;  gArmorFile->Get(itemNum, AArmor);  gArmorFile->Close();    long1 = itemNum + 1;  NumToString(long1, st1);    SpaceOut(st1, 4);  G_Outln(st1, true, 1);  PStr_Set(st1, PStr_Concat(Temp_Str255_1, "\p - ", AArmor.name));  SpaceOut(st1, 22);  G_Outln(st1, false, 3);  NumToString(AArmor.Defense, st1);  SpaceOut(st1, 8);  G_Outln(st1, false, 0);  if (AArmor.Cost > Coins)     int1 = 5;  else     int1 = 3;  NumToString(AArmor.Cost, st1);  G_Outln(PStr_Concat(Temp_Str255_1, "\p$ ", st1), false, int1);}//-------------------------------------------------void GetWeapon(short WeaponNum, WeaponRec *TheWeapon){  gWeaponFile->Get(WeaponNum - 1, *TheWeapon);  gWeaponFile->Close();}//-------------------------------------------------void GetArmor(short ArmorNum, ArmorRec *TheArmor){  gArmorFile->Get(ArmorNum - 1, *TheArmor);  gArmorFile->Close();}//-------------------------------------------------void DisplayWeapon(WeaponRec *TheWeapon, short Number){  Str255 st1;  Str255 Temp_Str255_1;  NumToString(Number, st1);  G_Outln(PStr_Concat(Temp_Str255_1, "\p---==", st1, "\p==---"),           true, 1);  G_Outln("\p0] Quit editing this weapon", true, 1);  G_Outln(PStr_Concat(Temp_Str255_1, "\p1] Name- ", TheWeapon->name), true, 1);  NumToString(TheWeapon->Strike, st1);  G_Outln(PStr_Concat(Temp_Str255_1, "\p2] Strike- ", st1),           true, 1);  NumToString(TheWeapon->Range, st1);  G_Outln(PStr_Concat(Temp_Str255_1, "\p3] Range- ", st1), true,           1);  NumToString(TheWeapon->Cost, st1);  G_Outln(PStr_Concat(Temp_Str255_1, "\p4] Cost- ", st1), true,           1);  NumToString(TheWeapon->Ability, st1);  G_Outln(PStr_Concat(Temp_Str255_1, "\p5] Ability- ", st1),           true, 1);  NumToString(TheWeapon->Quality, st1);  G_Outln(PStr_Concat(Temp_Str255_1, "\p6] Quality- ", st1),           true, 1);  G_bCr();  G_bCr();}//-------------------------------------------------void DisplayArmor(ArmorRec *TheArmor, short Number){  Str255 st1;  Str255 Temp_Str255_1;  NumToString(Number, st1);  G_Outln(PStr_Concat(Temp_Str255_1, "\p---==", st1, "\p==---"),           true, 1);  G_Outln("\p0] Quit editing this Armor", true, 1);  G_Outln(PStr_Concat(Temp_Str255_1, "\p1] Name- ", TheArmor->name), true, 1);  NumToString(TheArmor->Defense, st1);  G_Outln(PStr_Concat(Temp_Str255_1, "\p2] Defense- ", st1),           true, 1);  NumToString(TheArmor->Class_2, st1);  G_Outln(PStr_Concat(Temp_Str255_1, "\p3] Class- ", st1), true,           1);  NumToString(TheArmor->Cost, st1);  G_Outln(PStr_Concat(Temp_Str255_1, "\p4] Cost- ", st1), true,           1);  NumToString(TheArmor->Ability, st1);  G_Outln(PStr_Concat(Temp_Str255_1, "\p5] Ability- ", st1),           true, 1);  NumToString(TheArmor->Quality, st1);  G_Outln(PStr_Concat(Temp_Str255_1, "\p6] Quality- ", st1),           true, 1);  G_bCr();  G_bCr();}//-------------------------------------------------void SaveWeapon(WeaponRec *TheWeapon, short WNum){  gWeaponFile->Set(WNum - 1, *TheWeapon);  gWeaponFile->Close();  G_bCr();}//-------------------------------------------------void SaveArmor(ArmorRec *TheArmor, short ANum){  gArmorFile->Set(ANum - 1, *TheArmor);  gArmorFile->Close();  G_bCr();}//-------------------------------------------------