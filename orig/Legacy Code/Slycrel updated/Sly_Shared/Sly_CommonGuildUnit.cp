#include "Builtins.h"#include "Sly_CommonGuildUnit.h"//-------------------------------------------------long NextLevelUp(long lvl){  // when calling this fuction (it's recursive) the lvl paramater    // is the Level that you want the required experience for           long exp;  if (lvl <= 1)     exp = BASEEXP;  else     exp = (gSlyExternal->GeneralPrefs.LevelUpDifficulty) * lvl * lvl * lvl + NextLevelUp(lvl - 1);  return exp;}//-------------------------------------------------void GiveNewLevel(CharacterPtr theChar, char Class_5){    switch (Class_5) {     case 'F':      theChar->FighterLvl++;      theChar->MaxHP += RandomBetween(4, 5 + theChar->FighterLvl);      theChar->HitPoints = theChar->MaxHP;      theChar->Speed++;      theChar->Strength += RandomBetween(1, 2);      theChar->Dexterity += RandomBetween(0, 1);      theChar->Fame++;      theChar->Flirt1 += RandomBetween(0, 2);      theChar->Flirt2 += RandomBetween(0, 2);      theChar->Movement = RandomBetween(theChar->Speed - theChar->Speed / 5,                               theChar->Speed + theChar->Speed / 5);      //add Fighting skills here      break;    case 'M':      theChar->MageLvl++;      theChar->MaxHP += RandomBetween(2, 3 + theChar->MageLvl);      theChar->HitPoints = theChar->MaxHP;      theChar->Speed++;      theChar->Strength += RandomBetween(0, 1);      theChar->Dexterity += RandomBetween(0, 1);      theChar->MaxPsyche += RandomBetween(1, 2);      theChar->Psyche = theChar->MaxPsyche;      theChar->Fame++;      theChar->Flirt1 += RandomBetween(0, 2);      theChar->Flirt2 += RandomBetween(0, 2);      theChar->Movement = RandomBetween(theChar->Speed - theChar->Speed / 5,                               theChar->Speed + theChar->Speed / 5);      //add Magic skills here      break;    case 'T':      theChar->ThiefLvl++;      theChar->MaxHP += RandomBetween(3, 4 + theChar->ThiefLvl);      theChar->HitPoints = theChar->MaxHP;      theChar->Speed += RandomBetween(1, 2);      theChar->Strength += RandomBetween(1, 2);      theChar->Dexterity += RandomBetween(1, 2);      theChar->Fame++;      theChar->Flirt1 += RandomBetween(0, 2);      theChar->Flirt2 += RandomBetween(0, 2);      theChar->Movement = RandomBetween(theChar->Speed - theChar->Speed / 5,                               theChar->Speed + theChar->Speed / 5);      //add Thieving skills here      break;  } //case  SaveChar(*gCharacter);  }//-------------------------------------------------