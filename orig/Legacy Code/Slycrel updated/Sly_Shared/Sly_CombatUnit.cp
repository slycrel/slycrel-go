#include <math.h>#include "Builtins.h"#include "PStrings.h"#include "Sly_CombatUnit.h"inline long abs(long a){	return (a >= 0) ? a : -a;}static short ShootArrow(short UserR, short UserC, short MonR, short MonC, short FinalR, short FinalC);static short ShootMonsterArrow(short MonR, short MonC, short UserR, short UserC, short FinalR, short FinalC);static void PosCursor(short x, short y);//-***********-Utils-***********-//-------------------------------------------------void GetTerrChar(short TheByte, Boolean ANSI, StringPtr terrChar){  Str255 Temp_Str255_1;  if (ANSI)     switch (TheByte) {       case 0:        PStr_Set(terrChar, PStr_Concat(Temp_Str255_1, "\p0;37;40m",                                        "\p "));        break;      case 1:        PStr_Set(terrChar, PStr_Concat(Temp_Str255_1, "\p0;32;40m",                                        "\p°"));        break;      case 2:        PStr_Set(terrChar, PStr_Concat(Temp_Str255_1, "\p0;33;40m",                                        "\p°"));        break;      case 3:        PStr_Set(terrChar, PStr_Concat(Temp_Str255_1, "\p0;34;40m",                                        "\p÷"));        break;      case 4:        PStr_Set(terrChar, PStr_Concat(Temp_Str255_1, "\p0;34;43m",                                        "\pð"));        break;      case 5:        PStr_Set(terrChar, PStr_Concat(Temp_Str255_1, "\p1;30;40m",                                        "\pí"));        break;      case 6:        PStr_Set(terrChar, PStr_Concat(Temp_Str255_1, "\p1;32;40m",                                        "\p\006"));        break;      case 7:        PStr_Set(terrChar, PStr_Concat(Temp_Str255_1, "\p0;32;40m",                                        "\p\006"));        break;      case 8:        PStr_Set(terrChar, PStr_Concat(Temp_Str255_1, "\p1;30;47m",                                        "\p±"));        break;      case 9:        PStr_Set(terrChar, PStr_Concat(Temp_Str255_1, "\p1;30;40m",                                        "\p²"));        break;      default:        PStr_Set(terrChar, PStr_Concat(Temp_Str255_1, "\p1;31;40m",                                        "\p"));        break;    }  else     switch (TheByte) {       case 0:        PStr_Set(terrChar, "\p ");        break;      case 1:        PStr_Set(terrChar, "\p°");        break;      case 2:        PStr_Set(terrChar, "\p°");        break;      case 3:        PStr_Set(terrChar, "\p÷");        break;      case 4:        PStr_Set(terrChar, "\pð");        break;      case 5:        PStr_Set(terrChar, "\pí");        break;      case 6:        PStr_Set(terrChar, "\p\006");        break;      case 7:        PStr_Set(terrChar, "\p\006");        break;      case 8:        PStr_Set(terrChar, "\p±");        break;      case 9:        PStr_Set(terrChar, "\p²");        break;      default:        PStr_Set(terrChar, "\p");        break;    }}//-------------------------------------------------void MovePlayer(char Direction, PtrToWord NewR, PtrToWord NewC, PtrToWord Movement, TerrainType *TheTerrain){  Str255 st1;  Str255 st2;  Str255 Temp_Str255_1;  NumToString(*NewR + 2, st1);  NumToString(*NewC + 2, st2);  G_ANSICode(PStr_Concat(Temp_Str255_1, st1, "\p;", st2, "\pH"));  GetTerrChar((*TheTerrain)[*NewR - 1][2*(*NewC) - 1], true, st1);  G_ANSICode(st1);  if ((*TheTerrain)[*NewR - 1][2*(*NewC) - 1] == 3) {    G_ANSICode("\p20;7H");    G_ANSICode("\p5;1;31m>>>Swwishhhh<<<");    G_bCr();    G_ANSICode("\p0;1;34m><>   Gurgle gurgle... blurp!   <><");    (*gCharacter)->Alive = false;    UserGlobPtr()->boardAction = None;    myPausePrompt("\p-=Press A Key=-");  } else {    switch (Direction) {       case 'I':        if (*NewR <= 1)           *NewR = 1;        else {          (*NewR)--;          if (!(NumMovePoints(*NewR, *NewC, TheTerrain) <= *Movement)) {            TextOut("\pNot \'nuff Movement to Move There.");            (*Movement)--;            (*NewR)++;          } else             *Movement -= NumMovePoints(*NewR, *NewC, TheTerrain);        }        break;      case 'J':        if (*NewC <= 1)           *NewC = 1;        else {          (*NewC)--;          if (!(NumMovePoints(*NewR, *NewC, TheTerrain) <= *Movement)) {            TextOut("\pNot \'nuff Movement to Move There.");            (*Movement)--;            (*NewC)++;          } else             *Movement -= NumMovePoints(*NewR, *NewC, TheTerrain);        }        break;      case 'K':        if (*NewR >= 12)           *NewR = 12;        else {          (*NewR)++;          if (!(NumMovePoints(*NewR, *NewC, TheTerrain) <= *Movement)) {            TextOut("\pNot \'nuff Movement to Move There.");            (*Movement)--;            (*NewR)--;          } else             *Movement -= NumMovePoints(*NewR, *NewC, TheTerrain);        }        break;      case 'L':        if (*NewC >= 48)           *NewC = 48;        else {          (*NewC)++;          if (!(NumMovePoints(*NewR, *NewC, TheTerrain) <= *Movement)) {            TextOut("\pNot \'nuff Movement to Move There.");            (*Movement)--;            (*NewC)--;          } else             *Movement -= NumMovePoints(*NewR, *NewC, TheTerrain);        }        break;    } // Case     NumToString(*NewR + 2, st1);    NumToString(*NewC + 2, st2);    G_ANSICode(PStr_Concat(Temp_Str255_1, st1, "\p;", st2, "\pH"));    G_ANSICode("\p1;34mè");  }}//-------------------------------------------------void MoveMonster(PtrToWord R, PtrToWord C, PtrToWord Ru, PtrToWord Cu, MonsterRec *Monster, TerrainType *TheTerrain){  short move;  coord playpos;  Byte indx;  Str255 route;  Str255 st1;  Str255 st2;  Str255 Temp_Str255_1;  playpos.variant.vc_2.r = *Ru;  playpos.variant.vc_2.c = *Cu;    move = Monster->Movement;    if (FindRoute(*R, *C, playpos, route)) {        indx = 0;    do {      indx++;      //fireyn()      NumToString(*R + 2, st1);      NumToString(*C + 2, st2);      G_ANSICode(PStr_Concat(Temp_Str255_1, st1, "\p;", st2, "\pH"));      GetTerrChar((*TheTerrain)[*R - 1][2*(*C) - 1], true, st1);      G_ANSICode(st1);            switch (route[indx]) {         case 'U':          (*R)--;          break;        case 'D':          (*R)++;          break;        case 'L':          (*C)--;          break;        case 'R':          (*C)++;          break;      }            if (*C < 1)         *C = 2;      if (*C > 48)         *C = 47;      if (*R < 1)         *R = 2;      if (*R > 12)         *R = 11;            NumToString(*R + 2, st1);      NumToString(*C + 2, st2);      G_ANSICode(PStr_Concat(Temp_Str255_1, st1, "\p;", st2, "\pH"));      G_ANSICode("\p0;31mœ");            if (RandomBetween(1, 5) == 1) {        move -= 3;        DoMonsterShoot(*R, *C, *Ru, *Cu);      }            UpdateMovement(move);            move -= NumMovePoints(*R, *C, TheTerrain);    } while (!(indx == PStr_Length(route) || move < 1));  }}//-------------------------------------------------short NumMovePoints(short R, short C, TerrainType *TheTerrain){  short value_NumMovePoints;  switch ((*TheTerrain)[R - 1][2*C - 1]) {     case 0:      value_NumMovePoints = 1;      break;    case 1:      value_NumMovePoints = 2;      break;    case 2:      value_NumMovePoints = 1;      break;    case 3:      value_NumMovePoints = 998;      break;    case 4:      value_NumMovePoints = 1;      break;    case 5:      value_NumMovePoints = 998;      break;    case 6:      value_NumMovePoints = 3;      break;    case 7:      value_NumMovePoints = 4;      break;    case 8:      value_NumMovePoints = 3;      break;    case 9:      value_NumMovePoints = 5;      break;    default:      value_NumMovePoints = 998;      break;  }  return value_NumMovePoints;}//-------------------------------------------------void UpdateMovement(Byte Movement){  Str255 st1;  Str255 Temp_Str255_1;  NumToString(Movement, st1);  G_ANSICode("\p0;31m");  G_ANSICode(PStr_Concat(Temp_Str255_1, "\p5;65H", "\p    "));  G_ANSICode(PStr_Concat(Temp_Str255_1, "\p5;65H", st1));}//-------------------------------------------------Boolean CanMove(short R, short C, short Movement, TerrainType *TheTerrain){  Boolean CheckNorth;  Boolean CheckSouth;  Boolean CheckEast;  Boolean CheckWest;  Boolean value_CanMove;  CheckNorth = true;  CheckSouth = true;  CheckEast = true;  CheckWest = true;  value_CanMove = false;  // Checks to see if they're on the border...   if (C + 1 > 48)     CheckEast = false;  if (C - 1 < 1)     CheckWest = false;  if (R + 1 > 12)     CheckSouth = false;  if (R - 1 < 1)     CheckNorth = false;    if (CheckNorth)     if (Movement >= NumMovePoints(R, C - 1, TheTerrain))       value_CanMove = true;    if (CheckSouth)     if (Movement >= NumMovePoints(R, C + 1, TheTerrain))       value_CanMove = true;    if (CheckEast)     if (Movement >= NumMovePoints(R + 1, C, TheTerrain))       value_CanMove = true;    if (CheckWest)     if (Movement >= NumMovePoints(R - 1, C, TheTerrain))       value_CanMove = true;  return value_CanMove;}//-------------------------------------------------void SpaceToDot(StringPtr TheString){  short x;  short forEnd_1 = PStr_Length(TheString);  for (x = 1; x <= forEnd_1; ++x) {    if (TheString[x] == char(32))       TheString[x] = char(250);  }}//-------------------------------------------------inline double Distance(double x1, double y1, double x2, double y2){	double dx = x1 - x2;	double dy = y1 - y2;	return sqrt(dx*dx + dy*dy);}short ShootArrow(short UserR, short UserC, short MonR, short MonC, short FinalR, short FinalC){  Boolean HitTerrain;  Boolean HitMonster;  Boolean OutOfBounds;  Boolean FellShort;  short ArrowR;  short ArrowC;  short ChanceHit;  short Damage;  Str255 st1;  Str255 st2;  Str255 st3;  Str255 st4;  double Dist;  short value_ShootArrow;  Str255 Temp_Str255_1;    short dx, dy, steps;  double x_increment;  double y_increment;  double x;  double y;    HitTerrain = false;  HitMonster = false;  OutOfBounds = false;  FellShort = false;  ArrowR = UserR;  ArrowC = UserC;  Dist = 0;  value_ShootArrow = 0;    dx = FinalR - UserR;  dy = FinalC - UserC;  if (abs(dx) > abs(dy))    steps = abs(dx);  else    steps = abs(dy);  if (steps == 0)    return 0;  x_increment = double(dx)/double(steps);  y_increment = double(dy)/double(steps);  x = UserR;  y = UserC;    while (!(HitTerrain || HitMonster || OutOfBounds || FellShort)) {    x = x + x_increment;    y = y + y_increment;        ArrowR = Round(x);    ArrowC = Round(y);    Dist = Distance(ArrowR, ArrowC, UserR, UserC);        if (ArrowR > 12 || ArrowR < 1 || ArrowC < 1 || ArrowC > 48) {      value_ShootArrow = 0;      OutOfBounds = true;    }        if (!OutOfBounds) {      //Draws New Arrow      NumToString(ArrowR + 2, st1);      NumToString(ArrowC + 2, st2);      PStr_Set(st3, PStr_Concat(Temp_Str255_1, st1, "\p;", st2, "\pH"));      G_ANSICode(st3);      G_ANSICode("\p1;33;40m+");      //Re-Draws the Terrain over old arrow      NumToString(ArrowR + 2, st1);      NumToString(ArrowC + 2, st2);      PStr_Set(st3, PStr_Concat(Temp_Str255_1, st1, "\p;", st2, "\pH"));      G_ANSICode(st3);      GetTerrChar(gSlyPrivates->Terrain[ArrowR - 1][2*ArrowC - 1], true, st4);      G_ANSICode(st4);            if (Dist >= (*gCharacter)->Weapons[1].Range) {        FellShort = true;        value_ShootArrow = 0;      }            ChanceHit = NumMovePoints(ArrowR, ArrowC, &gSlyPrivates->Terrain);      if (gSlyPrivates->Terrain[ArrowR - 1][2*ArrowC - 1] == 3)   //fixes water bug        ChanceHit = 1;      if (RandomBetween(1, 100) < ChanceHit) {        value_ShootArrow = -gSlyPrivates->Terrain[ArrowR - 1][2*ArrowC - 1];        HitTerrain = true;      }            if (ArrowR == MonR && ArrowC == MonC) {        HitMonster = true;        NumToString(gSlyPrivates->monsR + 2, st1);        NumToString(gSlyPrivates->monsC + 2, st2);        G_ANSICode(PStr_Concat(Temp_Str255_1, st1, "\p;", st2, "\pH"));        G_ANSICode("\p0;31mœ");        CharacterPtr with_1 = *gCharacter;        Damage = with_1->Weapons[1].Strike - gSlyPrivates->Monster.Defense / 4 + RandomBetween(-with_1->Weapons[1].Strike / 5,                                                                                          with_1->Weapons[1].Strike / 5);        if (Damage < 0)           Damage = 0;        value_ShootArrow = Damage;      }          }  }                                               //While    return value_ShootArrow;}//-------------------------------------------------void DoShoot(short UserRow, short UserColumn, short MonsterRow, short MonsterColumn){  short HitTarget;  Str255 st1;  Str255 st2;  Str255 Temp_Str255_1;  short shootRow;  short shootColumn;  shootColumn = RandomBetween(MonsterColumn-1, MonsterColumn+1);  shootRow = RandomBetween(MonsterRow-1, MonsterRow+1);    HitTarget = ShootArrow(UserRow, UserColumn, MonsterRow, MonsterColumn, shootRow, shootColumn);    if (HitTarget > 0) {    gSlyPrivates->Monster.HitPoints = gSlyPrivates->Monster.HitPoints - HitTarget;    NumToString(HitTarget, st1);    PStr_Set(st1, PStr_Concat(Temp_Str255_1, "\pYou hit the ", gSlyPrivates->Monster.name,                               "\p for ", st1, "\p Damage."));    TextOut(st1);  } else     switch (HitTarget) {       case -4:        TextOut("\pYour Shot Fell Short!");        break;      case -5:        TextOut("\pYour Shot Bounces off a Boulder!");        break;      case -6:        TextOut("\pYour Aim isn\'t very good, it hit a TREE!");        break;      case -7:        TextOut("\pAww.. Too Bad, Hit a Tree...");        break;      case -8:        TextOut("\pIt Hit a Swamp Thingy!");        break;      case -9:        TextOut("\pArgh!  Take some Lessons!");        break;      default:        TextOut("\pYou COMPLETLY Miss.");        break;    }    (*gCharacter)->Movement = (*gCharacter)->Movement - 3;  NumToString(MonsterRow + 2, st1);  NumToString(MonsterColumn + 2, st2);  G_ANSICode(PStr_Concat(Temp_Str255_1, st1, "\p;", st2, "\pH"));  G_ANSICode("\p0;31mœ");  }//-------------------------------------------------short ShootMonsterArrow(short MonR, short MonC, short UserR, short UserC, short FinalR, short FinalC){  Boolean HitTerrain;  Boolean HitMonster;  Boolean OutOfBounds;  Boolean FellShort;  short ArrowR;  short ArrowC;  short ChanceHit;  short Damage;  Str255 st1;  Str255 st2;  Str255 st3;  Str255 st4;  double Dist;  short value_ShootMonsterArrow;  Str255 Temp_Str255_1;    short dx, dy, steps;  double x_increment;  double y_increment;  double x;  double y;  HitTerrain = false;  HitMonster = false;  OutOfBounds = false;  FellShort = false;  ArrowR = MonR;  ArrowC = MonC;  Dist = 0;  value_ShootMonsterArrow = 0;    dx = FinalR - MonR;  dy = FinalC - MonC;  if (abs(dx) > abs(dy))    steps = abs(dx);  else    steps = abs(dy);  if (steps == 0)    return 0;  x_increment = double(dx)/double(steps);  y_increment = double(dy)/double(steps);  x = MonR;  y = MonC;    while (!(HitTerrain || HitMonster || OutOfBounds || FellShort)) {    x = x + x_increment;    y = y + y_increment;        ArrowR = Round(x);    ArrowC = Round(y);    Dist = Distance(ArrowR, ArrowC, MonR, MonC);        if (ArrowR > 12 || ArrowR < 1 || ArrowC < 1 || ArrowC > 48) {      value_ShootMonsterArrow = 0;      OutOfBounds = true;    }        if (!OutOfBounds) {      //Draws New Arrow      NumToString(ArrowR + 2, st1);      NumToString(ArrowC + 2, st2);      PStr_Set(st3, PStr_Concat(Temp_Str255_1, st1, "\p;", st2, "\pH"));      G_ANSICode(st3);      G_ANSICode("\p1;33;40m+");      //Re-Draws the Terrain over old arrow      NumToString(ArrowR + 2, st1);      NumToString(ArrowC + 2, st2);      PStr_Set(st3, PStr_Concat(Temp_Str255_1, st1, "\p;", st2, "\pH"));      G_ANSICode(st3);      GetTerrChar(gSlyPrivates->Terrain[ArrowR - 1][2*ArrowC - 1], true,                   st4);      G_ANSICode(st4);            if (Dist >= gSlyPrivates->Monster.RangeOffense) {        FellShort = true;        value_ShootMonsterArrow = 0;      }            ChanceHit = NumMovePoints(ArrowR, ArrowC, &gSlyPrivates->Terrain);      if (gSlyPrivates->Terrain[ArrowR - 1][2*ArrowC - 1] == 3)   //fixes water bug        ChanceHit = 1;      if (RandomBetween(1, 100) < ChanceHit) {        value_ShootMonsterArrow = -gSlyPrivates->Terrain[ArrowR - 1][2*ArrowC - 1];        HitTerrain = true;      }            if (ArrowR == UserR && ArrowC == UserC) {        HitMonster = true;        NumToString(gSlyPrivates->monsR + 2, st1);        NumToString(gSlyPrivates->monsC + 2, st2);        G_ANSICode(PStr_Concat(Temp_Str255_1, st1, "\p;", st2, "\pH"));        G_ANSICode("\p0;31mœ");        Damage = gSlyPrivates->Monster.RangeOffense - ((*gCharacter)->Armor[0].Defense) / 3 + RandomBetween(-gSlyPrivates->Monster.Offense / 4,                                                                                                       gSlyPrivates->Monster.Offense / 5);        if (Damage < 0)           Damage = 0;        value_ShootMonsterArrow = Damage;      }          }  }                                               //While    return value_ShootMonsterArrow;}//-------------------------------------------------void DoMonsterShoot(short MonsterRow, short MonsterColumn, short UserRow, short UserColumn){  short HitTarget;  Str255 st1;  Str255 st2;  Str255 Temp_Str255_1;  short shootRow;  short shootColumn;  shootColumn = RandomBetween(UserColumn-1, UserColumn+1);  shootRow = RandomBetween(UserRow-1, UserRow+1);    HitTarget = ShootMonsterArrow(MonsterRow, MonsterColumn, UserRow, UserColumn, shootRow, shootColumn);    if (HitTarget > 0) {    (*gCharacter)->HitPoints = (*gCharacter)->HitPoints - HitTarget;    NumToString(HitTarget, st1);    PStr_Set(st1, PStr_Concat(Temp_Str255_1, "\pYou are hit by the ",                               gSlyPrivates->Monster.name, "\p for ",                               st1, "\p Damage."));    TextOut(st1);  } else     switch (HitTarget) {       case -4:        TextOut("\pIt\'s Shot Fell Short!");        break;      case -5:        TextOut("\pIt\'s Shot Bounces off a Boulder!");        break;      case -6:        TextOut("\pIt\' Aim isn\'t very good, it hit a TREE!");        break;      case -7:        TextOut("\pAww.. Too Bad, It Hit a Tree...");        break;      case -8:        TextOut("\pIt Hit a Swamp Thingy!");        break;      case -9:        TextOut(PStr_Concat(Temp_Str255_1, "\pYou Laugh at the ",                             gSlyPrivates->Monster.name));        break;      default:        TextOut("\pThe Monster COMPLETLY Misses!");        break;    }    NumToString(UserRow + 2, st1);  NumToString(UserColumn + 2, st2);  G_ANSICode(PStr_Concat(Temp_Str255_1, st1, "\p;", st2, "\pH"));  G_ANSICode("\p1;34mè");}//-------------------------------------------------void initCellMap(void){  Byte R;  Byte C;  for (R = 1; R <= 12; ++R)     for (C = 1; C <= 48; ++C) {      gSlyPrivates->cellMap[R - 1][C - 1].weight = 32700;      gSlyPrivates->cellMap[R - 1][C - 1].direction = ' ';      gSlyPrivates->cellMap[R - 1][C - 1].chosen = false;    }  gSlyPrivates->Head = NULL;  gSlyPrivates->Head->next = NULL;}//-------------------------------------------------void removeCell(coord pos){  LookUpptr currp;  LookUpptr delptr;  Boolean found;  currp = gSlyPrivates->Head;  found = false;  if (currp->pos.variant.vc_2.r == pos.variant.vc_2.r && currp->pos.variant.vc_2.c == pos.variant.vc_2.c) {    if (currp->next == NULL) {      currp = NULL;      gSlyPrivates->Head = NULL;      DisposePtr(Ptr(gSlyPrivates->Head));    } else {      delptr = currp;      currp = currp->next;      gSlyPrivates->Head = currp;      DisposePtr(Ptr(delptr));    }  } else {    do       if (currp->next->pos.variant.vc_2.r == pos.variant.vc_2.r && currp->next->pos.variant.vc_2.c == pos.variant.vc_2.c)         found = true;      else         currp = currp->next;    while (!(found || currp->next == NULL));    delptr = currp->next;    currp->next = currp->next->next;    DisposePtr(Ptr(delptr));  }}//-------------------------------------------------void addCell(coord pos){  LookUpptr currp;  LookUpptr newp;  Boolean found;  if (gSlyPrivates->Head == NULL) {    gSlyPrivates->Head = LookUpptr(NewPtr(sizeof(lookuprec)));    FailNIL((Ptr)gSlyPrivates->Head);    gSlyPrivates->Head->next = NULL;    gSlyPrivates->Head->pos = pos;  } else if (gSlyPrivates->cellMap[gSlyPrivates->Head->pos.variant.vc_2.r - 1][gSlyPrivates->Head->pos.variant.vc_2.c - 1].weight > gSlyPrivates->cellMap[pos.variant.vc_2.r - 1][pos.variant.vc_2.c - 1].weight) {    newp = LookUpptr(NewPtr(sizeof(lookuprec)));    FailNIL((Ptr)newp);    newp->pos = pos;    newp->next = gSlyPrivates->Head;    gSlyPrivates->Head = newp;  } else {        newp = LookUpptr(NewPtr(sizeof(lookuprec)));    FailNIL((Ptr)newp);    newp->pos = pos;    newp->next = NULL;        currp = gSlyPrivates->Head;    found = false;    do       if (currp->next == NULL) {        currp->next = newp;        found = true;      } else if (gSlyPrivates->cellMap[currp->next->pos.variant.vc_2.r - 1][currp->next->pos.variant.vc_2.c - 1].weight > gSlyPrivates->cellMap[newp->pos.variant.vc_2.r - 1][newp->pos.variant.vc_2.c - 1].weight) {        newp->next = currp->next;        currp->next = newp;        found = true;      } else         currp = currp->next;    while (!(found));  }                                               //else}//-------------------------------------------------void CheckForDupes(coord pos){  LookUpptr currp;  Boolean found;  currp = gSlyPrivates->Head;  found = false;    if (currp != NULL)     while (currp->next != NULL && !found) {      if (currp->pos.variant.vc_2.r == pos.variant.vc_2.r && currp->pos.variant.vc_2.c == pos.variant.vc_2.c) {        removeCell(pos);        found = true;      }      currp = currp->next;    }}//-------------------------------------------------void getLowestWeight(coord *pos){  *pos = gSlyPrivates->Head->pos;  removeCell(*pos);}//-------------------------------------------------Boolean FindRoute(Byte R, Byte C, coord dest, StringPtr route){  Str255 st1;  char tmpdirection;  coord currpos;  coord tmppos;  long counter;  //Postcondition :   string which contains full route to destination  //Result                : route returned in string VAR paramater;  //                                  if dest was found, return true   Boolean value_FindRoute;  Str255 Temp_Str255_1;    initCellMap();    currpos.variant.vc_2.r = R;  currpos.variant.vc_2.c = C;  gSlyPrivates->cellMap[currpos.variant.vc_2.r - 1][currpos.variant.vc_2.c - 1].weight = NumMovePoints(currpos.variant.vc_2.r,                                                                                                        currpos.variant.vc_2.c,                                                                                                        &gSlyPrivates->Terrain);  gSlyPrivates->cellMap[currpos.variant.vc_2.r - 1][currpos.variant.vc_2.c - 1].chosen = true;    counter = 0;  do {    counter++;        //                  PrintList;    //UP    if (currpos.variant.vc_2.r - 1 > 0)       if (!gSlyPrivates->cellMap[(currpos.variant.vc_2.r - 1) - 1][currpos.variant.vc_2.c - 1].chosen)         if (gSlyPrivates->cellMap[currpos.variant.vc_2.r - 1][currpos.variant.vc_2.c - 1].weight + NumMovePoints(currpos.variant.vc_2.r - 1,                                                                                                                  currpos.variant.vc_2.c,                                                                                                                  &gSlyPrivates->Terrain) < gSlyPrivates->cellMap[(currpos.variant.vc_2.r - 1) - 1][currpos.variant.vc_2.c - 1].weight) {          gSlyPrivates->cellMap[(currpos.variant.vc_2.r - 1) - 1][currpos.variant.vc_2.c - 1].weight = gSlyPrivates->cellMap[currpos.variant.vc_2.r - 1][currpos.variant.vc_2.c - 1].weight + NumMovePoints(currpos.variant.vc_2.r - 1,                                                                                                                                                                                                             currpos.variant.vc_2.c,                                                                                                                                                                                                             &gSlyPrivates->Terrain);          gSlyPrivates->cellMap[(currpos.variant.vc_2.r - 1) - 1][currpos.variant.vc_2.c - 1].direction = 'D';                    tmppos = currpos;          tmppos.variant.vc_2.r = tmppos.variant.vc_2.r - 1;                    CheckForDupes(tmppos);          addCell(tmppos);        }    //DOWN    if (currpos.variant.vc_2.r + 1 < 13)       if (!gSlyPrivates->cellMap[currpos.variant.vc_2.r + 1 - 1][currpos.variant.vc_2.c - 1].chosen)         if (gSlyPrivates->cellMap[currpos.variant.vc_2.r - 1][currpos.variant.vc_2.c - 1].weight + NumMovePoints(currpos.variant.vc_2.r + 1,                                                                                                                  currpos.variant.vc_2.c,                                                                                                                  &gSlyPrivates->Terrain) < gSlyPrivates->cellMap[currpos.variant.vc_2.r + 1 - 1][currpos.variant.vc_2.c - 1].weight) {          gSlyPrivates->cellMap[currpos.variant.vc_2.r + 1 - 1][currpos.variant.vc_2.c - 1].weight = gSlyPrivates->cellMap[currpos.variant.vc_2.r - 1][currpos.variant.vc_2.c - 1].weight + NumMovePoints(currpos.variant.vc_2.r + 1,                                                                                                                                                                                                           currpos.variant.vc_2.c,                                                                                                                                                                                                           &gSlyPrivates->Terrain);          gSlyPrivates->cellMap[currpos.variant.vc_2.r + 1 - 1][currpos.variant.vc_2.c - 1].direction = 'U';                    tmppos = currpos;          tmppos.variant.vc_2.r = tmppos.variant.vc_2.r + 1;                    CheckForDupes(tmppos);          addCell(tmppos);        }    //LEFT    if (currpos.variant.vc_2.c - 1 > 0)       if (!gSlyPrivates->cellMap[currpos.variant.vc_2.r - 1][(currpos.variant.vc_2.c - 1) - 1].chosen)         if (gSlyPrivates->cellMap[currpos.variant.vc_2.r - 1][currpos.variant.vc_2.c - 1].weight + NumMovePoints(currpos.variant.vc_2.r,                                                                                                                  currpos.variant.vc_2.c - 1,                                                                                                                  &gSlyPrivates->Terrain) < gSlyPrivates->cellMap[currpos.variant.vc_2.r - 1][(currpos.variant.vc_2.c - 1) - 1].weight) {          gSlyPrivates->cellMap[currpos.variant.vc_2.r - 1][(currpos.variant.vc_2.c - 1) - 1].weight = gSlyPrivates->cellMap[currpos.variant.vc_2.r - 1][currpos.variant.vc_2.c - 1].weight + NumMovePoints(currpos.variant.vc_2.r,                                                                                                                                                                                                             currpos.variant.vc_2.c - 1,                                                                                                                                                                                                             &gSlyPrivates->Terrain);          gSlyPrivates->cellMap[currpos.variant.vc_2.r - 1][(currpos.variant.vc_2.c - 1) - 1].direction = 'R';                    tmppos = currpos;          tmppos.variant.vc_2.c = tmppos.variant.vc_2.c - 1;                    CheckForDupes(tmppos);          addCell(tmppos);        }    //RIGHT    if (currpos.variant.vc_2.c + 1 < 49)       if (!gSlyPrivates->cellMap[currpos.variant.vc_2.r - 1][currpos.variant.vc_2.c + 1 - 1].chosen)         if (gSlyPrivates->cellMap[currpos.variant.vc_2.r - 1][currpos.variant.vc_2.c - 1].weight + NumMovePoints(currpos.variant.vc_2.r,                                                                                                                  currpos.variant.vc_2.c + 1,                                                                                                                  &gSlyPrivates->Terrain) < gSlyPrivates->cellMap[currpos.variant.vc_2.r - 1][currpos.variant.vc_2.c + 1 - 1].weight) {          gSlyPrivates->cellMap[currpos.variant.vc_2.r - 1][currpos.variant.vc_2.c + 1 - 1].weight = gSlyPrivates->cellMap[currpos.variant.vc_2.r - 1][currpos.variant.vc_2.c - 1].weight + NumMovePoints(currpos.variant.vc_2.r,                                                                                                                                                                                                           currpos.variant.vc_2.c + 1,                                                                                                                                                                                                           &gSlyPrivates->Terrain);          gSlyPrivates->cellMap[currpos.variant.vc_2.r - 1][currpos.variant.vc_2.c + 1 - 1].direction = 'L';                    tmppos = currpos;          tmppos.variant.vc_2.c = tmppos.variant.vc_2.c + 1;                    CheckForDupes(tmppos);          addCell(tmppos);        }        getLowestWeight(&currpos);    gSlyPrivates->cellMap[currpos.variant.vc_2.r - 1][currpos.variant.vc_2.c - 1].chosen = true;      } while (!(currpos.variant.vc_2.r == dest.variant.vc_2.r && currpos.variant.vc_2.c == dest.variant.vc_2.c || counter >= 1050));    if (counter >= 1050)     value_FindRoute = false;  else     value_FindRoute = true;    //put string, switch and reverse    PStr_Set(route, "\p");    do {    switch (gSlyPrivates->cellMap[currpos.variant.vc_2.r - 1][currpos.variant.vc_2.c - 1].direction) {       case 'U':        currpos.variant.vc_2.r = currpos.variant.vc_2.r - 1;        tmpdirection = 'D';        break;      case 'D':        currpos.variant.vc_2.r = currpos.variant.vc_2.r + 1;        tmpdirection = 'U';        break;      case 'L':        currpos.variant.vc_2.c = currpos.variant.vc_2.c - 1;        tmpdirection = 'R';        break;      case 'R':        currpos.variant.vc_2.c = currpos.variant.vc_2.c + 1;        tmpdirection = 'L';        break;    }    st1[0] = 1;    st1[1] = tmpdirection;    PStr_Set(route, PStr_Concat(Temp_Str255_1, st1, route));  } while (!(currpos.variant.vc_2.r == R && currpos.variant.vc_2.c == C));    cleanupList();    return value_FindRoute;}//-------------------------------------------------void cleanupList(void){  LookUpptr currp;  LookUpptr delptr;  currp = gSlyPrivates->Head;  do {    delptr = currp;    currp = currp->next;    DisposePtr(Ptr(delptr));  } while (currp != NULL);  }//-------------------------------------------------/*void PrintList(void){  LookUpptr currp;  if (gSlyPrivates->Head != NULL) {    currp = gSlyPrivates->Head;    while (currp->next != NULL) {      cout << "\pw: " << gSlyPrivates->cellMap[currp->pos.variant.vc_2.r - 1][currp->pos.variant.vc_2.c - 1].weight << "\p r: " << currp->pos.variant.vc_2.r << "\p c: " << currp->pos.variant.vc_2.c << "\n";      currp = currp->next;    }  }}*///-------------------------------------------------//-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-//-***********-Files-***********-//-------------------------------------------------void GetTerrain(StringPtr WhatTerrain, TerrainType *TheTerrain){  TTerrainFile terrainFile(TerrainPath, WhatTerrain);  terrainFile.Get(*TheTerrain);  terrainFile.Close();}//-------------------------------------------------void GetMonster(StringPtr MonsterType, short WhatMonster, MonsterRec *TheMonster){  TMonsterFile monsterFile(MonsterPath, MonsterType);  monsterFile.Get(WhatMonster - 1, *TheMonster);  monsterFile.Close();}//-------------------------------------------------//-***********-Screen-***********-//-------------------------------------------------void PosCursor(short x, short y){  Str255 Xstr;  Str255 Ystr;  Str255 where;  Str255 Temp_Str255_1;  NumToString(x, Xstr);  NumToString(y, Ystr);  PStr_Set(where, PStr_Concat(Temp_Str255_1, Ystr, "\p;", Xstr, "\pH"));  G_ANSICode(where);}//-------------------------------------------------void DrawCombatField(TerrainType *TheTerrain){  short Current;  short Last;  short R;  short C;  Str255 st1;  Str255 st2;  Str255 TheLine;  Str255 Temp_Str255_1;    for (R = 1; R <= 12; ++R) {    Current = -1;    Last = -1;    PStr_Set(TheLine, "\p");    NumToString(R + 2, st1);    BufferANSI(PStr_Concat(Temp_Str255_1, st1, "\p;3H"), false);        for (C = 1; C <= 48; ++C) {      Last = Current;      Current = (*TheTerrain)[R - 1][2*C - 1];      if (Last != Current) {        if (PStr_Cmp(TheLine, "\p") != 0)           BufferANSI(TheLine, false);        GetTerrChar((*TheTerrain)[R - 1][2*C - 1], true, TheLine);      } else {        GetTerrChar((*TheTerrain)[R - 1][2*C - 1], false, st2);        PStr_Set(TheLine, PStr_Concat(Temp_Str255_1, TheLine, st2));      }    }                                             // for c         BufferANSI(TheLine, false);  }                                               // for r     ReleaseBuffer(gHermSetup->procs[vReleaseBuffer]);} // procedure //-------------------------------------------------void DrawCharInfo(CharacterPtr TheCharacter){  Str255 st1;  Str255 Temp_Str255_1;  BufferANSI("\p4;56H", false);  BufferANSI("\p0;35m-", false);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p0;36m", TheCharacter->name), false);    BufferANSI("\p5;65H", false);  NumToString(TheCharacter->Movement, st1);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p0;32m", st1), false);    BufferANSI("\p6;65H", false);  NumToString(TheCharacter->HitPoints, st1);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p0;32m", st1), false);  BufferANSI("\p0;34m/", false);  NumToString(TheCharacter->MaxHP, st1);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p0;32m", st1), false);    BufferANSI("\p7;65H", false);  NumToString(TheCharacter->Psyche, st1);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p0;32m", st1), false);  BufferANSI("\p0;34m/", false);  NumToString(TheCharacter->MaxPsyche, st1);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p0;32m", st1), false);    BufferANSI("\p9;57H", false);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p0;35m", TheCharacter->Weapons[0].name), false);    BufferANSI("\p10;57H", false);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p0;35m", TheCharacter->Weapons[1].name), false);    BufferANSI("\p11;57H", false);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p0;35m", TheCharacter->Weapons[2].name), false);    BufferANSI("\p13;57H", false);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p0;35m", TheCharacter->Armor[0].name), false);    BufferANSI("\p14;57H", false);  BufferANSI(PStr_Concat(Temp_Str255_1, "\p0;35m", TheCharacter->Armor[1].name), false);    ReleaseBuffer(gHermSetup->procs[vReleaseBuffer]);}//-------------------------------------------------void TextOut(const StringPtr TheString){  short x;  Str255 st1;  Str255 st2;  Str255 Temp_Str255_1;  Str255 outStr;  PStr_Set(outStr, TheString);  G_ANSICode("\p1;30;40m");  gSlyPrivates->TextOutln = gSlyPrivates->TextOutln + 1;    if (gSlyPrivates->TextOutln > 5) {    gSlyPrivates->TextOutln = 1;    G_ANSICode("\p18;2H");    G_ANSICode(PStr_Concat(Temp_Str255_1, "\p1;30;40m", outStr));    PStr_Set(st2, "\p;2H");    SpaceOut(st2, 47);    SpaceToDot(st2);    for (x = 1; x <= 5; ++x) {      NumToString(x + 17, st1);      G_ANSICode(PStr_Concat(Temp_Str255_1, st1, st2));    }  }    NumToString(gSlyPrivates->TextOutln + 17, st1);  G_ANSICode(PStr_Concat(Temp_Str255_1, st1, "\p;2H"));  SpaceOut(outStr, 47);  SpaceToDot(outStr);  G_ANSICode(PStr_Concat(Temp_Str255_1, "\p1;30;40m", outStr));  }//-------------------------------------------------//-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-