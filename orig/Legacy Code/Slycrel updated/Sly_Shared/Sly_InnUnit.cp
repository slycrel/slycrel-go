#include "Builtins.h"#include "PStrings.h"#include "Sly_InnUnit.h"//-------------------------------------------------void FReadInnData(InnRec *InnData){  gInnFile->Get(*InnData);  gInnFile->Close();}//-------------------------------------------------void FWriteInnData(InnRec *InnData){  gInnFile->Set(*InnData);  gInnFile->Close();}//-------------------------------------------------Boolean AddToRooms(StringPtr PlayerName, Byte Days, Byte TheLock){  short x;  InnRec InnData;  Boolean found;  Boolean value_AddToRooms;  found = false;  FReadInnData(&InnData);    x = 0;  while (x < 10 && !found) {    x++;    if (PStr_Cmp(InnData.Rooms[x - 1].Who, "\pEmpty") == 0)       found = true;  }    if (found) {    PStr_Set(InnData.Rooms[x - 1].Who, PlayerName);    InnData.Rooms[x - 1].DaysLeft = Days;    InnData.Rooms[x - 1].Lock = TheLock;  }    value_AddToRooms = found;  FWriteInnData(&InnData);  return value_AddToRooms;}//-------------------------------------------------Byte EmptyRoom(StringPtr CharName){  short x;  InnRec InnData;  Boolean HasRoom;  Boolean found;  Byte value_EmptyRoom;  found = false;  HasRoom = false;  FReadInnData(&InnData);    for (x = 1; x <= 10; ++x) {    if (PStr_Cmp(InnData.Rooms[x - 1].Who, "\pEmpty") == 0)       found = true;    if (PStr_Cmp(InnData.Rooms[x - 1].Who, CharName) == 0)       HasRoom = true;  }  if (HasRoom)     value_EmptyRoom = 3;  else if (!found)     value_EmptyRoom = 2;  else     value_EmptyRoom = 0;  return value_EmptyRoom;}//-------------------------------------------------void DisplayInnKeeperMenu(void){  G_Outln("\p 1]- Set Daily Room Charge.", true, 5);  G_Outln("\p 2]- View Players In Room.", true, 5);  G_Outln("\p 3]- Kick Player Out of Room.", true, 5);  G_Outln("\p 4]- List Inn Stats", true, 5);  G_Outln("\p 5]- Close Inn", true, 5);  G_Outln("\p 6]- Give Inn to somebody else.", true, 5);  G_Outln("\p Q]- Quit", true, 5);}//-------------------------------------------------void ChangeRate(short NewRate){  InnRec InnData;  FReadInnData(&InnData);  InnData.CurRate = NewRate;  FWriteInnData(&InnData);}//-------------------------------------------------void ListRooms(void){  InnRec InnData;  short x;  Str255 st1;  Str255 st2;  Str255 Temp_Str255_1;  FReadInnData(&InnData);  G_Outln("\p##) Name                                Days      Lock",           true, 2);  G_Outln("\p컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴",           true, 2);  for (x = 1; x <= 10; ++x) {    NumToString(x, st1);    PStr_Set(st1, PStr_Concat(Temp_Str255_1, st1, "\p)  ", InnData.Rooms[x - 1].Who));    SpaceOut(st1, 40);    G_Outln(st1, true, 1);    NumToString(InnData.Rooms[x - 1].DaysLeft, st1);    NumToString(InnData.Rooms[x - 1].Lock, st2);    SpaceOut(st1, 10);    G_Outln(PStr_Concat(Temp_Str255_1, st1, st2), false, 3);  }  G_Outln("\p컴컴袴袴袴羔컴컴컴컴컴컴컴컴", true, 2);  G_bCr();  G_bCr();}//-------------------------------------------------void RemovePlayerFromInn(Byte long1){  InnRec InnData;  FReadInnData(&InnData);  PStr_Set(InnData.Rooms[long1 - 1].Who, "\pEmpty");  InnData.Rooms[long1 - 1].DaysLeft = 0;  InnData.Rooms[long1 - 1].Lock = 255;  FWriteInnData(&InnData);}//-------------------------------------------------void ViewInnStats(void){  InnRec InnData;  Str255 st1;  short x;  Str255 Temp_Str255_1;  FReadInnData(&InnData);  G_Outln("\p[-------------------]", true, 2);  for (x = 1; x <= 10; ++x)     G_Outln(PStr_Concat(Temp_Str255_1, st1, "\p)  ", InnData.Rooms[x - 1].Who), true, 1);  G_Outln("\p[-------------------]", true, 2);  G_bCr();  NumToString(InnData.CurRate, st1);  G_Outln(PStr_Concat(Temp_Str255_1, "\pCurrent Rate:  ", st1),           true, 1);  NumToString(InnData.Safe, st1);  G_Outln(PStr_Concat(Temp_Str255_1, "\pSafe $$:  ", st1), true,           1);  G_Outln(PStr_Concat(Temp_Str255_1, InnData.Owner, "\p currently owns this inn."), true, 1);  if (InnData.Open)     G_Outln("\pThe Inn is open to the public.", true, 1);  else     G_Outln("\pThe Inn is closed to the public.", true, 1);  G_bCr();  G_bCr();}//-------------------------------------------------void CloseInn(Boolean Closed){  InnRec InnData;  FReadInnData(&InnData);  InnData.Open = Closed;  FWriteInnData(&InnData);}//-------------------------------------------------short RoomCostPerDay(void){  InnRec InnData;  FReadInnData(&InnData);  return InnData.CurRate;}//-------------------------------------------------void NewInnOwner(StringPtr NewOwner){  InnRec InnData;  FReadInnData(&InnData);  ucase(NewOwner);  PStr_Set(InnData.Owner, NewOwner);  FWriteInnData(&InnData);}//-------------------------------------------------