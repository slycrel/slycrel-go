#include "Builtins.h"#include "PStrings.h"#include "Sly_TextCombatUnit.h"//-------------------------------------------------Boolean RollInitiative(void){  short int1;  Boolean value_RollInitiative;  int1 = (*gCharacter)->Movement - gSlyPrivates->Monster.Movement;  if (int1 + RandomBetween(0, 3) < 0)     value_RollInitiative = false;  else     value_RollInitiative = true;  return value_RollInitiative;}//-------------------------------------------------short DoDamage(Boolean User){  short damage;  if (User) {    CharacterPtr with_1 = *gCharacter;    if ((with_1->ThiefLvl + with_1->MageLvl + with_1->FighterLvl) / 3 <= 4) {      damage = RandomBetween(Round((with_1->Strength * 0.75 + with_1->Weapons[0].Strike) * 1.25),                    Round((with_1->Strength / 0.75 + with_1->Weapons[0].Strike) * 1.35)) - gSlyPrivates->Monster.Defense;      if (damage < 2)         damage = RandomBetween(0, 2);    } else       damage = RandomBetween(Round(with_1->Strength / 2 + with_1->Weapons[0].Strike),                    Round((with_1->Strength / 2 + with_1->Weapons[0].Strike) * 1.25)) - gSlyPrivates->Monster.Defense;  } else                                          //if this is the monster then    damage = RandomBetween(Trunc(gSlyPrivates->Monster.Offense * 0.35), Trunc(gSlyPrivates->Monster.Offense * 1.35)) - (*gCharacter)->Armor[0].Defense;  if (damage < 0)     damage = 0;  return damage;}//-------------------------------------------------void ParseText(StringPtr TheString){  Str255 MWeapon;  Str255 UWeapon;  Str255 MName;  short where;  Str255 Temp_Str255_1;  PStr_Set(MWeapon, gSlyPrivates->Monster.AttackStr1);  PStr_Set(UWeapon, (*gCharacter)->Weapons[0].name);  if (PStr_Cmp((*gCharacter)->Weapons[2].name, "\pHands") != 0 || PStr_Cmp((*gCharacter)->Weapons[0].name, (*gCharacter)->Weapons[1].name) == 0)     PStr_Set(UWeapon, PStr_Concat(Temp_Str255_1, UWeapon, "\p x2"));  PStr_Set(MName, gSlyPrivates->Monster.name);  if (PStr_Cmp(TheString, "\p") == 0) {    G_bCr();  } else {    where = PStr_Pos("\p%mweapon", TheString);    if (where != 0) {      PStr_Delete(TheString, where, 8);      PStr_Insert(MWeapon, TheString, where);    }    where = PStr_Pos("\p%mname", TheString);    if (where != 0) {      PStr_Delete(TheString, where, 6);      PStr_Insert(MName, TheString, where);    }    where = PStr_Pos("\p%uweapon", TheString);    if (where != 0) {      PStr_Delete(TheString, where, 8);      PStr_Insert(UWeapon, TheString, where);    }                                             //if  }                                               //else}//-------------------------------------------------void InitiativeText(Boolean GotInitiative){  short damage;  Str255 st1;  Str255 Temp_Str255_1;  if (GotInitiative) {    G_ANSICode("\p0m");    switch (RandomBetween(0, 6)) {       case 0:        G_ANSICode("\p0m     You close with the vile ");        G_ANSICode(PStr_Concat(Temp_Str255_1, "\p0;31m", gSlyPrivates->Monster.name, "\p, "));        G_ANSICode("\p0mand snarl in defiance.");        G_bCr();        G_ANSICode("\p0mThe ");        G_ANSICode(PStr_Concat(Temp_Str255_1, "\p0;31m", gSlyPrivates->Monster.name, "\p "));        G_ANSICode("\p0mquakes in fear as you ready your ");        G_ANSICode(PStr_Concat(Temp_Str255_1, "\p0;34m", (*gCharacter)->Weapons[0].name, "\p "));        G_ANSICode("\p0mand square off...");        break;      case 1:        G_ANSICode("\p0m    The terrifying ");        G_ANSICode(PStr_Concat(Temp_Str255_1, "\p0;31m", gSlyPrivates->Monster.name, "\p "));        G_ANSICode("\p0mquickly closes as you begin laughing.");        G_bCr();        G_ANSICode("\p0mThis is going to be as easy as flirting with Corenne...");        break;      case 2:        G_ANSICode("\p0m     A strange feeling comes over you as you begin the");        G_bCr();        G_ANSICode("\p0mmelee.  A curse of rage is thrown your way from the");        G_bCr();        G_ANSICode(PStr_Concat(Temp_Str255_1, "\p0;31m", gSlyPrivates->Monster.name));        G_ANSICode("\p0m in a guttural tongue...");        break;      case 3:        G_ANSICode("\p0mThe ");        G_ANSICode(PStr_Concat(Temp_Str255_1, "\p0;31m", gSlyPrivates->Monster.name));        G_ANSICode("\p0m leaps at you , inhuman appendages flailing. ");        G_bCr();        G_ANSICode("\p0mYou bring up your arms in defense as ");        G_ANSICode(PStr_Concat(Temp_Str255_1, "\p0;31m", gSlyPrivates->Monster.name, "\p "));        G_bCr();        G_ANSICode("\p0mcrashes into you.  The battle begins!");        break;      case 4:        G_ANSICode("\p0mYou ready your ");        G_ANSICode(PStr_Concat(Temp_Str255_1, "\p1;32m", (*gCharacter)->Weapons[0].name, "\p "));        G_ANSICode("\p0mand prepare for the oncoming fray.");        G_bCr();        G_ANSICode("\p0mThe surrounding terrain goes silent as you face off with the ");        G_ANSICode(PStr_Concat(Temp_Str255_1, "\p0;31m", gSlyPrivates->Monster.name));        break;      case 5:        G_ANSICode("\p0mThe ");        G_ANSICode(PStr_Concat(Temp_Str255_1, "\p0;31m", gSlyPrivates->Monster.name, "\p "));        G_ANSICode("\p0mlooks surprised that you do not quake in fear, and");        G_bCr();        G_ANSICode("\p0mstarts waving it\'s ");        G_ANSICode(PStr_Concat(Temp_Str255_1, "\p0;31m", gSlyPrivates->Monster.AttackStr1, "\p "));        G_ANSICode("\p0menacingly, attempting to ward you");        G_bCr();        G_ANSICode("\p0moff.  You gleefully close for the kill!");        break;      case 6:        G_ANSICode("\p0mAs you close with the ");        G_ANSICode(PStr_Concat(Temp_Str255_1, "\p0;31m", gSlyPrivates->Monster.name));        G_ANSICode("\p0m, you cannot help but");        G_bCr();        G_ANSICode("\p0mcompare it to your sixth grade teacher, Grizelda.  As");        G_bCr();        G_ANSICode("\p0mthe fight begins, you resolve to rid the world of both");        G_bCr();        G_ANSICode("\p0mhideous beings...");        break;    }        //Case  } else {    switch (RandomBetween(7, 9)) {       case 7:        G_ANSICode("\p0m     You cannot flee.  The ");        G_ANSICode(PStr_Concat(Temp_Str255_1, "\p0;31m", gSlyPrivates->Monster.name, "\p "));        G_ANSICode("\p0mslashes at your back,");        G_bCr();        G_ANSICode("\p0mcutting a painful gash in your left shoulder.  You turn,");        G_bCr();        G_ANSICode("\p0mand ready your ");        G_ANSICode(PStr_Concat(Temp_Str255_1, "\p0;34m", (*gCharacter)->Weapons[0].name, "\p, "));        G_ANSICode("\p0mconvinced that");        G_bCr();        G_ANSICode("\p0myou are about to die...");        damage = DoDamage(false);        break;      case 8:        G_ANSICode("\p0m     You bring up your ");        G_ANSICode(PStr_Concat(Temp_Str255_1, "\p1;32m", (*gCharacter)->Weapons[0].name, "\p, "));        G_ANSICode("\p0massured that you can");        G_bCr();        G_ANSICode("\p0mdefeat the ");        G_ANSICode(PStr_Concat(Temp_Str255_1, "\p0;31m", gSlyPrivates->Monster.name, "\p."));        G_ANSICode("\p0m  As silence descends on the surrounding");        G_bCr();        G_ANSICode("\p0marea, you start to wonder where the ");        G_ANSICode(PStr_Concat(Temp_Str255_1, "\p0;31m", gSlyPrivates->Monster.name));        G_bCr();        G_ANSICode("\p0mhas gone to.  The sudden slice in your back whips you around,");        G_bCr();        G_ANSICode("\p0mthe fight already started...");        damage = DoDamage(false);        break;      case 9:        G_ANSICode("\p0m You bring up your ");        G_ANSICode(PStr_Concat(Temp_Str255_1, "\p0;34m", (*gCharacter)->Weapons[0].name, "\p, "));        G_ANSICode("\p0massured that you");        G_bCr();        G_ANSICode("\p0mcan defeat the ");        G_ANSICode(PStr_Concat(Temp_Str255_1, "\p0;31m", gSlyPrivates->Monster.name, "\p."));        G_ANSICode("\p0m  As silence descends, you begin to");        G_bCr();        G_ANSICode("\p0mwonder where that ");        G_ANSICode(PStr_Concat(Temp_Str255_1, "\p0;31m", gSlyPrivates->Monster.name, "\p "));        G_ANSICode("\p0mhas gone to.  The sudden");        G_bCr();        G_ANSICode("\p0mslice in your back flips you around, the fiend already");        G_bCr();        G_ANSICode("\p0mpreparing for another strike...");        damage = DoDamage(false);        break;    } //case    NumToString(damage, st1);    if (damage > 0) {      (*gCharacter)->HitPoints = (*gCharacter)->HitPoints - damage;      PStr_Set(st1, PStr_Concat(Temp_Str255_1, "\p\033", "\p[0;37mYou are hit For ",                                 "\p\033", "\p[0;31m", st1, "\p\033",                                 "\p[0;37m Damage."));      G_Outln(st1, true, 0);      G_bCr();    }  }}//-------------------------------------------------void GetMainCombatText(short UserHP, short UserMax, short MonsterHP, short MonsterMax){  enum DispositionType {    MgoodUgood = 1,    MgoodUbad = 2,    MbadUgood = 3,    MokUok = 4,    MokUgood = 5,    MokUbad = 6,    MgoodUok = 7,    MbadUok = 8,    MbadUbad = 9  };  typedef enum DispositionType DispositionType;    const short strListID1 = 128;  const short strListID2 = 129;    DispositionType Disp;  Str255 MName;  Str255 MWeapon;  Str255 UWeapon;  short int1;  short int2;  short x;  Str255 st1;  Str255 st2;  Str255 Temp_Str255_1;  PStr_Set(MName, gSlyPrivates->Monster.name);  PStr_Set(MWeapon, gSlyPrivates->Monster.AttackStr1);  PStr_Set(UWeapon, (*gCharacter)->Weapons[0].name);  if (PStr_Cmp((*gCharacter)->Weapons[2].name, "\pHands") != 0 || PStr_Cmp((*gCharacter)->Weapons[0].name, (*gCharacter)->Weapons[1].name) == 0)     PStr_Set(UWeapon, PStr_Concat(Temp_Str255_1, UWeapon, "\p x2"));  if (UserHP != 0)    int1 = Round((double(UserHP) / double(UserMax)) * 100.0);  else    int1 = 0;  if (MonsterHP != 0)    int2 = Round((double(MonsterHP) / double(MonsterMax)) * 100.0);  else    int2 = 0;  if (int1 >= 70) {    if (int2 >= 70)       Disp = MgoodUgood;    else if (int2 < 70 && int2 >= 35)       Disp = MokUgood;    else if (int2 < 35)       Disp = MbadUgood;  }                                               //if int1 >= 70  else if (int1 <= 70 && int1 >= 35) {    if (int2 >= 70)       Disp = MgoodUok;    else if (int2 < 70 && int2 >= 35)       Disp = MokUok;    else if (int2 < 35)       Disp = MbadUok;  }                                               //else if (int1 <= 70) and (int1 >= 35)   else if (int1 <= 35) {    if (int2 >= 70)       Disp = MgoodUbad;    else if (int2 < 70 && int2 >= 35)       Disp = MokUbad;    else if (int2 < 35)       Disp = MbadUbad;  }                                               //else if int1 <= 35    switch (gSlyPrivates->Monster.MonType) {     case Humanoid:      int1 = 1;      break;    case Orc:      int1 = 2;      break;    case Goblin:      int1 = 3;      break;    case Fairy:      int1 = 4;      break;    case Insectoid:      int1 = 5;      break;    case Fantastic:      int1 = 6;      break;    case Elven:      int1 = 7;      break;    case FElemental:      int1 = 8;      break;    case WElemental:      int1 = 9;      break;    case EElemental:      int1 = 10;      break;    case AElemental:      int1 = 11;      break;    case Dwarven:      int1 = 12;      break;    case Evil:      int1 = 18;  // don't have strings for these yet      break;    case Good:      int1 = 18;  // so they default to the strings      break;    case Flying:      int1 = 18;  // for the other monster type      break;    case Undead:      int1 = 18;  // .....      break;    case psychic:      int1 = 17;      break;    case Other:      int1 = 18;      break;  } //case    // if disposition not printed  if (Disp != gSlyPrivates->lastDisposition) {        // print current disposition only once    gSlyPrivates->lastDisposition = Disp;        // choose and print strings based on user and monster disposition    x = 9 * int1 - 9 + Disp;      GetIndString(st1, strListID1, x);    GetIndString(st2, strListID2, x);      ParseText(st1);    ParseText(st2);      G_bCr();    WBOutln(st1, 7);    WBOutln(st2, 7);    G_bCr();  }}//-------------------------------------------------void CalcUserMove(char Move, PtrToWord LoopVal, PtrToWord AdvMoves){  short damage;  short TotDamage;  short x;  Str255 st1;  Str255 Temp_Str255_1;  if (Move == 'A') {    gSlyPrivates->userMove = Attack;    G_Outln("\pYou attack the sucker!", true, 1);    G_bCr();    if (gSlyPrivates->monMove == Attack)       TotDamage = DoDamage(true);    else if (gSlyPrivates->monMove == Block)       TotDamage = DoDamage(true) / 2;    else if (gSlyPrivates->monMove == Parry)       TotDamage = Round(DoDamage(true) * 0.6);    else if (gSlyPrivates->monMove == Dodge) {      if (RandomBetween(1, (*gCharacter)->Dexterity) < gSlyPrivates->Monster.Movement / 3)         damage = 0;      G_Outln("\pThe monster laughs as it dodges your attack.", true, 5);      G_bCr();    }        if (TotDamage > 0) {      NumToString(TotDamage, st1);      G_Outln(PStr_Concat(Temp_Str255_1, "\pYou hit the monster for ", st1, "\p damage."), true, 2);      gSlyPrivates->Hit = TheUser;    } else if (damage <= 0) {      G_bCr();      G_Outln("\pYou miss!", true, 6);      G_bCr();    }        if (*AdvMoves > 0) {      for (x = 1; x <= *AdvMoves; ++x) {        damage = DoDamage(true);        TotDamage += damage;        NumToString(damage, st1);        G_Outln(PStr_Concat(Temp_Str255_1, "\pAgain, You hit the vile fiend for ",                             st1, "\p Damage!"), true, 1);        gSlyPrivates->Hit = TheUser;      }      G_bCr();      G_bCr();      *LoopVal -= *AdvMoves;    }                                             //else if    gSlyPrivates->Monster.HitPoints = gSlyPrivates->Monster.HitPoints - TotDamage;    gSlyPrivates->Hit = TheUser;  } else if (Move == 'B') {    gSlyPrivates->userMove = Block;    gSlyPrivates->Hit = UserMiss;    *LoopVal -= *AdvMoves;  } else if (Move == 'P') {    gSlyPrivates->userMove = Parry;    gSlyPrivates->Hit = TheUser;    TotDamage = DoDamage(true) / 3;    NumToString(TotDamage, st1);    if (TotDamage > 0)       G_Outln(PStr_Concat(Temp_Str255_1, "\pYou parry, slicing the monster for ",                           st1, "\p damage."), true, 1);    else       G_Outln("\pYou raise your weapon, ready to parry.", true, 3);    G_bCr();    gSlyPrivates->Monster.HitPoints = gSlyPrivates->Monster.HitPoints - TotDamage;    *LoopVal -= *AdvMoves;  } else if (Move == 'D') {    gSlyPrivates->userMove = Dodge;    gSlyPrivates->Hit = UserMiss;    *LoopVal -= *AdvMoves;  } else if (Move == 'S') {    gSlyPrivates->userMove = Special;    gSlyPrivates->Hit = UserMiss;    G_bCr();    G_Outln("\pOkay, you sit there and feel special.", true, 1);    *LoopVal -= *AdvMoves;  } else if (Move == 'R') {    G_bCr();    G_Outln("\pYou attempt escape...", true, 2);    G_bCr();    gSlyPrivates->Hit = UserRan;    gSlyPrivates->userMove = Special;  }  G_bCr();}//-------------------------------------------------CombatType rndMonsterAttack(Boolean Run){  Byte int1;  CombatType value_rndMonsterAttack;  int1 = RandomBetween(1, 50);  if (gSlyPrivates->monsR / 20 > gSlyPrivates->Monster.HitPoints)     Run = true;  else     Run = false;  switch (int1) {     case 1:    case 2:     case 3:     case 4:     case 5:     case 6:     case 7:     case 8:     case 9:     case 10:     case 11:     case 12:     case 13:     case 14:     case 15:     case 16:     case 17:     case 18:     case 19:     case 20:     case 21:     case 22:     case 23:     case 24:     case 25:       value_rndMonsterAttack = Attack;      break;    case 26:    case 27:     case 28:     case 29:     case 30:       value_rndMonsterAttack = Parry;      break;    case 31:    case 32:     case 33:     case 34:     case 35:     case 36:     case 37:       value_rndMonsterAttack = Block;      break;    case 38:    case 39:     case 40:     case 41:     case 42:     case 43:     case 44:       value_rndMonsterAttack = Dodge;      break;    case 45:    case 46:     case 47:     case 48:     case 49:     case 50:       if (Run)         gSlyPrivates->Hit = OpponentRan;      else         value_rndMonsterAttack = Attack;      break;  }  return value_rndMonsterAttack;}//-------------------------------------------------void MonsterAttacks(CombatType UserMove, short AdvMoves){  short damage;  Str255 st1;  CombatType MnMove;  Boolean boo1;  short x;  short TotDamage;  Str255 Temp_Str255_1;  TotDamage = 0;  damage = 0;  if (gSlyPrivates->monsR < ((*gCharacter)->MaxHP) / 4)     boo1 = true;  MnMove = rndMonsterAttack(boo1);  switch (MnMove) {     case Attack:      gSlyPrivates->monMove = Attack;      damage = DoDamage(false);      if (UserMove == Parry)         damage = Round(damage * 0.6);      if (UserMove == Block)         damage /= 2;      if (UserMove == Special) {        damage = Round(damage * 1.75);        G_Outln("\pYou feel VERY special now.", true, 2);        G_bCr();      }      if (UserMove == Dodge) {        if (RandomBetween(1, gSlyPrivates->Monster.Movement) < (*gCharacter)->Dexterity)           damage = 0;        G_Outln("\pYou Dodge successfully!", true, 5);        G_bCr();      }            if (damage > 0) {        G_bCr();        G_Outln("\pThe monster attacks you!", true, 3);        G_bCr();        NumToString(damage, st1);        G_Outln(PStr_Concat(Temp_Str255_1, "\pYou are hit for ", st1,                             "\p damage.  (Feel better yet?)"),                 true, 1);        G_bCr();        if (AdvMoves > 0) {          for (x = 1; x <= AdvMoves; ++x) {            damage = DoDamage(false);            if (UserMove == Parry)               damage = Round(damage * 0.6);            if (UserMove == Block)               damage /= 2;            if (UserMove == Special)               damage = Round(damage * 1.75);            if (UserMove == Dodge) {              if (RandomBetween(1, gSlyPrivates->Monster.Movement) < (*gCharacter)->Dexterity)                 damage = 0;              G_Outln("\pYou Dodge successfully!", true, 5);            }            TotDamage += damage;            NumToString(damage, st1);            G_Outln(PStr_Concat(Temp_Str255_1, "\pYou are hit again for ",                                 st1, "\p damage!"), true, 7);            gSlyPrivates->Hit = Opponent;          }          gSlyPrivates->Hit = Opponent;          G_bCr();        }        else           TotDamage = damage;        (*gCharacter)->HitPoints = (*gCharacter)->HitPoints - TotDamage;        if (gSlyPrivates->Hit == TheUser)           gSlyPrivates->Hit = Both;        if (gSlyPrivates->Hit == UserMiss || gSlyPrivates->Hit == _none)           gSlyPrivates->Hit = OpponentOnly;      } else         G_Outln("\pThe monster misses you!", true, 7);            if (TotDamage <= 0 && gSlyPrivates->Hit == TheUser)         gSlyPrivates->Hit = UserOnly;      else if (TotDamage <= 0 && (gSlyPrivates->Hit == UserMiss || gSlyPrivates->Hit == _none))         gSlyPrivates->Hit = Neither;      break;        case Block:      G_Outln("\pThe monster keeps it\'s distance, circling warily.",               true, 1);      G_bCr();      gSlyPrivates->monMove = Block;      if (gSlyPrivates->Hit == TheUser)         gSlyPrivates->Hit = UserOnly;      else         gSlyPrivates->Hit = Neither;      break;        case Parry:      G_bCr();      G_Outln("\pThe monster darts in and out, you aren\'t quite sure if it\'s attacking or not.",               true, 2);      G_bCr();      gSlyPrivates->monMove = Parry;      if (gSlyPrivates->Hit == TheUser)         gSlyPrivates->Hit = UserOnly;      else         gSlyPrivates->Hit = OpponentOnly;      break;        case Dodge:      G_bCr();      G_Outln("\pThe monster backs away, hissing at you, looking like a coiled spring, ready to  snap...",               true, 3);      G_bCr();      gSlyPrivates->monMove = Dodge;            if (gSlyPrivates->Hit == TheUser)         gSlyPrivates->Hit = UserOnly;      else         gSlyPrivates->Hit = Neither;      break;  }    //case}//-------------------------------------------------