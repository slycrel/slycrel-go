#include "Builtins.h"#include "PStrings.h"#include "UExternal.h"TPrivates *gUtilPrivates;TExternal *gExternal;void SetNextState(short newStage){  gUtilPrivates->SetNextState(newStage);}void SetReturnState(short stage){  gUtilPrivates->SetReturnState(stage);}void PopReturnState(void){  gUtilPrivates->PopReturnState();}TPrivates::TPrivates(void){  gUtilPrivates = this;  activeOn = false;  stage = 0;  returnStage = 0;}TPrivates::~TPrivates(void){  gUtilPrivates = NULL;}void TPrivates::CloseNode(void){}void TPrivates::SetNextState(short newStage){  stage = newStage;}void TPrivates::SetReturnState(short stage){  returnStage = stage;}void TPrivates::PopReturnState(void){  stage = returnStage;}TExternal::TExternal(StringPtr inName){  PStr_Set(mName, inName);}TExternal::~TExternal(void){  gExternal = NULL;}void TExternal::AllocatePreferences(void){  // Should Override }void TExternal::AllocatePrivates(void){  // Should Override }void TExternal::DeletePreferences(void){  // Should Override }void TExternal::DeletePrivates(void){  // Should Override }void TExternal::HandleDoInitialize(void){  AllocatePreferences();}void TExternal::HandleCreateNodeVars(void){  if (gUtilPrivates == NULL)     AllocatePrivates();  else {    DeletePrivates();    AllocatePrivates();  }}void TExternal::HandleDoMaintenance(void){}void TExternal::HandleCallLogon(void){}void TExternal::HandleCallMenu(void){}void TExternal::HandleIdle(void){}void TExternal::HandleGameIdle(void){}void TExternal::HandleCloseNode(void){  DeletePrivates();}void TExternal::HandleCloseExternal(void){  DeletePrivates();  DeletePreferences();}void TExternal::HandleActiveExternal(void){  // Must be overridden }void TExternal::SetupGlobalVariables(void){  // global gExternal and gHermSetup are already set  gUtilPrivates = (TPrivates *) gHermSetup->privates;}void TExternal::SaveGlobalVariables(void){  // if fatal error then don't run again  if (gDeadExternal)    gExternal = NULL;  gHermSetup->privates = Handle(gUtilPrivates);  gHermSetup->prefs = Handle(gExternal);}TFile::TFile(const Str255 fullPath)	: mOpen(false),	  mRefNum(0),	  mExists(false){	PStr_Concat(mName, filesPath(), fullPath);	try {		FailOSErr(FSOpen(mName, vRefNum, &mRefNum));		mOpen = true;		mExists = true;	}	catch (...) {	}}TFile::TFile(const Str255 path, const Str255 fileName)	: mOpen(false),	  mRefNum(0),	  mExists(false){	PStr_Concat(mName, filesPath(), path, fileName);}TFile::~TFile(void){	if (mOpen)		Close();}Boolean TFile::Exists(void){	try {		if (!mOpen) {			FailOSErr(FSOpen(mName, vRefNum, &mRefNum));			FailOSErr(FSClose(mRefNum));			mExists = true;		} else			mExists = true;	} catch (...) {		mExists = false; // shouldn't really need this	}	return mExists;}void TFile::Create(void){	try {		long version = 1;		FailOSErr(::Create(mName, vRefNum, 'HRMS', 'DATA'));		Write(sizeof(long), &version);		mExists = true;		Open();	} catch (...) {		WriteDebugText(mName);		ReportFatalError("\pMacOS Error: unable to create file!");	}}void TFile::Open(void){	if (!mOpen) {		try {			FailOSErr(FSOpen(mName, vRefNum, &mRefNum));			mOpen = true;			mExists = true;		} catch (...) {			WriteDebugText(mName);			ReportFatalError("\pMacOS Error: unable to open file!");		}	}}void TFile::SetPosition(long offSet){	try {		Open();		FailOSErr(SetFPos(mRefNum, fsFromStart, offSet+sizeof(long)));	} catch (...) {		WriteDebugText(mName);		ReportFatalError("\pMacOS Error: unable to set file position!");	}}long TFile::GetPosition(void){	long filePosition;		try {		Open();		FailOSErr(GetFPos(mRefNum, &filePosition));		filePosition -= sizeof(long);	} catch(...) {		WriteDebugText(mName);		ReportFatalError("\pMacOS Error: unable to get file position!");	}	return filePosition;}long TFile::GetSize(void){	long fileSize;		try {		Open();		FailOSErr(GetEOF(mRefNum, &fileSize));		fileSize -= sizeof(long);	} catch (...) {		WriteDebugText(mName);		ReportFatalError("\pMacOS Error: unable to find file size!");	}	return fileSize;}Boolean TFile::IsEOF(void){	long fileSize;	long filePosition;	Open();	filePosition = GetPosition();	fileSize = GetSize();	if (filePosition >= fileSize) 		return true;	else 		return false;}void TFile::Read(long byteCount, void *bytePtr){	try {		Open();		FailOSErr(FSRead(mRefNum, &byteCount, bytePtr));	} catch (...) {		WriteDebugText(mName);		ReportFatalError("\pMacOS Error: unable to read from file!");	}}void TFile::Write(long byteCount, void *bytePtr){	try {		Open();		FailOSErr(FSWrite(mRefNum, &byteCount, bytePtr));	} catch (...) {		WriteDebugText(mName);		ReportFatalError("\pMacOS Error: unable to write to file!");	}}void TFile::Close(void){	if (mOpen) {		try {			FailOSErr(FSClose(mRefNum));			mRefNum = 0;			mOpen = false;		} catch (...) {			WriteDebugText(mName);			ReportFatalError("\pMacOS Error: unable to close file!");		}	}}void TFile::Delete(void){	if (mExists) {		try {			Close();			FailOSErr(FSDelete(mName, vRefNum));			mRefNum = 0;			mOpen = false;			mExists = false;		} catch (...) {			WriteDebugText(mName);			ReportFatalError("\pMacOS Error: unable to delete file!");		}	}}void _WriteDebugText(StringPtr ToWrite){  G_Outln(ToWrite, true, 6);}void _DebugError(short error){  Str255 errorStr;  Str255 stageStr;  Str255 Temp_Str255_1;  NumToString(error, errorStr);  NumToString(gUtilPrivates->stage, stageStr);  G_Outln(PStr_Concat(Temp_Str255_1, "\pError #", errorStr, "\p in stage #",                       stageStr), true, 6);}void FailMemError(void){  OSErr error;  error = MemError();  if (error != noErr) {    gLastError = error;#if cDebugLevel > 0    ReportError(gLastError);#endif    throw TMacOSErr(error);  }}void FailNIL(void *p){  if (p == NULL) {    gLastError = memFullErr;#if cDebugLevel > 0    ReportError(gLastError);#endif    throw TMacOSErr(memFullErr);  }}void FailOSErr(short error){  if (error != noErr) {    gLastError = error;#if cDebugLevel > 0    ReportError(gLastError);#endif    throw TMacOSErr(error);  }}void FailResError(void){  OSErr error;  error = ResError();  if (error != noErr) {    gLastError = error;#if cDebugLevel > 0    ReportError(gLastError);#endif    throw TMacOSErr(error);  }}void ReportKindError(StringPtr errorStr){  G_Outln("\pAn error occured in Slycrel!", true, 6);  ReportError(gLastError);  G_Outln(errorStr, true, 6);  G_Outln("\pPlease notify the Sysop!", true, 6);}void ReportStageError(StringPtr errorStr){  G_Outln("\pAn error occured in Slycrel!", true, 6);  ReportError(gLastError);  G_Outln(errorStr, true, 6);  G_Outln("\pPlease notify the Sysop!", true, 6);  throw TMacOSErr(gLastError);}void ReportFatalError(StringPtr errorStr){  G_Outln("\pA fatal error occured in Slycrel!", true, 6);  ReportError(gLastError);  G_Outln(errorStr, true, 6);  G_Outln("\pPlease notify the Sysop!", true, 6);  throw TMacOSErr(gLastError);}void ReportDeadError(StringPtr errorStr){  G_Outln("\pA fatal error occured in Slycrel!", true, 6);  ReportError(gLastError);  G_Outln(errorStr, true, 6);  gDeadExternal = true;  throw TMacOSErr(gLastError);}