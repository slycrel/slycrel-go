#include "Builtins.h"#include "PStrings.h"#include "ExternalUtils.h"UserXIPtr gHermSetup;                             // global for access to HermSetup passed to MAIN OSErr gLastError;                                 // last error number thrown Boolean gDeadExternal;                            // if true then external won't run PtrToWord curNode(void){  return gHermSetup->curNode;}SystPtr HSystPtr(void){  return gHermSetup->hSystPtr;}HermUserGlobPtr UserGlobPtr(void){  return gHermSetup->n[*curNode() - 1];}const StringPtr filesPath(void){  return gHermSetup->filesPath;}void G_Outln(StringPtr goingOut, Boolean NLatBegin, short typeLine){  Outln(goingOut, NLatBegin, typeLine, gHermSetup->procs[vOutln]);}void G_bCr(void){  bCr(gHermSetup->procs[vbCr]);}void G_BufferbCr(void){  BufferbCr(gHermSetup->procs[vBufferbCr]);}void G_ANSICode(StringPtr theCode){  ANSICode(theCode, gHermSetup->procs[vANSICode]);}void G_LettersPrompt(StringPtr prompt, StringPtr accepted, short sizeLimit, Boolean auto_3, Boolean wrap, Boolean capital, char replace){  LettersPrompt(prompt, accepted, sizeLimit, auto_3, wrap, capital,                 replace, gHermSetup->procs[vLettersPrompt]);}void G_ANSIPrompter(short numChars){  ANSIPrompter(numChars, gHermSetup->procs[vANSIPrompter]);}void G_YesNoQuestion(StringPtr prompt, Boolean yesIsDefault){  YesNoQuestion(prompt, yesIsDefault, gHermSetup->procs[vYesNoQuestion]);}void G_LogThis(StringPtr logIt, short rsrv){  LogThis(logIt, rsrv, gHermSetup->procs[vLogThis]);}Boolean G_FExist(StringPtr FNmPth){  return FExist(FNmPth, gHermSetup->procs[vFExist]);}Boolean G_ReadTextFile(StringPtr fileName, short storedAs, Boolean insertPath){  return ReadTextFile(fileName, storedAs, insertPath, gHermSetup->procs[vReadTextFile]);}void G_NumbersPrompt(StringPtr prompt, StringPtr accepted, long high, long low){  NumbersPrompt(prompt, accepted, high, low, gHermSetup->procs[vNumbersPrompt]);}void G_ClearScreen(void){  ClearScreen(gHermSetup->procs[vClearScreen]);}void G_BufferIt (Str255 goingOut, Boolean NLatBegin, short typeLine){	BufferIt(goingOut, NLatBegin, typeLine, gHermSetup->procs[vBufferIt]);}void LockHandle(Handle h){  MoveHHi(h);  HNoPurge(h);  HLock(h);}void WBOutln(StringPtr goingOut, short typeLine){  Str255 remaining;  Str255 output;  short i;    PStr_Set(remaining, goingOut);  while (PStr_Length(remaining) > 0) {  	if (PStr_Length(remaining) < 80) {      G_Outln(remaining, false, typeLine);      G_bCr();      PStr_Set(remaining, "\p");    }    else {      for (i = 79; i >= 1; i--)        if (remaining[i] == ' ')          break;      // if word takes up entire line then print it all      if (i < 1)        i = 79;      PStr_Copy(output, remaining, 1, i);      G_Outln(output, false, typeLine);      G_bCr();      PStr_Copy(output, remaining, i+1, PStr_Length(remaining) - i);      PStr_Set(remaining, output);    }  }}