program Encode_Decode;uses	Types;const	TotalTypeable = 94;	{the maximum # of typable chars ' ' - '~'}	MaxTypeable = 126;	{Maximum ordinal value of a typeable character}	MinTypeable = 32;		{Minimum ordinal value of a typeable character}											{add MinTypeable to the modded #'s, makes them typable (32-126)}	CharShift = 3;			{determines how many chars the strings are shifted}	BitRollVal = 5;			{determines how many places to roll the bits in a char by}	SlyVersion = 250;		{format:  2.1.0 = 210}	ModNumber = 85;			{mod the shifted chars by this #, should be less then 94}		BBSNameLength = 10;		{Determines # of chars the BBS Name encryption holds SlySerialNum}	BBSSerialLength = 7;	{Determines # of chars the BBS SerialNum encryption holds SlySerialNum}	SysOpNameLength = 8;	{Determines # of chars the SysOp Name encryption holds SlySerialNum}	FillerCharacters = '1AFCCAF22459C287D82F';	{used as 'filler' if the length isn't long enough}	FillerCharacters2 = 'C1A245FCC287DAF2982F';	{used as 'filler' if the length isn't long enough}	FillerCharacters3 = '2FD829C287FCCA1A245F';	{used as 'filler' if the length isn't long enough}{	One thing you'll wanna remember, VALID serial numbers will always contain 'Kh8' starting	at character 10 and ending at character 12, they will ALSO have '\h2' tacked on the end.i						     ___                ___				3P?F]5E1AKh8F3P?F]5E3P?F]5E2\h2				lhn40EE3gKh8A3PM#x_83PrfrF2x\h2				jF*EFbb84Kh803Phf40F3P7FF*E8\h2				78J#CT3g1Kh8AWh23g8-3P8F_122\h2				         ~~~                ~~~	Those are four 'example' serial numbers...}{-------------------------------------------}procedure EncodeString(ToEncode: str255; var result: str255);	var		x: integer;		tempStr: str255;		tempChar: char;			begin		Writeln('Encoded string = ''', ToEncode, '''');		tempStr := '';		result := '';		for x := 1 to length(ToEncode) do			begin				tempChar := char( ord(ToEncode[x]) + CharShift );				Write('-',ord(tempChar):3);				tempChar := char( BRotL(ord(tempChar), BitRollVal) );				Write('-',ord(tempChar):3);				tempChar := char( (ord(tempChar) + SlyVersion) mod (ModNumber) );					Write('-',ord(tempChar):3);				tempChar := char( ord(tempChar) + MinTypeable );				Write('-',ord(tempChar):3);				case ord(tempChar) of					32..37:		tempStr := concat(tempStr, tempChar, '8F', tempChar);					38..45: 	tempStr := concat(tempStr, tempChar, '28E');					46..50: 	tempStr := concat(tempStr, 'C93AF');					51..56: 	tempStr := concat(tempStr, tempChar, '48FF0');					57..62: 	tempStr := concat(tempStr, 'Fq_;', tempChar);					63..68: 	tempStr := concat(tempStr, tempChar, 'j39Fbh', tempChar);					69..73: 	tempStr := concat(tempStr, 'DEA', tempChar);					74..79: 	tempStr := concat(tempStr, tempChar, 'ghF#@8');					80..86: 	tempStr := concat(tempStr, '3CPsv', tempChar);					87..95: 	tempStr := concat(tempStr, tempChar, ';hF582');					96..99: 	tempStr := concat(tempStr, tempChar, tempChar, 'T8b%T');					100..107: tempStr := concat(tempStr, tempChar, 'xFFf_*');					108..114: tempStr := concat(tempStr, tempChar, '*h3f8ng', tempChar);					115..121: tempStr := concat(tempStr, tempChar, '13Fa2d');					122..126: tempStr := concat(tempStr, '4fC32bE', tempChar, tempChar);				end; {case}				Writeln(tempStr);			end;			{now take ever few characters out of the Encoded stuff}			{it should be somewhat randomish because of the mod}			for x := 1 to length(tempStr) do				begin					result := concat(result, tempStr[x]);					x := x + (x mod 4);					Write('-', x:2, '- ');					Writeln(result);				end;	end;{-------------------------------------------}procedure MakeRegString(BBSName, BBSSerialNumber, SysOpName: str255; var result: str255);	var		st1, st2: str255;		x: integer;	begin		st1 := '';		st2 := '';		EncodeString(BBSName, st1);		if length(st1) < BBSNameLength then			for x := length(st1) to BBSNameLength do				st1 := concat(st1, copy(FillerCharacters, 1, BBSNameLength - length(st1)));		if length(st1) >= BBSNameLength then			st1 := copy(st1, 1, BBSNameLength);		st2 := concat(st2, st1);		EncodeString(BBSSerialNumber, st1);		if length(st1) < BBSSerialLength then			for x := length(st1) to BBSSerialLength do				st1 := concat(st1, copy(FillerCharacters2, 1, BBSSerialLength - length(st1)));		if length(st1) >= BBSSerialLength then			st1 := copy(st1, 1, BBSSerialLength);		st2 := concat(st2, st1);		EncodeString(SysOpName, st1);		if length(st1) < SysOpNameLength then			for x := length(st1) to SysOpNameLength do				st1 := concat(st1, copy(FillerCharacters3, 1, SysOpNameLength - length(st1)));		if length(st1) >= SysOpNameLength then			st1 := copy(st1, 1, SysOpNameLength);		st2 := concat(st2, st1);		EncodeString('~', st1);	{inserted so that we can 'verify' valid serial numbers}		Insert(st1, st2, 10);				EncodeString('\', st1);	{tacked on so that we can 'verify' valid serial numbers}		st2 := concat(st2, st1);		result := st2;	end;{-------------------------------------------}var	st1, st2, BBSName, BBSSerialNumber, SysOpName: str255;	x: integer;	outFile: Text;begin		Writeln('Enter the BBS Name');		Write(': ');		Readln(BBSName);		Writeln('Enter the BBS SerialNumber');		Write(': ');		Readln(BBSSerialNumber);		Writeln('Enter the SysOp''s Name');		Write(': ');		Readln(SysOpName);		MakeRegString(BBSName, BBSSerialNumber, SysOpName, st1);		Writeln(st1);				Open(outFile, SysOpName);		Writeln(outFile, 'Slycrel registration information:');		Writeln(outFile, 'SysOp''s Name: ', SysOpName); 		Writeln(outFile, 'BBS Name: ', BBSName);		Writeln(outFile, 'BBS Serial Number: ', BBSSerialNumber);		Writeln(outFile, 'Slycrel Serial Number: ', st1);		Close(outFile);end.