#include "Builtins.h"#include "PStrings.h"#include "USlycrel.h"void HandleDoInitialize(void){  TSlyExternal *slyExternal;  try {    slyExternal = new TSlyExternal("\pSlycrel");    FailNIL(slyExternal);    gExternal = slyExternal;    gHermSetup->prefs = Handle(gExternal);  } catch (...) {    G_Outln("\pError: Unable to initialize ", false, 5);    G_Outln("\pSlycrel", true, 5);    gExternal = NULL;    gHermSetup->prefs = Handle(NULL);  }}TSlyPrivates::TSlyPrivates(void)  : TPrivates(){  gSlyPrivates = this;  character = CharacterHandle(NewHandleClear(sizeof(CharacterRec)));  FailNIL(character);  LockHandle(Handle(character));  gCharacter = character;    gUtilPrivates->stage = 0;  PStr_Set((*gCharacter)->name, "\p ");  //0 to init everything to 0  RollChar(*gCharacter, '0');  PStr_Set((*gCharacter)->bbsName, UserGlobPtr()->thisUser.userName);}TSlyPrivates::~TSlyPrivates(void){  if (character != NULL) {                        //dispose of char handle    HUnlock(Handle(character));    HPurge(Handle(character));    DisposeHandle(Handle(character));  }  gCharacter = NULL;  gSlyPrivates = NULL;}void TSlyPrivates::CloseNode(void){}TSlyExternal::TSlyExternal(StringPtr inName)  : TExternal(inName){   mCharacterFile = new TCharFile(PlayerListPath);  FailNIL(mCharacterFile);  mCharacterFile->Close();  mHighScoreFile = new THighScoreFile(HighDataPath);  FailNIL(mHighScoreFile);  mHighScoreFile->Close();  mInnFile = new TInnFile(InnDataPath);  FailNIL(mInnFile);  mInnFile->Close();  mWeaponFile = new TWeaponFile(WeaponsPath);  FailNIL(mWeaponFile);  mWeaponFile->Close();  mArmorFile = new TArmorFile(ArmorPath);  FailNIL(mArmorFile);  mArmorFile->Close();  mGCombatFile = new TGCombatPrefsFile(GCombatPath);  FailNIL(mGCombatFile);  mGCombatFile->Close();  mRegistrationFile = new TRegistrationFile(RegistrationPath);  FailNIL(mRegistrationFile);  mRegistrationFile->Close();  mCombatListFile = new TGCombatListFile(GCombatListPath);  FailNIL(mCombatListFile);  mCombatListFile->Close();}inline void FreeFile(TFile *file){	if (file != NULL)		delete file;}TSlyExternal::~TSlyExternal(void){   FreeFile(mCharacterFile);  FreeFile(mHighScoreFile);  FreeFile(mInnFile);  FreeFile(mWeaponFile);  FreeFile(mArmorFile);  FreeFile(mGCombatFile);  FreeFile(mRegistrationFile);  FreeFile(mCombatListFile);}void TSlyExternal::AllocatePreferences(void){    G_LogThis("\p-=-   Gateway to Slycrel Opened by the Immortal Mages...",             0);    InitUserRec(gHermSetup->procs[vInitUserRec]);    PStr_Set(GeneralPrefs.TownName, gHermSetup->hSystPtr->bbsName);  GeneralPrefs.NumberPlayers = gHermSetup->hSystPtr->numUsers;  //all these are temporary  GeneralPrefs.GoldPool = 100000000;  GeneralPrefs.ManaPool = 1000000;  GeneralPrefs.RealTime = false;  GeneralPrefs.Population = 3200;  GeneralPrefs.TownSize = SmallTown;  GeneralPrefs.TaxRate = 0;  GeneralPrefs.PlayerPower = false;  GeneralPrefs.NPCNum = 0;  GeneralPrefs.Difficulty = 1;  GeneralPrefs.LevelUpDifficulty = 4;    UserGlobPtr()->ansiTerm = true;  UserGlobPtr()->thisUser.terminalType = 1;  ResetUserColors(&UserGlobPtr()->thisUser, gHermSetup->procs[vResetUserColors]);  G_bCr();  G_ANSICode("\p0;34mÄÍÄ   ");  G_ANSICode("\p1;36mGateway to Slycrel Opened by the Immortal Mages...");  G_bCr();  G_ANSICode("\p0;34mÄÍÄ   ");  G_ANSICode("\p1;32mWritten by Dave Dolinar & Jeremy Stone.");  G_bCr();}void TSlyExternal::AllocatePrivates(void){  TSlyPrivates *slyPrivates;  try {    gUtilPrivates = NULL;    gSlyPrivates = NULL;        slyPrivates = new TSlyPrivates;    FailNIL((Ptr)slyPrivates);    gHermSetup->privates = Handle(slyPrivates);      } catch (...) {    if (gUtilPrivates != NULL)       delete gUtilPrivates;    gUtilPrivates = NULL;    gSlyPrivates = NULL;    ReportFatalError("\pUnable to allocate enough memory.");  }}void TSlyExternal::DeletePreferences(void){}void TSlyExternal::DeletePrivates(void){  if (gUtilPrivates != NULL)     delete gUtilPrivates;}void TSlyExternal::HandleDoMaintenance(void){  DoUpkeep();}void TSlyExternal::HandleCallLogon(void){  G_Outln("\pRemember to Play Slycrel!", true, RandomBetween(0, 15));}void TSlyExternal::HandleCallMenu(void){  DoUpkeep();}void TSlyExternal::HandleActiveExternal(void){  switch (gUtilPrivates->stage) {     //REMEMBER TO MAKE A CHECK FOR CHARACTER VARIABLES OUT OF RANGE!!!!!!!!!!!!!        case stBeginExternal:      ST_BeginExternal();      break;    case stGetOpeningANSI:      ST_GetOpeningANSI();      break;    case stCheckForRegistration:      ST_CheckForRegistration();      break;    case stMainMenu:      ST_MainMenu();      break;    case stBeginRegistration:      ST_BeginRegistration();      break;    case stSaveSysopName:      ST_SaveSysopName();      break;    case stGetKey:      ST_GetKey();      break;    case stSaveKey:      ST_SaveKey();      break;    case stEndRegistration:      ST_EndRegistration();      break;    case stDemandANSI:      ST_DemandANSI();      break;    case stANSIReply:      ST_ANSIReply();      break;    case stEnterSlycrel:      ST_EnterSlycrel();      break;    case stCreateCharacter:      ST_CreateCharacter();      break;    case stCreateCharMenu:      ST_CreateCharMenu();      break;    case stGetCharName:      ST_GetCharName();      break;    case stSaveCharName:      ST_SaveCharName();      break;    case stOccupationMenu:      ST_OccupationMenu();      break;    case stGetOccupation:      ST_GetOccupation();      break;    case stSetOccupation:      ST_SetOccupation();      break;    case stFavoriteColorMenu:      ST_FavoriteColorMenu();      break;    case stGetFavoriteColor:      ST_GetFavoriteColor();      break;    case stViewCharacter:      ST_ViewCharacter();      break;    case stDoMyPausePrompt:      ST_DoMyPausePrompt();      break;    case stTown:      ST_Town();      break;    case stTownShortPrompt:      ST_TownShortPrompt();      break;    case stGetTownMenu:      ST_GetTownMenu();      break;        case stWilderness:      ST_Wilderness();      break;    case stWildernessShortPrompt:      ST_WildernessShortPrompt();      break;    case stWildernessMenu:      ST_WildernessMenu();      break;    case stSetupCombat:      ST_SetupCombat();      break;    case stCombatPlace:      ST_CombatPlace();      break;    case stGetCombatANSI:      ST_GetCombatANSI();      break;    case stDrawCombatField:      ST_DrawCombatField();      break;    case stDrawCombatStats:      ST_DrawCombatStats();      break;    case stCombat:      ST_Combat();      break;    case stMovePlayer:      ST_MovePlayer();      break;    case stMoveMonster:      ST_MoveMonster();      break;        case stSetupTextCombat:      ST_SetupTextCombat();      break;    case stTextCombatLoop:      ST_TextCombatLoop();      break;    case stUserAttackStage:      ST_UserAttackStage();      break;    case stCalcAdvanceMoves:      ST_CalcAdvanceMoves();      break;    case stOpponentAttackStage:      ST_OpponentAttackStage();      break;    case stUserKilled:      ST_UserKilled();      break;    case stUserVictorious:      ST_UserVictorious();      break;    case stUserEscapes:      ST_UserEscapes();      break;    case stMonsterRuns:      ST_MonsterRuns();      break;        case stTavern:      ST_Tavern();      break;    case stTavernShortPrompt:      ST_TavernShortPrompt();      break;    case stTavernMenu:      ST_TavernMenu();      break;    case stOrderDrinkPrompt:      ST_OrderDrinkPrompt();      break;    case stOrderDrinkMenu:      ST_OrderDrinkMenu();      break;    case stTalkToLynx:      ST_TalkToLynx();      break;    case stHangAround:      ST_HangAround();      break;    case stCorennePrompt:      ST_CorennePrompt();      break;    case stCorenneMenu:      ST_CorenneMenu();      break;    case stViewGuilds:      ST_ViewGuilds();      break;        case stInn:      ST_Inn();      break;    case stInnShortPrompt:      ST_InnShortPrompt();      break;    case stInnMenu:      ST_InnMenu();      break;    case stRentaRoom:      ST_RentaRoom();      break;    case stGetDays:      ST_GetDays();      break;    case stTestRental:      ST_TestRental();      break;    case stSaveRental:      ST_SaveRental();      break;    case stInnCheatPrompt:      ST_InnCheatPrompt();      break;    case stInnCheatMenu:      ST_InnCheatMenu();      break;    case stNewDailyCharge:      ST_NewDailyCharge();      break;    case stKickoutPlayer:      ST_KickoutPlayer();      break;    case stCloseInn:      ST_CloseInn();      break;    case stSetInnOwner:      ST_SetInnOwner();      break;        case stHealer:      ST_Healer();      break;    case stHealerPrompt:      ST_HealerPrompt();      break;    case stHealerMenu:      ST_HealerMenu();      break;    case stAgathaHeals:      ST_AgathaHeals();      break;    case stLifeHealedPrompt:      ST_LifeHealedPrompt();      break;    case stHealbyHealer:      ST_HealbyHealer();      break;    case stHerbalist:      ST_Herbalist();      break;    case stHerbalistPrompt:      ST_HerbalistPrompt();      break;    case stHerbalistMenu:      ST_HerbalistMenu();      break;    case stHerbalistHeal:      ST_HerbalistHeal();      break;        case stBank:      ST_Bank();      break;    case stBankPrompt:      ST_BankPrompt();      break;    case stBankMenu:      ST_BankMenu();      break;    case stGetDeposit:      ST_GetDeposit();      break;    case stSaveDeposit:      ST_SaveDeposit();      break;    case stGetWithdrawl:      ST_GetWithdrawl();      break;    case stSaveWithdrawl:      ST_SaveWithdrawl();      break;        case stTower:      ST_Tower();      break;        case stJail:      ST_Jail();      break;        case stBlacksmith:      ST_Blacksmith();      break;        case stArmory:      ST_Armory();      break;    case stArmoryShortPrompt:      ST_ArmoryShortPrompt();      break;    case stArmoryMenu:      ST_ArmoryMenu();      break;    case stOpenWeaponsFile:      ST_OpenWeaponsFile();      break;    case stChooseWeapon:      ST_ChooseWeapon();      break;    case stQBuyWeapon:      ST_QBuyWeapon();      break;    case stQReplaceWeapon:      ST_QReplaceWeapon();      break;    case stDisplayWeapons:      ST_DisplayWeapons();      break;    case stOpenArmorFile:      ST_OpenArmorFile();      break;    case stChooseArmor:      ST_ChooseArmor();      break;    case stQBuyArmor:      ST_QBuyArmor();      break;    case stSaveNewArmor:      ST_SaveNewArmor();      break;    case stQSellWeapon:      ST_QSellWeapon();      break;    case stSaveWeaponSale:      ST_SaveWeaponSale();      break;    case stQSellArmor:      ST_QSellArmor();      break;    case stSaveArmorSale:      ST_SaveArmorSale();      break;        case stArena:      ST_Arena();      break;    case stArenaShortPrompt:      ST_ArenaShortPrompt();      break;    case stArenaMenu:      ST_ArenaMenu();      break;    case stGetChallenge:      ST_GetChallenge();      break;    case stBeginChallenge:      ST_BeginChallenge();      break;    case stChallengeWon:      ST_ChallengeWon();      break;    case stChallengeLost:      ST_ChallengeLost();      break;    case stOpenPlayerList:      ST_OpenPlayerList();      break;    case stListPlayers:      ST_ListPlayers();      break;    case stGetGladiator:      ST_GetGladiator();      break;    case stGladiatorSure:      ST_GaldiatorSure();      break;    case stSetGladiator:      ST_SetGladiator();      break;    case stBeginBet:      ST_BeginBet();      break;    case stGetBet:      ST_GetBet();      break;    case stSaveBet:      ST_SaveBet();      break;        case stCommonGuild:      ST_CommonGuild();      break;    case stGuildShortPrompt:      ST_GuildShortPrompt();      break;    case stGuildMenu:      ST_GuildMenu();      break;    case stTryNewLevel:      ST_TryNewLevel();      break;        case stStartListTextFile:      ST_StartListTextFile();      break;    case stFinishListTextFile:      ST_FinishListTextFile();      break;    case stShouldWeQuit:      ST_ShouldWeQuit();      break;    case stWillWeQuit:      ST_WillWeQuit();      break;    case stSaveAndQuit:      ST_SaveAndQuit();    case stQuiting:      ST_Quiting();      break;        default:      ReportFatalError("\pError: reached unprogrammed stage");      break;  }}void TSlyExternal::SetupGlobalVariables(void){  // first setup framework globals  TExternal::SetupGlobalVariables();    // then setup our own  gSlyExternal = (TSlyExternal *)gExternal;  gSlyPrivates = (TSlyPrivates *)gHermSetup->privates;  if (gSlyPrivates != NULL)     gCharacter = CharacterHandle(gSlyPrivates->character);  gCharacterFile = mCharacterFile;  gHighScoreFile = mHighScoreFile;  gInnFile = mInnFile;  gWeaponFile = mWeaponFile;  gArmorFile = mArmorFile;  gGCombatFile = mGCombatFile;  gCombatListFile = mCombatListFile;  gRegistrationFile = mRegistrationFile;}void TSlyExternal::SaveGlobalVariables(void){  TExternal::SaveGlobalVariables();  mCharacterFile = gCharacterFile;  mHighScoreFile = gHighScoreFile;  mInnFile = gInnFile;  mWeaponFile = gWeaponFile;  mArmorFile = gArmorFile;  mGCombatFile = gGCombatFile;  mCombatListFile = gCombatListFile;  mRegistrationFile = gRegistrationFile;}