#include <A4Stuff.h>#include "Builtins.h"#include "HermHeaders.h"#include "ExternalUtils.h"#include "UExternal.h"#include "USlycrel.h"#include "SlyHeaders.h"extern pascal void main(UserXIPtr gHermSetup);pascal void main(UserXIPtr inHermSetup){  long oldA4;  // Wave our hands to make global variables and strings  // work properly  oldA4 = SetCurrentA4();    // Get main globals  gExternal = (TExternal *)inHermSetup->prefs;  gHermSetup = inHermSetup;  gDeadExternal = false;    // Check for one time initialization -- must be done before  // setting up and using global variables  if (inHermSetup->message == DOINITIALIZE) {    HandleDoInitialize();    gExternal->HandleDoInitialize();  }    if (gExternal == NULL) {    if (inHermSetup->message == ACTIVEEXT) {      Outln("\pA fatal error has occurred in the external!", true,             6, inHermSetup->procs[vOutln]);      Outln("\pPlease notify the Sysop!", true, 6, inHermSetup->procs[vOutln]);      inHermSetup->n[*inHermSetup->curNode - 1]->activeUserExternal = -1;    }  }  else {      // Set up global variables for framework and external    // Should likely assume all globals can be trashed if    // code resource gets purged from memory.    gExternal->SetupGlobalVariables();        try {      if (gHermSetup->message == ACTIVEEXT)         if (!gUtilPrivates->activeOn) {          gUtilPrivates->activeOn = true;          SetNextState(stBeginExternal);        }            switch (gHermSetup->message) {         case CREATENODEVARS:          gExternal->HandleCreateNodeVars();          break;        case DOMAINTENANCE:          gExternal->HandleDoMaintenance();          break;        case CALLLOGON:          gExternal->HandleCallLogon();          break;        case CALLMENU:          gExternal->HandleCallMenu();          break;        case IDLE:          gExternal->HandleIdle();          break;        case GAMEIDLE:          gExternal->HandleGameIdle();          break;        case ACTIVEEXT:          gExternal->HandleActiveExternal();          break;        case CLOSENODE:          gExternal->HandleCloseNode();          break;        case CLOSEEXTERNAL:          break;        default:          break;      } //Case Message of    }    catch (...) {      // if error gets this far then assume its fatal for this node       if (gHermSetup->message == ACTIVEEXT)         UserGlobPtr()->activeUserExternal = -1;      G_bCr();      _DebugError(gLastError);      _WriteDebugText("\pFatal error in external!  Please inform sysop.");      gExternal->DeletePrivates();    }        // Save any changed global variables     gExternal->SaveGlobalVariables();    if (inHermSetup->message == CLOSEEXTERNAL) {      gExternal->HandleCloseExternal();      delete gExternal;      gHermSetup->prefs = Handle(NULL);    }  }    // Wave our hands to finish using global variables  oldA4 = SetA4(oldA4);}