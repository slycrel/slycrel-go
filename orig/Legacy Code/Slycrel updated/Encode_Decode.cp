#include <stdlib.h>#include <stdio.h>#include "Builtins.h"#include "PStrings.h"#include "SlyHeaders.h"void EncodeString(StringPtr ToEncode, StringPtr result){  short x;  Str255 TempStr;  short tempChar;  Str255 Temp_Str255_1;  Str255 Temp_Str255_2;  Str255 str1;  PStr_Set(TempStr, "\p");  PStr_Set(result, "\p");  short forEnd_2 = PStr_Length(ToEncode);  for (x = 1; x <= forEnd_2; ++x) {    tempChar = short(ToEncode[x] + CharShift);    tempChar = short(BRotL(tempChar, BitRollVal));    tempChar = short((tempChar + SlyVersion) % ModNumber);    tempChar = short(tempChar + MinTypeable);    str1[0] = 1;    str1[1] = tempChar;    switch (tempChar) {       case 32:      case 33:       case 34:       case 35:       case 36:       case 37:         PStr_Set(TempStr, PStr_Concat(Temp_Str255_1, TempStr, str1,                                       "\p8F", str1));        break;      case 38:      case 39:       case 40:       case 41:       case 42:       case 43:       case 44:       case 45:         PStr_Set(TempStr, PStr_Concat(Temp_Str255_1, TempStr, str1,                                       "\p28E"));        break;      case 46:      case 47:       case 48:       case 49:       case 50:         PStr_Set(TempStr, PStr_Concat(Temp_Str255_1, TempStr, "\pC93AF"));        break;      case 51:      case 52:       case 53:       case 54:       case 55:       case 56:         PStr_Set(TempStr, PStr_Concat(Temp_Str255_1, TempStr, str1,                                       "\p48FF0"));        break;      case 57:      case 58:       case 59:       case 60:       case 61:       case 62:         PStr_Set(TempStr, PStr_Concat(Temp_Str255_1, TempStr, "\pFq_;",                                       str1));        break;      case 63:      case 64:       case 65:       case 66:       case 67:       case 68:         PStr_Set(TempStr, PStr_Concat(Temp_Str255_1, TempStr, str1,                                       "\pj39Fbh", str1));        break;      case 69:      case 70:       case 71:       case 72:       case 73:         PStr_Set(TempStr, PStr_Concat(Temp_Str255_1, TempStr, "\pDEA",                                       str1));        break;      case 74:      case 75:       case 76:       case 77:       case 78:       case 79:         PStr_Set(TempStr, PStr_Concat(Temp_Str255_1, TempStr, str1,                                       "\pghF#@8"));        break;      case 80:      case 81:       case 82:       case 83:       case 84:       case 85:       case 86:         PStr_Set(TempStr, PStr_Concat(Temp_Str255_1, TempStr, "\p3CPsv",                                       str1));        break;      case 87:      case 88:       case 89:       case 90:       case 91:       case 92:       case 93:       case 94:       case 95:         PStr_Set(TempStr, PStr_Concat(Temp_Str255_1, TempStr, str1,                                       "\p;hF582"));        break;      case 96:      case 97:       case 98:       case 99:         PStr_Set(TempStr, PStr_Concat(Temp_Str255_1, TempStr, str1,                                       str1, "\pT8b%T"));        break;      case 100:      case 101:       case 102:       case 103:       case 104:       case 105:       case 106:       case 107:         PStr_Set(TempStr, PStr_Concat(Temp_Str255_1, TempStr, str1,                                       "\pxFFf_*"));        break;      case 108:      case 109:       case 110:       case 111:       case 112:       case 113:       case 114:         PStr_Set(TempStr, PStr_Concat(Temp_Str255_1, TempStr, str1,                                       "\p*h3f8ng", str1));        break;      case 115:      case 116:       case 117:       case 118:       case 119:       case 120:       case 121:         PStr_Set(TempStr, PStr_Concat(Temp_Str255_1, TempStr, str1,                                       "\p13Fa2d"));        break;      case 122:      case 123:       case 124:       case 125:       case 126:         PStr_Set(TempStr, PStr_Concat(Temp_Str255_1, TempStr, "\p4fC32bE",                                       str1, str1));        break;    } //case      }  short forEnd_3 = PStr_Length(TempStr);  //now take ever few characters out of the Encoded stuff  //it should be somewhat randomish because of the mod  for (x = 1; x <= forEnd_3; ++x) {    PStr_Set(result, PStr_Concat(Temp_Str255_1, result, PStr_FromChar(Temp_Str255_2, TempStr[x])));    //????-Bad news here... loop variable changed-????    x += x % 4;  }}//-------------------------------------------------void MakeRegString(StringPtr bbsName, StringPtr BBSSerialNumber, StringPtr SysOpName, StringPtr result){  Str255 st1;  Str255 st2;  short x;  Str255 Temp_Str255_1;  Str255 Temp_Str255_2;  PStr_Set(st1, "\p");  PStr_Set(st2, "\p");    EncodeString(bbsName, st1);  if (PStr_Length(st1) < bbsNameLength)     for (x = PStr_Length(st1); x <= bbsNameLength; ++x)       PStr_Set(st1, PStr_Concat(Temp_Str255_2, st1, PStr_Copy(Temp_Str255_1,                                                               FillerCharacters,                                                               1, bbsNameLength - PStr_Length(st1))));  if (PStr_Length(st1) >= bbsNameLength)     PStr_Set(st1, PStr_Copy(Temp_Str255_1, st1, 1, bbsNameLength));  PStr_Set(st2, PStr_Concat(Temp_Str255_1, st2, st1));    EncodeString(BBSSerialNumber, st1);  if (PStr_Length(st1) < BBSSerialLength)     for (x = PStr_Length(st1); x <= BBSSerialLength; ++x)       PStr_Set(st1, PStr_Concat(Temp_Str255_2, st1, PStr_Copy(Temp_Str255_1,                                                               FillerCharacters2,                                                               1, BBSSerialLength - PStr_Length(st1))));  if (PStr_Length(st1) >= BBSSerialLength)     PStr_Set(st1, PStr_Copy(Temp_Str255_1, st1, 1, BBSSerialLength));  PStr_Set(st2, PStr_Concat(Temp_Str255_1, st2, st1));    EncodeString(SysOpName, st1);  if (PStr_Length(st1) < SysOpNameLength)     for (x = PStr_Length(st1); x <= SysOpNameLength; ++x)       PStr_Set(st1, PStr_Concat(Temp_Str255_2, st1, PStr_Copy(Temp_Str255_1,                                                               FillerCharacters3,                                                               1, SysOpNameLength - PStr_Length(st1))));  if (PStr_Length(st1) >= SysOpNameLength)     PStr_Set(st1, PStr_Copy(Temp_Str255_1, st1, 1, SysOpNameLength));  PStr_Set(st2, PStr_Concat(Temp_Str255_1, st2, st1));    EncodeString("\p~", st1);                       //inserted so that we can 'verify' valid serial numbers  PStr_Insert(st1, st2, 10);    EncodeString("\p\\", st1);                      //tacked on so that we can 'verify' valid serial numbers  PStr_Set(st2, PStr_Concat(Temp_Str255_1, st2, st1));    PStr_Set(result, st2);}main (){	unsigned char *bbsName = "\pTwilight Zone";	unsigned char *bbsSerialNumber = "\pF9C0B18B";	unsigned char *sysOpName = "\pDave Dolinar";	unsigned char registrationStr[256];	MakeRegString(bbsName, bbsSerialNumber, sysOpName, registrationStr);}