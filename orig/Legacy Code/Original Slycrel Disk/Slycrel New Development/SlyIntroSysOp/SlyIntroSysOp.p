unit Basic;interface	uses		HermHeaders, Sly_General, Sly_MainUnit, Sly_Weapons;	procedure MAIN (HermSetup: UserXIPtr);implementation	const		SysOpEdit = 1000;		EditWeapon = 199;		EditArmor = 249;		EditPlayer = 300;		EditMonster = 1100;		ViewMonster = 1150;		DeletePlayer = 100;	procedure MAIN (HermSetup: UserXIPtr);		var			i, x, int1, y: integer;			fRefNum: integer;			TerrType, st1, st2: str255;			long1, bytecount: longint;			done: boolean;			err: OSErr;{-------------------------------------------------}		procedure NumPrintCharStats (TheStats: CharRec; var HermSetup: UserXIPtr);{ Adds the Character Sheet to }{ the Buffer then RELEASES it}			var				C1, C2, C3, tempstr, st2: str255;				x, ColorNum: integer;		begin			with HermSetup^ do				begin					ColorNum := rnd(31, 37, HermSetup);					NumToString(ColorNum, C1);					C1 := concat(C1, 'm');					ColorNum := rnd(31, 37, HermSetup);					NumToString(ColorNum, C2);					C2 := Concat(C2, 'm');					ColorNum := rnd(31, 37, HermSetup);					NumToString(ColorNum, C3);					C3 := Concat(C3, 'm');					ANSICode('2J', procs[13]);					ANSICode('H', procs[13]);					BufferANSI('1;28H', false, HermSetup);					BufferANSI(concat(C2, 'ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ'), false, HermSetup);					BufferANSI('1;32H', false, HermSetup);					BufferANSI(concat(C1, 'Character'), false, HermSetup);					BufferANSI('1;43H', false, HermSetup);					BufferANSI(concat(C1, 'Info'), false, HermSetup);					BufferANSI(C1, false, HermSetup);					BufferANSI('2H1 Name', false, HermSetup);					BufferANSI('2;40H2 Class', false, HermSetup);					BufferANSI('3;5H3  HitPoints', false, HermSetup);					BufferANSI('3;45H4  Level', false, HermSetup);					BufferANSI('4;5H5  Exploration', false, HermSetup);					BufferANSI('4;45H6  Won / Lost', false, HermSetup);					BufferANSI('5;5H7  Spars', false, HermSetup);					BufferANSI('5;45H8  Ammo', false, HermSetup);					BufferANSI('6;5H9  Dexterity', false, HermSetup);					BufferANSI('6;45H10 Psyche', false, HermSetup);					BufferANSI('7;5H11 Strength', false, HermSetup);					BufferANSI('7;45H12 Speed', false, HermSetup);					BufferANSI('8;5H13 Coins Hand', false, HermSetup);					BufferANSI('8;45H14 Coins Bank', false, HermSetup);					BufferANSI('9;5H15 Gender', false, hermsetup);					BufferANSI(C3, false, HermSetup);					BufferANSI('2;7H-', false, HermSetup);					BufferANSI('2;47H-', false, HermSetup);					for X := 3 to 9 do						begin							NumToString(x, tempstr);							BufferANSI(concat(tempStr, ';17H', ':'), false, HermSetup);							BufferANSI(concat(tempStr, ';57H', ':'), false, HermSetup);						end;					BufferANSI('2;9H', false, HermSetup);					BufferANSI(concat('1;36m', TheStats.Name), false, HermSetup);					BufferANSI('0;37m', false, HermSetup);					BufferANSI('2;49H', false, HermSetup);					BufferANSI(concat('1;36m', TheStats.CharClass), false, HermSetup);					BufferANSI('0;37m', false, HermSetup);					BufferANSI(C2, false, HermSetup);					NumtoString(TheStats.HitPoints, TempStr);					BufferANSI(concat('3;20H', TempStr), false, HermSetup);					BufferANSI(C3, false, HermSetup);					BufferANSI('s/', false, HermSetup);					NumtoString(TheStats.MaxHP, TempStr);					BufferANSI(concat(C2, TempStr), false, HermSetup);					TempStr := 'No Level';					BufferANSI(concat('3;60H', TempStr), false, HermSetup);					NumToString(TheStats.Exploration, TempStr);					BufferANSI(concat('4;20H', TempStr), false, HermSetup);					NumToString(TheStats.FightsWon, TempStr);					NumToString(TheStats.TotalFights - TheStats.FightsWon, st2);					TempStr := concat(TempStr, '/', st2);					int1 := round((TheStats.FightsWon / (TheStats.TotalFights - TheStats.FightsWon)) * 100);					NumtoString(int1, TempStr);					BufferANSI(concat('4;66H', '(', TempStr, '%)'), false, HermSetup);					BufferANSI(concat('4;60H', TempStr), false, HermSetup);					NumToString(TheStats.Spars, TempStr);					BufferANSI(concat('5;20H', TempStr), false, HermSetup);					NumToString(TheStats.Ammo, TempStr);					BufferANSI(concat('5;60H', TempStr), false, HermSetup);					BufferANSI(concat('6;20H', convertStats(TheStats.Dexterity, HermSetup)), false, HermSetup);					BufferANSI(concat('6;60H', convertStats(TheStats.Psyche, HermSetup)), false, HermSetup);					BufferANSI(concat('7;20H', convertStats(TheStats.Strength, HermSetup)), false, HermSetup);					BufferANSI(concat('7;60H', convertStats(TheStats.Speed, HermSetup)), false, HermSetup);					NumtoString(TheStats.CoinsHand, TempStr);					BufferANSI(concat('8;20H', TempStr), false, HermSetup);					NumtoString(TheStats.CoinsBank, TempStr);					BufferANSI(concat('8;60H', TempStr), false, HermSetup);					if TheStats.Gender then						TempStr := 'Male'					else						TempStr := 'Female';					BufferANSI(concat('9;20H', TempStr), false, Hermsetup);					ReleaseBuffer(procs[99]);					bCr(procs[0]);				end;		end;{-------------------------------------------------}		procedure CS (stage: integer);		begin			with HermSetup^ do				Privates^^.Stage[CurNode^] := stage;		end;{------------------------------}		procedure RS (stage: integer);		begin			with HermSetup^ do				Privates^^.ReturnStage[CurNode^] := stage;		end;{-------------------------------------------------}		procedure FReadMonster (fRefNum: integer; var TheMonster: MonsterRec; var HermSetup: UserXIPtr);			var				ByteCount: longint;				err: OSErr;		begin			with HermSetup^ do				begin					ByteCount := SizeOf(MonsterRec);					err := FSRead(fRefNum, ByteCount, @TheMonster);					parseerr(err, HermSetup);				end;		end;{-------------------------------------------------}		procedure FWriteMonster (fRefNum: integer; TheMonster: MonsterRec; MonsterNum: integer; var HermSetup: UserXIPtr);			var				ByteCount: longint;				err: OSErr;		begin			ByteCount := Sizeof(MonsterRec);			SetFilePos(fRefNum, ByteCount * (MonsterNum - 1), HermSetup);			err := FSWrite(fRefNum, ByteCount, @TheMonster);			parseerr(err, HermSetup);		end;{-------------------------------------------------}		procedure GetMonster (MonsterType: str255; WhatMonster: integer; var TheMonster: MonsterRec; var HermSetup: UserXIPtr);			var				FRefNum: integer;				theOffSet: longint;		begin			with HermSetup^ do				begin					FOpen(concat(filesPath^, MonsterPath, MonsterType), FRefNum, HermSetup);					theOffSet := SizeOf(MonsterRec) * (whatMonster - 1);					SetFilePos(fRefNum, theOffset, HermSetup);					FReadMonster(FRefNum, TheMonster, HermSetup);					FClose(FRefNum, HermSetup);				end;		end;{-------------------------------------------------}		function GetMonsterType (TheMonster: MonsterRec; var HermSetup: UserXIPtr): str255;			var				st1: str255;		begin			with HermSetup^ do				begin					case TheMonster.MType of						Humanoid: 							st1 := 'Humanoid';						Orc: 							st1 := 'Orc';						Goblin: 							st1 := 'Goblin';						Fairy: 							st1 := 'Fairy';						Insectoid: 							st1 := 'Insectiod';						Fantastic: 							st1 := 'Fantastic (Magical)';						Elven: 							st1 := 'Elven';						FElemental: 							st1 := 'Fire Elemental';						WElemental: 							st1 := 'Water Elemental';						EElemental: 							st1 := 'Earth Elemental';						AElemental: 							st1 := 'Air Elemental';						Dwarven: 							st1 := 'Dwarven';						Evil: 							st1 := 'Inherently evil';						Good: 							st1 := 'Inherently Good';						Flying: 							St1 := 'Flying';						Undead: 							st1 := 'undead';						Psychic: 							st1 := 'Psychic';						Other: 							st1 := 'Other';					end;  {case}					GetMonsterType := st1;				end;		end;{-------------------------------------------------}		procedure PrintMonster (TheMonster: MonsterRec; var HermSetup: UserXIPtr);			var				st1: str255;		begin			with hermSetup^ do				begin					BufferIt('[1]  Name: ', false, 7, procs[98]);					BufferIt(TheMonster.Name, false, 1, procs[98]);					bufferbCr(procs[101]);					NumToString(TheMonster.Level, st1);					BufferIt('[ ]  Level: ', false, 7, procs[98]);					BufferIt(st1, false, 1, procs[98]);					bufferbCr(procs[101]);					NumToString(TheMonster.MonsterNum, st1);					BufferIt('[ ]  MonsterNum: ', false, 7, procs[98]);					BufferIt(st1, false, 1, procs[98]);					bufferbCr(procs[101]);					NumToString(TheMonster.HitPoints, st1);					BufferIt('[2]  HitPoints: ', false, 7, procs[98]);					BufferIt(st1, false, 1, procs[98]);					bufferbCr(procs[101]);					NumToString(TheMonster.Offense, st1);					BufferIt('[3]  Offense: ', false, 7, procs[98]);					BufferIt(st1, false, 1, procs[98]);					bufferbCr(procs[101]);					NumToString(TheMonster.Defense, st1);					BufferIt('[4]  Defense: ', false, 7, procs[98]);					BufferIt(st1, false, 1, procs[98]);					bufferbCr(procs[101]);					NumToString(TheMonster.Experience, st1);					BufferIt('[5]  Experience: ', false, 7, procs[98]);					BufferIt(st1, false, 1, procs[98]);					bufferbCr(procs[101]);					BufferIt('[6]  AttackString 1: ', false, 7, procs[98]);					BufferIt(TheMonster.AttackStr1, false, 1, procs[98]);					bufferbCr(procs[101]);					BufferIt('[7]  AttackString 2: ', false, 7, procs[98]);					BufferIt(TheMonster.AttackStr2, false, 1, procs[98]);					bufferbCr(procs[101]);					BufferIt('[8]  Defense String: ', false, 7, procs[98]);					BufferIt(TheMonster.DefenseStr, false, 1, procs[98]);					bufferbCr(procs[101]);					NumToString(TheMonster.Coins, st1);					BufferIt('[9]  Coins Given: ', false, 7, procs[98]);					BufferIt(st1, false, 1, procs[98]);					bufferbCr(procs[101]);					NumToString(TheMonster.Movement, st1);					BufferIt('[10] Movement: ', false, 7, procs[98]);					BufferIt(st1, false, 1, procs[98]);					bufferbCr(procs[101]);					NumToString(TheMonster.Disposition, st1);					BufferIt('[11] Disposition: ', false, 7, procs[98]);					BufferIt(st1, false, 1, procs[98]);					bufferbCr(procs[101]);					st1 := GetMonsterType(TheMonster, HermSetup);					BufferIt('[12] Monster Type: ', false, 7, procs[98]);					BufferIt(st1, false, 1, procs[98]);					bufferbCr(procs[101]);					NumToString(TheMonster.RangeOffense, st1);					BufferIt('[13] Range Offense:', false, 7, procs[98]);					BufferIt(st1, false, 1, procs[98]);					bufferbCr(procs[101]);					ReleaseBuffer(procs[99]);				end;		end;{-------------------------------------------------}	begin		with HermSetup^ do			begin				if message <> closeExternal then					begin						if privates = nil then  {never been called before}							begin								privates := myPrivsHand(NewHandle(SizeOf(myPrivs)));								MoveHHi(handle(privates));								HNoPurge(handle(privates));								for i := 1 to 10 do									begin										privates^^.Char[i] := CharHand(NewHandle(SizeOf(CharRec)));										MoveHHi(Handle(privates^^.Char[i]));										HNoPurge(Handle(privates^^.Char[i]));										HLock(Handle(privates^^.Char[i]));									end;								for x := 1 to 1 do									begin										privates^^.otherCode[x] := GetResource('XHRM', 10001 + x);  {Gets Different Resources}										MoveHHi(privates^^.otherCode[x]);										HNoPurge(Privates^^.otherCode[x]);										HLock(privates^^.otherCode[x]);										numToString(x + 10001, st1);										numToString(ResError, st2);										WriteText(concat(' Loading resource #', st1, ' ', st2), privates^^.myWindow, HermSetup);									end;								for i := 1 to 10 do									begin										privates^^.activeOn[i] := false;										privates^^.stage[i] := 0;									end;							end;						if not privates^^.activeOn[curNode^] then							begin								privates^^.activeOn[curNode^] := true;								privates^^.stage[curNode^] := 1;							end;					end;				case message of					closeExternal: 						begin							if privates <> nil then		{will execute if our external has been called}								begin									for i := 1 to numsegs do										if privates^^.otherCode[i] <> nil then	{dispose of other segs}											begin												HUnlock(privates^^.otherCode[i]);												HPurge(privates^^.otherCode[i]);												ReleaseResource(privates^^.otherCode[i]);												int1 := ResError;												NumToString(int1, st1);											end;									for i := 1 to 10 do										if privates^^.Char[i] <> nil then	{dispose of char handle}											begin												HUnlock(handle(privates^^.Char[i]));												HPurge(handle(privates^^.Char[i]));												DisposHandle(Handle(privates^^.Char[i]));												privates^^.Char[i] := nil;											end;									HUnlock(handle(Privates));				{dispose of privates}									HPurge(handle(Privates));									DisposHandle(Handle(privates));									privates := nil;								end; {if privates nil}						end;					closeNode: 						begin							privates^^.activeOn[curNode^] := false;							privates^^.stage[curNode^] := 0;							n[curNode^]^.activeUserExternal := -1;						end;					activeExt: 						begin							case privates^^.stage[curNode^] of								1: 									begin										Seed(HermSetup);										CS(SysOpEdit);									end;								DeletePlayer: 									begin										bCr(procs[0]);										LettersPrompt('What user do you want deleted? :', '', 31, false, false, false, chr(0), procs[4]);										ANSIPrompter(31, procs[9]);										CS(101);									end;								101: 									begin										FDelete(concat(filespath^, Userpath, n[CurNode^]^.CurPrompt), HermSetup);										Outline('Okay, that user has been deleted.', true, 3, procs[1]);										CS(SysOpEdit);									end;								EditWeapon..299: 									begin					{ Calls the Editweapon and armor resource... }										if privates^^.otherCode[1]^ <> nil then											begin												CallOtherCode(HermSetup, procptr(privates^^.otherCode[1]^));											end										else											begin												Outline('Error, Not Enough Memory avbl.!!', true, 6, procs[1]);												CS(ShutDown3);											end;									end;								EditPlayer: 									begin										bCr(procs[0]);										LettersPrompt('What user do you want to edit? :', '', 31, false, false, false, chr(0), procs[4]);										ANSIPrompter(31, procs[9]);										CS(301);									end;								301: 									begin										if not FExist(concat(FilesPath^, UserPath, N[CurNode^]^.CurPrompt), procs[62]) then											CS(SysOpEdit)										else											begin												FOpen(concat(FilesPath^, UserPath, n[CurNode^]^.CurPrompt), fRefNum, HermSetup);												FReadChar(Privates^^.Char[CurNode^]^^, fRefNum, HermSetup);												FClose(fRefNum, HermSetup);												bCr(procs[0]);												Privates^^.TempStr[CurNode^] := n[CurNode^]^.CurPrompt;												bCr(procs[0]);												CS(302);											end;									end;								302: 									begin										NumPrintCharStats(Privates^^.Char[CurNode^]^^, HermSetup);										NumbersPrompt('Your choice? [1-15,Q,S]  ', '1234567890QS', 15, 1, procs[5]);										CS(303);									end;								303: 									begin										if n[CurNode^]^.CurPrompt[1] = 'Q' then											CS(SysOpEdit)										else if n[CurNode^]^.CurPrompt[1] = '?' then											CS(302)										else if n[CurNode^]^.CurPrompt[1] = 'S' then											begin												FOpen(concat(FilesPath^, UserPath, Privates^^.TempStr[CurNode^]), fRefNum, HermSetup);												FWriteChar(Privates^^.Char[CurNode^]^^, fRefNum, HermSetup);												FClose(fRefNum, HermSetup);												CS(302);											end										else											begin												StringToNum(n[curNode^]^.curPrompt, Long1);												case long1 of													1: 														CS(305);{name  x, Done}													2: 														CS(310);{Class  x, Done}													3: 														CS(315);{HitPoints, Done}													4: 														begin															Outline('Sorry, you can''t just mess with people''s levels like that!  ;) ', true, 1, procs[1]);															bCr(procs[0]);															CS(EditPlayer);														end;													5: 														CS(325);{Exploration, Done}													6: 														CS(330);{Win/Total, Done}													7: 														CS(335);{Spars, Done}													8: 														CS(340);{Ammo, Done}													9: 														CS(345);{Dexterity, Done}													10: 														CS(350);{Psyche, Done}													11: 														CS(355);{Strength, Done}													12: 														CS(360);{Speed, Done}													13: 														CS(365);{CoinsHand, Done}													14: 														CS(370);{CoinsBank, Done}													15: 														begin		{Gender x}															with privates^^.char[curNode^]^^ do																if Privates^^.char[curNode^]^^.Gender = true then																	begin																		Outline('You are Now Female.', true, 3, procs[1]);																		Gender := false;																		Strength := Strength - 3;																		MaxPsyche := MaxPsyche + 1;																		Dexterity := Dexterity + 2;																		MaxHp := MaxHp - 2;																		HitPoints := MaxHp;																		Faith := Faith + 2;																	end																else																	begin																		Outline('You are Now Male.', true, 3, procs[1]);																		Privates^^.char[curNode^]^^.Gender := true;																		Strength := Strength + 3;																		MaxPsyche := MaxPsyche - 1;																		Dexterity := Dexterity - 2;																		MaxHp := MaxHp + 2;																		HitPoints := MaxHp;																		Faith := Faith - 2;																	end;															CS(302);														end;													otherwise														CS(SysOpEdit);												end;											end									end;								305: 									begin										Lettersprompt('', '', 20, false, false, false, char(0), procs[4]);										ANSICode('33mWhat is your new Name:', procs[13]);										ANSIPrompter(20, procs[9]);										n[curNode^]^.curPrompt := privates^^.ch