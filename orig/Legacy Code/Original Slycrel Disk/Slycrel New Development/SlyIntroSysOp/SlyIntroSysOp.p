p);										FWriteMonster(fRefNum, Privates^^.Monster[CurNode^], Privates^^.Monster[curNode^].MonsterNum, HermSetup);										FClose(fRefNum, HermSetup);										Outline('Monster Saved', true, 3, procs[1]);										CS(SysOpEdit);									end;								ShutDown: 									begin										privates^^.activeOn[curNode^] := false;										privates^^.stage[curNode^] := 0;										n[curNode^]^.activeUserExternal := -1;									end;								otherwise							end;						end;					otherwise				end;			end;	end;end.