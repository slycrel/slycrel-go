unit Sly_Files;interfaceuses	HermHeaders, Sly_Include;procedure parseerr (err: OSErr; var HermSetup: UserXIPtr);procedure FOpen (FileName: str255; var fRefNum: integer; var HermSetup: UserXIPtr);procedure FClose (var fRefNum: integer; var HermSetup: UserXIPtr);procedure FCreate (FileName: Str255; var HermSetup: UserXIPtr);procedure FDelete (FileName: str255; var HermSetup: UserXIPtr);procedure SetFilePos (fRefNum: integer; OffSet: longint; var HermSetup: UserXIPtr);procedure FReadTerrain (fRefNum: integer; var TheTerrain: TerrainType; var HermSetup: UserXIPtr);procedure GetTerrain (WhatTerrain: str255; var TheTerrain: TerrainType; var HermSetup: UserXIPtr);procedure FReadMonster (fRefNum: integer; var TheMonster: MonsterRec; var HermSetup: UserXIPtr);procedure FWriteMonster (fRefNum: integer; TheMonster: MonsterRec; MonsterNum: integer; var HermSetup: UserXIPtr);procedure GetMonster (MonsterType: str255; WhatMonster: integer; var TheMonster: MonsterRec; var HermSetup: UserXIPtr);procedure FReadChar (fRefNum: integer; var HermSetup: UserXIPtr);procedure FWriteChar (fRefNum: integer; var HermSetup: UserXIPtr);procedure SaveChar (var HermSetup: UserXIPtr);implementation{-------------------------------------------------}procedure parseerr (err: OSErr; var HermSetup: UserXIPtr);	{check for an error}	var		st1, st2: str255;	begin		if err <> noerr then			with HermSetup^ do				begin					numToString(err, st1);					numToString(privates^^.stage[curNode^], st2);					Outline(concat('Error #', st1, ' in stage #', st2), true, 6, procs[1]);				end;	end;{-------------------------------------------------}procedure FOpen (FileName: str255; var fRefNum: integer; var HermSetup: UserXIPtr);	var		err: OSErr;	begin		err := FSOpen(FileName, vRefNum, fRefNum);		parseerr(err, HermSetup);	end;{-------------------------------------------------}procedure FClose (var fRefNum: integer; var HermSetup: UserXIPtr);	var		err: OSErr;	begin		err := FSClose(fRefNum);		parseerr(err, HermSetup);	end;{-------------------------------------------------}procedure FCreate (FileName: Str255; var HermSetup: UserXIPtr);	var		err: OSErr;	begin		err := Create(Filename, vRefNum, HermesType, DataType);		parseerr(Err, HermSetup);	end;{-------------------------------------------------}procedure FDelete (FileName: str255; var HermSetup: UserXIPtr);	var		err: OSErr;	begin		err := FSDelete(FileName, vRefNum);		parseerr(err, HermSetup);	end;{-------------------------------------------------}procedure SetFilePos (fRefNum: integer; OffSet: longint; var HermSetup: UserXIPtr);	var		err: OSErr;	begin		err := SetFPos(fRefNum, FSFromStart, OffSet);		parseerr(err, HermSetup);	end;{-------------------------------------------------}procedure FReadTerrain (fRefNum: integer; var TheTerrain: TerrainType; var HermSetup: UserXIPtr);	var		ByteCount: longint;		err: OSErr;	begin		with HermSetup^ do			begin				ByteCount := SizeOf(TerrainType);				err := FSRead(fRefNum, ByteCount, @TheTerrain);				parseerr(err, HermSetup);			end;	end;{-------------------------------------------------}procedure GetTerrain (WhatTerrain: str255; var TheTerrain: TerrainType; var HermSetup: UserXIPtr);	var		FRefNum: integer;	begin		with HermSetup^ do			begin				FOpen(concat(filesPath^, TerrainPath, WhatTerrain), FRefNum, HermSetup);				FReadTerrain(FRefNum, TheTerrain, HermSetup);				FClose(FRefNum, HermSetup);			end;	end;{-------------------------------------------------}procedure FReadMonster (fRefNum: integer; var TheMonster: MonsterRec; var HermSetup: UserXIPtr);	var		ByteCount: longint;		err: OSErr;	begin		with HermSetup^ do			begin				ByteCount := SizeOf(MonsterRec);				err := FSRead(fRefNum, ByteCount, @TheMonster);				parseerr(err, HermSetup);			end;	end;{-------------------------------------------------}procedure FWriteMonster (fRefNum: integer; TheMonster: MonsterRec; MonsterNum: integer; var HermSetup: UserXIPtr);	var		ByteCount: longint;		err: OSErr;	begin		ByteCount := Sizeof(MonsterRec);		SetFilePos(fRefNum, ByteCount * (MonsterNum - 1), HermSetup);		err := FSWrite(fRefNum, ByteCount, @TheMonster);		parseerr(err, HermSetup);	end;{-------------------------------------------------}procedure GetMonster (MonsterType: str255; WhatMonster: integer; var TheMonster: MonsterRec; var HermSetup: UserXIPtr);	var		FRefNum: integer;		theOffSet: longint;	begin		with HermSetup^ do			begin				FOpen(concat(filesPath^, MonsterPath, MonsterType), FRefNum, HermSetup);				theOffSet := SizeOf(MonsterRec) * (whatMonster - 1);				SetFilePos(fRefNum, theOffset, HermSetup);				FReadMonster(FRefNum, TheMonster, HermSetup);				FClose(FRefNum, HermSetup);			end;	end;{-------------------------------------------------}procedure FReadChar (fRefNum: integer; var HermSetup: UserXIPtr);	var		ByteCount: longint;		err: OSErr;	begin		with HermSetup^ do			begin				ByteCount := SizeOf(CharRec);				err := FSRead(fRefNum, ByteCount, @Privates^^.Char[CurNode^]);				parseerr(err, HermSetup);			end;	end;{-------------------------------------------------}procedure FWriteChar (fRefNum: integer; var HermSetup: UserXIPtr);	var		ByteCount: longint;		err: OSErr;	begin		with HermSetup^ do			begin				ByteCount := SizeOf(CharRec);				err := FSWrite(fRefNum, ByteCount, @Privates^^.Char[CurNode^]);				parseerr(err, HermSetup);			end;	end;{-------------------------------------------------}procedure SaveChar (var HermSetup: UserXIPtr);	var		st1: str255;		FRefNum: integer;	begin		with HermSetup^ do			begin				NumToString(Privates^^.Char[CurNode^].UserNum, St1);				if not FExist(concat(FilesPath^, UserPath, St1), procs[62]) then					FCreate(concat(FilesPath^, UserPath, St1), HermSetup);				FOpen(concat(FilesPath^, UserPath, St1), FRefNum, HermSetup);				FWriteChar(FRefNum, HermSetup);				FClose(FRefNum, HermSetup);			end;	end;{-------------------------------------------------}end.