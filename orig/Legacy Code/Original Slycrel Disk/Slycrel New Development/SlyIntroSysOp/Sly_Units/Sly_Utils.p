unit Sly_Utils;interface	uses		HermHeaders;	procedure Seed (var HermSetup: UserXIPtr);	function rnd (Min, Max: integer; var HermSetup: UserXIPtr): integer;	function OkPrompt (Accepted: str255; var HermSetup: UserXIPtr): boolean;	procedure ClrPrompt (var HermSetup: UserXIPtr);	procedure RollChar (var TheChar: CharRec; Ch1: Char; var HermSetup: UserXIPtr);	function ConvertStats (Value: integer; var HermSetup: UserXIPtr): string;	function GetTerrChar (TheByte: integer; ANSI: boolean): string;	procedure MovePlayer (Direction: Char; var NewR, NewC: integer; var Movement: byte; TheTerrain: TerrainType; var HermSetup: UserXIPtr);	procedure MoveMonster (var R, C, Ru, Cu: integer; Monster: MonsterRec; TheTerr: TerrainType; var HermSetup: UserXIPtr);	function Passable (R, C: integer; TheTerrain: TerrainType): integer;	procedure UpdateMovement (Movement: byte; var HermSetup: UserXIPtr);	function CheckMovement (R, C, Movement: integer; TheTerrain: TerrainType): boolean;implementation{-------------------------------------------------}	procedure Seed (var HermSetup: UserXIPtr);		var			i, TheSeed: integer;			x: real;	begin		TheSeed := TickCount mod 255;		if TheSeed < 0 then			TheSeed := -TheSeed;		for i := 1 to TheSeed do			x := Random;		HermSetup^.privates^^.Seed := TheSeed	end;{-------------------------------------------------}	function rnd (Min, Max: integer; var HermSetup: UserXIPtr): integer;{This function will put out a random # between the Max and Min that is specified}		var			QdRandom: Longint;	begin		Seed(HermSetup);		QdRandom := Random + 32768;		QdRandom := (QdRandom * (max - min + 1)) div 65536 + min;		rnd := QdRandom;	end;{-------------------------------------------------}	function OkPrompt (Accepted: str255; var HermSetup: UserXIPtr): boolean;		var			found: boolean;			x, y: integer;	begin		found := false;		with HermSetup^ do			begin				y := pos(n[curNode^]^.CurPrompt[1], Accepted);				if y <> 0 then					found := true;			end;		if found then			OkPrompt := true		else			OkPrompt := false;	end;{-------------------------------------------------}	procedure ClrPrompt (var HermSetup: UserXIPtr);	begin		with HermSetup^ do			begin				n[CurNode^]^.CurPrompt := '˛';			end;	end;{-------------------------------------------------}	procedure RollChar (var TheChar: CharRec; Ch1: Char; var HermSetup: UserXIPtr);		var			x: integer;	begin		with HermSetup^ do			begin				TheChar.LastOn := TheDate;				TheChar.Alive := true;				TheChar.Ammo := rnd(1, 10, HermSetup);				TheChar.CoinsHand := 15;				TheChar.CoinsBank := 5;				TheChar.TotalExperience := rnd(1, 100, HermSetup);				TheChar.SpendingExperience := TheChar.TotalExperience;				TheChar.ThiefLvl := 0;				TheChar.MageLvl := 0;				TheChar.FighterLvl := 0;				case ch1 of					'F': 						begin							with TheChar do								begin									CharClass := 'Fighter';									Strength := rnd(4, 12, HermSetup);									Speed := rnd(8, 12, HermSetup);									MaxPsyche := 1;									Psyche := MaxPsyche;									Fame := rnd(0, 2, HermSetup);									Dexterity := rnd(4, 15, HermSetup);									HitPoints := rnd(15, 35, HermSetup);									MaxHP := HitPoints;									Movement := rnd(speed - speed div 5, speed + speed div 5, HermSetup);									Exploration := 15;									Spars := 3;									Honor := rnd(1, 15, HermSetup);									Faith := rnd(1, 7, HermSetup);									Flirt1 := 1;									Flirt2 := 1;								end;						end;					'T': 						begin							with TheChar do								begin									CharClass := 'Thief';									Strength := rnd(1, 12, HermSetup);									Speed := rnd(10, 16, HermSetup);									MaxPsyche := 1;									Psyche := MaxPsyche;									Fame := rnd(0, 2, HermSetup);									Dexterity := rnd(4, 20, HermSetup);									HitPoints := rnd(13, 26, HermSetup);									MaxHP := HitPoints;									Movement := rnd(speed - speed div 5, speed + speed div 5, HermSetup);									Exploration := 15;									Spars := 3;									Honor := rnd(1, 12, HermSetup);									Faith := rnd(1, 5, HermSetup);									Flirt1 := 1;									Flirt2 := 1;								end;						end;					'M': 						begin							with TheChar do								begin									CharClass := 'Mage';									Strength := rnd(1, 10, HermSetup);									Speed := rnd(8, 16, HermSetup);									MaxPsyche := rnd(2, 4, HermSetup);									Psyche := MaxPsyche;									Fame := rnd(0, 2, HermSetup);									Dexterity := rnd(4, 15, HermSetup);									HitPoints := rnd(4, 17, HermSetup);									MaxHP := HitPoints;									Movement := rnd(speed - speed div 5, speed + speed div 5, HermSetup);									Exploration := 15;									Spars := 3;									Honor := rnd(4, 15, HermSetup);									Faith := rnd(0, 5, HermSetup);									Flirt1 := 1;									Flirt2 := 1;								end;						end;					otherwise						begin							with TheChar do								begin									CharClass := 'None';									Strength := 0;									Speed := 0;									MaxPsyche := 0;									Psyche := 0;									Fame := 0;									Dexterity := 0;									HitPoints := 0;									MaxHP := 0;									Movement := 0;									Exploration := 0;									Spars := 0;									Honor := 0;									Faith := 0;									Flirt1 := 1;									Flirt2 := 1;								end;						end;				end;	{Case}				TheChar.TotalFights := 0;				TheChar.FightsWon := 0;				TheChar.TheifGuild := false;				TheChar.MageGuild := false;				TheChar.FighterGuild := false;				TheChar.Location := TheTown;	{if they are female then 'Adjust' the Stats a little}				with TheChar do					if not (Gender = true) then						begin							Strength := Strength - 3;							MaxPsyche := MaxPsyche + 1;							Dexterity := Dexterity + 2;							MaxHp := MaxHp - 2;							HitPoints := MaxHp;							Faith := Faith + 2;						end;				for x := 1 to 3 do					with TheChar do						begin							Weapons[x].Name := 'Hands';							Weapons[x].Strike := Strength div 4;							Weapons[x].Range := 0;							Weapons[x].Cost := 0;							Weapons[x].Ability := 0;							if x = 2 then								begin									Weapons[x].Name := 'rocks';									Weapons[x].Strike := 1;									Weapons[x].Range := 2;								end;						end;				with TheChar do					begin						Armor[1].Name := 'Clothing';						Armor[1].Defense := 1;						Armor[1].Cost := 0;						Armor[1].Ability := 0;						Armor[2].Name := 'None';						Armor[2].Defense := 1;						Armor[2].Cost := 0;						Armor[2].Ability := 0;					end;			end;	end;{-------------------------------------------------}	function ConvertStats (Value: integer; var HermSetup: UserXIPtr): string;	begin		with hermSetup^ do			begin				case Value of					1..3: 						ConvertStats := 'Hahaha!';					4..7: 						ConvertStats := 'Puny';					8..10: 						ConvertStats := 'Weak';					11..14: 						ConvertStats := 'Lacking';					15..25: 						ConvertStats := 'Fair';					26..35: 						ConvertStats := 'Typical';					36..45: 						ConvertStats := 'Adequate';					46..55: 						ConvertStats := 'Commendable';					56..65: 						ConvertStats := 'Admirable';					66..75: 						ConvertStats := 'Exceptional';					76..90: 						ConvertStats := 'Superior';					91..99: 						ConvertStats := 'Invincible';					100: 						ConvertStats := 'Kickin''!';				end;			end;	end;{-------------------------------------------------}	function GetTerrChar (TheByte: integer; ANSI: boolean): string;	begin		if ANSI then			case theByte of				0: 					GetTerrChar := concat('0;37;40m', ' ');				1: 					GetTerrChar := concat('0;32;40m', '∞');				2: 					GetTerrChar := concat('0;33;40m', '∞');				3: 					GetTerrChar := concat('0;34;40m', '˜');				4: 					GetTerrChar := concat('0;34;43m', '');				5: 					GetTerrChar := concat('1;30;40m', 'Ì');				6: 					GetTerrChar := concat('1;32;40m', char(6));				7: 					GetTerrChar := concat('0;32;40m', char(6));				8: 					GetTerrChar := concat('1;30;47m', '±');				9: 					GetTerrChar := concat('1;30;40m', '≤');				otherwise					GetTerrChar := concat('1;31;40m', 'ù');			end		else			case theByte of				0: 					GetTerrChar := ' ';				1: 					GetTerrChar := '∞';				2: 					GetTerrChar := '∞';				3: 					GetTerrChar := '˜';				4: 					GetTerrChar := '';				5: 					GetTerrChar := 'Ì';				6: 					GetTerrChar := char(6);				7: 					GetTerrChar := char(6);				8: 					GetTerrChar := '±';				9: 					GetTerrChar := '≤';				otherwise					GetTerrChar := 'ù';			end;	end;{-------------------------------------------------}	procedure MovePlayer (Direction: Char; var NewR, NewC: integer; var Movement: byte; TheTerrain: TerrainType; var HermSetup: UserXIPtr);		var			st1, st2: str255;	begin		with HermSetup^ do			begin				NumToString(NewR + 2, st1);				NumToString(NewC + 2, st2);				ANSICode(concat(st1, ';', st2, 'H'), procs[13]);				ANSICode(GetTerrChar(TheTerrain[NewR, NewC], True), procs[13]);				case direction of					'I': 						if NewR <= 1 then							NewR := 1						else							begin								NewR := NewR - 1;								if not (Passable(NewR, NewC, TheTerrain) < movement) then									NewR := NewR + 1								else									movement := movement - Passable(NewR, NewC, TheTerrain);							end;					'J': 						if NewC <= 1 then							NewC := 1						else							begin								NewC := NewC - 1;								if not (Passable(NewR, NewC, TheTerrain) < movement) then									NewC := NewC + 1								else									movement := movement - Passable(NewR, NewC, TheTerrain);							end;					'K': 						if NewR >= 12 then							NewR := 12						else							begin								NewR := NewR + 1;								if not (Passable(NewR, NewC, TheTerrain) < movement) then									NewR := NewR - 1								else									movement := movement - Passable(NewR, NewC, TheTerrain);							end;					'L': 						if NewC >= 48 then							NewC := 48						else							begin								NewC := NewC + 1;								if not (Passable(NewR, NewC, TheTerrain) < movement) then									NewC := NewC - 1								else									movement := movement - Passable(NewR, NewC, TheTerrain);							end;				end; { Case }				NumToString(NewR + 2, st1);				NumToString(NewC + 2, st2);				ANSICode(concat(st1, ';', st2, 'H'), procs[13]);				ANSICode('1;34mË', procs[13])			end;	end;{-------------------------------------------------}	procedure MoveMonster (var R, C, Ru, Cu: integer; Monster: MonsterRec; TheTerr: TerrainType; var HermSetup: UserXIPtr);		var			dist: real;			st1, st2: str255;			Temp: integer;	begin		with HermSetup^ do			begin				dist := sqrt(sqr(abs(R - Ru)) + sqr(abs(C - Cu)));				NumToString(R + 2, st1);				NumToString(C + 2, st2);				ANSICode(concat(st1, ';', st2, 'H'), procs[13]);				ANSICode(GetTerrChar(TheTerr[R, C], True), procs[13]);				case Monster.Disposition of					1: 						begin							if dist < 4 then								begin									if rnd(1, 10, HermSetup) < 6 then										begin											repeat												Temp := (rnd(1, 3, HermSetup) - 2);											until Temp <> 0;											r := r + Temp;											if not (passable(R, C, TheTerr) < Monster.Movement) then												r := r - Temp;										end									else										begin											repeat												Temp := (rnd(1, 3, HermSetup) - 2);											until temp <> 0;											c := c + Temp;											if not (passable(R, C, TheTerr) < Monster.Movement) then												c := c - Temp;										end								end							else { Dist < 4 }								begin									if rnd(1, 10, HermSetup) < 6 then										begin											repeat												Temp := (rnd(1, 3, HermSetup) - 2);											until Temp <> 0;											r := r + Temp;											if not (passable(R, C, TheTerr) < Monster.Movement) then												r := r - Temp;										end									else										begin											repeat												Temp := (rnd(1, 3, HermSetup) - 2);											until temp <> 0;											c := c + Temp;											if not (passable(R, C, TheTerr) < Monster.Movement) then												c := c - Temp;										end;								end;						end;				end;{case}				if c < 1 then					c := 1;				if c > 48 then					c := 48;				if r < 1 then					r := 1;				if r > 12 then					r := 12;				NumToString(R + 2, st1);				NumToString(C + 2, st2);				ANSICode(concat(st1, ';', st2, 'H'), procs[13]);				ANSICode('0;31mú', procs[13])			end;	{with HermSetup}	end;	{procedure}{-------------------------------------------------}	function Passable (R, C: integer; TheTerrain: TerrainType): integer;	begin		case TheTerrain[r, c] of			0: 				Passable := 2;			1: 				passable := 2;			2: 				passable := 1;			3: 				passable := 24;			4: 				passable := 1;			5: 				passable := 998;			6: 				passable := 4;			7: 				passable := 6;			8: 				passable := 4;			9: 				passable := 8;			otherwise				passable := 998;		end;	end;{-------------------------------------------------}	procedure UpdateMovement (Movement: byte; var HermSetup: UserXIPtr);		var			st1: str255;	begin		with HermSetup^ do			begin				NumToString(Movement, st1);				ANSICode(concat('5;65H', '    '), procs[13]);				ANSICode(concat('5;65H', st1), procs[13]);			end	end;{-------------------------------------------------}	function CheckMovement (R, C, Movement: integer; TheTerrain: TerrainType): boolean;		var			CheckNorth, CheckSouth, CheckEast, CheckWest: boolean;			counter: byte;	begin		CheckNorth := true;		CheckSouth := true;		CheckEast := true;		CheckWest := true;		Counter := 0;			{ Checks to see if they're on the border... }		if R + 1 > 48 then			CheckEast := false		else if R - 1 < 1 then			CheckWest := False		else if C + 1 > 12 then			CheckSouth := false		else if C - 1 < 1 then			CheckNorth := False;		if CheckNorth then			if Movement < passable(R, C - 1, TheTerrain) then				Counter := Counter + 1;		if CheckSouth then			if Movement < passable(R, C + 1, TheTerrain) then				Counter := Counter + 1;		if CheckEast then			if Movement < passable(R + 1, C, TheTerrain) then				Counter := Counter + 1;		if CheckWest then			if Movement < passable(R - 1, C, TheTerrain) then				Counter := Counter + 1;		if counter = 4 then			CheckMovement := false		else			CheckMovement := true;	end;{-------------------------------------------------}end.