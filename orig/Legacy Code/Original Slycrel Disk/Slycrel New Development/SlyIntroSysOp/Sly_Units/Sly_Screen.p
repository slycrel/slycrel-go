unit Sly_Screen;interfaceuses	HermHeaders, Sly_Include, Sly_Utils;procedure BufferANSI (TheANSI: string; bCrBefore: boolean; var HermSetup: UserXIPtr);procedure PosCursor (x, y: integer; var HermSetup: UserXIPtr);procedure PrintMenu (Div1, Command, Div2: string; DivColor, ComColor: string; Cr: boolean; var HermSetup: UserXIPtr);procedure PrintCharStats (TheStats: CharRec; var HermSetup: UserXIPtr);procedure PrintMonster (TheMonster: MonsterRec; var HermSetup: UserXIPtr);procedure DrawCombatField (TheTerrain: TerrainType; var HermSetup: UserXIPtr);procedure DrawCharInfo (TheCharacter: CharRec; var HermSetup: UserXIPtr);procedure ShowScale (var HermSetup: UserXIPtr);implementation{-------------------------------------------------}procedure BufferANSI (TheANSI: string; bCrBefore: boolean; var HermSetup: UserXIPtr);	begin		with HermSetup^ do			begin				Bufferit(concat(char(27), '[', TheANSI), bCrBefore, 0, procs[98]);			end;	end;{-------------------------------------------------}procedure PosCursor (x, y: integer; var HermSetup: UserXIPtr);	var		Xstr, Ystr, where: str255;	begin		with HermSetup^ do			begin				numToString(X, Xstr);				numToString(Y, Ystr);				where := concat(Ystr, ';', Xstr, 'H');				ANSICode(Where, procs[13]);			end;	end;{-------------------------------------------------}procedure PrintMenu (Div1, Command, Div2: string; DivColor, ComColor: string; Cr: boolean; var HermSetup: UserXIPtr);	begin		with HermSetup^ do			begin				ANSICode(concat(Divcolor, div1), procs[13]);				ANSICode(concat(Comcolor, Command), procs[13]);				ANSICode(concat(Divcolor, Div2), procs[13]);				if Cr then					bCr(procs[0]);			end;	end;{-------------------------------------------------}procedure PrintCharStats (TheStats: CharRec; var HermSetup: UserXIPtr);{ Adds the Character Sheet to }{ the Buffer then RELEASES it}	var		C1, C2, C3, tempstr: str255;		x, ColorNum: integer;	begin		with HermSetup^ do			begin				ColorNum := rnd(31, 37, HermSetup);				NumToString(ColorNum, C1);				C1 := concat(C1, 'm');				ColorNum := rnd(31, 37, HermSetup);				NumToString(ColorNum, C2);				C2 := Concat(C2, 'm');				ColorNum := rnd(31, 37, HermSetup);				NumToString(ColorNum, C3);				C3 := Concat(C3, 'm');				ANSICode('2J', procs[13]);				ANSICode('H', procs[13]);				BufferANSI('1;28H', false, HermSetup);				BufferANSI(concat(C2, '컴컴컴컴컴컴컴컴컴컴컴�'), false, HermSetup);				BufferANSI('1;32H', false, HermSetup);				BufferANSI(concat(C1, 'Character'), false, HermSetup);				BufferANSI('1;43H', false, HermSetup);				BufferANSI(concat(C1, 'Info'), false, HermSetup);				BufferANSI(C1, false, HermSetup);				BufferANSI('2HName', false, HermSetup);				BufferANSI('2;40HClass', false, HermSetup);				BufferANSI('3;5HHitPoints', false, HermSetup);				BufferANSI('3;45HLevel', false, HermSetup);				BufferANSI('4;5HExploration', false, HermSetup);				BufferANSI('4;45HExperience', false, HermSetup);				BufferANSI('5;5HSpars', false, HermSetup);				BufferANSI('5;45HAmmo', false, HermSetup);				BufferANSI('6;5HDexterity', false, HermSetup);				BufferANSI('6;45HPsyche', false, HermSetup);				BufferANSI('7;5HStrength', false, HermSetup);				BufferANSI('7;45HSpeed', false, HermSetup);				BufferANSI(C3, false, HermSetup);				BufferANSI('2;5H-', false, HermSetup);				BufferANSI('2;45H-', false, HermSetup);				for X := 3 to 7 do					begin						NumToString(x, tempstr);						BufferANSI(concat(tempStr, ';17H', ':'), false, HermSetup);						BufferANSI(concat(tempStr, ';57H', ':'), false, HermSetup);					end;				BufferANSI('2;7H', false, HermSetup);				BufferANSI(concat('1;36;41m', TheStats.Name), false, HermSetup);				BufferANSI('0;37;40m', false, HermSetup);				BufferANSI('2;47H', false, HermSetup);				BufferANSI(concat('1;36;41m', TheStats.CharClass), false, HermSetup);				BufferANSI('0;37;40m', false, HermSetup);				BufferANSI(C2, false, HermSetup);				NumtoString(TheStats.HitPoints, TempStr);				BufferANSI(concat('3;18H', TempStr), false, HermSetup);				TempStr := 'No Level';				BufferANSI(concat('3;58H', TempStr), false, HermSetup);				NumToString(TheStats.Exploration, TempStr);				BufferANSI(concat('4;18H', TempStr), false, HermSetup);				NumToString(TheStats.Experience, TempStr);				BufferANSI(concat('4;58H', TempStr), false, HermSetup);				NumToString(TheStats.Spars, TempStr);				BufferANSI(concat('5;18H', TempStr), false, HermSetup);				NumToString(TheStats.Ammo, TempStr);				BufferANSI(concat('5;58H', TempStr), false, HermSetup);				BufferANSI(concat('6;18H', convertStats(TheStats.Dexterity, HermSetup)), false, HermSetup);				BufferANSI(concat('6;58H', convertStats(TheStats.Psyche, HermSetup)), false, HermSetup);				BufferANSI(concat('7;18H', convertStats(TheStats.Strength, HermSetup)), false, HermSetup);				BufferANSI(concat('7;58H', convertStats(TheStats.Speed, HermSetup)), false, HermSetup);				ReleaseBuffer(procs[99]);			end;	end;{-------------------------------------------------}procedure PrintMonster (TheMonster: MonsterRec; var HermSetup: UserXIPtr);	var		st1: str255;	begin		with hermSetup^ do			begin				BufferIt('[1]  Name: ', false, 7, procs[98]);				BufferIt(TheMonster.Name, false, 1, procs[98]);				bufferbCr(procs[101]);				NumToString(TheMonster.Level, st1);				BufferIt('[ ]  Level: ', false, 7, procs[98]);				BufferIt(st1, false, 1, procs[98]);				bufferbCr(procs[101]);				NumToString(TheMonster.MonsterNum, st1);				BufferIt('[ ]  MonsterNum: ', false, 7, procs[98]);				BufferIt(st1, false, 1, procs[98]);				bufferbCr(procs[101]);				NumToString(TheMonster.HitPoints, st1);				BufferIt('[2]  HitPoints: ', false, 7, procs[98]);				BufferIt(st1, false, 1, procs[98]);				bufferbCr(procs[101]);				NumToString(TheMonster.Offense, st1);				BufferIt('[3]  Offense: ', false, 7, procs[98]);				BufferIt(st1, false, 1, procs[98]);				bufferbCr(procs[101]);				NumToString(TheMonster.Defense, st1);				BufferIt('[4]  Defense: ', false, 7, procs[98]);				BufferIt(st1, false, 1, procs[98]);				bufferbCr(procs[101]);				NumToString(TheMonster.Experience, st1);				BufferIt('[5]  Experience: ', false, 7, procs[98]);				BufferIt(st1, false, 1, procs[98]);				bufferbCr(procs[101]);				BufferIt('[6]  AttackString 1: ', false, 7, procs[98]);				BufferIt(TheMonster.AttackStr1, false, 1, procs[98]);				bufferbCr(procs[101]);				BufferIt('[7]  AttackString 2: ', false, 7, procs[98]);				BufferIt(TheMonster.AttackStr2, false, 1, procs[98]);				bufferbCr(procs[101]);				BufferIt('[8]  Defense String: ', false, 7, procs[98]);				BufferIt(TheMonster.DefenseStr, false, 1, procs[98]);				bufferbCr(procs[101]);				NumToString(TheMonster.Coins, st1);				BufferIt('[9]  Coins Given: ', false, 7, procs[98]);				BufferIt(st1, false, 1, procs[98]);				bufferbCr(procs[101]);				NumToString(TheMonster.Movement, st1);				BufferIt('[10] Movement: ', false, 7, procs[98]);				BufferIt(st1, false, 1, procs[98]);				bufferbCr(procs[101]);				NumToString(TheMonster.Disposition, st1);				BufferIt('[11] Disposition: ', false, 7, procs[98]);				BufferIt(st1, false, 1, procs[98]);				ReleaseBuffer(procs[99]);			end;	end;{-------------------------------------------------}procedure DrawCombatField (TheTerrain: TerrainType; var HermSetup: UserXIPtr);	var		Current, Last: integer;		R, C: integer;		st1, TheLine: str255;	begin		with HermSetup^ do			begin				current := 0;				Last := 0;				for r := 1 to 12 do					begin						NumToString(r + 2, st1);						TheLine := concat(st1, ';3H');						for c := 1 to 48 do							begin								last := current;								current := TheTerrain[r, c];								if last <> current then									case TheTerrain[r, c] of										0: 											TheLine := concat(TheLine, char(27), '[0;37;40m');										1: 											TheLine := concat(TheLine, char(27), '[0;32;40m');										2: 											TheLine := concat(TheLine, char(27), '[0;33;40m');										3: 											TheLine := concat(TheLine, char(27), '[0;34;40m');										4: 											TheLine := concat(TheLine, char(27), '[0;34;43m');										5: 											TheLine := concat(TheLine, char(27), '[1;30;40m');										6: 											TheLine := concat(TheLine, char(27), '[1;32;40m');										7: 											TheLine := concat(TheLine, char(27), '[0;32;40m');										8: 											TheLine := concat(TheLine, char(27), '[1;30;47m');										9: 											TheLine := concat(TheLine, char(27), '[1;30;40m');									end;{ Case }								TheLine := concat(TheLine, GetTerrChar(TheTerrain[r, c], false));							end;{ for c }						BufferANSI(TheLine, false, HermSetup);					end; { for r }				ReleaseBuffer(procs[99]);			end;{ HermSetup }	end;{ procedure }{-------------------------------------------------}procedure DrawCharInfo (TheCharacter: CharRec; var HermSetup: UserXIPtr);	var		st1: str255;	begin		with HermSetup^ do			begin				BufferANSI('4;56H', false, HermSetup);				BufferANSI('0;35m-', false, Hermsetup);				BufferANSI(concat('0;36m', TheCharacter.Name), false, HermSetup);				BufferANSI('5;65H', false, HermSetup);				NumToString(TheCharacter.Movement, st1);				BufferANSI(concat('0;32m', st1), false, HermSetup);				BufferANSI('6;65H', false, HermSetup);				NumToString(TheCharacter.HitPoints, st1);				BufferANSI(concat('0;32m', st1), false, HermSetup);				BufferANSI('0;34m/', false, HermSetup);				NumToString(TheCharacter.MaxHP, st1);				BufferANSI(concat('0;32m', st1), false, HermSetup);				BufferANSI('7;65H', false, HermSetup);				NumToString(TheCharacter.Psyche, st1);				BufferANSI(concat('0;32m', st1), false, HermSetup);				BufferANSI('0;34m/', false, HermSetup);				NumToString(TheCharacter.MaxPsyche, st1);				BufferANSI(concat('0;32m', st1), false, HermSetup);				BufferANSI('9;57H', false, HermSetup);				BufferANSI(concat('0;35m', TheCharacter.Weapons[1].Name), false, HermSetup);				BufferANSI('10;57H', false, HermSetup);				BufferANSI(concat('0;35m', TheCharacter.Weapons[2].Name), false, HermSetup);				BufferANSI('11;57H', false, HermSetup);				BufferANSI(concat('0;35m', TheCharacter.Weapons[3].Name), false, HermSetup);				BufferANSI('13;57H', false, HermSetup);				BufferANSI(concat('0;35m', TheCharacter.Armor[1].Name), false, HermSetup);				BufferANSI('14;57H', false, HermSetup);				BufferANSI(concat('0;35m', TheCharacter.Armor[2].Name), false, HermSetup);				ReleaseBuffer(procs[99]);			end;	end;{-------------------------------------------------}procedure ShowScale (var HermSetup: UserXIPtr);	begin		with HermSetup^ do			begin				Outline('Scale:', true, 7, procs[1]);				bCr(procs[0]);				Outline(' 1 - Hahaha!', true, 1, procs[1]);				Outline(' 2 - Puny', true, 1, procs[1]);				Outline(' 3 - Weak', true, 1, procs[1]);				Outline(' 4 - Lacking', true, 1, procs[1]);				Outline(' 5 - Fair', true, 1, procs[1]);				Outline(' 6 - Typical', true, 1, procs[1]);				Outline(' 7 - Adequate', true, 1, procs[1]);				Outline(' 8 - Commendable', true, 1, procs[1]);				Outline(' 9 - Admirable', true, 1, procs[1]);				Outline('10 - Exceptional', true, 1, procs[1]);				Outline('11 - Superior', true, 1, procs[1]);				Outline('12 - Invincible!', true, 1, procs[1]);				bCr(procs[0]);				Outline(' ** Note:  Based on 10 as being Human mortal maximum value', true, 3, procs[1]);			end;	end;{-------------------------------------------------}end.