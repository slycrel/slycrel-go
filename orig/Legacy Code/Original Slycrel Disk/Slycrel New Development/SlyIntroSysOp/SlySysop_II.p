unit SlySysop_II;interface	uses		HermHeaders, Sly_General, Sly_MainUnit, Sly_Weapons;	procedure MAIN (HermSetup: UserXIPtr);implementation	const		SysOpEdit = 1000;		EditWeapon = 199;		EditArmor = 249;		EditPlayer = 300;		EditMonster = 1100;		ViewMonster = 1150;		DeletePlayer = 100;	procedure MAIN (HermSetup: UserXIPtr);		var			i, x, int1, y: integer;			fRefNum: integer;			TerrType, st1, st2: str255;			long1, bytecount: longint;			done: boolean;			err: OSErr;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}		procedure CS (stage: integer);		begin			with HermSetup^ do				Privates^^.Stage[CurNode^] := stage;		end;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}		procedure RS (stage: integer);		begin			with HermSetup^ do				Privates^^.ReturnStage[CurNode^] := stage;		end;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}	begin		with HermSetup^ do			begin				case message of					ActiveExt: 						case privates^^.stage[curNode^] of							EditWeapon: 								begin									if not FExist(concat(filesPath^, SlyDataPath, 'Weapons'), procs[62]) then										begin											bCr(procs[0]);											Outline('No Weapons file, creating new...', true, 1, procs[1]);											bCr(procs[0]);											FCreate(concat(filesPath^, SlyDataPath, 'Weapons'), DataType, HermSetup);											with Privates^^.Char[CurNode^]^^.Weapons[1] do												begin													Name := 'Generic Sword';													Strike := 2;													Range := 0;													Cost := 10;													Ability := 0;													Quality := 100;												end; {with}											parseErr(FSOpen(concat(filesPath^, SlyDataPath, 'Weapons'), vRefNum, privates^^.TempInt[curNode^]), HermSetup);											ByteCount := SizeOf(WeaponRec);											parseErr(FSWrite(privates^^.TempInt[curNode^], ByteCount, @Privates^^.Char[CurNode^]^^.Weapons[1]), HermSetup);											FClose(privates^^.TempInt[curNode^], HermSetup);										end;									ParseErr(FSOpen(concat(filesPath^, SlyDataPath, 'Weapons'), vRefNum, privates^^.TempInt[curNode^]), HermSetup);									n[curNode^]^.BoardAction := repeating;									CS(200);								end;							200: 								begin									if (n[curNode^]^.Aborted) or (MyEOF(privates^^.TempInt[curNode^], HermSetup)) then										begin											if (n[curNode^]^.Aborted) then												Outline(' - Aborted - ', true, 3, procs[1]);											n[curNode^]^.Aborted := false;											ParseErr(GetEOF(privates^^.TempInt[curNode^], ByteCount), HermSetup);											Privates^^.C1[CurNode^] := ByteCount div sizeOf(WeaponRec);											FClose(Privates^^.Tempint[CurNode^], HermSetup);											bCr(procs[0]);											bCr(procs[0]);											NumbersPrompt('Choose Your Weapon: [N,Q,#]', 'NQ0123456789', privates^^.C1[CurNode^], 1, procs[5]);											CS(201);										end									else										DisplayWeaponList(privates^^.TempInt[CurNode^], 32767, HermSetup);  {else}								end;							201: 								begin									if n[CurNode^]^.CurPrompt[1] = 'Q' then										CS(SysOpEdit)									else if n[CurNode^]^.CurPrompt[1] = 'N' then										CS(230)									else if n[CurNode^]^.CurPrompt = '' then										CS(EditWeapon)									else										begin											stringToNum(n[curNode^]^.curPrompt, long1);											Privates^^.C1[CurNode^] := long1;											GetWeapon(long1, privates^^.Char[curNode^]^^.Weapons[1], HermSetup);											CS(205);										end;								end;							205: 								begin									SaveWeapon(Privates^^.Char[CurNode^]^^.Weapons[1], Privates^^.C1[Curnode^], HermSetup);									DisplayWeapon(privates^^.char[curNode^]^^.Weapons[1], Privates^^.C1[CurNode^], HermSetup);									NumbersPrompt('Edit: ', '0123456789', 6, 0, procs[5]);									CS(206);								end;							206: 								begin									if n[CurNode^]^.Curprompt = '' then										CS(205);									case n[CurNode^]^.CurPrompt[1] of										'0': 											begin												bCr(procs[0]);												CS(EditWeapon);											end;										'1': 											CS(210);				{Name}										'2': 											CS(213);				{Strike}										'3': 											CS(216);				{Range}										'4': 											CS(219);				{Cost}										'5': 											CS(222);				{Ability}										'6': 											CS(225);				{Quality}									end {Case}								end;							210: 		{Changing Weapon Name}								begin									bCr(procs[0]);									Outline('What would you like to re-name this weapon to [max 20 chrs]?', true, 1, procs[1]);									bCr(procs[0]);									LettersPrompt(':', '', 20, false, false, false, chr(0), procs[4]);									ANSIPrompter(20, procs[9]);									CS(211);								end;							211: 								begin									bCr(procs[0]);									Privates^^.Char[CurNode^]^^.Weapons[1].Name := n[CurNode^]^.CurPrompt;									Outline(concat('Okay, your weapon is now re-named to ', n[CurNode^]^.CurPrompt, '.'), true, 3, procs[1]);									bCr(procs[0]);									CS(205);								end;  {End of re-naming Weapon}							213:     {Changing Weapon Strike}								begin									bCr(procs[0]);									NumbersPrompt('What would you like your new strike to be [1..32767]? ', '0123456789', 32767, 0, procs[5]);									CS(214);								end;							214: 								begin									StringToNum(n[CurNode^]^.CurPrompt, long1);									Privates^^.Char[CurNode^]^^.Weapons[1].Strike := long1;									bCr(procs[0]);									Outline(concat('Okay, your weapon''s strike is now ', n[CurNode^]^.CurPrompt, '.'), true, 1, procs[1]);									bCr(procs[0]);									CS(205);								end;  {End of strike mods}							216:      {Weapon Range Modifications(0 for melee weapons)}								begin									bCr(procs[0]);									NumbersPrompt('What is the weapon''s new range [0-melee, 1..255-ranged]? ', '0123456789', 255, 0, procs[5]);									bCr(procs[0]);									CS(217);								end;							217: 								begin									StringToNum(n[CurNode^]^.CurPrompt, long1);									Privates^^.Char[CurNode^]^^.Weapons[1].Range := long1;									Outline(concat('Okay, your weapon''s new range is ', n[CurNode^]^.CurPrompt, '.'), true, 1, procs[1]);									bCr(procs[0]);									CS(205);								end;  {End of Ranged mods}							219: 								begin  {Weapon Cost modifications}									bCr(procs[0]);									NumbersPrompt('What would you like the new cost of this weapon to be [0-unavbl, 1..32767-buyable]?', '0123456789', 32767, 0, procs[5]);									bCr(procs[0]);									CS(220);								end;							220: 								begin									StringToNum(n[CurNode^]^.CurPrompt, long1);									Privates^^.Char[CurNode^]^^.Weapons[1].Cost := long1;									bCr(Procs[0]);									Outline(concat('Okay, your weapon''s cost is now ', n[CurNode^]^.CurPrompt, '.'), true, 1, procs[1]);									bCr(procs[0]);									CS(205);								end;  {end of cost change}							222:  {Ability}								begin									bCr(procs[0]);									NumbersPrompt('What ability would you like your weapon to have [0-none, 1..255, ?-list]?', '?0123456789', 255, 0, procs[5]);									bCr(procs[0]);									CS(223);								end;							223: 								if n[CurNode^]^.CurPrompt[1] <> '?' then									begin										StringToNum(n[CurNode^]^.CurPrompt, long1);										Privates^^.Char[CurNode^]^^.Weapons[1].Ability := long1;										Outline(concat('Okay, your weapon''s ability is now ', n[CurNode^]^.CurPrompt, '.'), true, 1, procs[1]);										bCr(procs[0]);										CS(205);									end								else									begin										bCr(procs[0]);										Outline('Not yet implemented...', true, 1, procs[1]);										bCr(procs[0]);										CS(222);									end;  {End ability mods}							225:    {Quality mods}								begin									bCr(procs[0]);									NumbersPrompt('What quality would you like your weapon to have [0..32767]?', '?0123456789', 32767, 0, procs[5]);									bCr(procs[0]);									CS(226);								end;							226: 								begin									StringToNum(n[CurNode^]^.CurPrompt, long1);									Privates^^.Char[CurNode^]^^.Weapons[1].Quality := long1;									Outline(concat('Okay, your weapon''s new quality is ', n[CurNode^]^.CurPrompt, '.'), true, 1, procs[1]);									bCr(procs[0]);									CS(205);								end;  {quailty mods}							230: 								begin{initialize new weapon}									with Privates^^.Char[CurNode^]^^.Weapons[1] do										begin											Name := 'Generic Sword';											Strike := 2;											Range := 0;											Cost := 10;											Ability := 0;											Quality := 100;										end; {with}									parseerr(FSOpen(concat(filesPath^, SlyDataPath, 'Weapons'), vRefNum, Privates^^.Tempint[CurNode^]), HermSetup);									long1 := SizeOf(WeaponRec);									Privates^^.C1[CurNode^] := 0;{Write weapon to file & close file}									err := SetFPos(Privates^^.tempint[CurNode^], FSFromLEOF, 0);									parseerr(err, HermSetup);									err := FSWrite(privates^^.Tempint[CurNode^], long1, @Privates^^.Char[CurNode^]^^.Weapons[1]);									parseerr(err, HermSetup);									err := GetFPos(Privates^^.Tempint[CurNode^], long1);									parseerr(err, HermSetup);									Privates^^.C1[CurNode^] := long1 div SizeOf(WeaponRec);									FClose(Privates^^.Tempint[CurNode^], HermSetup);{go to edit weapon stage and edit new weapon}									CS(205);								end;				{New Weapon}							EditArmor: 								begin									if not FExist(concat(filesPath^, SlyDataPath, 'Armor'), procs[62]) then										begin											bCr(procs[0]);											Outline('No Armor file, creating new...', true, 1, procs[1]);											bCr(procs[0]);											FCreate(concat(filesPath^, SlyDataPath, 'Armor'), DataType, HermSetup);											with Privates^^.Char[CurNode^]^^.Armor[1] do												begin													Name := 'Generic Armor';													Class := 0;													Defense := 2;													Cost := 10;													Ability := 0;													Quality := 100;												end; {with}											parseErr(FSOpen(concat(filesPath^, SlyDataPath, 'Armor'), vRefNum, privates^^.TempInt[curNode^]), HermSetup);											ByteCount := SizeOf(ArmorRec);											parseErr(FSWrite(privates^^.TempInt[curNode^], ByteCount, @Privates^^.Char[CurNode^]^^.Armor[1]), HermSetup);											FClose(privates^^.TempInt[curNode^], HermSetup);										end;									ParseErr(FSOpen(concat(filesPath^, SlyDataPath, 'Armor'), vRefNum, privates^^.TempInt[curNode^]), HermSetup);									n[curNode^]^.BoardAction := repeating;									CS(250);								end;							250: 								begin									if (n[curNode^]^.Aborted) or (MyEOF(privates^^.TempInt[curNode^], HermSetup)) then										begin											if (n[curNode^]^.Aborted) then												Outline(' - Aborted - ', true, 3, procs[1]);											n[curNode^]^.Aborted := false;											ParseErr(GetEOF(privates^^.TempInt[curNode^], ByteCount), HermSetup);											Privates^^.C1[CurNode^] := ByteCount div sizeOf(ArmorRec);											FClose(Privates^^.Tempint[CurNode^], HermSetup);											bCr(procs[0]);											bCr(procs[0]);											NumbersPrompt('Choose Your Weapon: [N,Q,#]', 'NQ0123456789', privates^^.C1[CurNode^], 1, procs[5]);											CS(251);										end									else										DisplayArmorList(privates^^.TempInt[CurNode^], 32767, HermSetup);  {else}								end;							251: 								begin									if n[CurNode^]^.CurPrompt[1] = 'Q' then										CS(SysOpEdit)									else if n[CurNode^]^.CurPrompt[1] = 'N' then										CS(280)									else if n[CurNode^]^.CurPrompt = '' then										CS(EditArmor)									else										begin											stringToNum(n[curNode^]^.curPrompt, long1);											Privates^^.C1[CurNode^] := long1;											GetArmor(long1, privates^^.Char[curNode^]^^.Armor[1], HermSetup);											CS(255);										end;								end;							255: 								begin									SaveArmor(Privates^^.Char[CurNode^]^^.Armor[1], Privates^^.C1[Curnode^], HermSetup);									DisplayArmor(privates^^.char[curNode^]^^.Armor[1], Privates^^.C1[CurNode^], HermSetup);									NumbersPrompt('Edit: ', '0123456789', 6, 0, procs[5]);									CS(256);								end;							256: 								begin									if n[CurNode^]^.Curprompt = '' then										CS(255);									case n[CurNode^]^.CurPrompt[1] of										'0': 											begin												bCr(procs[0]);												CS(EditArmor);											end;										'1': 											CS(260);				{Name}										'2': 											CS(263);				{Defense}										'3': 											CS(266);				{Class}										'4': 											CS(269);				{Cost}										'5': 											CS(272);				{Ability}										'6': 											CS(275);				{Quality}									end {Case}								end;							260: 		{Changing Armor Name}								begin									bCr(procs[0]);									Outline('What would you like to re-name this Armor to [max 20 chrs]?', true, 1, procs[1]);									bCr(procs[0]);									LettersPrompt(':', '', 20, false, false, false, chr(0), procs[4]);									ANSIPrompter(20, procs[9]);									CS(261);								end;							261: 								begin									bCr(procs[0]);									Privates^^.Char[CurNode^]^^.Armor[1].Name := n[CurNode^]^.CurPrompt;									Outline(concat('Okay, your Armor is now re-named to ', n[CurNode^]^.CurPrompt, '.'), true, 3, procs[1]);									bCr(procs[0]);									CS(255);								end;  {End of re-naming Armor}							263:     {Changing Armor Strike}								begin									bCr(procs[0]);									NumbersPrompt('What would you like your new defense to be [1..32767]? ', '0123456789', 32767, 0, procs[5]);									CS(264);								end;							264: 								begin									StringToNum(n[CurNode^]^.CurPrompt, long1);									Privates^^.Char[CurNode^]^^.Armor[1].Defense := long1;									bCr(procs[0]);									Outline(concat('Okay, your Armor''s Defense is now ', n[CurNode^]^.CurPrompt, '.'), true, 1, procs[1]);									bCr(procs[0]);									CS(255);								end;  {End of defense mods}							266:      {Armor Class Modifications(0 for body, 1 for shield, 2 for full body...}								begin									bCr(procs[0]);									NumbersPrompt('What is the Armor''s new Class [0-Body, 1-Shield,2-Full Body]? ', '0123456789', 255, 0, procs[5]);									bCr(procs[0]);									CS(267);								end;							267: 								begin									StringToNum(n[CurNode^]^.CurPrompt, long1);									Privates^^.Char[CurNode^]^^.Armor[1].Class := long1;									Outline(concat('Okay, your Armor''s new Class is ', n[CurNode^]^.CurPrompt, '.'), true, 1, procs[1]);									bCr(procs[0]);									CS(255);								end;  {End of Ranged mods}							269: 								begin  {Armor Cost modifications}									bCr(procs[0]);									NumbersPrompt('What would you like the new cost of this Armor to be [0-unavbl, 1..32767-buyable]?', '0123456789', 32767, 0, procs[5]);									bCr(procs[0]);									CS(270);								end;							270: 								begin									StringToNum(n[CurNode^]^.CurPrompt, long1);									Privates^^.Char[CurNode^]^^.Armor[1].Cost := long1;									bCr(Procs[0]);									Outline(concat('Okay, your Armor''s cost is now ', n[CurNode^]^.CurPrompt, '.'), true, 1, procs[1]);									bCr(procs[0]);									CS(255);								end;  {end of cost change}							272:  {Ability}								begin									bCr(procs[0]);									NumbersPrompt('What ability would you like your Armor to have [0-none, 1..255, ?-list]?', '?0123456789', 255, 0, procs[5]);									bCr(procs[0]);									CS(273);								end;							273: 								if n[CurNode^]^.CurPrompt[1] <> '?' then									begin										StringToNum(n[CurNode^]^.CurPrompt, long1);										Privates^^.Char[CurNode^]^^.Armor[1].Ability := long1;										Outline(concat('Okay, your Armor''s ability is now ', n[CurNode^]^.CurPrompt, '.'), true, 1, procs[1]);										bCr(procs[0]);										CS(265);									end								else									begin										bCr(procs[0]);										Outline('Not yet implemented...', true, 1, procs[1]);										bCr(procs[0]);										CS(272);									end;  {End ability mods}							275:    {Quality mods}								begin									bCr(procs[0]);									NumbersPrompt('What quality would you like your Armor to have [0..32767]?', '?0123456789', 32767, 0, procs[5]);									bCr(procs[0]);									CS(276);								end;							276: 								begin									StringToNum(n[CurNode^]^.CurPrompt, long1);									Privates^^.Char[CurNode^]^^.Armor[1].Quality := long1;									Outline(concat('Okay, your Armor''s new quality is ', n[CurNode^]^.CurPrompt, '.'), true, 1, procs[1]);									bCr(procs[0]);									CS(255);								end;  {quailty mods}							280: 								begin{initialize new Armor}									with Privates^^.Char[CurNode^]^^.Armor[1] do										begin											Name := 'Generic Armor';											Defense := 2;											Class := 0;											Cost := 10;											Ability := 0;											Quality := 100;										end; {with}									parseerr(FSOpen(concat(filesPath^, SlyDataPath, 'Armor'), vRefNum, Privates^^.Tempint[CurNode^]), HermSetup);									long1 := SizeOf(ArmorRec);									Privates^^.C1[CurNode^] := 0;{Write Armor to file & close file}									err := SetFPos(Privates^^.tempint[CurNode^], FSFromLEOF, 0);									parseerr(err, HermSetup);									err := FSWrite(privates^^.Tempint[CurNode^], long1, @Privates^^.Char[CurNode^]^^.Armor[1]);									parseerr(err, HermSetup);									err := GetFPos(Privates^^.Tempint[CurNode^], long1);									parseerr(err, HermSetup);									Privates^^.C1[CurNode^] := long1 div SizeOf(ArmorRec);									FClose(Privates^^.Tempint[CurNode^], HermSetup);{go to edit Armor stage and edit new Armor}									CS(255);								end;				{New Armor}						end;  {case privates^^.stage[curNode^] of}				end;			end;	end;end.