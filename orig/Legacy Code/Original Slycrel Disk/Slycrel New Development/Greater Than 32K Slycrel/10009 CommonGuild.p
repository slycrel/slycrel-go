unit CommonGuild;{Make this 'XHRM' ID = 10009, but make the file type 'rsrc' and creator 'RSED'.}{You should include your resource file in this one. (in the 'Run' menu under 'Run Options...').}interfaceuses	SlyHeaders, HermHeaders, Sly_General;procedure MAIN (HermSetup: UserXIPtr);implementationprocedure MAIN (HermSetup: UserXIPtr);	var		i, x: integer;		boo1: boolean;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}	procedure CS (stage: integer);		begin			with HermSetup^ do				Privates^^.Stage := stage;		end;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}	procedure RS (stage: integer);		begin			with HermSetup^ do				Privates^^.ReturnStage := stage;		end;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}	begin		with HermSetup^ do			begin				case message of					ActiveExt: 						case privates^^.stage of							CommonGuild: 								begin									privates^^.char^^.Location := TheCommonGuild;									Boo1 := ReadTextFile('Externals:Sly_Data:ANSI:CommonGuildMenu', 0, true, procs[vReadTextFile]);									RS(651);									CS(ListTextFile);								end;							651: 								begin									Outline('[Q,?]', true, 1, procs[vOutline]);									bCr(procs[vbCr]);									n[curNode^]^.curPrompt := ' ';									LettersPrompt('Your choice?  ', 'Q?', 1, true, false, true, chr(0), procs[vLettersPrompt]);									CS(652);								end;							652: 								begin									case n[curNode^]^.curPrompt[1] of										'Q': 											begin												privates^^.char^^.Location := TheTown;												CS(Town);											end;										'?': 											begin												privates^^.char^^.Location := TheCommonGuild;												CS(CommonGuild);											end;										otherwise											CS(CommonGuild);									end;								end;						end;  {case privates^^.stage of}				end;			end;	end;end.