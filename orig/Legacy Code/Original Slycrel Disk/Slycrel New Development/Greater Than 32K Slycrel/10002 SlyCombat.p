unit Sly_Combat;{Make this 'XHRM' ID = 10002, but make the file type 'rsrc' and creator 'RSED'.}{You should include your resource file in this one. (in the 'Run' menu under 'Run Options...').}interfaceuses	SlyHeaders, HermHeaders, Sly_CombatUnit, Sly_General;procedure MAIN (HermSetup: UserXIPtr);implementationprocedure MAIN (HermSetup: UserXIPtr);	var		i, a, b, x: integer;		FRefNum: integer;		int1, damage: integer;		St1, St2, FileName, Monstr: str255;		ch1: char;		Long1: longint;		Boo1: boolean;		err: OSerr;{------------------------------}	procedure CS (newStage: integer);		begin			with HermSetup^ do				Privates^^.Stage := newStage;		end;{------------------------------}	procedure RS (stage: integer);		begin			with HermSetup^ do				Privates^^.ReturnStage := stage;		end;{------------------------------}	procedure inc (var ToInc: integer; HowMuch: integer);		begin			ToInc := ToInc + HowMuch;		end;{------------------------------}	begin		with HermSetup^ do			begin				case privates^^.stage of{The ranges that you put before would now be broken up into individual stages}					Wilderness: 						begin							privates^^.char^^.Location := TheWildernessMenu;							Boo1 := ReadTextFile(concat(ANSIPath, 'WildernessMenu'), 0, true, procs[vReadTextFile]);							RS(Wilderness + 1);							CS(ListTextFile);						end;					96: 						begin							Outline('[A,F,M,S,Q,?]', true, 1, procs[vOutline]);							bCr(procs[vbCr]);							LettersPrompt('Your selection? ', 'AFMSQ?', 1, true, false, true, chr(0), procs[vLettersPrompt]);							CS(97);						end;					97: 						begin							case n[curNode^]^.curPrompt[1] of								'A': 									begin										privates^^.char^^.Location := TheHealersHut;										CS(Healer);									end;								'F', 'M', 'S': 									begin										privates^^.char^^.Location := TheWildernessCombat;										CS(SetupCombat);									end;								'Q': 									begin										privates^^.char^^.Location := TheTown;										CS(Town);									end;								'?': 									begin										privates^^.char^^.Location := TheWildernessMenu;										CS(Wilderness);									end;								otherwise									CS(96);							end;						end;					SetupCombat:{--Reads Terrain and Reads the Monstor into Memory}						begin							Privates^^.Char^^.TotalFights := Privates^^.Char^^.TotalFights + 1;							if Privates^^.char^^.Exploration <= 0 then								begin									Outline('You just can''t find any more monsters today...  Try again tomorrow.', true, 3, procs[vOutline]);									CS(Wilderness);								end							else								begin									Privates^^.char^^.Exploration := Privates^^.char^^.Exploration - 1;									privates^^.char^^.TotalFights := privates^^.char^^.TotalFights + 1;									privates^^.TextOutStr := ' ';									privates^^.TextOutLine := 0;									a := rnd(1, 3, HermSetup);									case n[CurNode^]^.CurPrompt[1] of										'M': 											Monstr := 'Mountain';										'F': 											Monstr := 'Forest';										'S': 											Monstr := 'Swamp';									end;{case}									NumToString(a, st1);									if n[curNode^]^.curPrompt[1] = 'F' then										FileName := concat('Forest-', st1)									else if n[curNode^]^.curPrompt[1] = 'S' then										FileName := concat('Swamp-', st1)									else										FileName := concat('Mountain-', st1);									GetTerrain(FileName, Privates^^.Terrain, HermSetup);									GetMonster(Monstr, rnd(1, 4, HermSetup), Privates^^.Monster, HermSetup);{This gets and saves our monster Max Hitpoints for text combat}									Privates^^.Tempint := Privates^^.Monster.HitPoints;									with privates^^ do										begin											R1 := rnd(1, 12, HermSetup);											C1 := rnd(1, 48, HermSetup);											R2 := rnd(1, 12, HermSetup);											C2 := rnd(1, 48, HermSetup);											with char^^ do												Movement := rnd(speed - speed div 5, speed + speed div 5, HermSetup);										end;									CS(111);								end;						end;					111: 						begin							with privates^^ do								begin									if (NumMovePoints(R1, C1, Terrain) >= Privates^^.char^^.Movement) then										begin											R1 := rnd(1, 12, HermSetup);											C1 := rnd(1, 48, HermSetup);										end;									if (NumMovePoints(R2, C2, Terrain) >= Privates^^.Monster.Movement) then										begin											R2 := rnd(1, 12, HermSetup);											C2 := rnd(1, 48, HermSetup);										end;									if not ((R1 = R2) and (C1 = C2)) then										if (NumMovePoints(R1, C1, Terrain) < Privates^^.char^^.Movement) then											if (NumMovePoints(R2, C2, Terrain) < Privates^^.Monster.Movement) then												CS(DrawCombat);									WriteText('Going through a loop to place our people...', prefs^^.Mywindow, HermSetup);									numToString(Privates^^.char^^.Movement, st1);									WriteText(concat('Character Movement: ', st1), prefs^^.Mywindow, HermSetup);									numToString(Privates^^.monster.movement, st1);									WriteText(concat('Monster Movement: ', st1), prefs^^.Mywindow, HermSetup);								end;						end;					DrawCombat:{--Reads Base Combat ANSI and Releases it}						begin							Boo1 := ReadTextFile(concat(ANSIPath, 'CombatANSI'), 0, true, procs[vReadTextFile]);							if not boo1 then								begin									Outline(concat('Error in Reading ''', FilesPath^, ANSIPath, 'CombatANSI'' file!'), true, 6, procs[vOutline]);									Outline('Aborted', true, 3, procs[vOutline]);									CS(Wilderness);								end							else								begin									n[curNode^]^.BoardAction := ListText;									CS(121);								end;						end;					121: {Draw Combat Field--Draws Combat Field}						begin							DrawCombatField(Privates^^.Terrain, HermSetup);							CS(122);						end;					122: {Draw User Combat Stats-- Draws Users combat Stats}						begin							NumToString(privates^^.R1 + 2, st1);							NumToString(privates^^.C1 + 2, st2);							ANSICode(concat(st1, ';', st2, 'H'), procs[vANSICode]);							ANSICode('1;34mè', procs[vANSICode]);							NumToString(privates^^.R2 + 2, st1);							NumToString(privates^^.C2 + 2, st2);							ANSICode(concat(st1, ';', st2, 'H'), procs[vANSICode]);							ANSICode('0;31mœ', procs[vANSICode]);							DrawCharInfo(privates^^.char^^, HermSetup);							UpdateMovement(Privates^^.char^^.Movement, HermSetup);							TextOut(concat('You Encounter a ', privates^^.Monster.Name), HermSetup);							CS(Combat);						end;					Combat: {Prompt combat movement}						begin							if (not Privates^^.char^^.Alive) or (Privates^^.char^^.HitPoints <= 0) then								begin									if privates^^.char^^.Location = TheArenaCombat then										begin											privates^^.char^^.Location := TheArenaMenu;											CS(612);										end									else										begin											Privates^^.char^^.Alive := false;											privates^^.char^^.Location := TheTown;											SaveChar(n[curNode^]^.ThisUser.UserName, privates^^.char^^, HermSetup);											ANSICode('2J', procs[vANSICode]);											ANSICode('H', procs[vANSICode]);											Outline('You''re outta life buddy...', true, 6, procs[vOutline]);											CS(ShutDown3);										end;								end							else if (Privates^^.Monster.HitPoints <= 0) then								begin									ANSICode('2J', procs[vANSICode]);									ANSICode('H', procs[vANSICode]);									CS(160)								end							else								begin									if (not CanMove(privates^^.R1, privates^^.C1, Privates^^.char^^.Movement, Privates^^.Terrain)) then										CS(102)									else										begin											n[curNode^]^.curPrompt := '';											LettersPrompt('', 'AFIJKLRP*', 1, true, false, true, chr(46), procs[vLettersPrompt]);											ANSICode('16;23H', procs[vANSICode]);											CS(101);										end;								end;						end;					101: { React to user input (Moving player) }						begin							if (privates^^.char^^.Movement < 3) & ((n[curNode^]^.CurPrompt[1] = 'A') or (n[curNode^]^.CurPrompt[1] = 'F')) then								begin									TextOut('Not ''nuff Movement Pts. Left!', Hermsetup);									CS(Combat);								end							else								case n[curNode^]^.CurPrompt[1] of									'I', 'J', 'K', 'L': 										begin											st1 := n[curNode^]^.curPrompt[1];											MovePlayer(st1[1], privates^^.R1, privates^^.C1, privates^^.char^^.Movement, privates^^.Terrain, HermSetup);											if Privates^^.char^^.Alive then												CS(Combat)											else												CS(ShutDown3);										end;									'F': 										with privates^^ do											begin												DoShoot(R1, C1, R2, C2, HermSetup);												CS(combat);											end;									'P': 										begin											TextOut('You pass your remaining moves', hermsetup);											CS(102);										end;									'R': 										begin											if privates^^.char^^.Location = TheArenaCombat then												begin													privates^^.char^^.Location := TheArenaMenu;													CS(Arena);												end											else												begin													privates^^.char^^.Location := TheWildernessMenu;													CS(Wilderness);												end;										end;									'*': 										CS(DrawCombat);									'A': 										begin											Privates^^.char^^.Movement := Privates^^.char^^.Movement - 3;											if rnd(1, 50, HermSetup) < 8 then												CS(SetupTextCombat)											else												begin													TextOut('You Attempt to Attack the Creature, & you fail.', HermSetup);													CS(Combat);												end;										end;									otherwise										CS(Combat);								end; {Case}							with Privates^^ do		{ Quits to Text Combat if User is on Monster }								if (R1 = R2) and (C1 = C2) then									CS(SetupTextCombat);							UpdateMovement(Privates^^.char^^.Movement, HermSetup);						end;					102: { Moves Monster }						begin							for i := 1 to privates^^.Monster.Movement do								begin									with privates^^ do										begin											MoveMonster(R2, C2, R1, C1, monster, Terrain, HermSetup);											if ((R1 = R2) and (C1 = C2)) or not CanMove(R2, C2, Monster.Movement, Terrain) then												i := Monster.Movement;										end;	{with}								end;  { for }							with privates^^.char^^ do								Movement := rnd(speed - speed div 5, speed + speed div 5, HermSetup);							with privates^^ do								if (R1 = R2) and (C1 = C2) then									CS(SetupTextCombat)								else									CS(Combat);							UpdateMovement(Privates^^.char^^.Movement, HermSetup);						end;				end;			end;	end;end.