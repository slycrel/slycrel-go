unit SlyInn;{Make this 'XHRM' ID = 10010, but make the file type 'rsrc' and creator 'RSED'.}{You should include your resource file in this one. (in the 'Run' menu under 'Run Options...').}interfaceuses	SlyHeaders, HermHeaders, Sly_General, InnUnit;procedure MAIN (HermSetup: UserXIPtr);implementationprocedure MAIN (HermSetup: UserXIPtr);	var		i, int1: integer;		long1: longint;		Boo1: boolean;		st1, st2: str255;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}	procedure CS (stage: integer);		begin			with HermSetup^ do				Privates^^.Stage := stage;		end;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}	procedure RS (stage: integer);		begin			with HermSetup^ do				Privates^^.ReturnStage := stage;		end;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}	begin		with HermSetup^ do			begin				case message of					ActiveExt: 						case privates^^.stage of							Inn: 								begin									privates^^.char^^.Location := TheInn;									Boo1 := ReadTextFile('Externals:Sly_Data:ANSI:InnMenu', 0, true, procs[vReadTextFile]);									RS(351);									CS(ListTextFile);								end;							351: 								begin									if n[curNode^]^.thisUser.CoSysOp then										Outline('[R,Q,*,?]', true, 1, procs[vOutline])									else										Outline('[R,Q,?]', true, 1, procs[vOutline]);									bCr(procs[vbCr]);									n[curNode^]^.curPrompt := ' ';									LettersPrompt('Your choice? ', 'QR?*', 1, true, false, true, chr(0), procs[vLettersPrompt]);									CS(352);								end;							352: 								begin									case n[curNode^]^.curPrompt[1] of										'R': 											begin												privates^^.Char^^.Location := TheInn;												CS(355);											end;										'Q': 											begin												privates^^.char^^.Location := TheTown;												CS(Town);											end;										'?': 											begin												privates^^.char^^.Location := TheInn;												CS(Inn);											end;										'*': 											begin												privates^^.Char^^.Location := TheInn;												if (InnKeeperName(HermSetup) = ucase(n[curNode^]^.ThisUser.UserName)) or (n[CurNode^]^.ThisUser.CoSysOp) then													CS(360)												else													CS(351);											end;										otherwise											CS(Inn);									end;								end;							355: 								begin									int1 := EmptyRoom(privates^^.Char^^.Name, boo1, HermSetup);									if int1 = 2 then										begin											Outline('Sorry There are no more rooms Avbl. for Rent', true, 3, procs[vOutline]);											CS(351);										end									else if int1 = 3 then										begin											Outline('Sorry, you can only have one room.', true, 3, procs[vOutline]);											CS(351);										end									else										begin											YesNoQuestion('Would you like to Rent a room? ', true, procs[vYesNoQuestion]);											CS(356);										end;								end;							356: 								begin									if n[curNode^]^.CurPrompt[1] = 'N' then										CS(351)									else										begin											n[curNode^]^.curPrompt := '0';											NumbersPrompt('For how many days? [0-14] :', '0123456789', 14, 0, procs[vNumbersPrompt]);											CS(357);										end;								end;							357: 								begin									StringToNum(n[curNode^]^.CurPrompt, long1);									if n[curNode^]^.CurPrompt[1] = '0' then										begin											Outline('FINE!  Don''t Rent a room, go sleep in the streets!', true, 3, procs[vOutline]);											CS(351);										end									else if privates^^.char^^.CoinsHand < (long1 * RoomCostPerDay(HermSetup)) then										begin											Outline('I''m not giving the room away, come back when you have enough coins!', true, 3, procs[vOutline]);											NumToString(RoomCostPerDay(HermSetup), St1);											Outline(concat('Note, it costs ', st1, ' coins per day to rent a room.'), true, 1, procs[vOutline]);											long1 := 0;{don't charge if they can't afford it, we'll deny them a room if this = 0}											CS(351);										end									else										begin											privates^^.C1 := long1 * RoomCostPerDay(HermSetup);{C1 = Total Cost of Rooms for x days}											privates^^.TempInt := long1;{TempInt = number of days rented}											n[curNode^]^.curPrompt := '0';											NumbersPrompt('What Security Rating would you like on your lock? [0-10] :', '0123456789', 10, 0, procs[vNumbersPrompt]);											CS(358);										end;								end;							358: 								begin									StringToNum(n[curNode^]^.CurPrompt, long1);									long1 := long1 * 2;{long1 = cost of the lock}									if (n[curNode^]^.curprompt = '0') then										Outline('"Ok, don''t blame me if Corenne slips in late at night," grins the Innkeeper . ', true, 3, procs[vOutline])									else if privates^^.char^^.CoinsHand < (long1) then										begin											Outline('I''m not giving the Lock away!', true, 3, procs[vOutline]);											Outline('Note, it costs twice the lock rating for the lock.', true, 1, procs[vOutline]);											long1 := 0;{Don't charge em if they don't have enough cash}										end;{if room cost = 0 then they didn't buy a room! so don't give it to em}									if privates^^.C1 <> 0 then										begin											Outline('Item:              Days:                  Cost:', true, 2, procs[vOutline]);											numToString(privates^^.TempInt, st1);											numToString(privates^^.C1, st2);											Outline(concat(' Room               ', spaceOut(st1, 23), '$', st2), true, 1, procs[vOutline]);											numToString(long1, st2);											Outline(concat(' Lock               ', spaceOut('1', 23), '$', st2), true, 1, procs[vOutline]);											numToString(privates^^.C1 + long1, st1);											Outline(concat('Total:                                     $', st1), true, 3, procs[vOutline]);											privates^^.char^^.coinsHand := privates^^.char^^.coinsHand - long1 - privates^^.C1;{take away their cash dude}											boo1 := AddToRooms(privates^^.Char^^.Name, privates^^.TempInt, long1, HermSetup);											if not boo1 then												Outline('Sorry, but the Inn Keeper just robbed you blind.', true, 3, procs[vOutline]);										end;	{if, cost = 0}									CS(351);								end;							360: 								begin									DisplayInnKeeperMenu(HermSetup);									Outline('[1,2,3,4,5,6,Q]', true, 1, procs[vOutline]);									bCr(procs[0]);									n[curNode^]^.curPrompt := ' ';									NumbersPrompt('Your choice?  ', '123456Q', 6, 1, procs[vNumbersPrompt]);									CS(361);								end;							361: 								begin									case n[curNode^]^.curPrompt[1] of										'Q': 											begin												privates^^.char^^.Location := TheTown;												CS(Inn);											end;										'1': 											begin												bCr(Procs[vbCr]);												NumbersPrompt('Daily Charge for a Room:  ', '', 32000, 1, procs[vNumbersPrompt]);												ANSIPrompter(5, procs[vANSIPrompter]);												CS(362);											end;										'2': 											begin												ListRooms(HermSetup);												bCr(procs[vbCr]);												CS(360);											end;										'3': 											begin												ListRooms(HermSetup);												bCr(procs[vbCr]);												NumbersPrompt('Which player? [1-10] ', '', 10, 1, procs[vNumbersPrompt]);												CS(363);											end;										'4': 											begin												ViewInnStats(HermSetup);												CS(360);											end;										'5': 											begin												YesNoQuestion('Would you like to close the Inn to the public? [y/N]', false, procs[vYesNoQuestion]);												CS(364);											end;										'6': 											begin												Outline('Who is to be the new Inn Owner?', true, 7, procs[vOutline]);												bCr(procs[vbCr]);												n[curNode^]^.curPrompt := '0';												LettersPrompt(': ', '', 20, false, false, true, chr(0), procs[vLettersPrompt]);												CS(365);											end;										otherwise											CS(360);									end;								end;							362: 								begin									bCr(procs[vbCr]);									StringToNum(n[CurNode^]^.CurPrompt, Long1);									ChangeRate(Long1, HermSetup);									CS(360);								end;							363: 								begin									bCr(procs[vbCr]);									StringToNum(n[CurNode^]^.CurPrompt, Long1);									RemovePlayerFromInn(long1, HermSetup);									CS(360);								end;							364: 								begin									bCr(procs[vbCr]);									if n[CurNode^]^.CurPrompt[1] = 'Y' then										CloseInn(false, HermSetup)									else										CloseInn(true, HermSetup);									CS(360);								end;							365: 								begin									if (n[curNode^]^.curPrompt <> '0') then										NewInnOwner(n[curNode^]^.curPrompt, HermSetup);									CS(360);								end;						end;  {case}				end;			end;	end;end.