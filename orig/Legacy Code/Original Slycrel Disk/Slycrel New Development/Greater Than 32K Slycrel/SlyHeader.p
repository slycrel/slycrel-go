unit SlyHeaders; {for Slycrel}interfaceconst	EnterSlycrel = 20;	CreateCharacter = 30;	ViewCharacter = 50;	Wilderness = 95;	SetupCombat = 110;	DrawCombat = 120;	Combat = 100;	SetupTextCombat = 149;	TextCombatLoop = 150;	UserAttackStage = 155;	OpponentAttackStage = 160;	Town = 200;	UpperTown = 250;	Tavern = 300;	Inn = 350;	Healer = 400;	Herbalist = 450;	Bank = 500;	Tower = 525;	Armory = 550;	Arena = 600;	ListSlyPlayers = 615;	CommonGuild = 650;	FigterGuild = 700;	MageGuild = 750;	ThiefGuild = 800;	ListTextFile = 9997;	ShutDown = 32700;	ShutDown2 = 32701;	ShutDown3 = 32702;	SlyDataPath = 'Externals:Sly_Data:';	UserPath = 'Externals:Sly_Data:Users:';	MonsterPath = 'Externals:Sly_Data:Monsters:';	TerrainPath = 'Externals:Sly_Data:Terrain:';	ANSIPath = 'Externals:Sly_Data:ANSI:';	MailPath = 'Externals:Sly_Data:Mail:';	HermesType = 'HRMS';	DataType = 'DATA';	TextType = 'TEXT';	vRefNum = 0;	numSegs = 10;  {the number of additional segments you will use}type{$IFC UNDEFINED DEBUG_LEVEL}{$SETC CURRENT_DEBUG_LEVEL := 1}{$ENDC}	TownType = (Village, SmallTown, Commonwealth, Province, City, LargeCity, Capitol);	HitType = (TheUser, UserOnly, UserMiss, Opponent, OpponentOnly, Both, Neither, _none, UserRan, OpponentRan);	CombatType = (Attack, Block, Parry, Dodge, Special);	GeneralRec = record			TownName: str255;			LastUpDate: DateTimeRec;			NumberPlayers: integer;			GoldPool: longint;			ManaPool: longint;			RealTime: boolean;			Population: longint;			TownSize: TownType;			TaxRate: real;						{percentage}			PlayerPower: boolean;			NPCNum: byte;						{Ceiling of # of players * 2}			Difficulty: real;				{0.5 to 3.0 -- Multiply modifier}		end;{This is our file reading, etc. for our Gladiator combat stuff}	GCombatPrefs = record			Challenger: str255;			Opponent: str255;			Odds: array[1..2] of byte;		end;	GCombatList = record			FightNum: integer;	{what fight number the bet is on}			FileName: str255;	{the better's character file name}			Bet: integer;			Challenger: str255;			Opponent: str255;			ForChallenger: boolean;		end;{end of gladiator combat stuff}	RoomRec = record			Who: string[20];			DaysLeft: byte;			Lock: byte;		end;	InnRec = record			Rooms: array[1..10] of RoomRec;			Owner: string[20];			CurRate: integer;			Safe: longint;			Open: boolean;		end;	PlayersRec = record			BBSName: string[31];			SlyName: string[20];			Class: string[8];			Alive: Boolean;			LastPlayed: longint;			ApprVal: longint;		end;	HighScoreType = record			name: string[40];			Value: longint;			LastDate: str255;		end;	HighScoreArr = array[1..11] of HighScoreType;	WeaponRec = record			Name: string[20];			Strike: integer;			Range: byte;			Cost: integer;			Ability: byte;			Quality: integer;		end;	ArmorRec = record			Name: string[20];			Defense: integer;			Class: byte;		{0 = body, 1 = shield, 2 = full body...}			Cost: integer;			Ability: byte;			Quality: byte;		end;	Color = (Black, White, Blue, Red, Purple, Yellow, Orange, Green);	WhereType = (TheTown, TheInn, TheWildernessMenu, TheWildernessCombat, TheHerbalist, TheBank, TheTavern, TheTower, TheArenaMenu, TheArenaCombat, TheHealersHut, TheCommonGuild, TheFightersGuild, TheThievesGuild, TheMagesGuild, TheArmory);{DON'T FORGET!!!}{Athos - God of War}{DON'T FORGET!!!}	SpellsType = (Heal, Flame, Snap);	ThiefSkillsType = (PickPocket, PickLock, BackStab);	FighterSkillsType = (Lunge, BreakWeapon, Disarm);	ItemsType = (Candel, Torch, DavesPlate);	MonsterType = (Humanoid, Orc, Goblin, Fairy, Insectoid, Fantastic, Elven, FElemental, WElemental, EElemental, AElemental, Dwarven, Evil, Good, Flying, Undead, psychic, Other);	CurMaxRec = record			Cur: byte;			Max: byte;		end;{---!!!!--!!!!--- Remember to check <add> color & other new var's for initilization in character creation}{Character's info is held in this record}{Similar to a character Sheet <grin>}	CharHand = ^CharPtr;	CharPtr = ^CharRec;	CharRec = record			Name: string[20];			Laston: longint;			Alive: boolean;			Location: WhereType;			Gender: boolean;			CharClass: string[8];			TotalExperience, SpendingExperience: Longint;			ThiefLvl, MageLvl, FighterLvl: byte;			TheifGuild, MageGuild, FighterGuild: Boolean;			HitPoints, MaxHP: integer;			CoinsHand, CoinsBank: longint;			Speed: byte;			Strength: byte;			Dexterity: byte;			Psyche, MaxPsyche: byte;			Fame: byte;			Profile: integer;			Honor: byte;			Faith: byte;			FavColor: Color;			Flirt1, Flirt2: byte;			Ammo: byte;			Movement: byte;			Exploration: byte;			Spars: byte;			TotalFights, FightsWon: longint;			Spells: array[heal..snap] of CurMaxRec;			FighterSkills: array[lunge..Disarm] of CurMaxRec;			ThiefSkills: array[pickPocket..BackStab] of CurMaxRec;			Weapons: array[1..3] of WeaponRec;			Armor: array[1..2] of ArmorRec;		end;	MonsterRec = record			Name: string[20];			Level: byte;			MType: MonsterType;			MonsterNum: integer;			HitPoints: integer;			Offense, RangeOffense: byte;			Defense: byte;			Movement: byte;			Disposition: byte;			Experience: integer;			AttackStr1, AttackStr2: string[15];			DefenseStr: string[15];			Coins: integer;		end;	TerrainType = array[1..12, 1..48] of byte;	myPrefsHand = ^myPrefsPtr;	myPrefsPtr = ^myPrefs;	myPrefs = record			otherCode: array[1..numSegs] of handle;			Seed: integer;			LastUpdate: longint;			myWindow: WindowPtr;		end;	myPrivsHand = ^myPrivsPtr;	myPrivsPtr = ^myPrivs;	myPrivs = record			activeOn: boolean;			stage: integer;			Char: CharHand;			Monster: MonsterRec;			Terrain: TerrainType;			ReturnStage: integer;			R1, C1, R2, C2: integer;	{Row, Column of User & Foe}			Hit: HitType;			Move: CombatType;			MMove: CombatType;			PrefData: GCombatPrefs;			Tempstr, Tempstr2: str255;			Tempint: integer;			TextOutStr: string[50];	{Used for Combat Text Window}			TextOutLine: byte;			{What line in the Combat Text Window}		end;implementationend.