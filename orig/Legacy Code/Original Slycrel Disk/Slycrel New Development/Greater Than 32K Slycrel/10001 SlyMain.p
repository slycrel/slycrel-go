unit SlyMain;{Make this 'XHRM' ID = 10001, the normal way you make an external.}{The resource file to include for this is the other external, so compile it first,}{then include it when you compile this one, that way you don't need to use ResEdit!}{This works for SysOp externals too!}interfaceuses	SlyHeaders, HermHeaders, Sly_MainUnit, Sly_General;procedure MAIN (HermSetup: UserXIPtr);{$IFC UNDEFINED DEBUG_LEVEL}{$SETC DEBUG_LEVEL:= CURRENT_DEBUG_LEVEL}{$ENDC}implementationprocedure MAIN (HermSetup: UserXIPtr);	var		i, x, y: integer;		int1, damage: integer;		St1, St2: str255;		ch1: char;		Long1: longint;		Boo1: boolean;		err: OSerr;		FRefNum: integer;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}	procedure CS (newStage: integer);		begin			with HermSetup^ do				Privates^^.Stage := newStage;		end;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}	procedure FReadInnData (var InnData: InnRec; var HermSetup: UserXIPtr);		var			ByteCount: longint;			fRefNum: integer;			err: OSErr;		begin			with HermSetup^ do				begin					FOpen(concat(filesPath^, SlyDataPath, 'InnData'), fRefNum, HermSetup);					ByteCount := SizeOf(InnRec);					err := FSRead(fRefNum, ByteCount, @InnData);					parseerr(err, HermSetup);					FClose(fRefNum, HermSetup);				end;		end;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}	procedure RS (stage: integer);		begin			with HermSetup^ do				Privates^^.ReturnStage := stage;		end;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}	procedure inc (var ToInc: integer; HowMuch: integer);		begin			ToInc := ToInc + HowMuch;		end;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}	begin		with HermSetup^ do			begin				if (message = ActiveExt) then					if not privates^^.activeOn then						begin							privates^^.activeOn := true;							privates^^.stage := 1;						end;				case message of					DoInitilize: 						begin							prefs := myPrefsHand(newHandleClear(sizeOf(myPrefs)));							MoveHHi(handle(prefs));							HNoPurge(Handle(prefs));							HLock(Handle(prefs));							LogThis('-=-   Gateway to Slycrel Opened by the Immortal Mages...', 0, procs[vLogThis]);							prefs^^.myWindow := nil;							InitUserRec(procs[vInitUserRec]);							n[curNode^]^.AnsiTerm := true;							n[curNode^]^.ThisUser.TerminalType := 1;							ResetUserColors(n[curNode^]^.ThisUser, procs[vResetUserColors]);							bCr(procs[vbCr]);							ANSICode('0;34mÄÍÄ   ', procs[vANSICode]);							Outline('Gateway to Slycrel Opened by the Immortal Mages...', false, 1, procs[vOutline]);							bCr(procs[vbCr]);							ANSICode('0;34mÄÍÄ   ', procs[vANSICode]);							Outline('Written by Dave Dolinar & Jeremy Stone.', false, 5, procs[vOutline]);{Get the other code resource and hold it in memory}							for x := 1 to numsegs do								begin									prefs^^.otherCode[x] := GetResource('XHRM', 10001 + x);  {Gets Different Resources}									MoveHHi(prefs^^.otherCode[x]);									HNoPurge(prefs^^.otherCode[x]);									HLock(prefs^^.otherCode[x]);									numToString(x + 10001, st1);									numToString(ResError, st2);									WriteText(concat(' Loading resource #', st1, ' ', st2), prefs^^.myWindow, HermSetup);								end;						end;	{DoInitilize}					CreateNodeVars: 						begin							if privates = nil then  {never been called before}								begin									privates := myPrivsHand(NewHandleClear(SizeOf(myPrivs)));									MoveHHi(handle(privates));									HNoPurge(Handle(privates));									HLock(Handle(privates));									privates^^.Char := CharHand(NewHandleClear(SizeOf(CharRec)));									MoveHHi(Handle(privates^^.Char));									HNoPurge(Handle(privates^^.Char));									HLock(Handle(privates^^.Char));								end;							privates^^.activeOn := false;							privates^^.stage := 0;							privates^^.Char^^.Name := ' ';							RollChar(Privates^^.Char^^, '0', HermSetup); {0 to init everything to 0}							Seed(HermSetup);						end;	{CreateNodeVars}					DoMaintence: 						begin							if privates = nil then  {never been called before}								begin									privates := myPrivsHand(NewHandleClear(SizeOf(myPrivs)));									MoveHHi(handle(privates));									HNoPurge(Handle(privates));									HLock(Handle(privates));									privates^^.Char := CharHand(NewHandleClear(SizeOf(CharRec)));									MoveHHi(Handle(privates^^.Char));									HNoPurge(Handle(privates^^.Char));									HLock(Handle(privates^^.Char));								end;							privates^^.activeOn := false;							privates^^.stage := 0;							DoUpkeep(HermSetup);						end;	{DoMaintence}					CallLogon: 						begin							Outline('Remember to Play Slycrel!', true, rnd(0, 15, HermSetup), procs[vOutline]);						end;	{CallLogon}					CallMenu: {Command for this is //SLYUPDATE}						begin							if privates = nil then  {never been called before}								begin									privates := myPrivsHand(NewHandleClear(SizeOf(myPrivs)));									MoveHHi(handle(privates));									HNoPurge(Handle(privates));									HLock(Handle(privates));									privates^^.Char := CharHand(NewHandleClear(SizeOf(CharRec)));									MoveHHi(Handle(privates^^.Char));									HNoPurge(Handle(privates^^.Char));									HLock(Handle(privates^^.Char));								end;							privates^^.activeOn := false;							privates^^.stage := 0;							DoUpkeep(HermSetup);						end;	{CallMenu}					Idle: 						begin						end;	{Idle}					GameIdle: 						begin						end;	{GameIdle}					closeNode: 		{May want to save the character if they were playing...}						begin							if privates <> nil then								begin									if privates^^.Char <> nil then	{dispose of char handle}										begin											HUnlock(handle(privates^^.Char));											HPurge(handle(privates^^.Char));											DisposHandle(Handle(privates^^.Char));											privates^^.Char := nil;										end;									HUnlock(handle(privates));									HPurge(handle(privates));									DisposHandle(handle(privates));									privates := nil;								end;						end;	{closeNode}					closeExternal: 						begin{deallocate privates handle & handles inside of it}							if privates <> nil then								begin									if privates^^.Char <> nil then	{dispose of char handle}										begin											HUnlock(handle(privates^^.Char));											HPurge(handle(privates^^.Char));											DisposHandle(Handle(privates^^.Char));											privates^^.Char := nil;										end;									HUnlock(handle(privates));									HPurge(handle(privates));									DisposHandle(handle(privates));									privates := nil;								end;{deallocate prefs handle, handles inside of it, AND The rest of the Code Segments}							if prefs <> nil then								begin									for i := 1 to numsegs do										if prefs^^.otherCode[i] <> nil then	{dispose of other segs}											begin												HUnlock(prefs^^.otherCode[i]);												HPurge(prefs^^.otherCode[i]);												ReleaseResource(prefs^^.otherCode[i]);												int1 := ResError;												NumToString(int1, st1);											end;									if prefs^^.myWindow <> nil then										CloseWindow(prefs^^.myWindow);									prefs^^.myWindow := nil;									HUnlock(handle(prefs));									HPurge(handle(prefs));									DisposHandle(handle(prefs));									prefs := nil;								end;						end;	{closeExternal}					activeExt: 						begin							case privates^^.stage of{REMEMBER TO MAKE A CHECK FOR CHARACTER VARIABLES OUT OF RANGE!!!!!!!!!!!!!}								1: 									begin										privates^^.Char^^.Name := '';										RollChar(Privates^^.Char^^, '0', HermSetup); {0 to init everything to 0}										if not (n[curNode^]^.thisUser.TerminalType = 1) then											CS(10)										else											CS(2);									end;								2: 									begin										Boo1 := ReadTextFile('Externals:Sly_Data:ANSI:Opening ANSI', 0, true, procs[vReadTextFile]);										RS(3);										CS(ListTextFile);									end;								3: 									begin										LettersPrompt('Your Selection >', 'EVL?', 1, true, false, true, chr(32), procs[vLettersPrompt]);										CS(4);									end;								4: 									begin										case n[curNode^]^.curPrompt[1] of											'E': 												CS(EnterSlycrel);											'L': 												begin													Outline('Exiting Slycrel...', true, 3, procs[vOutline]);													CS(ShutDown3);												end;											'V': 												begin													ViewGuildLists(HermSetup);													CS(2);												end;											'?': 												CS(2);											otherwise												CS(3);										end;{Case}									end;								10: 									begin										Outline('This Game Requires ANSI emulation.', true, 3, procs[vOutline]);										YesNoQuestion('Does your Terminal Support ANSI? [Y/n] :', true, procs[vYesNoQuestion]);										CS(11);									end;								11: 									begin										if (n[curNode^]^.CurPrompt[1] = 'n') or (n[curNode^]^.CurPrompt[1] = 'N') then											begin												Outline('Exiting Slycrel...', true, 6, procs[vOutline]);												CS(ShutDown3);											end										else											begin												n[curNode^]^.thisUser.TerminalType := 1;												n[curNode^]^.thisUser.ColorTerminal := True;												CS(2);											end;									end;								EnterSlycrel:  {--Checks & Updates Player Stat's}									begin										st1 := concat('-=---  ', n[curnode^]^.ThisUser.UserName, ' Entered the realm of Slycrel.');										LogThis(st1, 0, procs[vLogThis]);										st1 := n[CurNode^]^.ThisUser.UserName;										if not FExist(concat(filespath^, UserPath, st1), procs[vFExist]) then											begin												privates^^.char^^.Name := n[curNode^]^.thisUser.UserName;												x := rnd(1, 3, HermSetup);												case x of													1: 														RollChar(Privates^^.char^^, 'F', HermSetup);													2: 														RollChar(Privates^^.char^^, 'T', HermSetup);													3: 														RollChar(Privates^^.char^^, 'M', HermSetup);													otherwise														RollChar(Privates^^.char^^, 'F', HermSetup);												end;												CS(CreateCharacter);											end										else											begin												ReadChar(n[curNode^]^.ThisUser.UserName, privates^^.char^^, HermSetup);{Checks to see if user is a valid player}												if n[curNode^]^.thisUser.CoSysOp then													begin														if (privates^^.char^^.HitPoints < 0) or (not privates^^.char^^.Alive) then															begin																Privates^^.Char^^.HitPoints := Privates^^.Char^^.MaxHP;																NewDayForUser(n[curNode^]^.ThisUser.UserName, privates^^.char^^, HermSetup);															end;													end {if cosysop}												else if (Privates^^.char^^.LastOn < TheDate) and (not Privates^^.char^^.Alive) then													begin														NewDayForUser(n[curNode^]^.ThisUser.UserName, privates^^.char^^, HermSetup);													end												else if (not Privates^^.char^^.Alive) and (not n[CurNode^]^.ThisUser.CoSysOp) then													begin														Outline('Sorry, You have been killed today.  Please play again Tomorrow...', true, 6, procs[vOutline]);														bCr(procs[vbCr]);														CS(ShutDown3);													end;{shows daily mail...}{updates our player list here}												UpDatePlayerList(HermSetup);												if FExist(concat(FilesPath^, MailPath, n[CurNode^]^.ThisUser.UserName, '--News'), procs[vFExist]) then													begin														Boo1 := ReadTextFile(concat('Externals:Sly_Data:Mail:', n[curNode^]^.thisUser.UserName, '--News'), 0, true, procs[vReadTextFile]);														err := FSDelete(concat(FilesPath^, MailPath, n[CurNode^]^.ThisUser.UserName, '--News'), vRefNum);														parseerr(err, HermSetup);														bCr(procs[vbCr]);														RS(199);														CS(ListTextFile);													end												else													CS(Town);											end;									end;								CreateCharacter: 									begin										bCr(procs[vbCr]);										bCr(procs[vbCr]);										PrintMenu(' ', 'V', ')iew Character.', '1;34m', '0;31m', true, HermSetup);										PrintMenu(' ', 'N', ')ew Name.', '1;34m', '0;31m', true, HermSetup);										PrintMenu(' ', 'F', ')avorite Color', '1;34m', '0;31m', true, HermSetup);										PrintMenu(' ', 'C', ')hange Occupation & Reroll Character.', '1;34m', '0;31m', true, HermSetup);										PrintMenu(' ', 'G', ')ender Change', '1;34m', '0;31m', true, HermSetup);										PrintMenu(' ', 'R', ')eroll Attributes.', '1;34m', '0;31m', true, HermSetup);										PrintMenu(' ', 'S', ')how Scale.', '1;34m', '0;31m', true, HermSetup);										PrintMenu(' ', 'E', ')nter Town!', '1;34m', '0;31m', true, HermSetup);										bCr(procs[vbCr]);										LettersPrompt('[V,N,F,C,R,S,E,G]', 'VNFCRSEG?', 1, true, false, true, char(0), procs[vLettersPrompt]);										bCr(procs[vbCr]);										ANSICode('36mYour Choice', procs[vANSICode]);										ANSICode('35m - ', procs[vANSICode]);										CS(31);									end;								31: 									begin										case n[CurNode^]^.CurPrompt[1] of											'N': 												CS(35);											'F': 												CS(40);											'C': 												CS(37);											'R': 												CS(39);											'V': 												begin													RS(CreateCharacter);													CS(ViewCharacter);												end;											'E': 												begin													if AddChar2List(privates^^.char^^, HermSetup) then														begin															SaveChar(n[curNode^]^.ThisUser.UserName, privates^^.char^^, HermSetup);															CS(Town);														end													else														begin															Outline('Error In Creating Character...', true, 1, procs[vOutline]);															CS(35);	{Chage to Stage Where they Choose their Name}														end;												end;											'S': 												begin													ShowScale(HermSetup);													CS(CreateCharacter);												end;											'G': 												begin													with privates^^.char^^ do														if Privates^^.char^^.Gender = true then															begin																Outline('You are Now Female.', true, 3, procs[vOutline]);																Gender := false;																Strength := Strength - 3;																MaxPsyche := MaxPsyche + 1;																Dexterity := Dexterity + 2;																MaxHp := MaxHp - 2;																HitPoints := MaxHp;																Faith := Faith + 2;															end														else															begin																Outline('You are Now Male.', true, 3, procs[vOutline]);																Privates^^.char^^.Gender := true;																Strength := Strength + 3;																MaxPsyche := MaxPsyche - 1;																Dexterity := Dexterity - 2;																MaxHp := MaxHp + 2;																HitPoints := MaxHp;																Faith := Faith - 2;															end;													RS(CreateCharacter);													CS(ViewCharacter);												end;											otherwise												CS(CreateCharacter);										end;									end;								35: 									begin										Lettersprompt('', '', 20, false, false, false, char(0), procs[vLettersPrompt]);										ANSICode('33mWhat is your new Name:', procs[vANSICode]);										ANSIPrompter(20, procs[vANSIPrompter]);										n[curNode^]^.curPrompt := privates^^.char^^.name;										Outline(n[curNode^]^.curPrompt, false, 4, procs[vOutline]);										CS(36);									end;								36: 									begin										Privates^^.char^^.Name := n[CurNode^]^.CurPrompt;										CS(CreateCharacter);									end;								37: 									begin										PrintMenu('[', 'F', ']ighter', '0;36m', '1;5;31m', true, HermSetup);										PrintMenu('[', 'T', ']hief', '0;36m', '1;31m', true, HermSetup);										PrintMenu('[', 'M', ']age', '0;36m', '1;31m', true, HermSetup);										ClrPrompt(HermSetup);										Lettersprompt('', 'FTM', 1, true, false, true, char(0), procs[vLettersPrompt]);										ANSICode('1;34mNew class', procs[vANSICode]);										ANSICode('0;35m - ', procs[vANSICode]);										CS(38);									end;								38: 									begin										if not OKPrompt('FTM', HermSetup) then											CS(30)										else											begin												Privates^^.char^^.CharClass := n[CurNode^]^.CurPrompt[1];												CS(39);											end;									end;								39: 									begin										RollChar(Privates^^.char^^, Privates^^.char^^.CharClass[1], HermSetup);										RS(CreateCharacter);										CS(ViewCharacter);									end;								40: 									begin										bCr(procs[vbCr]);										AnsiCode('1;30m 1 - Black', procs[vANSICode]);										bCr(procs[vbCr]);										AnsiCode('1;37m 2 - White', procs[vANSICode]);										bCr(procs[vbCr]);										AnsiCode('0;34m 3 - Blue', procs[vANSICode]);										bCr(procs[vbCr]);										AnsiCode('1;31m 4 - Red', procs[vANSICode]);										bCr(procs[vbCr]);										AnsiCode('1;35m 5 - Purple', procs[vANSICode]);										bCr(procs[vbCr]);										AnsiCode('1;33m 6 - Yellow', procs[vANSICode]);										bCr(procs[vbCr]);										AnsiCode('0;33m 7 - Orange', procs[vANSICode]);										bCr(procs[vbCr]);										AnsiCode('1;32m 8 - Green', procs[vANSICode]);										bCr(procs[vbCr]);										bCr(procs[vbCr]);										NumbersPrompt('# of Color : ', '12345678', 8, 1, procs[vNumbersPrompt]);										CS(41);									end;								41: 									begin										case n[curNode^]^.CurPrompt[1] of											'1': 												begin													privates^^.char^^.FavColor := Black;													CS(CreateCharacter);												end;											'2': 												begin													privates^^.char^^.FavColor := White;													CS(CreateCharacter);												end;											'3': 												begin													privates^^.char^^.FavColor := Blue;													CS(CreateCharacter);												end;											'4': 												begin													privates^^.char^^.FavColor := Red;													CS(CreateCharacter);												end;											'5': 												begin													privates^^.char^^.FavColor := Purple;													CS(CreateCharacter);												end;											'6': 												begin													privates^^.char^^.FavColor := Yellow;													CS(CreateCharacter);												end;											'7': 												begin													privates^^.char^^.FavColor := Orange;													CS(CreateCharacter);												end;											'8': 												begin													privates^^.char^^.FavColor := Green;													CS(CreateCharacter);												end;											otherwise												CS(40);										end;									end;								ViewCharacter: {--Displays Character Rec and Returns to 'Return Stage'}									begin										PrintCharStats(privates^^.char^^, HermSetup);										CS(Privates^^.ReturnStage);									end;								199: 									begin										MyPausePrompt(concat(chr(13), '--press a key--', chr(13)), HermSetup);										CS(Town);									end;{Town}								Town: 									begin										privates^^.char^^.Location := TheTown;										Boo1 := ReadTextFile('Externals:Sly_Data:ANSI:MainMenu', 0, true, procs[vReadTextFile]);										RS(201);										CS(ListTextFile);									end;{Town2}								201: 									begin										Outline('[A,B,H,I,L,T,V,W,X,@,?]', true, 1, procs[vOutline]);										bCr(procs[vbCr]);										n[curNode^]^.CurPrompt := ' ';										LettersPrompt('Your Choice? ', 'ABHILTVWX@?~', 1, true, false, true, Chr(0), procs[vLettersPrompt]);										CS(202);									end;{Town3}								202: 									begin										case n[curNode^]^.curPrompt[1] of											'A': 												begin													privates^^.char^^.Location := TheArenaMenu;													CS(Arena);												end;											'B': 												begin													privates^^.char^^.Location := TheBank;													CS(Bank);												end;											'H': 												begin													privates^^.char^^.Location := TheHerbalist;													CS(Herbalist);												end;											'I': 												begin													if CheckInn(HermSetup) then														begin															privates^^.char^^.Location := TheInn;															CS(Inn);														end													else if (n[curNode^]^.thisUser.coSysop) or (privates^^.Char^^.Name = InnKeeperName(HermSetup)) then														begin															Outline('Warning, Inn is Closed!', true, 6, procs[vOutline]);															Outline('Warning, Inn is Closed!', true, 6, procs[vOutline]);															Outline('Warning, Inn is Closed!', true, 6, procs[vOutline]);															privates^^.char^^.Location := TheInn;															CS(Inn);														end													else														begin															Outline('The Inn''s windows are boarded up, with a sign painted on them--KEEP OUT!', true, 3, procs[vOutline]);															bCr(procs[vbCr]);															Outline('(This means that it''s closed...)', true, 1, procs[vOutline]);														end;												end;											'L': 												begin													privates^^.char^^.Location := TheArmory;													CS(Armory);												end;											'T': 												begin													privates^^.char^^.Location := TheTavern;													CS(Tavern);												end;											'V': 												begin													privates^^.char^^.Location := TheTown;													CS(ViewCharacter);													RS(201);												end;											'W': 												begin													privates^^.char^^.Location := TheWildernessMenu;													CS(Wilderness);												end;											'X': 												begin													privates^^.char^^.Location := TheTown;													CS(ShutDown);												end;											'@': 												begin													privates^^.char^^.Location := TheTower;													CS(Tower);												end;											'~': 												begin													Privates^^.Char^^.CoinsHand := Privates^^.Char^^.CoinsHand + 50;													CS(201);												end;											'?'