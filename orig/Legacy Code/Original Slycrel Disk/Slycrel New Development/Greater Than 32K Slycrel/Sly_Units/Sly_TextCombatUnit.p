unit SlyTextCombatUnit;interfaceuses	SlyHeaders, HermHeaders, Sly_General;function RollInitiative (var HermSetup: UserXIPtr): boolean;function DoDamage (User: boolean; HermSetup: UserXIPtr): integer;procedure PrintMenu (Div1, Command, Div2: string; DivColor, ComColor: string; Cr: boolean; var HermSetup: UserXIPtr);procedure ParseText (var TheString: str255; HermSetup: UserXIPtr);procedure InitiativeText (GotInitiative: boolean; var HermSetup: UserXIPtr);procedure GetMainCombatText (UserHP, UserMax, MonsterHP, MonsterMax: integer; var HermSetup: UserXIPtr);procedure CalcUserMove (Move: char; var LoopVal, AdvMoves: integer; var HermSetup: UserXIPtr);function rndMonsterAttack (Run: boolean; var HermSetup: UserXIPtr): CombatType;procedure MonsterAttacks (UserMove: CombatType; AdvMoves: integer; var HermSetup: UserXIPtr);implementation{-------------------------------------------------}function RollInitiative (var HermSetup: UserXIPtr): boolean;	var		int1: integer;	begin		with HermSetup^ do			with Privates^^ do				begin					int1 := char^^.Movement - Monster.Movement;					if int1 + rnd(0, 3, HermSetup) < 0 then						RollInitiative := false					else						RollInitiative := true;				end;	end;{-------------------------------------------------}function DoDamage (User: boolean; HermSetup: UserXIPtr): integer;	var		damage: integer;	begin		with HermSetup^ do			begin				if user then					begin						with Privates^^.Char^^ do							if (ThiefLvl + MageLvl + FighterLvl) div 3 <= 4 then								begin									Damage := (rnd(round((Strength * 0.75 + Weapons[1].Strike) * 1.25), round((Strength / 0.75 + Weapons[1].Strike) * 1.35), HermSetup)) - privates^^.Monster.Defense;									if Damage < 2 then										Damage := rnd(0, 2, HermSetup);								end							else								Damage := (rnd(round((Strength / 2 + Weapons[1].Strike)), round((Strength / 2 + Weapons[1].Strike) * 1.25), HermSetup)) - privates^^.Monster.Defense					end				else {if this is the monster then}					Damage := rnd(trunc(Privates^^.Monster.Offense * 0.35), trunc(Privates^^.Monster.Offense * 1.35), HermSetup) - Privates^^.char^^.Armor[1].Defense;			end;		if Damage < 0 then			Damage := 0;		DoDamage := Damage;	end;{-------------------------------------------------}procedure PrintMenu (Div1, Command, Div2: string; DivColor, ComColor: string; Cr: boolean; var HermSetup: UserXIPtr);	begin		with HermSetup^ do			begin				ANSICode(concat(Divcolor, div1), procs[vANSICode]);				ANSICode(concat(Comcolor, Command), procs[vANSICode]);				ANSICode(concat(Divcolor, Div2), procs[vANSICode]);				if Cr then					bCr(procs[vbCr]);			end;	end;{-------------------------------------------------}procedure ParseText (var TheString: str255; HermSetup: UserXIPtr);	var		MWeapon, UWeapon, MName: str255;		where: integer;	begin		with HermSetup^ do			begin				MWeapon := Privates^^.Monster.AttackStr1;				UWeapon := Privates^^.char^^.Weapons[1].Name;				if (Privates^^.char^^.Weapons[3].Name <> 'Hands') or (Privates^^.char^^.Weapons[1].Name = Privates^^.char^^.Weapons[2].Name) then					UWeapon := concat(UWeapon, ' x2');				MName := Privates^^.Monster.Name;				if TheString = '' then					begin						bCr(procs[vbCr]);					end				else					begin						where := pos('%mweapon', TheString);						if where <> 0 then							begin								delete(TheString, where, 8);								insert(MWeapon, TheString, where);							end;						where := pos('%mname', TheString);						if where <> 0 then							begin								delete(TheString, where, 6);								insert(MName, TheString, where);							end;						where := pos('%uweapon', TheString);						if where <> 0 then							begin								delete(TheString, where, 8);								insert(UWeapon, TheString, where);							end; {if}					end;{else}			end;	end;{-------------------------------------------------}procedure InitiativeText (GotInitiative: boolean; var HermSetup: UserXIPtr);	var		damage: integer;		st1: str255;	begin		if GotInitiative then			with HermSetup^ do				begin					ANSICode('0m', procs[vANSICode]);					case rnd(0, 6, HermSetup) of						0: 							begin								ANSICode('0m     You close with the vile ', procs[vANSICode]);								ANSICode(concat('0;31m', Privates^^.Monster.Name, ', '), procs[vANSICode]);								ANSICode('0mand snarl in defiance.', procs[vANSICode]);								bCr(procs[vbCr]);								ANSICode('0mThe ', procs[vANSICode]);								ANSICode(concat('0;31m', Privates^^.Monster.Name, ' '), procs[vANSICode]);								ANSICode('0mquakes in fear as you ready your ', procs[vANSICode]);								ANSICode(concat('0;34m', Privates^^.char^^.Weapons[1].Name, ' '), procs[vANSICode]);								ANSICode('0mand square off...', procs[vANSICode]);							end;						1: 							begin								ANSICode('0m    The terrifying ', procs[vANSICode]);								ANSICode(concat('0;31m', Privates^^.Monster.Name, ' '), procs[vANSICode]);								ANSICode('0mquickly closes as you begin laughing.', procs[vANSICode]);								bCr(procs[vbCr]);								ANSICode('0mThis is going to be as easy as flirting with Corenne...', procs[vANSICode]);							end;						2: 							begin								ANSICode('0m     A strange feeling comes over you as you begin the', procs[vANSICode]);								bCr(procs[vbCr]);								ANSICode('0mmelee.  A curse of rage is thrown your way from the', procs[vANSICode]);								bCr(procs[vbCr]);								ANSICode(concat('0;31m', Privates^^.Monster.Name), procs[vANSICode]);								ANSICode('0m in a guttural tongue...', procs[vANSICode]);							end;						3: 							begin								ANSICode('0mThe ', procs[vANSICode]);								ANSICode(concat('0;31m', Privates^^.Monster.Name), procs[vANSICode]);								ANSICode('0m leaps at you , inhuman appendages flailing. ', procs[vANSICode]);								bCr(procs[vbCr]);								ANSICode('0mYou bring up your arms in defense as ', procs[vANSICode]);								ANSICode(concat('0;31m', Privates^^.Monster.Name, ' '), procs[vANSICode]);								bCr(procs[vbCr]);								ANSICode('0mcrashes into you.  The battle begins!', procs[vANSICode]);							end;						4: 							begin								ANSICode('0mYou ready your ', procs[vANSICode]);								ANSICode(concat('1;32m', Privates^^.char^^.Weapons[1].Name, ' '), procs[vANSICode]);								ANSICode('0mand prepare for the oncoming fray.', procs[vANSICode]);								bCr(procs[vbCr]);								ANSICode('0mThe surrounding terrain goes silent as you face off with the ', procs[vANSICode]);								ANSICode(concat('0;31m', Privates^^.Monster.Name), procs[vANSICode]);							end;						5: 							begin								ANSICode('0mThe ', procs[vANSICode]);								ANSICode(concat('0;31m', Privates^^.Monster.Name, ' '), procs[vANSICode]);								ANSICode('0mlooks surprised that you do not quake in fear, and', procs[vANSICode]);								bCr(procs[vbCr]);								ANSICode('0mstarts waving it''s ', procs[vANSICode]);								ANSICode(concat('0;31m', Privates^^.Monster.AttackStr1, ' '), procs[vANSICode]);								ANSICode('0mmenacingly, attempting to ward you', procs[vANSICode]);								bCr(procs[vbCr]);								ANSICode('0moff.  You gleefully close for the kill!', procs[vANSICode]);							end;						6: 							begin								ANSICode('0mAs you close with the ', procs[vANSICode]);								ANSICode(concat('0;31m', Privates^^.Monster.Name), procs[vANSICode]);								ANSICode('0m, you cannot help but', procs[vANSICode]);								bCr(procs[vbCr]);								ANSICode('0mcompare it to your sixth grade teacher, Grizelda.  As', procs[vANSICode]);								bCr(procs[vbCr]);								ANSICode('0mthe fight begins, you resolve to rid teh world of both', procs[vANSICode]);								bCr(procs[vbCr]);								ANSICode('0mhideous beings...', procs[vANSICode]);							end;					end;   {Case}				end		else			with HermSetup^ do				begin					case rnd(7, 9, HermSetup) of						7: 							begin								ANSICode('0m     You cannot flee.  The ', procs[vANSICode]);								ANSICode(concat('0;31m', Privates^^.Monster.Name, ' '), procs[vANSICode]);								ANSICode('0mslashes at your back,', procs[vANSICode]);								bCr(Procs[vbCr]);								ANSICode('0mcutting a painful gash in your left shoulder.  You turn,', procs[vANSICode]);								bCr(Procs[vbCr]);								ANSICode('0mand ready your ', procs[vANSICode]);								ANSICode(concat('0;34m', Privates^^.char^^.Weapons[1].Name, ', '), procs[vANSICode]);								ANSICode('0mconvinced that', procs[vANSICode]);								bCr(procs[vbCr]);								ANSICode('0myou are about to die...', procs[vANSICode]);								Damage := DoDamage(false, HermSetup);							end;						8: 							begin								ANSICode('0m     You bring up your ', procs[vANSICode]);								ANSICode(concat('1;32m', Privates^^.char^^.Weapons[1].Name, ', '), procs[vANSICode]);								ANSICode('0massured that you can', procs[vANSICode]);								bCr(procs[vbCr]);								ANSICode('0mdefeat the ', procs[vANSICode]);								ANSICode(concat('0;31m', Privates^^.Monster.Name, '.'), procs[vANSICode]);								ANSICode('0m  As silence descends on the surrounding', procs[vANSICode]);								bCr(procs[vbCr]);								ANSICode('0marea, you start to wonder where the ', procs[vANSICode]);								ANSICode(concat('0;31m', Privates^^.Monster.Name), procs[vANSICode]);								bCr(procs[vbCr]);								ANSICode('0mhas gone to.  The sudden slice in your back whips you around,', procs[vANSICode]);								bCr(procs[vbCr]);								ANSICode('0mthe fight already started...', procs[vANSICode]);								Damage := DoDamage(false, HermSetup);							end;						9: 							begin								ANSICode('0m You bring up your ', procs[vANSICode]);								ANSICode(concat('0;34m', Privates^^.char^^.Weapons[1].Name, ', '), procs[vANSICode]);								ANSICode('0massured that you', procs[vANSICode]);								bCr(procs[vbCr]);								ANSICode('0mcan defeat the ', procs[vANSICode]);								ANSICode(concat('0;31m', Privates^^.Monster.Name, '.'), procs[vANSICode]);								ANSICode('0m  As silence descends, you begin to', procs[vANSICode]);								bCr(procs[vbCr]);								ANSICode('0mwonder where that ', procs[vANSICode]);								ANSICode(concat('0;31m', Privates^^.Monster.Name, ' '), procs[vANSICode]);								ANSICode('0mhas gone to.  The sudden', procs[vANSICode]);								bCr(procs[vbCr]);								ANSICode('0mslice in your back flips you around, the fiend already', procs[vANSICode]);								bCr(procs[vbCr]);								ANSICode('0mpreparing for another strike...', procs[vANSICode]);								Damage := DoDamage(false, HermSetup);							end;					end;  {case}					NumToString(Damage, st1);					if damage > 0 then						begin							privates^^.char^^.HitPoints := privates^^.char^^.HitPoints - damage;							st1 := concat(chr(27), '[0;37mYou are hit For ', chr(27), '[0;31m', st1, chr(27), '[0;37m Damage.');							Outline(st1, true, 0, procs[vOutline]);							bCr(procs[vbCr]);						end;				end;	end;{-------------------------------------------------}procedure GetMainCombatText (UserHP, UserMax, MonsterHP, MonsterMax: integer; var HermSetup: UserXIPtr);	type		DispositionType = (MUGood, MGoodUBad, UGoodMBad, MUOK, MOKUBad, MOKUGood, UOKMBad, UOKMGood, MUBad);	const		strListID1 = 128;		strListID2 = 129;	var		Disp: dispositionType;		MName, Mweapon, UWeapon: str255;		int1, int2, x: integer;		st1, st2: str255;	begin		with HermSetup^ do			begin				MName := Privates^^.Monster.Name;				MWeapon := Privates^^.Monster.AttackStr1;				UWeapon := Privates^^.char^^.Weapons[1].Name;				if (Privates^^.char^^.Weapons[3].Name <> 'Hands') or (Privates^^.char^^.Weapons[1].Name = Privates^^.char^^.Weapons[2].Name) then					UWeapon := concat(UWeapon, ' x2');				int1 := round((UserMax / UserHP) * 100);				int2 := round((MonsterMax / MonsterHP) * 100);				if int1 >= 70 then					begin						if int2 >= 70 then							Disp := MUGood						else if (int2 < 70) and (int2 >= 35) then							Disp := MOKUGood						else if (int2 < 35) then							Disp := UGoodMBad;					end {if int1 >= 70}				else if (int1 <= 70) and (int1 >= 35) then					begin						if int2 >= 70 then							Disp := UOKMGood						else if (int2 < 70) and (int2 >= 35) then							Disp := MUOK						else if (int2 < 35) then							Disp := UOKMBad;					end  {else if (int1 <= 70) and (int1 >= 35) }				else if int1 <= 35 then					begin						if int2 >= 70 then							Disp := MGoodUBad						else if (int2 < 70) and (int2 >= 35) then							Disp := MOKUBad						else if (int2 < 35) then							Disp := MUBad;					end;  {else if int1 <= 35}				case Privates^^.Monster.MType of					Humanoid: 						int1 := 1;					Orc: 						int1 := 2;					Goblin: 						int1 := 3;					Fairy: 						int1 := 4;					Insectoid: 						int1 := 5;					Fantastic: 						int1 := 6;					Elven: 						int1 := 7;					FElemental: 						int1 := 8;					WElemental: 						int1 := 9;					EElemental: 						int1 := 10;					AElemental: 						int1 := 11;					Dwarven: 						int1 := 12;					Evil: 						int1 := 13;					Good: 						int1 := 14;					Flying: 						int1 := 15;					Undead: 						int1 := 16;					Psychic: 						int1 := 17;					Other: 						int1 := 18;				end;  {case}				x := (9 * int1) - 9;				GetIndString(st1, strListID1, x);				GetIndString(st2, strListID2, x);				ParseText(st1, HermSetup);				ParseText(st2, HermSetup);				bCr(procs[vbCr]);				Outline(st1, true, 7, procs[vOutline]);				Outline(st2, true, 7, procs[vOutline]);				bCr(procs[vbCr]);			end;	end; {procedure} {-------------------------------------------------}procedure CalcUserMove (Move: char; var LoopVal, AdvMoves: integer; var HermSetup: UserXIPtr);	var		CanMove: boolean;		Damage, TotDamage, x: integer;		st1: str255;	begin		with HermSetup^ do			begin				if Move = 'A' then					begin						Privates^^.Move := Attack;						Outline('You attack the sucker!', true, 1, procs[vOutline]);						bCr(procs[vbCr]);						if Privates^^.MMove = Attack then							TotDamage := DoDamage(true, HermSetup)						else if Privates^^.MMove = Block then							TotDamage := DoDamage(true, HermSetup) div 2						else if Privates^^.MMove = Parry then							TotDamage := round(DoDamage(true, HermSetup) * 0.6)						else if Privates^^.MMove = Dodge then							begin								if rnd(1, Privates^^.char^^.Dexterity, HermSetup) < Privates^^.Monster.Movement div 3 then									Damage := 0;								Outline('The monster laughs as it dodges your attack.', true, 5, procs[vOutline]);								bCr(procs[vbCr]);							end;						if TotDamage > 0 then							begin								NumtoString(TotDamage, st1);								Outline(concat('You hit the monster for ', st1, ' damage.'), true, 2, procs[vOutline]);								Privates^^.Hit := TheUser;							end						else if Damage <= 0 then							begin								bCr(procs[vbCr]);								Outline('You miss!', true, 6, procs[vOutline]);								bCr(procs[vbCr]);							end;						if AdvMoves > 0 then							begin								for x := 1 to AdvMoves do									begin										Damage := DoDamage(true, HermSetup);										TotDamage := TotDamage + Damage;										NumToString(Damage, st1);										Outline(concat('Again, You hit the vile fiend for ', st1, ' Damage!'), true, 1, procs[vOutline]);										Privates^^.Hit := TheUser;									end;								bCr(procs[vbCr]);								bCr(procs[vbCr]);								LoopVal := LoopVal - AdvMoves;							end; {else if}						Privates^^.Monster.HitPoints := Privates^^.Monster.HitPoints - TotDamage;						Privates^^.Hit := TheUser;					end				else if Move = 'B' then					begin						Privates^^.Move := Block;						Privates^^.Hit := UserMiss;						LoopVal := LoopVal - AdvMoves;					end				else if Move = 'P' then					begin						Privates^^.Move := Parry;						Privates^^.Hit := TheUser;						TotDamage := DoDamage(true, HermSetup) div 3;						NumToString(TotDamage, st1);						if TotDamage > 0 then							Outline(concat('You parry, slicing the monster for ', st1, ' damage.'), true, 1, procs[vOutline])						else							Outline('You raise your weapon, ready to parry.', true, 3, procs[vOutline]);						bCr(procs[vbCr]);						Privates^^.Monster.HitPoints := Privates^^.Monster.HitPoints - TotDamage;						LoopVal := LoopVal - AdvMoves;					end				else if Move = 'D' then					begin						Privates^^.Move := Dodge;						Privates^^.Hit := UserMiss;						LoopVal := LoopVal - AdvMoves;					end				else if Move = 'S' then					begin						Privates^^.Move := Special;						Privates^^.Hit := UserMiss;						bCr(procs[vbCr]);						Outline('Okay, you sit there and feel special.', true, 1, procs[vOutline]);						LoopVal := LoopVal - AdvMoves;					end				else if Move = 'R' then					begin						bCr(procs[vbCr]);						Outline('You attempt escape...', true, 2, procs[vOutline]);						bCr(procs[vbCr]);						Privates^^.Hit := UserRan;						Privates^^.Move := Special;					end;				bCr(procs[vbCr]);			end;	end;{-------------------------------------------------}function rndMonsterAttack (Run: boolean; var HermSetup: UserXIPtr): CombatType;	var		int1: byte;	begin		with HermSetup^ do			begin				int1 := rnd(1, 50, HermSetup);				if Privates^^.R2 div 20 > Privates^^.Monster.HitPoints then					run := true				else					run := false;				case int1 of					1..25: 						rndMonsterAttack := Attack;					26..30: 						rndMonsterAttack := Parry;					31..37: 						rndMonsterAttack := Block;					38..44: 						rndMonsterAttack := Dodge;					45..50: 						if run then							Privates^^.Hit := OpponentRan						else							rndMonsterAttack := Attack;				end;			end;	end;{-------------------------------------------------}procedure MonsterAttacks (UserMove: CombatType; AdvMoves: integer; var HermSetup: UserXIPtr);	var		Damage: integer;		St1: str255;		MnMove: CombatType;		boo1: boolean;		x: integer;		TotDamage: integer;	begin		TotDamage := 0;		Damage := 0;		with HermSetup^ do			begin				if Privates^^.R2 < Privates^^.char^^.MaxHp div 4 then					boo1 := true;				MnMove := rndMonsterAttack(boo1, HermSetup);				case MnMove of					Attack: 						begin							Privates^^.MMove := Attack;							Damage := DoDamage(false, HermSetup);							if UserMove = Parry then								Damage := round(damage * 0.6);							if UserMove = Block then								Damage := Damage div 2;							if UserMove = Special then								begin									Damage := round(Damage * 1.75);									Outline('You feel VERY special now.', true, 2, procs[vOutline]);									bCr(procs[vbCr]);								end;							if UserMove = Dodge then								begin									if rnd(1, Privates^^.Monster.Movement, HermSetup) < Privates^^.char^^.Dexterity then										Damage := 0;									Outline('You Dodge successfully!', true, 5, procs[vOutline]);									bCr(procs[vbCr]);								end;{if}							if Damage > 0 then								begin									bCr(procs[vbCr]);									Outline('The monster attacks you!', true, 3, procs[vOutline]);									bCr(procs[vbCr]);									NumToString(Damage, st1);									Outline(concat('You are hit for ', st1, ' damage.  (Feel better yet?)'), true, 1, procs[vOutline]);									bCr(procs[vbCr]);									if AdvMoves > 0 then										begin											for x := 1 to AdvMoves do												begin													Damage := DoDamage(false, HermSetup);													if UserMove = Parry then														Damage := round(damage * 0.6);													if UserMove = Block then														Damage := Damage div 2;													if UserMove = Special then														Damage := round(Damage * 1.75);													if UserMove = Dodge then														begin															if rnd(1, Privates^^.Monster.Movement, HermSetup) < Privates^^.char^^.Dexterity then																Damage := 0;															Outline('You Dodge successfully!', true, 5, procs[vOutline]);														end;{if}													TotDamage := TotDamage + Damage;													NumToString(Damage, st1);													Outline(concat('You are hit again for ', st1, ' damage!'), true, 7, procs[vOutline]);													Privates^^.Hit := Opponent;												end;											Privates^^.Hit := Opponent;											bCr(procs[vbCr]);											Privates^^.Tempint := Privates^^.Tempint - AdvMoves;										end  {if AdvMoves}									else										TotDamage := Damage;									Privates^^.char^^.HitPoints := Privates^^.char^^.HitPoints - TotDamage;									if (Privates^^.Hit = TheUser) then										Privates^^.Hit := Both;									if (Privates^^.Hit = UserMiss) or (Privates^^.Hit = _None) then										Privates^^.Hit := OpponentOnly;								end							else								Outline('The monster misses you!', true, 7, procs[vOutline]);							if (TotDamage <= 0) and (Privates^^.Hit = TheUser) then								Privates^^.Hit := UserOnly							else if (TotDamage <= 0) and ((Privates^^.Hit = UserMiss) or (Privates^^.Hit = _None)) then								Privates^^.Hit := neither;						end;{attack}					Block: 						begin							Outline('The monster keeps it''s distance, circling warily.', true, 1, procs[vOutline]);							bCr(procs[vbCr]);							Privates^^.MMove := Block;							if Privates^^.Hit = TheUser then								Privates^^.Hit := UserOnly							else								Privates^^.Hit := neither;						end;					Parry: 						begin							bCr(procs[vbCr]);							Outline('The monster darts in and out, you aren''t quite sure if it''s attacking or not.', true, 2, procs[vOutline]);							bCr(procs[vbCr]);							Privates^^.MMove := Parry;							if Privates^^.Hit = TheUser then								Privates^^.Hit := UserOnly							else								Privates^^.Hit := OpponentOnly;						end;					Dodge: 						begin							bCr(procs[vbCr]);							Outline('The monster backs away, hissing at you, looking like a coiled spring, ready to  snap...', true, 3, procs[vOutline]);							bCr(procs[vbCr]);							Privates^^.MMove := Dodge;							if Privates^^.Hit = TheUser then								Privates^^.Hit := UserOnly							else								Privates^^.Hit := neither;						end;				end;{case}			end; {with}	end;{-------------------------------------------------}end.