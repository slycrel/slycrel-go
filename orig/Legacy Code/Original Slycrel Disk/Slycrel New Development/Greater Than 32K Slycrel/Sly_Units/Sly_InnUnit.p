unit InnUnit;interfaceuses	SlyHeaders, HermHeaders, Sly_General;procedure FReadInnData (var InnData: InnRec; var HermSetup: UserXIPtr);procedure FWriteInnData (InnData: InnRec; var HermSetup: UserXIPtr);function AddToRooms (PlayerName: str255; Days, TheLock: byte; HermSetup: UserXIPtr): boolean;function EmptyRoom (CharName: str255; var Rented: Boolean; HermSetup: UserXIPtr): byte;procedure DisplayInnKeeperMenu (HermSetup: UserXIPtr);procedure ChangeRate (NewRate: integer; HermSetup: UserXIPtr);procedure ListRooms (HermSetup: UserXIPtr);procedure RemovePlayerFromInn (long1: byte; HermSetup: UserXIPtr);procedure ViewInnStats (HermSetup: UserXIPtr);procedure CloseInn (Closed: boolean; HermSetup: UserXIPtr);function RoomCostPerDay (HermSetup: UserXIPtr): integer;procedure NewInnOwner (NewOwner: str255; HermSetup: UserXIPtr);implementation{-------------------------------------------------}procedure FReadInnData (var InnData: InnRec; var HermSetup: UserXIPtr);	var		ByteCount: longint;		fRefNum: integer;		err: OSErr;	begin		with HermSetup^ do			begin				FOpen(concat(filesPath^, SlyDataPath, 'InnData'), fRefNum, HermSetup);				ByteCount := SizeOf(InnRec);				err := FSRead(fRefNum, ByteCount, @InnData);				parseerr(err, HermSetup);				FClose(fRefNum, HermSetup);			end;	end;{-------------------------------------------------}procedure FWriteInnData (InnData: InnRec; var HermSetup: UserXIPtr);	var		ByteCount: longint;		fRefNum: integer;		err: OSErr;	begin		with HermSetup^ do			begin				FOpen(concat(filesPath^, SlyDataPath, 'InnData'), fRefNum, HermSetup);				ByteCount := SizeOf(InnRec);				err := FSWrite(fRefNum, ByteCount, @InnData);				parseerr(err, HermSetup);				FClose(fRefNum, HermSetup);			end;	end;{-------------------------------------------------}function AddToRooms (PlayerName: str255; Days, TheLock: byte; HermSetup: UserXIPtr): boolean;	var		x: integer;		InnData: InnRec;		found: boolean;	begin		found := false;		FReadInnData(InnData, HermSetup);		x := 0;		while (x < 10) and (not found) do			begin				x := x + 1;				if InnData.Rooms[x].Who = 'Empty' then					found := true;			end;		if found then			with InnData.Rooms[x] do				begin					Who := PlayerName;					DaysLeft := Days;					Lock := TheLock;				end;		AddToRooms := found;		FWriteInnData(InnData, HermSetup);	end;{-------------------------------------------------}function EmptyRoom (CharName: str255; var Rented: Boolean; HermSetup: UserXIPtr): byte;	var		x: integer;		InnData: InnRec;		HasRoom, found: boolean;	begin		found := false;		HasRoom := false;		FReadInnData(InnData, HermSetup);		for x := 1 to 10 do			begin				if InnData.Rooms[x].Who = 'Empty' then					found := true;				if InnData.Rooms[x].Who = CharName then					HasRoom := true;			end;		if HasRoom then			EmptyRoom := 3		else if not Found then			EmptyRoom := 2		else			EmptyRoom := 0;	end;{-------------------------------------------------}procedure DisplayInnKeeperMenu (HermSetup: UserXIPtr);	begin		with HermSetup^ do			begin				Outline(' 1]- Set Daily Room Charge.', true, 5, procs[vOutline]);				Outline(' 2]- View Players In Room.', true, 5, procs[vOutline]);				Outline(' 3]- Kick Player Out of Room.', true, 5, procs[vOutline]);				Outline(' 4]- List Inn Stats', true, 5, procs[vOutline]);				Outline(' 5]- Close Inn', true, 5, procs[vOutline]);				Outline(' 6]- Give Inn to somebody else.', true, 5, procs[vOutline]);				Outline(' Q]- Quit', true, 5, procs[vOutline]);			end;	end;{-------------------------------------------------}procedure ChangeRate (NewRate: integer; HermSetup: UserXIPtr);	var		fRefNum: integer;		ByteCount: longint;		InnData: InnRec;	begin		with HermSetup^ do			begin				FReadInnData(InnData, HermSetup);				InnData.CurRate := NewRate;				FWriteInnData(InnData, HermSetup);			end;	end;{-------------------------------------------------}procedure ListRooms (HermSetup: UserXIPtr);	var		InnData: InnRec;		x: integer;		st1: string;	begin		with HermSetup^ do			begin				FReadInnData(InnData, HermSetup);				Outline('[-------------------]', true, 2, procs[vOutline]);				for x := 1 to 10 do					Outline(concat(st1, ')  ', InnData.Rooms[x].Who), true, 1, procs[vOutline]);				Outline('[-------------------]', true, 7, procs[vOutline]);				bCr(procs[vbCr]);				bCr(procs[vbCr]);			end;	end;{-------------------------------------------------}procedure RemovePlayerFromInn (long1: byte; HermSetup: UserXIPtr);	var		InnData: InnRec;	begin		with HermSetup^ do			begin				FReadInnData(InnData, HermSetup);				InnData.Rooms[long1].Who := 'Empty';				InnData.Rooms[long1].DaysLeft := 0;				InnData.Rooms[long1].Lock := 255;				FWriteInnData(InnData, HermSetup);			end;	end;{-------------------------------------------------}procedure ViewInnStats (HermSetup: UserXIPtr);	var		InnData: InnRec;		st1: str255;		x: integer;	begin		with HermSetup^ do			begin				FReadInnData(InnData, HermSetup);				Outline('[-------------------]', true, 2, procs[vOutline]);				for x := 1 to 10 do					Outline(concat(st1, ')  ', InnData.Rooms[x].Who), true, 1, procs[vOutline]);				Outline('[-------------------]', true, 2, procs[vOutline]);				bCr(procs[vbCr]);				NumToString(InnData.CurRate, st1);				Outline(concat('Current Rate:  ', st1), true, 1, procs[vOutline]);				NumToString(InnData.Safe, st1);				Outline(concat('Safe $$:  ', st1), true, 1, procs[vOutline]);				Outline(concat(InnData.Owner, ' currently owns this inn.'), true, 1, procs[vOutline]);				if InnData.Open then					Outline('The Inn is open to the public.', true, 1, procs[vOutline])				else					Outline('The Inn is closed to the public.', true, 1, procs[vOutline]);				bCr(procs[vbCr]);				bCr(procs[vbCr]);			end;	end;{-------------------------------------------------}procedure CloseInn (Closed: boolean; HermSetup: UserXIPtr);	var		InnData: InnRec;	begin		FReadInnData(InnData, HermSetup);		InnData.Open := Closed;		FWriteInnData(InnData, HermSetup);	end;{-------------------------------------------------}function RoomCostPerDay (HermSetup: UserXIPtr): integer;	var		InnData: InnRec;	begin		FReadInnData(InnData, HermSetup);		RoomCostPerDay := InnData.curRate;	end;{-------------------------------------------------}procedure NewInnOwner (NewOwner: str255; HermSetup: UserXIPtr);	var		InnData: InnRec;	begin		FReadInnData(InnData, HermSetup);		InnData.Owner := UCase(NewOwner);		FWriteInnData(InnData, HermSetup);	end;{-------------------------------------------------}end.