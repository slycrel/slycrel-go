unit Sly_Weapons;interfaceuses	SlyHeaders, HermHeaders, Sly_General;procedure DisplayWeaponList (FRefNum, Coins: integer; var HermSetup: UserXIPtr);procedure DisplayRangedWeaponList (FRefNum, Coins: integer; var HermSetup: UserXIPtr);procedure DisplayArmorList (FRefNum, Coins: integer; var HermSetup: UserXIPtr);procedure GetWeapon (WeaponNum: integer; var TheWeapon: WeaponRec; HermSetup: UserXIPtr);procedure GetRangedWeapon (WeaponNum: integer; var TheWeapon: WeaponRec; HermSetup: UserXIPtr);procedure GetArmor (ArmorNum: integer; var TheArmor: ArmorRec; HermSetup: UserXIPtr);procedure DisplayWeapon (TheWeapon: WeaponRec; Number: integer; var HermSetup: UserXIPtr);procedure DisplayRangedWeapon (TheWeapon: WeaponRec; Number: integer; var HermSetup: UserXIPtr);procedure DisplayArmor (TheArmor: ArmorRec; Number: integer; var HermSetup: UserXIPtr);procedure SaveWeapon (TheWeapon: WeaponRec; WNum: integer; HermSetup: UserXIPtr);procedure SaveRangedWeapon (TheWeapon: WeaponRec; WNum: integer; HermSetup: UserXIPtr);procedure SaveArmor (TheArmor: ArmorRec; ANum: integer; HermSetup: UserXIPtr);implementation{-------------------------------------------------}procedure DisplayWeaponList (FRefNum, Coins: integer; var HermSetup: UserXIPtr);	var		err: OSErr;		st1: str255;		byteCount, long1: longint;		int1: integer;		AWeapon: WeaponRec;	begin		with HermSetup^ do			begin				byteCount := SizeOf(WeaponRec);				err := FSRead(fRefNum, ByteCount, @AWeapon);				parseerr(err, HermSetup);				err := GetFPos(fRefNum, long1);				parseerr(err, HermSetup);				long1 := long1 div SizeOf(WeaponRec);				NumToString(long1, st1);				Outline(spaceout(st1, 4), True, 1, procs[vOutline]);				Outline(spaceOut(concat(' - ', AWeapon.Name), 22), false, 3, procs[vOutline]);				NumToString(AWeapon.Strike, st1);				Outline(spaceOut(st1, 8), false, 0, procs[vOutline]);				if AWeapon.Cost > Coins then					int1 := 5				else					int1 := 3;				NumToString(AWeapon.Cost, st1);				Outline(concat('$ ', st1), false, int1, procs[vOutline]);			end;	end;{-------------------------------------------------}procedure DisplayRangedWeaponList (FRefNum, Coins: integer; var HermSetup: UserXIPtr);	var		err: OSErr;		st1: str255;		byteCount, long1: longint;		int1: integer;		AWeapon: WeaponRec;	begin		with HermSetup^ do			begin				byteCount := SizeOf(WeaponRec);				err := FSRead(fRefNum, ByteCount, @AWeapon);				parseerr(err, HermSetup);				err := GetFPos(fRefNum, long1);				parseerr(err, HermSetup);				long1 := long1 div SizeOf(WeaponRec);				NumToString(long1, st1);				Outline(spaceout(st1, 4), True, 1, procs[vOutline]);				Outline(spaceOut(concat(' - ', AWeapon.Name), 22), false, 3, procs[vOutline]);				NumToString(AWeapon.Range, st1);				Outline(spaceOut(st1, 8), false, 1, procs[vOutline]);				NumToString(AWeapon.Strike, st1);				Outline(spaceOut(st1, 8), false, 0, procs[vOutline]);				if AWeapon.Cost > Coins then					int1 := 5				else					int1 := 3;				NumToString(AWeapon.Cost, st1);				Outline(concat('$ ', st1), false, int1, procs[vOutline]);			end;	end;{-------------------------------------------------}procedure DisplayArmorList (FRefNum, Coins: integer; var HermSetup: UserXIPtr);	var		err: OSErr;		st1: str255;		byteCount, long1: longint;		int1: integer;		AArmor: ArmorRec;	begin		with HermSetup^ do			begin				byteCount := SizeOf(ArmorRec);				err := FSRead(fRefNum, ByteCount, @AArmor);				parseerr(err, HermSetup);				err := GetFPos(fRefNum, long1);				parseerr(err, HermSetup);				long1 := long1 div SizeOf(ArmorRec);				NumToString(long1, st1);				Outline(spaceout(st1, 4), True, 1, procs[vOutline]);				Outline(spaceOut(concat(' - ', AArmor.Name), 22), false, 3, procs[vOutline]);				NumToString(AArmor.Defense, st1);				Outline(spaceOut(st1, 8), false, 0, procs[vOutline]);				if AArmor.Cost > Coins then					int1 := 5				else					int1 := 3;				NumToString(AArmor.Cost, st1);				Outline(concat('$ ', st1), false, int1, procs[vOutline]);			end;	end;{-------------------------------------------------}procedure GetWeapon (WeaponNum: integer; var TheWeapon: WeaponRec; HermSetup: UserXIPtr);	var		ByteCount: longint;		err: OSErr;		x, fRefNum: integer;	begin		with HermSetup^ do			begin				parseerr(FSOpen(concat(filesPath^, SlyDataPath, 'Weapons'), vRefNum, fRefNum), HermSetup);				ByteCount := SizeOf(WeaponRec);				SetFilePos(fRefNum, ByteCount * (WeaponNum - 1), HermSetup);				ParseErr(FSRead(fRefNum, ByteCount, @TheWeapon), HermSetup);				FClose(FRefNum, HermSetup);			end;	end;{-------------------------------------------------}procedure GetRangedWeapon (WeaponNum: integer; var TheWeapon: WeaponRec; HermSetup: UserXIPtr);	var		ByteCount: longint;		err: OSErr;		x, fRefNum: integer;	begin		with HermSetup^ do			begin				parseerr(FSOpen(concat(filesPath^, SlyDataPath, 'RangedWeapons'), vRefNum, fRefNum), HermSetup);				ByteCount := SizeOf(WeaponRec);				SetFilePos(fRefNum, ByteCount * (WeaponNum - 1), HermSetup);				ParseErr(FSRead(fRefNum, ByteCount, @TheWeapon), HermSetup);				FClose(FRefNum, HermSetup);			end;	end;{-------------------------------------------------}procedure GetArmor (ArmorNum: integer; var TheArmor: ArmorRec; HermSetup: UserXIPtr);	var		ByteCount: longint;		err: OSErr;		x, fRefNum: integer;	begin		with HermSetup^ do			begin				parseerr(FSOpen(concat(filesPath^, SlyDataPath, 'Armor'), vRefNum, fRefNum), HermSetup);				ByteCount := SizeOf(ArmorRec);				SetFilePos(fRefNum, ByteCount * (ArmorNum - 1), HermSetup);				ParseErr(FSRead(fRefNum, ByteCount, @TheArmor), HermSetup);				FClose(FRefNum, HermSetup);			end;	end;{-------------------------------------------------}procedure DisplayWeapon (TheWeapon: WeaponRec; Number: integer; var HermSetup: UserXIPtr);	var		err: OSErr;		st1: str255;		byteCount: longint;	begin		with HermSetup^ do			begin				NumToString(Number, st1);				Outline(concat('---==', st1, '==---'), true, 1, procs[vOutline]);				Outline('0] Quit editing this weapon', true, 1, procs[vOutline]);				Outline(concat('1] Name- ', TheWeapon.Name), true, 1, procs[vOutline]);				NumToString(TheWeapon.Strike, st1);				Outline(concat('2] Strike- ', st1), true, 1, procs[vOutline]);				NumToString(TheWeapon.Range, st1);				Outline(concat('3] Range- ', st1), true, 1, procs[vOutline]);				NumToString(TheWeapon.Cost, st1);				Outline(concat('4] Cost- ', st1), true, 1, procs[vOutline]);				NumToString(TheWeapon.Ability, st1);				Outline(concat('5] Ability- ', st1), true, 1, procs[vOutline]);				NumToString(TheWeapon.Quality, st1);				Outline(concat('6] Quality- ', st1), true, 1, procs[vOutline]);				bCr(procs[vbCr]);				bCr(procs[vbCr]);			end;	end;{-------------------------------------------------}procedure DisplayRangedWeapon (TheWeapon: WeaponRec; Number: integer; var HermSetup: UserXIPtr);	var		err: OSErr;		st1: str255;		byteCount: longint;	begin		with HermSetup^ do			begin				NumToString(Number, st1);				Outline(concat('---==', st1, '==---'), true, 1, procs[vOutline]);				Outline('0] Quit editing this weapon', true, 1, procs[vOutline]);				Outline(concat('1] Name- ', TheWeapon.Name), true, 1, procs[vOutline]);				NumToString(TheWeapon.Strike, st1);				Outline(concat('2] Strike- ', st1), true, 1, procs[vOutline]);				NumToString(TheWeapon.Range, st1);				Outline(concat('3] Range- ', st1), true, 1, procs[vOutline]);				NumToString(TheWeapon.Cost, st1);				Outline(concat('4] Cost- ', st1), true, 1, procs[vOutline]);				NumToString(TheWeapon.Ability, st1);				Outline(concat('5] Ability- ', st1), true, 1, procs[vOutline]);				NumToString(TheWeapon.Quality, st1);				Outline(concat('6] Quality- ', st1), true, 1, procs[vOutline]);				bCr(procs[vbCr]);				bCr(procs[vbCr]);			end;	end;{-------------------------------------------------}procedure DisplayArmor (TheArmor: ArmorRec; Number: integer; var HermSetup: UserXIPtr);	var		err: OSErr;		st1: str255;		byteCount: longint;		int1: integer;	begin		with HermSetup^ do			begin				NumToString(Number, st1);				Outline(concat('---==', st1, '==---'), true, 1, procs[vOutline]);				Outline('0] Quit editing this Armor', true, 1, procs[vOutline]);				Outline(concat('1] Name- ', TheArmor.Name), true, 1, procs[vOutline]);				NumToString(TheArmor.Defense, st1);				Outline(concat('2] Defense- ', st1), true, 1, procs[vOutline]);				NumToString(TheArmor.Class, st1);				Outline(concat('3] Class- ', st1), true, 1, procs[vOutline]);				NumToString(TheArmor.Cost, st1);				Outline(concat('4] Cost- ', st1), true, 1, procs[vOutline]);				NumToString(TheArmor.Ability, st1);				Outline(concat('5] Ability- ', st1), true, 1, procs[vOutline]);				NumToString(TheArmor.Quality, st1);				Outline(concat('6] Quality- ', st1), true, 1, procs[vOutline]);				bCr(procs[vbCr]);				bCr(procs[vbCr]);			end;	end;{-------------------------------------------------}procedure SaveWeapon (TheWeapon: WeaponRec; WNum: integer; HermSetup: UserXIPtr);	var		ByteCount: longint;		err: OSErr;		fRefNum: integer;	begin		with Hermsetup^ do			begin				parseerr(FSOpen(concat(filesPath^, SlyDataPath, 'Weapons'), vRefNum, FRefNum), HermSetup);				ByteCount := SizeOf(WeaponRec) * (WNum - 1);				SetFilePos(fRefNum, ByteCount, HermSetup);				ByteCount := SizeOf(WeaponRec);				err := FSWrite(fRefnum, ByteCount, @TheWeapon);				parseerr(err, HermSetup);				bCr(procs[vbCr]);				FClose(fRefNum, HermSetup);			end;	end;{-------------------------------------------------}procedure SaveRangedWeapon (TheWeapon: WeaponRec; WNum: integer; HermSetup: UserXIPtr);	var		ByteCount: longint;		err: OSErr;		fRefNum: integer;	begin		with Hermsetup^ do			begin				parseerr(FSOpen(concat(filesPath^, SlyDataPath, 'RangedWeapons'), vRefNum, FRefNum), HermSetup);				ByteCount := SizeOf(WeaponRec) * (WNum - 1);				SetFilePos(fRefNum, ByteCount, HermSetup);				ByteCount := SizeOf(WeaponRec);				err := FSWrite(fRefnum, ByteCount, @TheWeapon);				parseerr(err, HermSetup);				bCr(procs[vbCr]);				FClose(fRefNum, HermSetup);			end;	end;{-------------------------------------------------}procedure SaveArmor (TheArmor: ArmorRec; ANum: integer; HermSetup: UserXIPtr);	var		ByteCount: longint;		err: OSErr;		fRefNum: integer;	begin		with Hermsetup^ do			begin				parseerr(FSOpen(concat(filesPath^, SlyDataPath, 'Armor'), vRefNum, FRefNum), HermSetup);				ByteCount := SizeOf(ArmorRec) * (ANum - 1);				SetFilePos(fRefNum, ByteCount, HermSetup);				ByteCount := SizeOf(ArmorRec);				err := FSWrite(fRefnum, ByteCount, @TheArmor);				parseerr(err, HermSetup);				bCr(procs[vbCr]);				FClose(fRefNum, HermSetup);			end;	end;{-------------------------------------------------}end.