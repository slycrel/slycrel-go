unit Sly_TavernUnit;interfaceuses	SlyHeaders, HermHeaders, Sly_General;{-Misc.-}procedure OrderDrink (Long1: integer; HermSetup: UserXIPtr);procedure FlirtEffects (FlirtNum: integer; HermSetup: UserXIPtr);implementation			{-***********-Utils-***********-}{-------------------------------------------------}procedure OrderDrink (Long1: integer; HermSetup: UserXIPtr);	var		int1: integer;	begin		with Hermsetup^ do			begin				int1 := rnd(0, 7, HermSetup);				case long1 of					1: 						begin							Outline('Lynx gives you a hard look and shifts his eyes slightly.', true, int1, procs[vOutline]);							Outline('"Here.  But don''t let anyone know I still have this stuff...', true, int1, procs[vOutline]);							Privates^^.char^^.Flirt1 := Privates^^.char^^.Flirt1 - 1;							if Privates^^.char^^.Flirt1 < 1 then								Privates^^.char^^.Flirt1 := 1;						end;					2: 						begin							if not (Privates^^.char^^.CoinsHand < 1) then								begin									Privates^^.char^^.CoinsHand := Privates^^.char^^.CoinsHand - 1;									Outline('The bartender supresses a smile as he hands you the drink.', true, int1, procs[vOutline]);					{GetRandomEffect(light);}								end;						end;					3: 						begin							if not (Privates^^.char^^.CoinsHand < 2) then								begin									Privates^^.char^^.CoinsHand := Privates^^.char^^.CoinsHand - 2;									Outline('Lynx hands you an ale.  When you don''t tip him, he gets an', true, int1, procs[vOutline]);									Outline('angry look on his face, and stalks off.', true, 1, procs[vOutline])					{Make sure you get people drunk here.  =) }								end;						end;					4: 						begin							if not (Privates^^.char^^.CoinsHand < 2) then								begin									Privates^^.char^^.CoinsHand := Privates^^.char^^.CoinsHand - 2;									Outline('Lynx hands you the drink.  You think he winks as you turn,', true, int1, procs[vOutline]);									Outline('but you can''t be certain.', true, 7, procs[vOutline]);					{Love potion?}								end;						end;					5: 						begin							if not (Privates^^.char^^.CoinsHand < 3) then								begin									Privates^^.char^^.CoinsHand := Privates^^.char^^.CoinsHand - 3;									Outline('Lynx stirs the cocktail slightly and hands it to you.', true, int1, procs[vOutline]);									bCr(procs[vbCr]);									bCr(procs[vbCr]);									Outline('EWW!!!  He licked the spoon and stuck it in that guy''s drink!', true, int1, procs[vOutline])					{ GetRandomEffect(light)}								end;						end;					6: 						begin							if not (Privates^^.char^^.CoinsHand < 3) then								begin									Privates^^.char^^.CoinsHand := Privates^^.char^^.CoinsHand - 3;									Outline('Mmmm!  Delicious.  (You hope no faeries were still in it...)', true, int1, procs[vOutline]);					{GetRandomEffect(medium);}								end;						end;					7: 						begin							if not (Privates^^.char^^.CoinsHand < 4) then								begin									Privates^^.char^^.CoinsHand := Privates^^.char^^.CoinsHand - 4;									Outline('The Bartender hands you the wine, and tells you:', true, int1, procs[vOutline]);									Outline('"That woman over in the corner...  I think she likes you!"', true, rnd(0, 7, HermSetup), procs[vOutline]);					{GetRandomEffect(medium);}								end;						end;					8: 						begin							if not (Privates^^.char^^.CoinsHand < 4) then								begin									Privates^^.char^^.CoinsHand := Privates^^.char^^.CoinsHand - 4;									Outline('Lynx pours whiskey into a small glass.  He licks the rim of', true, int1, procs[vOutline]);									Outline('the bottle as he walks off.', true, int1, procs[vOutline]);					{GetRandomEffect(Medium)}								end;						end;					9: 						begin							if not (Privates^^.char^^.CoinsHand < 5) then								begin									Privates^^.char^^.CoinsHand := Privates^^.char^^.CoinsHand - 5;									Outline('The bartender tells you this stuff''s expensive, and how hard it''s', true, int1, procs[vOutline]);									Outline('going to be to replace.', true, int1, procs[vOutline]);									bCr(procs[vbCr]);									bCr(procs[vbCr]);									Outline('You just shrug, and gleefully chug down your drink.', true, rnd(0, 7, HermSetup), procs[vOutline]);					{GetRandomEffect(medium)}								end;						end;					10: 						begin							if not (Privates^^.char^^.CoinsHand < 5) then								begin									Privates^^.char^^.CoinsHand := Privates^^.char^^.CoinsHand - 5;									Outline('You shudder as the life essence of the poor, innocent,', true, int1, procs[vOutline]);									Outline('unsuspecting little dwarf rolls down you throat.', true, int1, procs[vOutline]);					{GetMagicEffect(medium);}								end;						end;					11: 						begin							if not (Privates^^.char^^.CoinsHand < 6) then								begin									Privates^^.char^^.CoinsHand := Privates^^.char^^.CoinsHand - 6;									Outline('The bartender steps into the back for a moment.  When he', true, int1, procs[vOutline]);									Outline('returns, he is carrying a slightly thicker mug with a lid.', true, int1, procs[vOutline]);									Outline('"I ain''t responsible ", he tells you as he hands it over. ', true, int1, procs[vOutline]);									bCr(procs[vbCr]);									bCr(procs[vbCr]);									Outline('The drink oozes down your throat, nearly suffocating you', true, rnd(0, 7, HermSetup), procs[vOutline]);					{GetRandomEffect(Heavy);}								end;						end;					12: 						begin							if not (Privates^^.char^^.CoinsHand < 7) then								begin									Privates^^.char^^.CoinsHand := Privates^^.char^^.CoinsHand - 7;									Outline('The barkeep reaches under the counter, and pulls out a large, black', true, int1, procs[vOutline]);									Outline('jug.  He pours you a tiny glass.', true, int1, procs[vOutline]);									bCr(procs[vbCr]);									bCr(procs[vbCr]);									Outline('The drink burns as it goes down.', true, rnd(0, 7, HermSetup), procs[vOutline]);					{GetRandomEffect(Heavy);}								end;						end;					13: 						begin							if not (Privates^^.char^^.CoinsHand < 9) then								begin									Privates^^.char^^.CoinsHand := Privates^^.char^^.CoinsHand - 9;									Outline('The bartender hands you a steaming glass of amber liquid.', true, int1, procs[vOutline]);									bCr(procs[vbCr]);									bCr(procs[vbCr]);									Outline('The drink runs smoothly down your throat.', true, int1, procs[vOutline]);									Outline('You suddenly feel the need to use the restroom.', true, rnd(0, 7, HermSetup), procs[vOutline]);					{GetRandomEffect(Heavy);}								end;						end;					14: 						begin							if not (Privates^^.char^^.CoinsHand < 10) then								begin									Privates^^.char^^.CoinsHand := Privates^^.char^^.CoinsHand - 10;									Outline('The bartender laughs, and says, "You HONESTLY thought that', true, int1, procs[vOutline]);									Outline('I''d even let Josepi IN here??"  He throws back his head and laughs.', true, int1, procs[vOutline]);									bCr(procs[vbCr]);									bCr(procs[vbCr]);									Outline('well, you DID ask...  (And pay, too!)', true, rnd(0, 7, HermSetup), procs[vOutline]);					{GetRandomEffect(heavy)}								end;						end;					15: 						begin							if not (Privates^^.char^^.CoinsHand < 10) then								begin									Privates^^.char^^.CoinsHand := Privates^^.char^^.CoinsHand - 10;									Outline('Lynx shrugs as if to say "hey, it''s not my life" and', true, int1, procs[vOutline]);									Outline('hands it to you.', true, int1, procs[vOutline]);									bCr(procs[vbCr]);									bCr(procs[vbCr]);									Outline('You suddenly feel as if the world turns upside down.', true, rnd(0, 7, HermSetup), procs[vOutline]);									Outline('You sway and pass out...', true, rnd(0, 7, HermSetup), procs[vOutline]);									bCr(procs[vbCr]);									Outline('You''d better check your stats bud!!!', true, rnd(0, 7, HermSetup), procs[vOutline]);					{GetMagicEffect(Heavy)}								end;						end;					16: 						begin							Privates^^.ReturnStage := ShutDown;							Outline('You just can''t follow directions, can you?  I said 1 to 15, NOT 16...', true, 6, procs[vOutline]);							Outline('But that''s okay.  I won''t mind killing you.', true, 2, procs[vOutline]);							bCr(procs[vbCr]);							bCr(procs[vbCr]);							Outline(' 					<ZZZZZZZZZZZZZZZT!!!>', true, 4, procs[vOutline]);							Privates^^.char^^.Alive := false;						end;				end;			end;	end;{-------------------------------------------------}procedure FlirtEffects (FlirtNum: integer; HermSetup: UserXIPtr);	begin		with Hermsetup^ do			begin				if (rnd(1, 100, hermsetup) < (18 + privates^^.char^^.flirt1)) then					begin						Outline('Corenne smiles at you as she serves you...', true, 5, procs[vOutline]);						bCr(procs[vbCr]);						Outline('Success!', true, 5, procs[vOutline]);						privates^^.char^^.Flirt1 := privates^^.char^^.Flirt1 + 1;					end				else					begin						case FlirtNum of							1: 								begin									Outline('Corenne doesn''t seem to see you, but Grego perks right up', true, 2, procs[vOutline]);									Outline('and runs over, eagerly awaiting your order...', true, 2, procs[vOutline]);								end;							2: 								begin									Outline('You take her hand as she turns away, but just as you lift it to your', true, 2, procs[vOutline]);									Outline('lips, she jerks free, quickly walking to a much better looking customer.', true, 2, procs[vOutline]);								end;							3: 								begin									Outline('You bravely announce that Corenne has the best looking elbows that', true, 2, procs[vOutline]);									Outline('you have ever seen.  She goes red all over and you congratulate', true, 2, procs[vOutline]);									Outline('yourself.  You do wonder, however, why Lynx and the other bar', true, 2, procs[vOutline]);									Outline('patrons are laughing at you...', true, 2, procs[vOutline]);									Privates^^.char^^.Honor := Privates^^.char^^.Honor - 1;								end;							4: 								begin									Outline('You stand, gathering everyones attention with a manly <ahem>.', true, 2, procs[vOutline]);									Outline('Someone in the back snickers as the bar goes silent.  You start', true, 2, procs[vOutline]);									Outline('rambling off miscellaneous heroic deeds that you have done.  After', true, 2, procs[vOutline]);									Outline('less than a minute, you feel slightly sick.  You wonder at fate,', true, 2, procs[vOutline]);									Outline('and all it''s quirks as you spill your lunch on the floor...', true, 2, procs[vOutline]);									Privates^^.char^^.Honor := Privates^^.char^^.Honor - 1;								end;							5: 								begin									Outline('You very obviously wink seductively at Corenne several times.', true, 2, procs[vOutline]);									Outline('She hurries over to you and asks if your eye is okay.  You', true, 2, procs[vOutline]);									Outline('nearly choke as you mumble you''re fine...', true, 2, procs[vOutline]);								end;							6: 								begin									Outline('You compliment Corenne''s attributes and how bouncy they are.', true, 2, procs[vOutline]);									Outline('You suddenly find yourself staring at the ceiling with a', true, 2, procs[vOutline]);									Outline('split lip.', true, 2, procs[vOutline]);									Privates^^.char^^.HitPoints := Privates^^.char^^.HitPoints - rnd(1, privates^^.char^^.HitPoints div 4, HermSetup);								end;							7: 								begin									Outline('As Corenne walks by, you ask her to dance.  She stares at you', true, 2, procs[vOutline]);									Outline('for a moment, and reminds you that there is no music playing.', true, 2, procs[vOutline]);									Outline('Grego quickly snakes in, and informs you he will dance.', true, 2, procs[vOutline]);									bCr(procs[vbCr]);									Outline('You shudder at the thought...', true, 3, procs[vOutline]);								end;							8: 								begin									Outline('You ask Corenne if she would like to sit a while and share a meal.', true, 2, procs[vOutline]);									Outline('She replies that she is on a diet, and that she needs to keep', true, 2, procs[vOutline]);									Outline('her figure for the MEN...', true, 2, procs[vOutline]);									bCr(procs[vbCr]);									Outline('Your pride is hurt....', true, 3, procs[vOutline]);									Privates^^.char^^.Honor := Privates^^.char^^.Honor - 1;								end;						end; {Case}						privates^^.char^^.Flirt1 := privates^^.char^^.Flirt1 - 2;						if privates^^.char^^.Flirt1 <= 0 then							privates^^.char^^.Flirt1 := 1;					end;			end;	end;{-------------------------------------------------}{-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-}end.