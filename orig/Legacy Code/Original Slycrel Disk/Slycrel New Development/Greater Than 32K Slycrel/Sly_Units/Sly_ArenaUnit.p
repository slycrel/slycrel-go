unit Sly_ArenaUnit;interfaceuses	SlyHeaders, HermHeaders, Sly_General;function User2Monster (Name: str255; var Monster: MonsterRec; var HermSetup: UserXIPtr): Boolean;procedure KillFoe (Killer: str255; DeadFoe: MonsterRec; var HermSetup: UserXIPtr);procedure KillUserArena (DeadUser: CharRec; WinningFoe: MonsterRec; var HermSetup: UserXIPtr);procedure GetTerrain (WhatTerrain: str255; var TheTerrain: TerrainType; var HermSetup: UserXIPtr);procedure SetUpGCombat (TheChar: CharRec; Opponent: str255; var HermSetup: UserXIPtr);procedure DisplayGCombat (var Number: integer; HermSetup: UserXIPtr);procedure GetFightInfo (var combPrefs: GCombatPrefs; Number: longint; var HermSetup: UserXIPtr);procedure AddGambler (UserFileName: str255; ForOrAgainst: char; Bet: longint; FightNum: integer; HermSetup: UserXIPtr);implementation{-------------------------------------------------}function User2Monster (Name: str255; var Monster: MonsterRec; var HermSetup: UserXIPtr): Boolean;	var		TheUser: CharRec;		boo1: boolean;	begin		with HermSetup^ do			begin				ReadChar(Name, TheUser, HermSetup);				boo1 := FindUser(Name, n[curNode^]^.TempUser, procs[vFindUser]);				Monster.Name := TheUser.Name;				Monster.Level := (TheUser.ThiefLvl + TheUser.MageLvl + TheUser.FighterLvl) div 3;				Monster.MonsterNum := n[curNode^]^.TempUser.UserNum;				Monster.HitPoints := TheUser.HitPoints;				Monster.Offense := TheUser.Strength div 2 + TheUser.Weapons[1].Strike;				Monster.RangeOffense := TheUser.Strength div 2 + TheUser.Weapons[2].Strike;				Monster.Defense := ((TheUser.Dexterity + TheUser.Speed) div 3) + ((TheUser.Armor[1].Defense + TheUser.Armor[2].Defense) div 2);				Monster.Movement := rnd(TheUser.speed - TheUser.speed div 5, TheUser.speed + TheUser.speed div 5, HermSetup);				Monster.Disposition := 1;				Monster.Experience := TheUser.totalExperience div 10;				Monster.AttackStr1 := TheUser.Weapons[1].Name;				Monster.AttackStr2 := TheUser.Weapons[2].Name;				Monster.DefenseStr := TheUser.Weapons[2].Name;				Monster.MType := Humanoid;				Monster.Coins := Trunc(TheUser.CoinsHand / 1.5);				User2Monster := TheUser.Alive;			end;	end;{-------------------------------------------------}procedure KillFoe (Killer: str255; DeadFoe: MonsterRec; var HermSetup: UserXIPtr);	var		boo1: boolean;		st1: str255;		DeadUser: CharRec;	begin		with HermSetup^ do			begin				numToString(DeadFoe.MonsterNum, st1);				boo1 := FindUser(st1, n[curNode^]^.TempUser, procs[vFindUser]);				ReadChar(n[curNode^]^.TempUser.UserName, DeadUser, HermSetup);				DeadUser.CoinsHand := DeadUser.CoinsHand - DeadFoe.Coins;{!!!!!--- This Can cause problems, because it will resurct the user}{Causing Them to loose Experience & coins as if they have died (killed themselves)}				DeadUser.Alive := false;				DeadUser.HitPoints := DeadFoe.HitPoints;				DeadUser.TotalExperience := Deaduser.TotalExperience - 20;				DeadUser.SpendingExperience := Deaduser.SpendingExperience - 20;		{Should we add 1 to the Foe's # of Fights?}				SaveChar(n[curNode^]^.TempUser.UserName, DeadUser, Hermsetup);		{Add 'Killer' Killed 'DeadFoe' to the News or whatever}			end;	end;{-------------------------------------------------}procedure KillUserArena (DeadUser: CharRec; WinningFoe: MonsterRec; var HermSetup: UserXIPtr);	var		int1: integer;		boo1: boolean;		st1: str255;		WinningUser: CharRec;	begin		with HermSetup^ do			begin				numToString(WinningFoe.MonsterNum, st1);				boo1 := FindUser(st1, n[curNode^]^.TempUser, procs[vFindUser]);				ReadChar(n[curNode^]^.TempUser.UserName, WinningUser, HermSetup);				int1 := rnd(1, round(privates^^.char^^.CoinsHand / 1.5) + 1, HermSetup);				WinningUser.CoinsHand := WinningUser.CoinsHand + int1;				DeadUser.CoinsHand := DeadUser.CoinsHand - int1;				WinningUser.TotalExperience := WinningUser.TotalExperience + round(DeadUser.TotalExperience * 0.3);				WinningUser.SpendingExperience := WinningUser.SpendingExperience + round(DeadUser.TotalExperience * 0.3);				WinningUser.FightsWon := WinningUser.FightsWon + 1;				WinningUser.TotalFights := WinningUser.TotalFights + 1;				DeadUser.Alive := false;				DeadUser.TotalExperience := DeadUser.TotalExperience + 20;				DeadUser.TotalFights := DeadUser.TotalFights + 1;				SaveChar(n[curNode^]^.TempUser.UserName, WinningUser, HermSetup);				SaveChar(n[curNode^]^.ThisUser.UserName, DeadUser, HermSetup);		{Add 'Killer' Killed 'DeadFoe' to the News or whatever}			end;	end;{-------------------------------------------------}procedure FReadTerrain (fRefNum: integer; var TheTerrain: TerrainType; var HermSetup: UserXIPtr);	var		ByteCount: longint;		err: OSErr;	begin		with HermSetup^ do			begin				ByteCount := SizeOf(TerrainType);				err := FSRead(fRefNum, ByteCount, @TheTerrain);				parseerr(err, HermSetup);			end;	end;{-------------------------------------------------}procedure GetTerrain (WhatTerrain: str255; var TheTerrain: TerrainType; var HermSetup: UserXIPtr);	var		FRefNum: integer;	begin		with HermSetup^ do			begin				FOpen(concat(filesPath^, TerrainPath, WhatTerrain), FRefNum, HermSetup);				FReadTerrain(FRefNum, TheTerrain, HermSetup);				FClose(FRefNum, HermSetup);			end;	end;{-------------------------------------------------}procedure SetUpGCombat (TheChar: CharRec; Opponent: str255; var HermSetup: UserXIPtr);	var		combPrefs: GCombatPrefs;		TheOpponent: CharRec;		int1, int2: integer;		ratio: real;		ByteCount: Longint;		fRefNum: integer;		Err: OSErr;	begin		with HermSetup^ do			begin				WriteText(Opponent, prefs^^.myWindow, HermSetup);				ReadChar(Opponent, TheOpponent, HermSetup);				int1 := Arena_Appraisal(TheOpponent);				int2 := Arena_Appraisal(TheChar);				Ratio := int1 / int2;				if (ratio < 1) and (ratio > 0) then					begin						ratio := int2 / int1;						combPrefs.Odds[2] := round(ratio);						combPrefs.Odds[1] := 1;					end				else					begin						combPrefs.Odds[1] := round(ratio);						combPrefs.Odds[2] := 1;					end; {else}				combPrefs.Challenger := TheChar.Name;				combPrefs.Opponent := TheOpponent.Name;				ByteCount := SizeOf(GCombatPrefs);				if not FExist(concat(filespath^, SlyDataPath, 'GCombat'), procs[vFExist]) then					FCreate(concat(filespath^, SlyDataPath, 'GCombat'), DataType, HermSetup);				FOpen(concat(filespath^, SlyDataPath, 'GCombat'), fRefNum, HermSetup);				err := SetFPos(fRefNum, FSFromLEOF, 0);				parseerr(err, Hermsetup);				err := FSWrite(fRefNum, ByteCount, @combPrefs);				parseerr(err, Hermsetup);				FClose(fRefNum, HermSetup);			end;	end;{-------------------------------------------------}procedure DisplayGCombat (var Number: integer; HermSetup: UserXIPtr);	var		combPrefs: GCombatPrefs;		Err: OSErr;		fRefNum: integer;		st1, st2: str255;		ByteCount: longint;	begin		with HermSetup^ do			begin				FOpen(concat(filespath^, SlyDataPath, 'GCombat'), fRefNum, HermSetup);				Number := 0;				err := SetFPos(fRefNum, FSFromStart, 0);				ByteCount := SizeOf(GCombatPrefs);				while not MyEOF(fRefNum, HermSetup) do					begin						Number := Number + 1;						err := FSRead(fRefNum, ByteCount, @combPrefs);						Parseerr(err, HermSetup);						NumToString(Number, St1);						Outline(st1, true, 1, procs[vOutline]);						NumToString(combPrefs.Odds[1], st1);						NumToString(combPrefs.Odds[2], st2);						Outline(concat('    Challenger: ', combPrefs.Challenger), false, 1, procs[vOutline]);						Outline(concat('     Opponent: ', combPrefs.Opponent), true, 1, procs[vOutline]);						Outline(concat('Odds (C:P) : ', st1, ':', st2), true, 1, procs[vOutline]);						bCr(procs[vbCr]);					end;				FClose(fRefNum, HermSetup);			end;	end;{-------------------------------------------------}procedure GetFightInfo (var combPrefs: GCombatPrefs; Number: longint; var HermSetup: UserXIPtr);	var		fRefNum: integer;		ByteCount: longint;		err: OSErr;	begin		with HermSetup^ do			begin				FOpen(concat(filespath^, SlyDataPath, 'GCombat'), fRefNum, HermSetup);				ByteCount := SizeOf(GCombatPrefs) * (Number - 1);				err := SetFPos(fRefNum, FSFromStart, ByteCount);				parseerr(err, HermSetup);				ByteCount := SizeOf(GCombatPrefs);				err := FSRead(fRefNum, ByteCount, @combPrefs);				parseerr(err, HermSetup);				FClose(fRefNum, HermSetup);			end;	end;{-------------------------------------------------}procedure AddGambler (UserFileName: str255; ForOrAgainst: char; Bet: longint; FightNum: integer; HermSetup: UserXIPtr);	var		fRefNum: integer;		ByteCount: longint;		List: GCombatList;		err: OSErr;	begin		with HermSetup^ do			begin				List.FileName := UserFileName;				List.FightNum := FightNum;				List.bet := bet;				if ForOrAgainst = 'F' then					List.ForChallenger := true				else					List.ForChallenger := false;				List.Challenger := Privates^^.PrefData.Challenger;				List.Opponent := Privates^^.PrefData.Opponent;				ByteCount := SizeOf(GCombatList);				if not FExist(concat(filespath^, SlyDataPath, 'GCombatlist'), procs[vFExist]) then					FCreate(concat(filespath^, SlyDataPath, 'GCombatList'), DataType, HermSetup);				FOpen(concat(filespath^, SlyDataPath, 'GCombatlist'), fRefNum, HermSetup);				err := SetFPos(fRefNum, FSFromLEOF, 0);				parseerr(err, Hermsetup);				err := FSWrite(fRefNum, ByteCount, @List);				parseerr(err, Hermsetup);				FClose(fRefNum, HermSetup);			end;	end;{-------------------------------------------------}end.