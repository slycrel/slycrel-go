unit Sly_MainUnit;interfaceuses	SlyHeaders, HermHeaders, Sly_General;procedure CallOtherCode (HermSetup: UserXIPtr; Addr: ProcPtr);inline$205F, $4E90;{-Utils-}procedure Seed (var HermSetup: UserXIPtr);procedure RollChar (var TheChar: CharRec; Ch1: Char; var HermSetup: UserXIPtr);procedure ResurrectUser (var TheChar: CharRec; var HermSetup: UserXIPtr);procedure NewDayForUser (UserName: str255; var TheChar: CharRec; var HermSetup: UserXIPtr);function CalcFight (Challenger, Opponent: str255; ChOdds, OppOdds: integer; var loser: str255; HermSetup: UserXIPtr): str255;procedure PayOffUsers (List: GCombatList; combPrefs: GCombatPrefs; Winner, Loser: str255; HermSetup: UserXIPtr);procedure DoFightUpkeep (var HermSetup: UserXIPtr);procedure DoUpkeep (var HermSetup: UserXIPtr);procedure UpDatePlayerList (HermSetup: UserXIPtr);{-Screen-}procedure PrintMenu (Div1, Command, Div2: string; DivColor, ComColor: string; Cr: boolean; var HermSetup: UserXIPtr);procedure ShowScale (var HermSetup: UserXIPtr);implementation				{-***********-Utils-***********-}{-------------------------------------------------}procedure Seed (var HermSetup: UserXIPtr);	var		i, TheSeed: integer;		x: real;	begin		TheSeed := TickCount mod 255;		if TheSeed < 0 then			TheSeed := -TheSeed;		for i := 1 to TheSeed do			x := Random;		HermSetup^.prefs^^.Seed := TheSeed	end;{-------------------------------------------------}procedure RollChar (var TheChar: CharRec; Ch1: Char; var HermSetup: UserXIPtr);	var		x: integer;	begin		with HermSetup^ do			begin				TheChar.LastOn := TheDate;				TheChar.Alive := true;				TheChar.Ammo := rnd(1, 10, HermSetup);				TheChar.CoinsHand := 15;				TheChar.CoinsBank := 5;				TheChar.TotalExperience := rnd(1, 100, HermSetup);				TheChar.SpendingExperience := TheChar.TotalExperience;				TheChar.ThiefLvl := 0;				TheChar.MageLvl := 0;				TheChar.FighterLvl := 0;				case ch1 of					'F': 						begin							with TheChar do								begin									CharClass := 'Fighter';									Strength := rnd(4, 12, HermSetup);									Speed := rnd(8, 12, HermSetup);									MaxPsyche := 1;									Psyche := MaxPsyche;									Fame := rnd(0, 2, HermSetup);									Dexterity := rnd(4, 15, HermSetup);									HitPoints := rnd(15, 35, HermSetup);									MaxHP := HitPoints;									Movement := rnd(speed - speed div 5, speed + speed div 5, HermSetup);									Exploration := 15;									Spars := 3;									Honor := rnd(1, 15, HermSetup);									Faith := rnd(1, 7, HermSetup);									Flirt1 := 1;									Flirt2 := 1;								end;						end;					'T': 						begin							with TheChar do								begin									CharClass := 'Thief';									Strength := rnd(3, 12, HermSetup);									Speed := rnd(10, 16, HermSetup);									MaxPsyche := 1;									Psyche := MaxPsyche;									Fame := rnd(0, 2, HermSetup);									Dexterity := rnd(4, 20, HermSetup);									HitPoints := rnd(13, 26, HermSetup);									MaxHP := HitPoints;									Movement := rnd(speed - speed div 5, speed + speed div 5, HermSetup);									Exploration := 15;									Spars := 3;									Honor := rnd(1, 12, HermSetup);									Faith := rnd(1, 5, HermSetup);									Flirt1 := 1;									Flirt2 := 1;								end;						end;					'M': 						begin							with TheChar do								begin									CharClass := 'Mage';									Strength := rnd(2, 10, HermSetup);									Speed := rnd(8, 16, HermSetup);									MaxPsyche := rnd(2, 4, HermSetup);									Psyche := MaxPsyche;									Fame := rnd(0, 2, HermSetup);									Dexterity := rnd(4, 15, HermSetup);									HitPoints := rnd(4, 17, HermSetup);									MaxHP := HitPoints;									Movement := rnd(speed - speed div 5, speed + speed div 5, HermSetup);									Exploration := 15;									Spars := 3;									Honor := rnd(4, 15, HermSetup);									Faith := rnd(0, 5, HermSetup);									Flirt1 := 1;									Flirt2 := 1;								end;						end;					otherwise						begin							with TheChar do								begin									CharClass := 'None';									Strength := 0;									Speed := 0;									MaxPsyche := 0;									Psyche := 0;									Fame := 0;									Dexterity := 0;									HitPoints := 0;									MaxHP := 0;									Movement := 0;									Exploration := 0;									Spars := 0;									Honor := 0;									Faith := 0;									Flirt1 := 0;									Flirt2 := 0;									CoinsHand := 0;									CoinsBank := 0;									TotalExperience := 0;									SpendingExperience := 0;									ThiefLvl := 0;									MageLvl := 0;									FighterLvl := 0;								end;						end;				end;	{Case}				TheChar.TotalFights := 0;				TheChar.FightsWon := 0;				TheChar.TheifGuild := false;				TheChar.MageGuild := false;				TheChar.FighterGuild := false;				TheChar.Location := TheTown;	{if they are female then 'Adjust' the Stats a little}				with TheChar do					if not (Gender = true) then						begin							Strength := Strength - 3;							MaxPsyche := MaxPsyche + 2;							Dexterity := Dexterity + 2;							MaxHp := MaxHp - 1;							HitPoints := MaxHp;						end;				for x := 1 to 3 do					with TheChar do						begin							Weapons[x].Name := 'Hands';							Weapons[x].Strike := Strength div 4;							Weapons[x].Range := 0;							Weapons[x].Cost := 0;							Weapons[x].Ability := 0;							if x = 2 then								begin									Weapons[x].Name := 'rocks';									Weapons[x].Strike := 1;									Weapons[x].Range := 2;								end;						end;				with TheChar do					begin						Armor[1].Name := 'Clothing';						Armor[1].Defense := 1;						Armor[1].Cost := 0;						Armor[1].Ability := 0;						Armor[2].Name := 'None';						Armor[2].Defense := 1;						Armor[2].Cost := 0;						Armor[2].Ability := 0;					end;			end;	end;{-------------------------------------------------}procedure ResurrectUser (var TheChar: CharRec; var HermSetup: UserXIPtr);	begin		with HermSetup^ do			begin				with TheChar do					begin						Alive := true;						HitPoints := MaxHP;						Psyche := MaxPsyche;						TotalExperience := TotalExperience - round(TotalExperience * 0.02);						SpendingExperience := SpendingExperience - round(SpendingExperience * 0.02);						Fame := Fame - 1;						Faith := Faith + 1;						CoinsHand := CoinsHand - (CoinsHand div 5);					end;			end;	end;{-------------------------------------------------}procedure NewDayForUser (UserName: str255; var TheChar: CharRec; var HermSetup: UserXIPtr);	var		fRefNum: integer;	begin		with HermSetup^ do			begin				with TheChar do					begin						Psyche := MaxPsyche;						TotalExperience := TotalExperience + 15;						SpendingExperience := SpendingExperience + 15;						Movement := rnd(speed - speed div 5, speed + speed div 5, HermSetup);						Exploration := 15;						Spars := 4;						if flirt1 < 0 then							Flirt1 := -Flirt1;						if flirt2 < 0 then							Flirt2 := -Flirt2;						if (not TheChar.Alive) then							ResurrectUser(TheChar, HermSetup);					end;				FOpen(concat(FilesPath^, UserPath, UserName), fRefNum, HermSetup);				FWriteChar(TheChar, fRefNum, HermSetup);				FClose(fRefNum, HermSetup);			end;	end;{-------------------------------------------------}function CalcFight (Challenger, Opponent: str255; ChOdds, OppOdds: integer; var loser: str255; HermSetup: UserXIPtr): str255;	var		result: integer;	begin		if ChOdds > OppOdds then			begin				result := rnd(1, ChOdds + 1, HermSetup);				if Result = 1 then					begin						CalcFight := 'Opponent';						loser := 'Challenger';					end				else					begin						CalcFight := 'Challenger';						loser := 'Opponent';					end;			end		else			begin				result := rnd(1, OppOdds + 1, HermSetup);				if Result = 1 then					begin						CalcFight := 'Challenger';						loser := 'Opponent';					end				else					begin						CalcFight := 'Opponent';						loser := 'Challenger';					end;			end;{else}	end;{-------------------------------------------------}procedure PayOffUsers (List: GCombatList; combPrefs: GCombatPrefs; Winner, Loser: str255; HermSetup: UserXIPtr);	var		TheChar: CharRec;		fRefNum, FNum: integer;		fName, st1, BBSName, strdate: str255;		err: OSErr;		boo1: boolean;	begin		with HermSetup^ do			begin				boo1 := findPlayer(List.FileName, BBSName, HermSetup);				fname := concat(filespath^, UserPath, BBSName);				if (List.ForChallenger) and (UCase(winner) = UCase(List.Challenger)) then					begin						List.bet := List.Bet * (combPrefs.Odds[1] + 1);						FOpen(fname, fRefNum, HermSetup);						FReadChar(TheChar, fRefNum, HermSetup);						TheChar.CoinsHand := TheChar.CoinsHand + List.Bet;						NumToString(List.Bet, st1);						FWriteChar(TheChar, fRefNum, HermSetup);						FClose(fRefNum, HermSetup);						WriteNewsToPlayer(concat('You profit on your betting (Gladiator combat: ', winner, '$', st1, '.'), TheChar, BBSName, false, HermSetup);					end;				if (not List.ForChallenger) and (UCase(Winner) = UCase(List.Opponent)) then					begin						List.bet := List.Bet * (combPrefs.Odds[1] + 1);						FOpen(fname, fRefNum, HermSetup);						FReadChar(TheChar, fRefNum, HermSetup);						TheChar.CoinsHand := TheChar.CoinsHand + List.Bet;						NumToString(List.Bet, st1);						FWriteChar(TheChar, fRefNum, HermSetup);						FClose(fRefNum, HermSetup);						WriteNewsToPlayer(concat('You profit on your betting (Gladiator combat: ', winner, '$', st1, '.'), TheChar, BBSName, false, HermSetup);					end;				if (List.ForChallenger) and (UCase(winner) = UCase(List.Opponent)) then					begin						WriteNewsToPlayer(concat('You lost on your betting (Gladiator combat: ', winner, '.'), TheChar, BBSName, false, HermSetup);					end;				if (not List.ForChallenger) and (UCase(winner) = UCase(List.Challenger)) then					begin						WriteNewsToPlayer(concat('You lost on your betting (Gladiator combat: ', winner, '.'), TheChar, BBSName, false, HermSetup);					end;			end;	end;{-------------------------------------------------}procedure DoFightUpkeep (var HermSetup: UserXIPtr);	var		fRefNum, fRefNum2, fRefNum3, fRefNum4: integer;		currentFightNum: integer;		combPrefs: GCombatPrefs;		List: GCombatList;		Err: OSErr;		ByteCount: longint;		winner, loser: str255;		SlyPlayers: PlayersRec;		Character1, Character2: CharRec;		WinnerFName, LoserFName: str255;		st1, st2, st3: str255;		boo1: boolean;	begin		CurrentFightNum := 0;		with HermSetup^ do			begin				if FExist(concat(filespath^, SlyDataPath, 'GCombat'), procs[vFExist]) then					begin						FOpen(concat(filespath^, SlyDataPath, 'GCombat'), fRefNum, HermSetup);						while not MyEOF(fRefNum, HermSetup) do							begin								ByteCount := SizeOf(GCombatPrefs);								err := FSRead(fRefNum, ByteCount, @combPrefs);								Parseerr(err, HermSetup);								CurrentFightNum := CurrentFightNum + 1;								if combPrefs.Opponent <> combPrefs.Challenger then 	{if not same person then}																															{determine the winner here}																															{& put winner's name in winner}									begin										winner := CalcFight(combPrefs.Challenger, combPrefs.Opponent, combPrefs.Odds[1], combPrefs.Odds[2], loser, HermSetup);										if Winner = 'Challenger' then											begin												winner := combPrefs.Challenger;												boo1 := FindPlayer(winner, winnerFName, HermSetup);												loser := combPrefs.Opponent;												boo1 := FindPlayer(loser, LoserFName, HermSetup);											end										else											begin												winner := combPrefs.Opponent;												boo1 := FindPlayer(winner, winnerFName, HermSetup);												loser := combPrefs.Challenger;												boo1 := FindPlayer(loser, LoserFName, HermSetup);											end;{get the combatants charrec here & write it to the E-mail/Sly Announcements}										FOpen(concat(filespath^, UserPath, winnerFName), fRefNum3, HermSetup);										FReadChar(Character1, fRefNum3, HermSetup);										FOpen(concat(filespath^, UserPath, loserFName), fRefNum4, HermSetup);										FReadChar(Character2, fRefNum4, HermSetup);										with Character1 do											begin												TotalExperience := TotalExperience + round(Character2.SpendingExperience * 0.1);												CoinsHand := CoinsHand + 25;												TotalFights := TotalFights + 1;												FightsWon := FightsWon + 1;											end;										FWriteChar(Character1, fRefNum3, HermSetup);										FClose(fRefNum3, HermSetup);										FClose(fRefNum4, HermSetup);										WriteNewsToPlayer(concat('You have lost Gladiator combat with ', winnerFName), Character1, loser, false, HermSetup);										WriteNewsToPlayer(concat('You have won Gladiator Combat with ', loserFName), Character2, winner, false, HermSetup);										if FExist(concat(filespath^, SlyDataPath, 'GCombatlist'), procs[vFExist]) then											begin												ByteCount := SizeOf(GCombatList);												FOpen(concat(filespath^, SlyDataPath, 'GCombatlist'), fRefNum2, HermSetup);												parseerr(err, Hermsetup);												while not MyEOF(fRefNum2, HermSetup) do													begin														err := FSRead(fRefNum2, ByteCount, @List);														parseerr(err, Hermsetup);														if List.FightNum = currentFightNum then															PayOffUsers(List, combPrefs, Winner, Loser, HermSetup);													end;												FClose(fRefNum2, HermSetup);											end;									end; {if not the same person}							end;	{While not EOF(Gcombat)}						FClose(fRefNum, HermSetup);						FDelete(concat(filespath^, SlyDataPath, 'GCombat'), HermSetup);						if FExist(concat(filespath^, SlyDataPath, 'GCombatList'), procs[vFExist]) then							FDelete(concat(filespath^, SlyDataPath, 'GCombatList'), HermSetup);					end;			end;	end;{-------------------------------------------------}procedure DoUpkeep (var HermSetup: UserXIPtr);	var		OurTime: DateTimeRec;		UserListRefNum: integer;		PlayerList: PlayersRec;		thePlayer: CharRec;		byteCount: longint;	begin		with HermSetup^ do			begin				prefs^^.LastUpdate := TheDate;				InnUpkeep(HermSetup);				if FExist(concat(filespath^, SlyDataPath, 'PlayerList'), procs[vFExist]) then					begin						WriteText('Opening Player List', Prefs^^.MyWindow, HermSetup);						FOpen(concat(filesPath^, SlyDataPath, 'PlayerList'), UserListRefNum, HermSetup);						while not MyEOF(UserListRefNum, Hermsetup) do							begin								ByteCount := SizeOf(PlayersRec);								parseerr(FSRead(UserListRefNum, ByteCount, @PlayerList), Hermsetup);								Outline(concat('Reading Player ', PlayerList.BBSName), true, 6, procs[vOutline]);								if FExist(concat(filespath^, UserPath, PlayerList.BBSName), procs[vFExist]) then									begin										ReadChar(PlayerList.BBSName, ThePlayer, HermSetup);										NewDayForUser(PlayerList.BBSName, ThePlayer, HermSetup);										PlayerList.SlyName := ThePlayer.Name;										PlayerList.Class := ThePlayer.CharClass;										PlayerList.Alive := ThePlayer.Alive;										PlayerList.LastPlayed := ThePlayer.Laston;										ParseErr(SetFPos(UserListRefNum, FSFromMark, -ByteCount), HermSetup);										ParseErr(FSWrite(UserListRefNum, ByteCount, @PlayerList), HermSetup);									end								else									Outline(concat(PlayerList.BBSName, ' Player not found'), true, 6, procs[vOutline]);							end;						Outline('Now closing Player List', true, 6, procs[vOutline]);						FClose(UserListRefNum, HermSetup);						DoFightUpkeep(HermSetup);					end				else					begin						Outline('Warning, Player upkeep skipped, PlayerList file not found.', true, 6, procs[vOutline]);					end;			end;	end;{-------------------------------------------------}procedure UpDatePlayerList (HermSetup: UserXIPtr);	var		ThePlayer: CharRec;		PlayerList: PlayersRec;		fRefNum: integer;		ByteCount: longint;		found: boolean;	begin		with HermSetup^ do			begin				found := false;				if FExist(concat(filespath^, SlyDataPath, 'PlayerList'), procs[vFExist]) then					begin						WriteText('Opening Player List', Prefs^^.MyWindow, HermSetup);						FOpen(concat(filesPath^, SlyDataPath, 'PlayerList'), fRefNum, HermSetup);						while not MyEOF(fRefNum, Hermsetup) do							begin								ByteCount := SizeOf(PlayersRec);								parseerr(FSRead(fRefNum, ByteCount, @PlayerList), Hermsetup);								if FExist(concat(filespath^, UserPath, PlayerList.BBSName), procs[vFExist]) then									begin										ReadChar(PlayerList.BBSName, ThePlayer, HermSetup);										if PlayerList.SlyName = Privates^^.Char^^.Name then											found := true;										PlayerList.SlyName := ThePlayer.Name;										PlayerList.Class := ThePlayer.CharClass;										PlayerList.Alive := ThePlayer.Alive;										PlayerList.LastPlayed := ThePlayer.Laston;										ParseErr(SetFPos(fRefNum, FSFromMark, -ByteCount), HermSetup);										ParseErr(FSWrite(fRefNum, ByteCount, @PlayerList), HermSetup);									end;							end;						FClose(fRefNum, HermSetup);						if not found then							if not AddChar2List(Privates^^.Char^^, HermSetup) then								outline('Your character did NOT get added!', true, 6, procs[vFExist])					end				else					begin						ThePlayer := Privates^^.Char^^;						if not FExist(concat(filesPath^, SlyDataPath, 'PlayerList'), procs[vFExist]) then							FCreate(concat(filesPath^, SlyDataPath, 'PlayerList'), DataType, HermSetup);						Outline('New player list created...', true, 6, procs[vOutline]);						PlayerList.BBSName := n[curNode^]^.ThisUser.UserName;						PlayerList.SlyName := ThePlayer.Name;						PlayerList.Class := ThePlayer.CharClass;						PlayerList.Alive := true;						PlayerList.LastPlayed := TheDate;						GetApprValue(PlayerList.ApprVal, ThePlayer);						ByteCount := SizeOf(PlayersRec);						if not AddChar2List(ThePlayer, HermSetup) then							outline('Your character did NOT get added!', true, 6, procs[vOutline]);					end;			end;	end;{-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-}				{-***********-Screen-***********-}{-------------------------------------------------}procedure PrintMenu (Div1, Command, Div2: string; DivColor, ComColor: string; Cr: boolean; var HermSetup: UserXIPtr);	begin		with HermSetup^ do			begin				ANSICode(concat(Divcolor, div1), procs[vANSICode]);				ANSICode(concat(Comcolor, Command), procs[vANSICode]);				ANSICode(concat(Divcolor, Div2), procs[vANSICode]);				if Cr then					bCr(procs[vbCr]);			end;	end;{-------------------------------------------------}procedure ShowScale (var HermSetup: UserXIPtr);	begin		with HermSetup^ do			begin				Outline('Scale:', true, 7, procs[vOutline]);				bCr(procs[vbCr]);				Outline(' 1 - Infant              ', true, 1, procs[vOutline]);				Outline(' 2 - Puny', false, 1, procs[vOutline]);				Outline(' 3 - Weak                ', true, 1, procs[vOutline]);				Outline(' 4 - Lacking', false, 1, procs[vOutline]);				Outline(' 5 - Typical             ', true, 1, procs[vOutline]);				Outline(' 6 - Fair', false, 1, procs[vOutline]);				Outline(' 7 - Adequate            ', true, 1, procs[vOutline]);				Outline(' 8 - Commendable', false, 1, procs[vOutline]);				Outline(' 9 - Admirable           ', true, 1, procs[vOutline]);				Outline('10 - Exceptional', false, 1, procs[vOutline]);				Outline('11 - Superior            ', true, 1, procs[vOutline]);				Outline('12 - Invincible', false, 1, procs[vOutline]);				bCr(procs[vbCr]);				Outline(' ** Note:  Based on 10 as being Human mortal maximum value', true, 3, procs[vOutline]);			end;	end;{-------------------------------------------------}{-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-#-*-}end.