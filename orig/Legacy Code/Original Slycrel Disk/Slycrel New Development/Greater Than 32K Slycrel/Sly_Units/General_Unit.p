unit Sly_General;interfaceuses	SlyHeaders, HermHeaders;{$IFC UNDEFINED DEBUG_LEVEL}{$SETC DEBUG_LEVEL:= CURRENT_DEBUG_LEVEL}{$ENDC}function SpaceOut (TheStr: str255; HowLong: integer): str255;procedure myPausePrompt (OurPromptLine: str255; var HermSetup: UserXIPtr);function OkPrompt (Accepted: str255; var HermSetup: UserXIPtr): boolean;procedure ClrPrompt (var HermSetup: UserXIPtr);function TheDate: longint;function RealDate (ADate: longint): string; 	{The date variable is in the format yymmdd}function rnd (Min, Max: integer; var HermSetup: UserXIPtr): integer;procedure BufferANSI (TheANSI: string; bCrBefore: boolean; var HermSetup: UserXIPtr);function ucase (the_string: string): string;function ConvertStats (Value: integer; var HermSetup: UserXIPtr): string;procedure parseerr (err: OSErr; var HermSetup: UserXIPtr);	{check for an error}procedure FOpen (FileName: str255; var fRefNum: integer; var HermSetup: UserXIPtr);procedure FClose (var fRefNum: integer; var HermSetup: UserXIPtr);procedure FCreate (FileName: Str255; FileType: str255; var HermSetup: UserXIPtr);procedure FDelete (FileName: str255; var HermSetup: UserXIPtr);procedure SetFilePos (fRefNum: integer; OffSet: longint; var HermSetup: UserXIPtr);function MyEOF (fRefNum: integer; HermSetup: UserXIPtr): Boolean;procedure FReadChar (var TheChar: CharRec; fRefNum: integer; var HermSetup: UserXIPtr);procedure FWriteChar (var TheChar: CharRec; fRefNum: integer; var HermSetup: UserXIPtr);procedure FReadScores (fRefNum: integer; var OurArray: HighScoreArr; var HermSetup: UserXIPtr);procedure FWriteScores (fRefNum: integer; OurArray: HighScoreArr; var HermSetup: UserXIPtr);procedure GetApprValue (var TheValue: Longint; TheChar: CharRec);procedure wln (TheString: str255; var FNum: integer; HermSetup: UserXIPtr);procedure WriteNewsToPlayer (TheString: Str255; ThePlayer: CharRec; OpponentFName: str255; WriteMail: boolean; HermSetup: userXIPtr);function AddChar2List (TheChar: CharRec; var HermSetup: UserXIPtr): Boolean;procedure FWritePlayer2List (UserName: str255; TheUser: CharRec; HermSetup: UserXIPtr);function FindPlayer (Player: str255; var FoundName: str255; HermSetup: UserXIPtr): Boolean;procedure SaveChar (FileName: str255; TheChar: CharRec; HermSetup: UserXIPtr);procedure ReadChar (FileName: str255; var TheChar: CharRec; var Hermsetup: UserXIPtr);procedure ViewGuildLists (HermSetup: UserXIPtr);procedure PrintCharStats (TheStats: CharRec; var HermSetup: UserXIPtr);function Arena_Appraisal (TheChar: CharRec): integer;function PlayerInInn (PlayerName: str255; HermSetup: UserXIPtr): boolean;procedure InnUpkeep (HermSetup: UserXIPtr);function SetupWindow: windowPtr;procedure WriteText (ToWrite: str255; var TheWindow: WindowPtr; var HermSetup: UserXIPtr);function CheckInn (HermSetup: UserXIPtr): boolean;function InnKeeperName (HermSetup: UserXIPtr): string;implementation{-------------------------------------------------}function SpaceOut (TheStr: str255; HowLong: integer): str255;	var		x: integer;	begin		for x := Length(TheStr) to HowLong do			TheStr := concat(TheStr, ' ');		SpaceOut := TheStr;	end;{-------------------------------------------------}procedure myPausePrompt (OurPromptLine: str255; var HermSetup: UserXIPtr);	begin		with HermSetup^ do			with n[CurNode^]^.MyPrompt do				begin					promptLine := ourPromptLine;					AllowedChars := 'abcdefghijklmnopqrstuvwxyz`1234567890-=[]\;'',./ ';					replaceChar := chr(32);					Capitalize := false;					enforceNumeric := false;					AutoAccept := true;					WrapAround := false;					WrapsOnCR := true;					breakChar := chr(0);					HermesColor := 3;					InputColor := 0;					NumericLow := -1;					NumericHigh := -1;					maxChars := 1;					Keystring1 := '';					KeyString2 := '';					KeyString3 := '';					PromptUser(CurNode^, procs[vPromptuser]);				end;	end;{-------------------------------------------------}function OkPrompt (Accepted: str255; var HermSetup: UserXIPtr): boolean;	var		found: boolean;		x, y: integer;	begin		found := false;		with HermSetup^ do			begin				y := pos(n[curNode^]^.CurPrompt[1], Accepted);				if y <> 0 then					found := true;			end;		if found then			OkPrompt := true		else			OkPrompt := false;	end;{-------------------------------------------------}procedure ClrPrompt (var HermSetup: UserXIPtr);	begin		with HermSetup^ do			begin				n[CurNode^]^.CurPrompt := 'þ';			end;	end;{-------------------------------------------------}function TheDate: longint;	{returns date in the format of yyyymmdd}	var		TempRec: DateTimeRec;		TempInt: longint;	begin		GetTime(TempRec);		TempInt := ((TempRec.year * 100000) + (TempRec.month * 1000) + (TempRec.day * 10)) div 10;		TheDate := TempInt;	end;{-------------------------------------------------}function RealDate (ADate: longint): string; 	{The date variable is in the format yyyymmdd}	var																				{converts to 'mm/dd/yy'}		st1, TempStr: str255;	begin		NumToString(ADate, TempStr);		st1 := concat(TempStr[5], TempStr[6], '/', TempStr[7], TempStr[8], '/', TempStr[3], TempStr[4]);		RealDate := st1;	end;{-------------------------------------------------}function rnd (Min, Max: integer; var HermSetup: UserXIPtr): integer;{This function will put out a random # between the Max and Min that is specified}	var		QdRandom: Longint;	begin		QdRandom := Random + 32768;		QdRandom := (QdRandom * (max - min + 1)) div 65536 + min;		rnd := QdRandom;	end;{-------------------------------------------------}procedure BufferANSI (TheANSI: string; bCrBefore: boolean; var HermSetup: UserXIPtr);	begin		with HermSetup^ do			begin				Bufferit(concat(char(27), '[', TheANSI), bCrBefore, 0, procs[vBufferIt]);			end;	end;{-------------------------------------------------}function ucase (the_string: string): string;	{convert lowercase string to uppercase string}	var		i: integer;	begin		for i := 1 to length(the_string) do			if the_string[i] in ['a'..'z'] then				the_string[i] := chr(ord(the_string[i]) - ord('a') + ord('A'));		ucase := the_string	end;{-------------------------------------------------}function ConvertStats (Value: integer; var HermSetup: UserXIPtr): string;	begin		with hermSetup^ do			begin				case Value of					1..3: 						ConvertStats := 'Infant';					4..7: 						ConvertStats := 'Puny';					8..10: 						ConvertStats := 'Weak';					11..14: 						ConvertStats := 'Lacking';					15..25: 						ConvertStats := 'Typical';					26..35: 						ConvertStats := 'Fair';					36..45: 						ConvertStats := 'Adequate';					46..55: 						ConvertStats := 'Commendable';					56..65: 						ConvertStats := 'Admirable';					66..75: 						ConvertStats := 'Exceptional';					76..90: 						ConvertStats := 'Superior';					91..99: 						ConvertStats := 'Invincible';					100: 						ConvertStats := 'Kickin''!';				end;			end;	end;{-------------------------------------------------}procedure parseerr (err: OSErr; var HermSetup: UserXIPtr);	{check for an error}	var		st1, st2: str255;	begin		if err <> noerr then			with HermSetup^ do				begin					numToString(err, st1);					numToString(privates^^.stage, st2);{$IFC DEBUG_LEVEL = 1}					WriteText(concat('Error #', st1, ' in stage #', st2), Prefs^^.MyWindow, HermSetup);{$ENDC}{$IFC DEBUG_LEVEL = 2}					Outline(concat('Error #', st1, ' in stage #', st2), true, 6, procs[vOutline]);{$ENDC}				end;	end;{-------------------------------------------------}procedure FOpen (FileName: str255; var fRefNum: integer; var HermSetup: UserXIPtr);	var		err: OSErr;	begin		err := FSOpen(FileName, vRefNum, fRefNum);		parseerr(err, HermSetup);	end;{-------------------------------------------------}procedure FClose (var fRefNum: integer; var HermSetup: UserXIPtr);	var		err: OSErr;	begin		err := FSClose(fRefNum);		parseerr(err, HermSetup);	end;{-------------------------------------------------}procedure FCreate (FileName: Str255; FileType: str255; var HermSetup: UserXIPtr);	var		err: OSErr;	begin		err := Create(Filename, vRefNum, HermesType, FileType);		parseerr(Err, HermSetup);	end;{-------------------------------------------------}procedure FDelete (FileName: str255; var HermSetup: UserXIPtr);	var		err: OSErr;	begin		err := FSDelete(FileName, vRefNum);		parseerr(err, HermSetup);	end;{-------------------------------------------------}procedure SetFilePos (fRefNum: integer; OffSet: longint; var HermSetup: UserXIPtr);	var		err: OSErr;	begin		err := SetFPos(fRefNum, FSFromStart, OffSet);		parseerr(err, HermSetup);	end;{-------------------------------------------------}function MyEOF (fRefNum: integer; HermSetup: UserXIPtr): Boolean;	var		WhereEOF, WhereFPos: longint;		err: OSErr;	begin		err := GetFPos(fRefNum, WhereFPos);		parseErr(err, HermSetup);		err := GetEOF(fRefNum, WhereEOF);		parseErr(err, HermSetup);		if WhereFPos >= WhereEOF then			MyEOF := true		else			MyEOF := false;	end;{-------------------------------------------------}procedure FReadChar (var TheChar: CharRec; fRefNum: integer; var HermSetup: UserXIPtr);	var		ByteCount: longint;		err: OSErr;	begin		with HermSetup^ do			begin				ByteCount := SizeOf(CharRec);				err := FSRead(fRefNum, ByteCount, @TheChar);				parseerr(err, HermSetup);			end;	end;{-------------------------------------------------}procedure FWriteChar (var TheChar: CharRec; fRefNum: integer; var HermSetup: UserXIPtr);	var		ByteCount: longint;		err: OSErr;	begin		with HermSetup^ do			begin				ByteCount := SizeOf(CharRec);				err := FSWrite(fRefNum, ByteCount, @TheChar);				parseerr(err, HermSetup);			end;	end;{-------------------------------------------------}procedure FReadScores (fRefNum: integer; var OurArray: HighScoreArr; var HermSetup: UserXIPtr);	var		ByteCount: longint;		err: OSErr;	begin		with HermSetup^ do			begin				ByteCount := SizeOf(HighScoreArr);				err := FSRead(fRefNum, ByteCount, @OurArray);				parseerr(err, HermSetup);			end;	end;{-------------------------------------------------}procedure FWriteScores (fRefNum: integer; OurArray: HighScoreArr; var HermSetup: UserXIPtr);	var		ByteCount: longint;		err: OSErr;	begin		with HermSetup^ do			begin				ByteCount := SizeOf(HighScoreArr);				err := FSWrite(fRefNum, ByteCount, @OurArray);				parseerr(err, HermSetup);			end;	end;{-------------------------------------------------}procedure GetApprValue (var TheValue: Longint; TheChar: CharRec);	begin		with TheChar do			begin				Thevalue := FightsWon + Strength + Speed + Fame + round(FighterLvl * 1.5) + (Dexterity div 2) + (TotalFights div (FightsWon + 1));			end;	end;{-------------------------------------------------}procedure wln (TheString: str255; var FNum: integer; HermSetup: UserXIPtr);	var		ByteCount: longint;		fRefNum: integer;		err: OSErr;	begin		with HermSetup^ do			begin				TheString := concat(TheString, chr(13), chr(10));				ByteCount := Length(TheString);				err := FSWrite(FNum, ByteCount, @TheString[1]);				parseerr(err, HermSetup);			end;	end;{-------------------------------------------------}function AddChar2List (TheChar: CharRec; var HermSetup: UserXIPtr): Boolean;	var		SlyPlayers: PlayersRec;		fRefNum: integer;		DupFound: boolean;		Size: longint;	begin		with HermSetup^ do			begin				DupFound := false;				if not FExist(concat(filesPath^, SlyDataPath, 'PlayerList'), procs[vFExist]) then					FCreate(concat(filesPath^, SlyDataPath, 'PlayerList'), DataType, HermSetup);				FOpen(concat(filesPath^, SlyDataPath, 'PlayerList'), fRefNum, HermSetup);				while (not MyEOF(fRefNum, HermSetup)) and (not (DupFound)) do					begin						Size := SizeOf(playersRec);						parseerr(FSRead(fRefNum, Size, @SlyPlayers), HermSetup);						if (SlyPlayers.SlyName = TheChar.Name) and (SlyPlayers.BBSName <> n[CurNode^]^.ThisUser.UserName) then							begin								Outline(concat('Error, the name "', TheChar.Name, '" Is Already Used, please Choose Another.'), True, 6, procs[vOutline]);								bCr(procs[vbCr]);								DupFound := True;							end;					end;				SlyPlayers.BBSName := n[curNode^]^.ThisUser.UserName;				SlyPlayers.SlyName := TheChar.Name;				SlyPlayers.Class := TheChar.CharClass;				SlyPlayers.Alive := true;				SlyPlayers.LastPlayed := TheDate;				GetApprValue(SlyPlayers.ApprVal, TheChar);				if not DupFound then					begin						Size := SizeOf(playersRec);						parseerr(FSWrite(fRefNum, Size, @SlyPlayers), HermSetup);						AddChar2List := true;					end				else					AddChar2List := false;				FClose(fRefNum, HermSetup);			end;	end;{-------------------------------------------------}procedure WriteNewsToPlayer (TheString: Str255; ThePlayer: CharRec; OpponentFName: str255; WriteMail: boolean; HermSetup: userXIPtr);	var		boo1: boolean;		st1, FName: str255;		long1: longint;		StrDate: str255;		err: OSErr;		TempUser: UserRec;		FNum: integer;	begin		with HermSetup^ do			begin				FName := concat(filespath^, MailPath, OpponentFName, '--News');				NumToString(TheDate, st1);				StrDate := concat(st1[5], st1[6], '-', st1[7], st1[8], '-', st1[3], st1[4]);				with HermSetup^ do					begin						err := Create(FName, vRefNum, HermesType, 'TEXT');						if not FExist(FName, procs[vFExist]) then							outline('You have bugs!!! (file not found)', true, 6, procs[vOutline]);						FOpen(FName, FNum, HermSetup);						ParseErr(SetFPos(FNum, FSFromLEOF, 0), HermSetup);						if err = 0 then							wln('   ', FNum, HermSetup);						wln('-=-=-=-=-=-=-=-=-=-=-', FNum, HermSetup);						wln(concat('     ', StrDate, ':'), FNum, HermSetup);						wln(TheString, FNum, HermSetup);						wln('   ', FNum, HermSetup);						FClose(FNum, HermSetup);{BBS E-Mail}						if WriteMail then							begin								boo1 := FindUser(OpponentFName, TempUser, procs[vFindUser]);								n[curNode^]^.CurEmailRec.Title := ThePlayer.Name;									{the title of the message}								n[curNode^]^.CurEmailRec.FromUser := n[CurNode^]^.ThisUser.UserNum;												{what user number this is from}								n[curNode^]^.CurEmailRec.ToUser := TempUser.UserNum;							{what number user you want to send to}								n[curNode^]^.CurEmailRec.AnonyFrom := False;											{if you want the message to be anonymous FROM}								n[curNode^]^.CurEmailRec.AnonyTo := False;												{If you want the message to be anonymous TO}								GetDateTime(n[curNode^]^.CurEmailRec.DateSent);									{Getting the exact time and date the email is being sent}								n[curNode^]^.CurEmailRec.MType := 1;														{MType = 1, normal mail, other MType's are 0 which would be a notification (someone downloaded, etc)}								n[curNode^]^.CurEmailRec.MultiMail := False;											{If this was multimail, it would be true, right?  Yes.}								n[curNode^]^.CurWriting := nil;								n[curNode^]^.curWriting := TextHand(NewHandle(0));								n[curNode^]^.CurEmailRec.FileAttached := false;											{there's NOT a file here...}								n[curNode^]^.CurEmailRec.Hasread := false;												{Has not ben read yet.}{n[curNode^]^.CurEmailRec.StoredAs := 0;     												???}								AddLine(TheString, procs[vAddLine]);  {The char(3)'s are for color, following is the color #}								AddLine('', procs[vAddLine]);								AddLine('Slycrel note:', procs[vAddLine]);								n[curNode^]^.curWriting^^[GetHandleSize(handle(n[curNode^]^.curWriting)) - 1] := char(26);								if not SaveMessAsEmail(procs[vSaveMessAsEMail]) then												{with the new procedures, save the email immediately, if there is an error, it will report it}									OutLineC('Error: Email database full.', true, 6, procs[vOutLineC])								else									begin										OutLineC('Email Sent.', true, 1, procs[vOutlineC]);										bcr(procs[vbCr]);									end;							end; {writeMail}					end;			end;	end;{-------------------------------------------------}procedure FWritePlayer2List (UserName: str255; TheUser: CharRec; HermSetup: UserXIPtr);	var		Players: PlayersRec;		fRefNum: integer;		byteCount: longint;		found, AddChar: boolean;	begin		with HermSetup^ do			begin				found := false;				ByteCount := SizeOf(PlayersRec);				if not FExist(concat(filesPath^, SlyDataPath, 'PlayerList'), procs[vFExist]) then					FCreate(concat(filesPath^, SlyDataPath, 'PlayerList'), DataType, HermSetup);				FOpen(concat(filesPath^, SlyDataPath, 'PlayerList'), fRefNum, HermSetup);				while not ((Found) or (MyEOF(fRefNum, Hermsetup))) do					begin						parseerr(FSRead(fRefNum, ByteCount, @Players), Hermsetup);						if (players.BBSName = n[CurNode^]^.ThisUser.UserName) then							Found := true;					end;				if found then					begin						Players.SlyName := TheUser.Name;						Players.Class := TheUser.CharClass;						Players.Alive := TheUser.Alive;						Players.LastPlayed := TheUser.Laston;						GetApprValue(Players.ApprVal, TheUser);						ParseErr(SetFPos(fRefNum, FSFromMark, -ByteCount), HermSetup);						parseerr(FSWrite(fRefNum, ByteCount, @Players), HermSetup);						FClose(fRefNum, HermSetup);					end				else					begin						FClose(fRefNum, HermSetup);						AddChar := AddChar2List(TheUser, HermSetup);					end;			end;	end;{-------------------------------------------------}function FindPlayer (Player: str255; var FoundName: str255; HermSetup: UserXIPtr): Boolean;	var		fRefNum: integer;		ByteCount: longint;		Players: PlayersRec;		Found: boolean;	begin		with HermSetup^ do			begin				Found := False;				FOpen(concat(filesPath^, SlyDataPath, 'PlayerList'), fRefNum, HermSetup);				ByteCount := SizeOf(PlayersRec);				while (not Found) and (not MyEOF(fRefNum, Hermsetup)) do					begin						parseerr(FSRead(fRefNum, ByteCount, @Players), Hermsetup);						if uCase(Players.SlyName) = uCase(Player) then							Found := true;					end;				if Found then					begin						FoundName := Players.BBSName;						FindPlayer := True;					end				else					FindPlayer := False;				FClose(fRefNum, HermSetup);			end;	end;{-------------------------------------------------}procedure SaveChar (FileName: str255; TheChar: CharRec; HermSetup: UserXIPtr);	var		st1: str255;		FRefNum: integer;	begin		with HermSetup^ do			begin				if not FExist(concat(FilesPath^, UserPath, fileName), procs[vFExist]) then					FCreate(concat(FilesPath^, UserPath, FileName), DataType, HermSetup);				Privates^^.char^^.LastOn := TheDate;				FOpen(concat(FilesPath^, UserPath, fileName), FRefNum, HermSetup);				FWriteChar(TheChar, FRefNum, HermSetup);				FClose(FRefNum, HermSetup);				FWritePlayer2List(FileName, TheChar, HermSetup);			end;	end;{-------------------------------------------------}procedure ReadChar (FileName: str255; var TheChar: CharRec; var Hermsetup: UserXIPtr);	var		st1: str255;		FRefNum: integer;	begin		with HermSetup^ do			begin				if FExist(concat(FilesPath^, UserPath, FileName), procs[vFExist]) then					begin						FOpen(concat(FilesPath^, UserPath, FileName), FRefNum, HermSetup);						FReadChar(TheChar, FRefNum, HermSetup);						FClose(FRefNum, HermSetup);					end				else					Outline('Error in Reading Character File!', true, 6, procs[vOutline]);			end;	end;{-------------------------------------------------}procedure ViewGuildLists (HermSetup: UserXIPtr);	var		temparr: HighScoreArr;		TempStats: HighScoreType;		x, y: integer;		long1: longint;		found: boolean;		st1: str255;		fRefNum: integer;	begin		with HermSetup^ do			begin				found := false;				if not FExist(concat(filespath^, SlyDataPath, 'High_data'), procs[vFExist]) then					begin						FCreate(concat(filespath^, SlyDataPath, 'High_data'), DataType, HermSetup);						FOpen(concat(filespath^, SlyDataPath, 'High_data'), fRefNum, HermSetup);						for x := 1 to 11 do							begin								TempArr[x].Name := '>>>>> None <<<<<';								Temparr[x].LastDate := RealDate(TheDate);								TempArr[x].Value := 0;							end;						FWriteScores(fRefNum, TempArr, HermSetup);						FClose(fRefNum, Hermsetup);					end;				FOpen(concat(filespath^, SlyDataPath, 'High_data'), fRefNum, HermSetup);				FReadScores(fRefNum, TempArr, HermSetup);				FClose(fRefNum, Hermsetup);				with Privates^^.char^^ do					long1 := TotalExperience + ((ThiefLvl + MageLvl + FighterLvl) * 100) + CoinsHand + CoinsBank + abs(Fame * 100) + abs(Honor * 100) + abs(faith * 100) + abs((flirt1 + flirt2) * 100);				if (Privates^^.char^^.Name <> '') then					begin						for x := 1 to 11 do							if TempArr[x].Name = Privates^^.char^^.Name then								begin									TempArr[x].Value := long1;									TempArr[x].LastDate := RealDate(TheDate);									Found := true;								end;						if not found then							begin								TempArr[11].Name := Privates^^.char^^.Name;								TempArr[11].LastDate := RealDate(TheDate);								TempArr[11].Value := long1;							end;					end; {end if no name}				for x := 1 to 11 do					for y := 1 to 10 do						if TempArr[y].Value < TempArr[y + 1].value then							begin								TempStats := TempArr[y];								TempArr[y] := TempArr[y + 1];								TempArr[y + 1] := TempStats;							end;				Outline('##  Name:                           Score:                    Last On:', true, 0, procs[vOutline]);				Outline('-=-.-=-.-=-.-=-.-=-.-=-.-=-.-=-.-=-.-=-.-=-.-=-.-=-.-=-.-=-.-=-.-=-.-=-.-=-.-=-', true, 5, procs[vOutline]);				for x := 1 to 11 do					begin						BufferbCr(procs[vBufferbCr]);						NumToString(x, st1);						for y := length(st1) to 4 do							st1 := concat(st1, ' ');						BufferIt(st1, false, 0, procs[vBufferIt]);						st1 := TempArr[x].Name;						for y := length(st1) to 32 do							st1 := concat(st1, ' ');						BufferIt(st1, false, 6, procs[vBufferIt]);						NumToString(TempArr[x].Value, st1);						for y := length(st1) to 25 do							st1 := concat(st1, ' ');						BufferIt(st1, false, 2, procs[vBufferIt]);						BufferIt(TempArr[x].LastDate, false, 3, procs[vBufferIt]);					end;				ReleaseBuffer(procs[vReleaseBuffer]);				FOpen(concat(filespath^, SlyDataPath, 'High_data'), fRefNum, HermSetup);				FWriteScores(fRefNum, TempArr, HermSetup);				FClose(fRefNum, HermSetup);				bCr(procs[vbCr]);				n[curNode^]^.BoardAction := None;				myPausePrompt('-=Press A Key=-', HermSetup);			end;	end;{-------------------------------------------------}procedure PrintCharStats (TheStats: CharRec; var HermSetup: UserXIPtr);{ Adds the Character Sheet to }{ the Buffer then RELEASES it}	var		C1, C2, C3, tempstr, st2: str255;		x, int1, ColorNum: integer;	begin		with HermSetup^ do			begin				ColorNum := rnd(31, 37, HermSetup);				NumToString(ColorNum, C1);				C1 := concat(C1, 'm');				ColorNum := rnd(31, 37, HermSetup);				NumToString(ColorNum, C2);				C2 := Concat(C2, 'm');				ColorNum := rnd(31, 37, HermSetup);				NumToString(ColorNum, C3);				C3 := Concat(C3, 'm');				ANSICode('2J', procs[vANSICode]);				ANSICode('H', procs[vANSICode]);				BufferANSI('1;28H', false, HermSetup);				BufferANSI(concat(C2, 'ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ'), false, HermSetup);				BufferANSI('1;32H', false, HermSetup);				BufferANSI(concat(C1, 'Character'), false, HermSetup);				BufferANSI('1;43H', false, HermSetup);				BufferANSI(concat(C1, 'Info'), false, HermSetup);				BufferANSI(C1, false, HermSetup);				BufferANSI('2HName', false, HermSetup);				BufferANSI('2;40HClass', false, HermSetup);				BufferANSI('3;5HHitPoints', false, HermSetup);				BufferANSI('3;45HLevel', false, HermSetup);				BufferANSI('4;5HExploration', false, HermSetup);				BufferANSI('4;45HWon / Total', false, HermSetup);				BufferANSI('5;5HSpars', false, HermSetup);				BufferANSI('5;45HAmmo', false, HermSetup);				BufferANSI('6;5HDexterity', false, HermSetup);				BufferANSI('6;45HPsyche', false, HermSetup);				BufferANSI('7;5HStrength', false, HermSetup);				BufferANSI('7;45HSpeed', false, HermSetup);				BufferANSI('8;5HCoins Hand', false, HermSetup);				BufferANSI('8;45HCoins Bank', false, HermSetup);				BufferANSI('9;5HGender', false, hermsetup);				BufferANSI(C3, false, HermSetup);				BufferANSI('2;5H-', false, HermSetup);				BufferANSI('2;45H-', false, HermSetup);				for X := 3 to 9 do					begin						NumToString(x, tempstr);						BufferANSI(concat(tempStr, ';17H', ':'), false, HermSetup);						BufferANSI(concat(tempStr, ';57H', ':'), false, HermSetup);					end;				BufferANSI('2;7H', false, HermSetup);				BufferANSI(concat('1;36m', TheStats.Name), false, HermSetup);				BufferANSI('0;37m', false, HermSetup);				BufferANSI('2;47H', false, HermSetup);				BufferANSI(concat('1;36m', TheStats.CharClass), false, HermSetup);				BufferANSI('0;37m', false, HermSetup);				BufferANSI(C2, false, HermSetup);				NumtoString(TheStats.HitPoints, TempStr);				BufferANSI(concat('3;18H', TempStr), false, HermSetup);				BufferANSI(C3, false, HermSetup);				BufferANSI('s/', false, HermSetup);				NumtoString(TheStats.MaxHP, TempStr);				BufferANSI(concat(C2, TempStr), false, HermSetup);				TempStr := 'No Level';				BufferANSI(concat('3;58H', TempStr), false, HermSetup);				NumToString(TheStats.Exploration, TempStr);				BufferANSI(concat('4;18H', TempStr), false, HermSetup);				NumToString(TheStats.FightsWon, TempStr);				NumToString(TheStats.TotalFights - TheStats.FightsWon, st2);				TempStr := concat(TempStr, '/', st2);				BufferANSI(concat('4;58H', TempStr), false, HermSetup);				int1 := round((TheStats.FightsWon / (TheStats.TotalFights - TheStats.FightsWon)) * 100);				NumtoString(int1, TempStr);				BufferANSI(concat('4;64H', '(', TempStr, '%)'), false, HermSetup);				NumToString(TheStats.Spars, TempStr);				BufferANSI(concat('5;18H', TempStr), false, HermSetup);				NumToString(TheStats.Ammo, TempStr);				BufferANSI(concat('5;58H', TempStr), false, HermSetup);				BufferANSI(concat('6;18H', convertStats(TheStats.Dexterity, HermSetup)), false, HermSetup);				BufferANSI(concat('6;58H', convertStats(TheStats.Psyche, HermSetup)), false, HermSetup);				BufferANSI(concat('7;18H', convertStats(TheStats.Strength, HermSetup)), false, HermSetup);				BufferANSI(concat('7;58H', convertStats(TheStats.Speed, HermSetup)), false, HermSetup);				NumtoString(TheStats.CoinsHand, TempStr);				BufferANSI(concat('8;18H', TempStr), false, HermSetup);				NumtoString(TheStats.CoinsBank, TempStr);				BufferANSI(concat('8;58H', TempStr), false, HermSetup);				if TheStats.Gender then					TempStr := 'Male'				else					TempStr := 'Female';				BufferANSI(concat('9;18H', TempStr), false, Hermsetup);				ReleaseBuffer(procs[vReleaseBuffer]);			end;	end;{-------------------------------------------------}function Arena_Appraisal (TheChar: CharRec): integer;	begin		with TheChar do			Arena_appraisal := strength + speed + totalexperience + HitPoints + dexterity + weapons[1].Strike + weapons[2].strike + Armor[1].defense + Armor[2].defense;	end;{-------------------------------------------------}function PlayerInInn (PlayerName: str255; HermSetup: UserXIPtr): boolean;	var		fRefNum: integer;		InnData: InnRec;		x: integer;		found: boolean;		byteCount: longint;	begin		with HermSetup^ do			begin				FOpen(concat(filesPath^, SlyDataPath, 'InnData'), fRefNum, HermSetup);				ByteCount := SizeOf(InnRec);				parseErr(FSRead(fRefNum, ByteCount, @InnData), HermSetup);				FClose(fRefNum, HermSetup);				found := false;				x := 0;				while (x < 10) and (not found) do					begin						x := x + 1;						if uCase(InnData.Rooms[x].Who) = uCase(PlayerName) then							found := true;					end;				PlayerInInn := found;			end;	end;{-------------------------------------------------}procedure InnUpkeep (HermSetup: UserXIPtr);	var		fRefNum: integer;		InnData: InnRec;		x: integer;		found: boolean;		byteCount: longint;		err: OSErr;	begin		with InnData do		{initilize our inn data}			begin				for x := 1 to 10 do					with Rooms[x] do						begin							Who := 'Empty';							DaysLeft := 0;							Lock := 255;						end;				Owner := 'NateÿMuhlestein';				CurRate := 5;				Safe := 150;				Open := true;			end;		with HermSetup^ do		{create & write inn file if not exists}			begin				if not FExist(concat(filespath^, SlyDataPath, 'InnData'), procs[vFExist]) then					begin						WriteText('Now creating a new inn file...', Prefs^^.MyWindow, HermSetup);						FCreate(concat(filespath^, SlyDataPath, 'InnData'), 'DATA', HermSetup);						WriteText('Opening the new inn file...', Prefs^^.MyWindow, HermSetup);						FOpen(concat(filesPath^, SlyDataPath, 'InnData'), fRefNum, HermSetup);						ByteCount := SizeOf(InnRec);						parseerr(FSWrite(fRefNum, ByteCount, @InnData), HermSetup);						WriteText('Closing the file...', Prefs^^.MyWindow, HermSetup);						FClose(fRefNum, HermSetup);					end;				FOpen(concat(filesPath^, SlyDataPath, 'InnData'), fRefNum, HermSetup);				ByteCount := SizeOf(InnRec);				WriteText('Re-opening the Inn file', Prefs^^.MyWindow, HermSetup);				parseErr(FSRead(fRefNum, ByteCount, @InnData), HermSetup);				for x := 1 to 10 do					begin						if InnData.Rooms[x].Who <> 'Empty' then			{one day passes}							InnData.Rooms[x].DaysLeft := InnData.Rooms[x].DaysLeft - 1						else if InnData.Rooms[x].DaysLeft < 1 then			{kick user out of inn}							begin								InnData.Rooms[x].DaysLeft := 0;								InnData.Rooms[x].Who := 'Empty';								InnData.Rooms[x].Lock := 0;							end					end;			end;		ByteCount := SizeOf(InnRec);		with HermSetup^ do			WriteText('Just ByteCounted & will close...', Prefs^^.MyWindow, HermSetup);		parseerr(FSWrite(fRefNum, ByteCount, @InnData), HermSetup);		FClose(fRefNum, HermSetup);		with HermSetup^ do			WriteText('File is now closed...', Prefs^^.MyWindow, HermSetup);	end;{-------------------------------------------------}function SetupWindow: windowPtr;	var		r: rect;		oldPort: GrafPtr;	begin		GetPort(oldPort);		SetRect(r, 0, 350, 640, 480);		SetupWindow := NewWindow(nil, r, 'Debugger Window!', true, DocumentProc, nil, false, 0);		SetPort(oldPort);	end;{-------------------------------------------------}procedure WriteText (ToWrite: str255; var TheWindow: WindowPtr; var HermSetup: UserXIPtr);	var		oldPort: GrafPtr;		rgn: rgnHandle;		OurFontInfo: FontInfo;		LineHeight, descent, fontNum: integer;	begin{$IFC DEBUG_LEVEL = 2}		if theWindow = nil then			TheWindow := SetupWindow		else			begin				GetPort(oldPort);				SetPort(TheWindow);{    GetFNum('IBM', fontNum);}				TextFont(courier);				TextSize(10);				GetFontInfo(OurFontInfo);				LineHeight := OurFontInfo.ascent + OurFontInfo.descent + OurFontInfo.leading;				Descent := OurFontInfo.descent;				rgn := newRgn;				ScrollRect(TheWindow^.portRect, 0, -LineHeight, rgn);				EraseRgn(rgn);				DisposeRgn(rgn);				MoveTo(5, TheWindow^.portRect.bottom - descent);				DrawString(ToWrite);				SetPort(oldPort);			end;{$ENDC}{$IFC DEBUG_LEVEL = 1}		with hermsetup^ do			Outline(toWrite, true, 6, procs[vOutline]);{$ENDC}	end;{-------------------------------------------------}function CheckInn (HermSetup: UserXIPtr): boolean;	var		InnData: InnRec;		ByteCount: longint;		fRefNum: integer;	begin		with HermSetup^ do			begin				FOpen(concat(filesPath^, SlyDataPath, 'InnData'), fRefNum, HermSetup);				ByteCount := SizeOf(InnRec);				parseerr(FSRead(fRefNum, ByteCount, @InnData), HermSetup);				FClose(fRefNum, HermSetup);				if InnData.Open = true then					CheckInn := true				else					CheckInn := false;			end;	end;{-------------------------------------------------}function InnKeeperName (HermSetup: UserXIPtr): string;	var		InnData: InnRec;		ByteCount: longint;		fRefNum: integer;	begin		with HermSetup^ do			begin				FOpen(concat(filesPath^, SlyDataPath, 'InnData'), fRefNum, HermSetup);				ByteCount := SizeOf(InnRec);				parseerr(FSRead(fRefNum, ByteCount, @InnData), HermSetup);				FClose(fRefNum, HermSetup);				InnKeeperName := UCase(InnData.Owner);			end;	end;{-------------------------------------------------}end.