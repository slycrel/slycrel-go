: 												begin													privates^^.char^^.Location := TheTown;													CS(Town);												end;											otherwise												CS(201);										end;									end;{Combat}								Wilderness..148: 									begin					{ Calls the Combat resource }										if privates^^.otherCode[1]^ <> nil then											begin												CallOtherCode(HermSetup, procptr(privates^^.otherCode[1]^));											end										else											begin												Outline('Error, Not Enough Memory avbl.!!', true, 6, procs[vOutline]);												CS(ShutDown3);											end;									end;{Tavern}								Tavern..349: 									begin					{ Calls the Tavern resource... }										if privates^^.otherCode[2]^ <> nil then											begin												CallOtherCode(HermSetup, procptr(privates^^.otherCode[2]^));											end										else											begin												Outline('Error, Not Enough Memory avbl.!!', true, 6, procs[vOutline]);												CS(ShutDown3);											end;									end;{Healer}								Healer..499: 									begin					{ Calls the Healer resource... }										if privates^^.otherCode[3]^ <> nil then											begin												CallOtherCode(HermSetup, procptr(privates^^.otherCode[3]^));											end										else											begin												Outline('Error, Not Enough Memory avbl.!!', true, 6, procs[vOutline]);												CS(ShutDown3);											end;									end;{Bank}								Bank..524: 									begin					{ Calls the Bank resource... }										if privates^^.otherCode[4]^ <> nil then											begin												CallOtherCode(HermSetup, procptr(privates^^.otherCode[4]^));											end										else											begin												Outline('Error, Not Enough Memory avbl.!!', true, 6, procs[vOutline]);												CS(ShutDown3);											end;									end;{Tower}								Tower..549: 									begin					{ Calls the Bank resource... }										if privates^^.otherCode[5]^ <> nil then											begin												CallOtherCode