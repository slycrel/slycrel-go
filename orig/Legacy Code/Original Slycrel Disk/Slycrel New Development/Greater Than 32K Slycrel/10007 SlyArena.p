unit SlyArena;{Make this 'XHRM' ID = 10007, but make the file type 'rsrc' and creator 'RSED'.}{You should include your resource file in this one. (in the 'Run' menu under 'Run Options...').}interfaceuses	SlyHeaders, HermHeaders, Sly_General, Sly_ArenaUnit;procedure MAIN (HermSetup: UserXIPtr);implementationprocedure MAIN (HermSetup: UserXIPtr);	var		i, int1: integer;		long, Long1: longint;		boo1, boo2: boolean;		st1, st2: str255;		SlyPlayers: PlayersRec;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}	procedure CS (stage: integer);		begin			with HermSetup^ do				Privates^^.Stage := stage;		end;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}	procedure RS (stage: integer);		begin			with HermSetup^ do				Privates^^.ReturnStage := stage;		end;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}	begin		with HermSetup^ do			begin				case message of					ActiveExt: 						case privates^^.stage of							Arena: 								begin									privates^^.char^^.Location := TheArenaMenu;									Boo1 := ReadTextFile('Externals:Sly_Data:ANSI:ArenaMenu', 0, true, procs[vReadTextFile]);									RS(601);									CS(ListTextFile);								end;							601: 								begin									Outline('[B,C,G,L,Q,V,?]', true, 1, procs[vOutline]);									bCr(procs[vbCr]);									n[curNode^]^.curPrompt := ' ';									LettersPrompt('Your choice?  ', 'BCGLQV?', 1, true, false, true, chr(0), procs[vLettersPrompt]);									CS(602);								end;							602: 								begin									case n[CurNode^]^.CurPrompt[1] of										'B': 											begin												privates^^.char^^.Location := TheArenaMenu;												if not FExist(concat(filespath^, SlyDataPath, 'GCombat'), procs[vFExist]) then													begin														Outline('Sorry, there are no matches to bet on at this time.', true, 3, procs[vOutline]);														bCr(procs[vbCr]);														CS(601);													end												else													begin														DisplayGCombat(int1, HermSetup);														n[CurNode^]^.CurPrompt := 'enter';	{needs to be = enter, for later in the code}														NumbersPrompt('Which fight? ', '0123456789', int1, 1, procs[vNumbersPrompt]);														CS(625);													end;											end;										'C': 											begin												privates^^.char^^.Location := TheArenaMenu;												CS(605);											end;										'G': 											begin												privates^^.char^^.Location := TheArenaMenu;												CS(620);											end;										'L': 											begin												privates^^.char^^.Location := TheArenaMenu;												RS(601);												CS(615);											end;										'Q': 											begin												privates^^.char^^.Location := TheTown;												CS(Town);											end;										'?': 											begin												privates^^.char^^.Location := TheArenaMenu;												CS(Arena);											end;										'V': 											begin												privates^^.char^^.Location := TheArenaMenu;												PrintCharStats(privates^^.char^^, HermSetup);												CS(601);											end;										otherwise											CS(601);									end;  {case}								end;							605: 								begin									if privates^^.char^^.Spars < 1 then										begin											Outline('Sorry Buddy, but you''ve fought All that you can Today.', true, 2, procs[vOutline]);											CS(601);										end									else										begin											n[curNode^]^.CurPrompt := '';											LettersPrompt('Player to Challenge:', '', 27, false, false, false, chr(0), procs[vLettersPrompt]);											CS(606);										end;								end;							606: 								begin									if not FindPlayer(n[curNode^]^.curPrompt, Privates^^.TempStr, HermSetup) then										begin											Outline('Player Not Found', true, 6, procs[vOutline]);											CS(601);										end									else if not User2Monster(Privates^^.TempStr, privates^^.Monster, HermSetup) then										begin											Outline('That Player is Dead, you can''t fight him!', true, 1, procs[vOutline]);											CS(601);										end									else if PlayerInInn(n[curNode^]^.curPrompt, HermSetup) then										begin											Outline('That Player is sound asleep in the Inn, you can''t fight him!', true, 1, procs[vOutline]);											CS(601);										end									else if UCase(Privates^^.TempStr) = UCase(n[CurNode^]^.ThisUser.UserName) then										begin											Outline('You can not challenge yourself.  Fool!', true, 3, procs[vOutline]);											CS(601);										end									else										begin											privates^^.char^^.Location := TheArenaCombat;											NumToString(rnd(1, 3, HermSetup), st1);											st1 := concat('Arena-', st1);											GetTerrain(st1, Privates^^.Terrain, HermSetup);											with privates^^ do												begin													R1 := rnd(1, 12, HermSetup);													C1 := rnd(1, 48, HermSetup);													R2 := rnd(1, 12, HermSetup);													C2 := rnd(1, 48, HermSetup);													with char^^ do														Movement := rnd(speed - speed div 5, speed + speed div 5, HermSetup);												end;											Privates^^.char^^.Spars := Privates^^.char^^.Spars - 1;											privates^^.char^^.TotalFights := privates^^.char^^.TotalFights + 1;											privates^^.TextOutStr := ' ';											privates^^.TextOutLine := 0;											CS(111);	{stage 111 places User & Foe then goes into Combat}										end;								end;							610:	{User Won Arena Combat, Kills Foe}								begin									bCr(procs[vbCr]);									int1 := rnd(1, Privates^^.Monster.Coins, HermSetup);									Outline(concat('You have Defeated ', Privates^^.Monster.name, '!!'), true, 7, procs[vOutline]);									Privates^^.char^^.TotalExperience := Privates^^.char^^.TotalExperience + Privates^^.Monster.experience;									Privates^^.char^^.SpendingExperience := Privates^^.char^^.SpendingExperience + Privates^^.Monster.experience;									Privates^^.char^^.CoinsHand := Privates^^.char^^.CoinsHand + int1;									privates^^.Monster.Coins := int1;									privates^^.char^^.FightsWon := privates^^.char^^.FightsWon + 1;									bCr(procs[vbCr]);									NumToString(int1, st1);									NumToString(Privates^^.Monster.experience, st2);									bCr(procs[vbCr]);									ANSICode('1;34mYou recieve ', procs[vANSICode]);									ANSICode(concat('0;35m', st2), procs[vANSICode]);									ANSICode('1;34m Experience points.', procs[vANSICode]);									bCr(procs[vbCr]);									ANSICode('1;34mYou recieve ', procs[vANSICode]);									ANSICode(concat('0;35m', st1), procs[vANSICode]);									ANSICode('1;34m Coins.', procs[vANSICode]);									bCr(procs[vbCr]);									bCr(procs[vbCr]);									n[curNode^]^.BoardAction := None;									myPausePrompt('-=Press A Key=-', HermSetup);									WriteNewsToPlayer(concat('You have been slaughtered by ', Privates^^.Monster.Name, '!'), Privates^^.Char^^, Privates^^.TempStr, false, HermSetup);									KillFoe(privates^^.char^^.Name, privates^^.Monster, HermSetup);									CS(Arena);								end;							612:	{User Looses Arena Combat, he Dies}								begin									KillUserArena(privates^^.char^^, privates^^.Monster, HermSetup);									Outline('You''re outta life buddy...', true, 6, procs[vOutline]);									WriteNewsToPlayer(concat('You have slaughtered ', Privates^^.Monster.Name, '!'), Privates^^.Char^^, Privates^^.TempStr, false, HermSetup);									CS(ShutDown3);								end;							615: 	{Lists Slycrel Players, returns to Return Stage}								begin									n[curNode^]^.BoardAction := repeating;									parseerr(FSOpen(concat(filesPath^, SlyDataPath, 'PlayerList'), vRefNum, privates^^.TempInt), HermSetup);									CS(616);								end;							616: 								begin									if (n[curNode^]^.Aborted) or (MyEOF(privates^^.TempInt, HermSetup)) then										begin											bCr(procs[vbCr]);											if n[curNode^]^.Aborted then												Outline('-Aborted-', true, 3, procs[vOutline]);											parseerr(FSClose(privates^^.TempInt), HermSetup);											CS(privates^^.ReturnStage);										end									else										begin											long := SizeOf(PlayersRec);											parseerr(FSRead(privates^^.TempInt, long, @SlyPlayers), Hermsetup);											bCr(procs[vbCr]);											ANSICode(concat('0;36;40m', SpaceOut(SlyPlayers.SlyName, 32)), procs[vANSICode]);											numToString(SlyPlayers.ApprVal, st1);											ANSICode(concat('0;36;40m', SpaceOut(st1, 5)), procs[vANSICode]);											if SlyPlayers.Alive then												ANSICode('0;31;40mAlive      ', procs[vANSICode])											else												ANSICode('0;31;40mDead       ', procs[vANSICode]);											ANSICode(concat('[0;36;40m', RealDate(SlyPlayers.LastPlayed), '      '), procs[vANSICode]);											ANSICode(concat('0;32;40m', SlyPlayers.Class), procs[vANSICode]);										end;								end;							620: 								begin									if privates^^.char^^.Spars < 1 then										begin											Outline('Sorry Buddy, but you''ve fought All that you can Today.', true, 2, procs[vOutline]);											CS(601);										end									else										begin											n[curNode^]^.CurPrompt := '';											LettersPrompt('Player to Challenge:', '', 27, false, false, false, chr(0), procs[vLettersPrompt]);											CS(621);										end;								end;							621: 								begin									if not FindPlayer(n[curNode^]^.curPrompt, privates^^.TempStr, HermSetup) then										begin											Outline('Player Not Found', true, 6, procs[vOutline]);											CS(601);										end									else if not User2Monster(privates^^.TempStr, privates^^.Monster, HermSetup) then										begin											Outline('That Player is Dead, you can''t fight him!', true, 1, procs[vOutline]);											CS(601);										end									else if PlayerInInn(n[curNode^]^.curPrompt, HermSetup) then										begin											Outline('That Player is sound asleep in the Inn, you can''t fight him!', true, 1, procs[vOutline]);											CS(601);										end									else if UCase(st1) = UCase(n[CurNode^]^.ThisUser.UserName) then										begin											Outline('You can not challenge yourself.  Fool!', true, 3, procs[vOutline]);											CS(601);										end									else										begin											Outline('Are you sure you want to go through with this? [Y/n]', true, 2, procs[vOutline]);											YesNoQuestion('', true, procs[vYesNoQuestion]);											CS(622);										end;								end;							622: 								begin									if ucase(n[CurNode^]^.CurPrompt[1]) = 'N' then										begin											bCr(procs[vbCr]);											Outline('You regretfully decide not to go through with this.', true, 1, procs[vOutline]);											bCr(procs[vbCr]);											CS(601);										end									else										begin											privates^^.char^^.Spars := privates^^.char^^.Spars - 1;											SetUpGCombat(Privates^^.Char^^, Privates^^.TempStr, HermSetup);											Outline(concat('You have entered into the Gladiator competition against ', Privates^^.TempStr, '!'), true, 1, procs[vOutline]);											bCr(procs[vbCr]);											CS(601);										end;								end;							625: 								begin									if not (n[CurNode^]^.CurPrompt = 'enter') then										begin											StringToNum(n[CurNode^]^.CurPrompt, long1);											Privates^^.TempInt := long1;											GetFightInfo(Privates^^.PrefData, Privates^^.TempInt, hermSetup);											n[curNode^]^.curPrompt := '';											LettersPrompt('Do you wish to bet for or against the challenger (Q=Quit)?  [F,A,Q] ', 'FAQ', 1, true, false, true, chr(0), procs[vLettersPrompt]);											CS(626);										end									else										begin											Outline('Aborted', true, 3, procs[vOutline]);											CS(601);										end;								end;							626: 								begin									case n[curNode^]^.curPrompt[1] of										'F': 											begin												privates^^.TempStr := 'F';												bCr(procs[vbCr]);												NumbersPrompt('How much do you wish to bet? [1..1000] ', '1234567890', 1000, 1, procs[vNumbersPrompt]);												CS(627);											end;										'A': 											begin												privates^^.TempStr := 'A';												bCr(procs[vbCr]);												NumbersPrompt('How much do you wish to bet? [1..1000] ', '1234567890', 1000, 1, procs[vNumbersPrompt]);												CS(627);											end;										'Q': 											CS(601);										otherwise											CS(601);									end;								end;							627: 								begin									StringToNum(n[CurNode^]^.CurPrompt, long1);									st1 := Privates^^.TempStr;									if long1 > privates^^.Char^^.CoinsHand then										begin											Outline('Sorry, you don''t have enough cash.', true, 1, procs[vOutline]);											bCr(procs[vbCr]);										end									else										begin											Privates^^.Char^^.CoinsHand := Privates^^.Char^^.CoinsHand - long1;											AddGambler(Privates^^.Char^^.Name, st1[1], long1, Privates^^.TempInt, Hermsetup);											Outline('Okay, you now are in the pool!', true, 2, procs[vOutline]);											bCr(procs[vbCr]);											MyPausePrompt('-Any Key-', HermSetup);										end;									CS(601);								end;						end;  {case}				end;			end;	end;end.