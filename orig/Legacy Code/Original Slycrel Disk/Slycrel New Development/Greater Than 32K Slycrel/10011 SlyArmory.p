unit SlyWeaponsandArmor;{Make this 'XHRM' ID = 10002, but make the file type 'rsrc' and creator 'RSED'.}{You should include your resource file in this one. (in the 'Run' menu under 'Run Options...').}interfaceuses	SlyHeaders, HermHeaders, Sly_General, Sly_Weapons;procedure MAIN (HermSetup: UserXIPtr);implementationprocedure MAIN (HermSetup: UserXIPtr);	var		i, int1: integer;		long, long1, long2, ByteCount: longint;		Boo1: boolean;		st1, st2: str255;		TWeapon: WeaponRec;		TArmor: ArmorRec;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}	procedure CS (stage: integer);		begin			with HermSetup^ do				Privates^^.Stage := stage;		end;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}	procedure RS (stage: integer);		begin			with HermSetup^ do				Privates^^.ReturnStage := stage;		end;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}	begin		with HermSetup^ do			begin				case message of					ActiveExt: 						case privates^^.stage of							Armory: 								begin									privates^^.char^^.Location := TheArmory;									Boo1 := ReadTextFile('Externals:Sly_Data:ANSI:ArmoryMenu', 0, true, procs[vReadTextFile]);									RS(551);									CS(ListTextFile);								end;							551: 								begin									Outline('[A,Q,G,M,S,W,?]', true, 1, procs[vOutline]);									bCr(procs[vbCr]);									n[curNode^]^.curPrompt := ' ';									LettersPrompt('Your choice?  ', 'AGMSWQ?', 1, true, false, true, chr(0), procs[vLettersPrompt]);									CS(552);								end;							552: 								begin									case n[curNode^]^.curPrompt[1] of										'W': 											begin												Privates^^.Char^^.Location := TheArmory;												CS(554);											end;										'A': 											begin												Privates^^.Char^^.Location := TheArmory;												CS(559);											end;										'S': 											begin												Privates^^.Char^^.Location := TheArmory;												CS(565);											end;										'G': 											begin												Privates^^.Char^^.Location := TheArmory;												CS(570);											end;										'M': 											begin												bCr(procs[vbCr]);												Outline('You switch your weapons.', true, 1, procs[vOutline]);												bCr(procs[vbCr]);												TWeapon := Privates^^.Char^^.Weapons[1];												Privates^^.Char^^.Weapons[1] := Privates^^.Char^^.Weapons[2];												Privates^^.Char^^.Weapons[2] := TWeapon;												CS(551);											end;										'Q': 											begin												privates^^.char^^.Location := TheTown;												CS(Town);											end;										'?': 											begin												privates^^.char^^.Location := TheArmory;												CS(Armory);											end;										otherwise											CS(Armory);									end;{case}								end;							554: 								begin									if not FExist(concat(filesPath^, SlyDataPath, 'Weapons'), procs[vFExist]) then										begin											bCr(procs[vbCr]);											Outline('No Weapons file, creating new...  PLEASE INFORM SYSOP!!', true, 1, procs[vOutline]);											bCr(procs[vbCr]);											FCreate(concat(filesPath^, SlyDataPath, 'Weapons'), DataType, HermSetup);											with Privates^^.Char^^.Weapons[1] do												begin													Name := 'Generic Sword';													Strike := 3;													Range := 0;													Cost := 10;													Ability := 0;													Quality := 100;												end; {with}											parseErr(FSOpen(concat(filesPath^, SlyDataPath, 'Weapons'), vRefNum, privates^^.TempInt), HermSetup);											ByteCount := SizeOf(WeaponRec);											parseErr(FSWrite(privates^^.TempInt, ByteCount, @Privates^^.Char^^.Weapons[1]), HermSetup);											FClose(privates^^.TempInt, HermSetup);										end;									ParseErr(FSOpen(concat(filesPath^, SlyDataPath, 'Weapons'), vRefNum, privates^^.TempInt), HermSetup);									n[curNode^]^.BoardAction := repeating;									CS(555);								end;							555: 								begin									if (n[curNode^]^.Aborted) or (MyEOF(privates^^.TempInt, HermSetup)) then										begin											if (n[curNode^]^.Aborted) then												Outline(' - Aborted - ', true, 3, procs[vOutline]);											n[curNode^]^.Aborted := false;											ParseErr(GetEOF(privates^^.TempInt, ByteCount), HermSetup);											Privates^^.C1 := ByteCount div sizeOf(WeaponRec);											FClose(Privates^^.Tempint, HermSetup);											bCr(procs[vbCr]);											bCr(procs[vbCr]);											NumbersPrompt('Choose Your Weapon: [Q=Quit]', 'Q0123456789', privates^^.C1, 1, procs[vNumbersPrompt]);											CS(556);										end									else										DisplayWeaponList(privates^^.TempInt, Privates^^.Char^^.Coinshand, HermSetup);  {else}								end;							556: 								begin									if n[CurNode^]^.CurPrompt[1] = 'Q' then										CS(Armory)									else if n[CurNode^]^.CurPrompt = '' then										CS(554)									else										begin											stringToNum(n[curNode^]^.curPrompt, long1);											Privates^^.C1 := long1;											Outline('Do you want to buy this Weapon? [Y/n] ', true, 3, procs[vOutline]);											YesNoQuestion('', true, procs[vYesNoQuestion]);											CS(557);										end;								end;							557: 								begin									if n[CurNode^]^.CurPrompt[1] = 'Y' then										begin											NumbersPrompt('Which weapon would you like to replace? [1/2, D-isplay, Q-uit] ', '12D', 2, 1, procs[vNumbersPrompt]);										end;									CS(558);								end;							558: 								begin{Display two weapons and go back to choice}									if ucase(n[CurNode^]^.CurPrompt[1]) = 'D' then										begin											Outline(concat('Weapon 1: ', Privates^^.Char^^.Weapons[1].Name), true, 1, procs[vOutline]);											bCr(procs[vbCr]);											Outline(concat('Weapon 2: ', Privates^^.Char^^.Weapons[2].Name), true, 1, procs[vOutline]);											bCr(procs[vbCr]);											n[CurNode^]^.Curprompt := 'Y';											CS(557);										end									else if ucase(n[CurNode^]^.CurPrompt[1]) = 'Q' then										begin											bCr(procs[vbCr]);											Outline('FINE, I didn''t want your stupid weapon anyway...', true, 1, procs[vOutline]);											bCr(procs[vbCr]);										end									else										begin{Long2 is the number of weapon record that you need, either one or two}											stringToNum(n[CurNode^]^.CurPrompt, long2);											if n[CurNode^]^.CurPrompt[1] <> 'N' then												n[CurNode^]^.CurPrompt := 'Y';											long1 := Privates^^.C1;											GetWeapon(long1, TWeapon, HermSetup);											if n[CurNode^]^.CurPrompt[1] = 'Y' then												begin													if (Privates^^.Char^^.CoinsHand >= TWeapon.Cost) then														begin															GetWeapon(long1, privates^^.Char^^.Weapons[long2], HermSetup);															bCr(procs[vbCr]);															Outline(concat('Okay, you buy the spiffy ', Privates^^.Char^^.Weapons[long2].Name, '.'), true, 3, procs[vOutline]);															Privates^^.Char^^.CoinsHand := Privates^^.Char^^.CoinsHand - Privates^^.Char^^.Weapons[long2].cost;															MyPausePrompt('--More--', HermSetup);															CS(Armory);														end													else if (Privates^^.Char^^.CoinsHand < TWeapon.Cost) then														begin															bCr(procs[vbCr]);															Outline('Sorry, I''m not giving these away . Come back when you get more money . ', true, 2, procs[vOutline]);															bCr(procs[vbCr]);															MyPausePrompt('--More--', HermSetup);															CS(Armory);														end;{else if}												end											else{if they said no then}												begin													bCr(procs[vbCr]);													Outline('Okay, your loss.  Have fun dying.', true, 1, procs[vOutline]);													bCr(procs[vbCr]);													MyPausePrompt('--More--', HermSetup);													CS(Armory);												end;{else 'N'}										end;								end;							559: 								begin									if not FExist(concat(filesPath^, SlyDataPath, 'Armor'), procs[vFExist]) then										begin											bCr(procs[vbCr]);											Outline('No Armor file, creating new...  PLEASE INFORM SYSOP', true, 1, procs[vOutline]);											bCr(procs[vbCr]);											FCreate(concat(filesPath^, SlyDataPath, 'Armor'), DataType, HermSetup);											with Privates^^.Char^^.Armor[1] do												begin													Name := 'Generic Armor';													Defense := 25;													Class := 0;													Cost := 10;													Ability := 0;													Quality := 100;												end; {with}											parseErr(FSOpen(concat(filesPath^, SlyDataPath, 'Armor'), vRefNum, privates^^.TempInt), HermSetup);											ByteCount := SizeOf(ArmorRec);											parseErr(FSWrite(privates^^.TempInt, ByteCount, @Privates^^.Char^^.Armor[1]), HermSetup);											FClose(privates^^.TempInt, HermSetup);										end;									ParseErr(FSOpen(concat(filesPath^, SlyDataPath, 'Armor'), vRefNum, privates^^.TempInt), HermSetup);									n[curNode^]^.BoardAction := repeating;									CS(560);								end;							560: 								begin									if (n[curNode^]^.Aborted) or (MyEOF(privates^^.TempInt, HermSetup)) then										begin											if (n[curNode^]^.Aborted) then												Outline(' - Aborted - ', true, 3, procs[vOutline]);											n[curNode^]^.Aborted := false;											ParseErr(GetEOF(privates^^.TempInt, ByteCount), HermSetup);											Privates^^.C1 := ByteCount div sizeOf(ArmorRec);											FClose(Privates^^.Tempint, HermSetup);											bCr(procs[vbCr]);											bCr(procs[vbCr]);											NumbersPrompt('Choose Your Armor: [Q=Quit]', 'Q0123456789', privates^^.C1, 1, procs[vNumbersPrompt]);											CS(561);										end									else										DisplayArmorList(privates^^.TempInt, Privates^^.Char^^.Coinshand, HermSetup);  {else}								end;							561: 								begin									if n[CurNode^]^.CurPrompt[1] = 'Q' then										CS(Armory)									else if n[CurNode^]^.CurPrompt = '' then										CS(559)									else										begin											stringToNum(n[curNode^]^.curPrompt, long1);											Privates^^.C1 := long1;											Outline('Do you want to buy this Armor? [Y/n] ', true, 3, procs[vOutline]);											YesNoQuestion('', true, procs[vYesNoQuestion]);											CS(562);										end;								end;							562: 								begin									long1 := Privates^^.C1;									GetArmor(long1, TArmor, HermSetup);									if (n[CurNode^]^.CurPrompt[1] = 'Y') then										begin											if (Privates^^.Char^^.CoinsHand >= TArmor.Cost) then												begin													GetArmor(long1, privates^^.Char^^.Armor[1], HermSetup);													bCr(procs[vbCr]);													Outline(concat('Okay, you buy the spiffy ', Privates^^.Char^^.Armor[1].Name, '.'), true, 3, procs[vOutline]);													Privates^^.Char^^.CoinsHand := Privates^^.Char^^.CoinsHand - Privates^^.Char^^.Armor[1].cost;													CS(Armory);												end											else if (Privates^^.Char^^.CoinsHand < TArmor.Cost) then												begin													bCr(procs[vbCr]);													Outline('Sorry, I''m not giving these away . Come back when you get more money . ', true, 2, procs[vOutline]);													bCr(procs[vbCr]);													CS(Armory);												end;{else if}										end{if 'Y' then}									else{if they said no then}										begin											bCr(procs[vbCr]);											Outline('Okay, your loss.  Have fun dying.', true, 1, procs[vOutline]);											bCr(procs[vbCr]);											CS(Armory);										end;{else 'N'}								end;							565: 								begin									bCr(procs[vbCr]);									int1 := Privates^^.Char^^.Weapons[1].Cost div 2;									NumToString(int1, st2);									st1 := Privates^^.Char^^.Weapons[1].Name;									Outline(Concat('Sell your ', st1, ' for ', st2, ' coins? [Y/n] '), true, 2, procs[vOutline]);									YesNoQuestion('', true, procs[vYesNoQuestion]);									CS(566);								end;							566: 								begin									if n[CurNode^]^.CurPrompt[1] = 'Y' then										if Privates^^.Char^^.weapons[1].name = 'Hands' then											begin												bCr(procs[vbCr]);												Outline('You can''t sell your hands.  Idiot...', true, 6, procs[vOutline]);												bCr(procs[vbCr]);												MyPausePrompt('-More-', HermSetup);											end										else if Privates^^.Char^^.weapons[1].Cost <= 0 then											begin												bCr(procs[vbCr]);												Outline('Sorry, I don''t buy junk.', true, 6, procs[vOutline]);												bCr(procs[vbCr]);												MyPausePrompt('-More-', HermSetup);											end										else											begin												bCr(procs[vbCr]);												Outline('Okay, thanks.  Come back anytime.', true, 1, procs[vOutline]);												bCr(procs[vbCr]);												MyPausePrompt('-More-', HermSetup);												int1 := Privates^^.Char^^.Weapons[1].Cost div 2;												Privates^^.Char^^.CoinsHand := Privates^^.Char^^.CoinsHand + int1;												with Privates^^.Char^^.Weapons[1] do													begin														Name := 'Hands';														Strike := 1;														Range := 0;														Cost := 0;														Ability := 0;														Quality := 0;													end; {with}												CS(Armory);											end {if 'Y' then}									else										begin											bCr(procs[vbCr]);											Outline('Okay, you jerk, I didn''t want it anyway.', true, 3, procs[vOutline]);											bCr(procs[vbCr]);											MyPausePrompt('-More-', HermSetup);											CS(Armory);										end;{if 'N' then}								end;							570: 								begin									bCr(procs[vbCr]);									int1 := Privates^^.Char^^.Armor[1].Cost div 2;									NumToString(int1, st2);									st1 := Privates^^.Char^^.Armor[1].Name;									Outline(Concat('Sell your ', st1, ' for ', st2, ' coins? [Y/n] '), true, 2, procs[vOutline]);									YesNoQuestion('', true, procs[vYesNoQuestion]);									CS(571);								end;							571: 								begin									if n[CurNode^]^.CurPrompt[1] = 'Y' then										begin											bCr(procs[vbCr]);											Outline('Okay, thanks.  Come back anytime.', true, 1, procs[vOutline]);											bCr(procs[vbCr]);											MyPausePrompt('-More-', HermSetup);											int1 := Privates^^.Char^^.Armor[1].Cost div 2;											Privates^^.Char^^.CoinsHand := Privates^^.Char^^.CoinsHand + int1;											with Privates^^.Char^^.Armor[1] do												begin													Name := 'Hands';													Defense := 1;													Class := 0;													Cost := 0;													Ability := 0;													Quality := 0;												end; {with}											CS(Armory);										end {if 'Y' then}									else										begin											bCr(procs[vbCr]);											Outline('Okay, you jerk, I didn''t want it anyway.', true, 3, procs[vOutline]);											bCr(procs[vbCr]);											MyPausePrompt('-More-', HermSetup);											CS(Armory);										end;{if 'N' then}								end;						end;  {case}				end;			end;	end;end.