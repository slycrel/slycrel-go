unit SlyTextCombat;{Make this 'XHRM' ID = 10008, but make the file type 'rsrc' and creator 'RSED'.}{You should include your resource file in this one. (in the 'Run' menu under 'Run Options...').}interfaceuses	SlyHeaders, HermHeaders, Sly_General, SlyTextCombatUnit;procedure MAIN (HermSetup: UserXIPtr);implementationprocedure MAIN (HermSetup: UserXIPtr);	var		i, x: integer;		long: longint;		damage, int1, int2: integer;		Boo1: boolean;		st1, st2: str255;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}	procedure CS (stage: integer);		begin			with HermSetup^ do				Privates^^.Stage := stage;		end;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}	procedure RS (stage: integer);		begin			with HermSetup^ do				Privates^^.ReturnStage := stage;		end;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}	begin		with HermSetup^ do			begin				case privates^^.stage of					SetupTextCombat: 						begin							ANSICode('2J', procs[vANSICode]);							ANSICode('H', procs[vANSICode]);							bCr(procs[vbCr]);{init user/monster attack stage values}							with Privates^^ do								begin									C1 := Char^^.speed div 10;							{User's attack loop val}									if C1 <= 0 then										C1 := 1;									R1 := Monster.Movement div 10;				{Monster's attack loop val}									if R1 <= 0 then										R1 := 1;									R2 := tempint;  											{monster's max HP}									Tempint := 15;           								     			{this is our loop value}									Hit := _None;                												{Who hit who when, etc.  ;-) }									Move := Attack;									MMove := Attack;								end;{initiative roll}							boo1 := RollInitiative(HermSetup);							InitiativeText(boo1, HermSetup);							CS(TextCombatLoop);						end;					TextCombatLoop: { -- Prompts User for his/her next action }						begin							with Privates^^ do								begin									if Char^^.HitPoints <= 0 then										CS(170)									else if Monster.HitPoints <= 0 then										CS(175)									else if Hit = UserRan then										CS(180)									else if Hit = OpponentRan then										CS(185)									else if (C1 >= tempint) and (Hit = _None) then										CS(UserAttackStage)									else if (R1 >= TempInt) and ((Hit <> Opponent) and (Hit <> OpponentOnly) and (Hit <> Both) and (Hit <> Neither) and (Hit <> UserOnly) and (Hit <> OpponentRan)) then										CS(OpponentAttackStage)									else										begin											Tempint := Tempint - 1;											Privates^^.Hit := _None;										end;									if Tempint <= 0 then										Tempint := 27;								end;						end;  {CombatLoop}					UserAttackStage: 						begin							bCr(procs[vbCr]);							with Privates^^ do								GetMainCombatText(Char^^.HitPoints, Char^^.MaxHP, Monster.HitPoints, R2, HermSetup);							bCr(procs[vbCr]);							LettersPrompt('A]ttack, B]lock, P]arry, D]odge, S]pecial, R]un -- ', 'ABPDSR', 1, true, false, true, chr(0), procs[vLettersPrompt]);							CS(156);						end;					156: 						begin{Calculates The # of advance moves}							boo1 := true;							int1 := 0;							int2 := Privates^^.Tempint;							while boo1 do								begin									int2 := int2 - 1;									if (Privates^^.C1 >= int2) and (Privates^^.R1 < int2) then										int1 := int1 + 1									else if (((Privates^^.C1 >= int2) and (Privates^^.R1 >= int2)) or ((Privates^^.C1 < int2) and (Privates^^.R1 >= int2))) then										boo1 := false;								end;							CalcUserMove(n[CurNode^]^.CurPrompt[1], int2, int1, HermSetup);							CS(TextCombatLoop);						end;					OpponentAttackStage: 						begin							int1 := 0;							int2 := Privates^^.Tempint;							while boo1 do								begin									int2 := int2 - 1;									if (Privates^^.R1 >= int2) and (Privates^^.C1 < int2) then										int1 := int1 + 1									else if (((Privates^^.R1 >= int2) and (Privates^^.C1 >= int2)) or ((Privates^^.R1 < int2) and (Privates^^.C1 >= int2))) then										boo1 := false;								end;							MonsterAttacks(Privates^^.Move, int1, HermSetup);							CS(TextCombatLoop);						end;					170: 						begin							if privates^^.char^^.Location = TheArenaCombat then								begin									privates^^.char^^.Location := TheArenaMenu;									CS(612);								end							else								begin									bCr(procs[vbCr]);									Outline('Tough luck.  You''re dead, buddy . ', true, 4, procs[vOutline]);									PrintMenu('See ya in ', 'Hero''s Heaven!', ' ', '1;34;40m', '0;37;44m', true, HermSetup);									Privates^^.char^^.CoinsHand := Privates^^.char^^.CoinsHand - (Privates^^.char^^.CoinsHand div 3);									SaveChar(n[curNode^]^.ThisUser.UserName, privates^^.char^^, HermSetup);									CS(ShutDown3);								end;						end;					175:  {User Wins}						begin							if privates^^.char^^.Location = TheArenaCombat then								begin									privates^^.char^^.Location := TheArenaMenu;									CS(610);								end							else								begin									bCr(procs[vbCr]);									int1 := rnd(0, Privates^^.Monster.Coins, HermSetup);									Outline(concat('You have won the ', Privates^^.Monster.name, '!!'), true, 7, procs[vOutline]);									Privates^^.char^^.TotalExperience := Privates^^.char^^.TotalExperience + Privates^^.Monster.experience;									Privates^^.char^^.SpendingExperience := Privates^^.char^^.SpendingExperience + Privates^^.Monster.experience;									Privates^^.char^^.CoinsHand := Privates^^.char^^.CoinsHand + int1;									privates^^.char^^.FightsWon := privates^^.char^^.FightsWon + 1;									bCr(procs[vbCr]);									NumToString(int1, st1);									NumToString(Privates^^.Monster.experience, st2);									ANSICode('1;34mYou receive ', procs[vANSICode]);									ANSICode(concat('0;35m', st2), procs[vANSICode]);									ANSICode('1;34m Experience points.', procs[vANSICode]);									bCr(procs[vbCr]);									ANSICode('1;34mYou receive ', procs[vANSICode]);									ANSICode(concat('0;35m', st1), procs[vANSICode]);									ANSICode('1;34m Coins.', procs[vANSICode]);									bCr(procs[vbCr]);									bCr(procs[vbCr]);									privates^^.char^^.Location := TheWildernessMenu;									n[curNode^]^.boardaction := none;									myPausePrompt('-=Press A Key=-', HermSetup);									CS(Wilderness);								end;						end;					180: 						begin							bCr(procs[vbCr]);							Outline('You try to escape...', true, 3, procs[vOutline]);							for x := 1 to 40 do								Outline('.', false, 2, procs[vOutline]);							bCr(procs[vbCr]);							Outline('You Succeed!', true, 6, procs[vOutline]);							if privates^^.char^^.Location = TheArenaCombat then								begin									privates^^.char^^.Location := TheArenaMenu;									CS(Arena);								end							else								begin									privates^^.char^^.Location := TheWildernessMenu;									CS(Wilderness);								end;						end; {170}					185: 						begin							bCr(procs[vbCr]);							Outline('<blink blink>', true, 1, procs[vOutline]);							bCr(procs[vbCr]);							Outline('The monster ran away from you!  What a coward.', true, 1, procs[vOutline]);							bCr(procs[vbCr]);							MyPausePrompt('-More-', HermSetup);							if privates^^.char^^.Location = TheArenaCombat then								begin									privates^^.char^^.Location := TheArenaMenu;									CS(Arena);								end							else								begin									privates^^.char^^.Location := TheWildernessMenu;									CS(Wilderness);								end;						end;				end;			end;	end;end.