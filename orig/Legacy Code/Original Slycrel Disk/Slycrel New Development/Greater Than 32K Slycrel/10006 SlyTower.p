unit SlyTower;{Make this 'XHRM' ID = 10006, but make the file type 'rsrc' and creator 'RSED'.}{You should include your resource file in this one. (in the 'Run' menu under 'Run Options...').}interfaceuses	SlyHeaders, HermHeaders, Sly_General;procedure MAIN (HermSetup: UserXIPtr);implementationprocedure MAIN (HermSetup: UserXIPtr);	var		i: integer;		long: longint;		Boo1: boolean;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}	procedure CS (stage: integer);		begin			with HermSetup^ do				Privates^^.Stage := stage;		end;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}	procedure RS (stage: integer);		begin			with HermSetup^ do				Privates^^.ReturnStage := stage;		end;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}	begin		with HermSetup^ do			begin				case message of					ActiveExt: 						case privates^^.stage of							Tower: 								begin									privates^^.char^^.Location := TheTower;									Boo1 := ReadTextFile('Externals:Sly_Data:ANSI:TowerMenu', 0, true, procs[vReadTextFile]);									RS(526);									CS(ListTextFile);								end;							526: 								begin									Outline('[Q,?]', true, 1, procs[vOutline]);									bCr(procs[vbCr]);									n[curNode^]^.curPrompt := ' ';									LettersPrompt('Your choice?  ', 'Q?', 1, true, false, true, chr(0), procs[vLettersPrompt]);									CS(527);								end;							527: 								begin									case n[curNode^]^.curPrompt[1] of										'Q': 											begin												privates^^.char^^.Location := TheTown;												CS(Town);											end;										'?': 											begin												privates^^.char^^.Location := TheTower;												CS(Tower);											end;										otherwise											CS(Tower);									end;								end;						end;  {case}				end;			end;	end;end.