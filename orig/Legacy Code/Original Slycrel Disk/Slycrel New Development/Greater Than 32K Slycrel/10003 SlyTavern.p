unit Sly_Inn;{Make this 'XHRM' ID = 10003, but make the file type 'rsrc' and creator 'RSED'.}{You should include your resource file in this one. (in the 'Run' menu under 'Run Options...').}interfaceuses	SlyHeaders, HermHeaders, Sly_General, Sly_TavernUnit;procedure MAIN (HermSetup: UserXIPtr);implementationprocedure MAIN (HermSetup: UserXIPtr);	var		i, x, tempint: integer;		FRefNum: integer;		damage: integer;		St1, St2: str255;		ch1: char;		int1, Long1: longint;		Boo1: boolean;		err: OSerr;{------------------------------}	procedure CS (stage: integer);		begin			with HermSetup^ do				Privates^^.Stage := stage;		end;{------------------------------}	procedure RS (stage: integer);		begin			with HermSetup^ do				Privates^^.ReturnStage := stage;		end;{------------------------------}	procedure inc (var ToInc: integer; HowMuch: integer);		begin			ToInc := ToInc + HowMuch;		end;{------------------------------}	begin		with HermSetup^ do			begin				case privates^^.stage of					Tavern: 						begin							privates^^.char^^.Location := TheTavern;							boo1 := ReadTextFile(concat(FilesPath^, ANSIPath, 'TavernMenu'), 0, false, procs[vReadTextFile]);							if not Boo1 then								Outline('Error in Reading ''TavernMENU'', please inform Sysop', true, 6, procs[vOutline]);							CS(ListTextFile);							RS(301);						end;					301: 						begin							Outline('[F,H,O,Q,T,V,?]', true, 1, procs[vOutline]);							bCr(procs[vbCr]);							n[curNode^]^.CurPrompt := ' ';							LettersPrompt('Well? :', 'FHOQTV?', 1, true, false, true, chr(0), procs[vLettersPrompt]);							CS(302);						end;					302: 						begin							case n[curNode^]^.CurPrompt[1] of								'?': 									begin										privates^^.char^^.Location := TheTavern;										CS(Tavern);									end;								'F': 									begin										privates^^.char^^.Location := TheTavern;										CS(320);									end;								'H': 									begin										privates^^.char^^.Location := TheTavern;										CS(315);									end;								'O': 									begin										privates^^.char^^.Location := TheTavern;										CS(305);									end;								'Q': 									begin										privates^^.char^^.Location := TheTown;										CS(Town);									end;								'T': 									begin										privates^^.char^^.Location := TheTavern;										CS(310);									end;								'V': 									begin										privates^^.char^^.Location := TheTavern;										CS(325);									end;								otherwise									CS(301);							end;						end;					305: 						begin							bCr(procs[vbCr]);							Outline('Whaddya want?', true, 1, procs[vOutline]);							bCr(procs[vbCr]);							Outline(' 1- Fruit Juice                  0', true, 2, procs[vOutline]);							Outline(' 2- Elven Ale                    1', true, 2, procs[vOutline]);							Outline(' 3- Ale                          2', true, 2, procs[vOutline]);							Outline(' 4- Mead                         2', true, 2, procs[vOutline]);							Outline(' 5- Cocktail                     3', true, 2, procs[vOutline]);							Outline(' 6- Faery Water                  3', true, 2, procs[vOutline]);							Outline(' 7- Fine Wine                    4', true, 2, procs[vOutline]);							Outline(' 8- Whiskey                      4', true, 2, procs[vOutline]);							Outline(' 9- Ogre Sweat                   5', true, 2, procs[vOutline]);							Outline('10- Dwarf Spirits                5', true, 2, procs[vOutline]);							Outline('11- Dragon Blood                 6', true, 2, procs[vOutline]);							Outline('12- Potency                      7', true, 2, procs[vOutline]);							Outline('13- Kwick                        9', true, 2, procs[vOutline]);							Outline('14- Josepi''s Molotov Cocktail   10', true, 2, procs[vOutline]);							Outline('15- Auneletho''s Surprise        10', true, 2, procs[vOutline]);							bCr(procs[vbCr]);							bCr(procs[vbCr]);							NumToString(privates^^.char^^.CoinsHand, st1);							ANSICode(concat('1;32m$', st1), procs[vANSICode]);							ANSICode('0;36m in Hand', procs[vANSICode]);							bCr(procs[vbCr]);							Numbersprompt(' [1-15,Q]:', 'Q', 16, 1, procs[vNumbersPrompt]);							CS(307);						end;					307: 						begin							if n[curNode^]^.curPrompt[1] = 'Q' then								CS(301)							else								begin									StringToNum(n[CurNode^]^.CurPrompt, long1);									bCr(procs[vbCr]);									OrderDrink(long1, HermSetup);									bCr(procs[vbCr]);									bCr(procs[vbCr]);									if n[curNode^]^.curPrompt = '16' then										begin											SaveChar(n[curNode^]^.ThisUser.UserName, privates^^.char^^, HermSetup);											CS(ShutDown3);										end									else										CS(301);								end;						end;					310: 						begin							Outline('Sorry, Lynx doesn''t feel up to talking right now.  He''s busy', true, rnd(0, 7, HermSetup), procs[vOutline]);							Outline('playing with the barmaid...', true, rnd(0, 7, HermSetup), procs[vOutline]);							bCr(procs[vbCr]);							bCr(procs[vbCr]);							CS(301);						end;					315: 						begin							if rnd(1, 100, HermSetup) <= 50 then								begin									Outline('You lounge around the bar for a while.', true, rnd(0, 7, HermSetup), procs[vOutline]);									bCr(procs[vbCr]);									bCr(procs[vbCr]);									Outline('This is boring.  Let''s do something else.', true, rnd(0, 7, HermSetup), procs[vOutline]);									bCr(procs[vbCr]);									bCr(procs[vbCr]);									n[curNode^]^.BoardAction := none;									myPausePrompt('ZZZZZzzzzzz...', HermSetup);								end							else								begin									Outline('You lounge around the bar for a while.', true, rnd(0, 7, HermSetup), procs[vOutline]);									bCr(procs[vbCr]);									bCr(procs[vbCr]);									Outline('You nod off after a while....', true, rnd(0, 7, HermSetup), procs[vOutline]);									bCr(procs[vbCr]);									bCr(procs[vbCr]);									n[curNode^]^.BoardAction := none;									for x := 1 to 100 do										if (x mod 30 = 0) then											Outline('ZZ', true, 1, procs[vOutline])										else if (x mod 10 = 0) then											Outline('zzz', false, 1, procs[vOutline]);									bCr(procs[vbCr]);									Outline('As you wake up, your money purse feels lighter...  You must have spent more than you thought...', true, 2, procs[vOutline]);									with Privates^^.char^^ do										begin											tempint := Coinshand div rnd(10, 25, hermsetup);											CoinsHand := CoinsHand - tempint;										end;								end;							CS(301);						end;					320: 						begin							if privates^^.char^^.Flirt1 < 0 then								begin									Outline('Corenne will probably think you''re desperate, and you wouldn''t want that.', true, 3, procs[vOutline]);									CS(301);								end							else								begin									bCr(procs[vbCr]);									Outline('1] Grin Foolishly', true, 6, procs[vOutline]);									Outline('2] Kiss her hand', true, 6, procs[vOutline]);									Outline('3] Compliment and tip her', true, 6, procs[vOutline]);									Outline('4] Brag about yourself', true, 6, procs[vOutline]);									Outline('5] Wink seductively', true, 6, procs[vOutline]);									Outline('6] Compliment her', true, 6, procs[vOutline]);									Outline('7] Ask her to dance', true, 6, procs[vOutline]);									Outline('8] Share a meal', true, 6, procs[vOutline]);									bCr(procs[vbCr]);									bCr(procs[vbCr]);									NumbersPrompt('Whats it gonna be Cutie? ', '12345678', 8, 1, procs[vNumbersPrompt]);									CS(321);								end;						end;					321: 						begin							StringToNum(n[CurNode^]^.CurPrompt, int1);							bCr(procs[vbCr]);							FlirtEffects(int1, HermSetup);							privates^^.char^^.flirt1 := privates^^.char^^.Flirt1 * (-1);							CS(301);						end;					325: 						begin							ViewGuildLists(HermSetup);							CS(301);						end;				end;			end;	end;end.