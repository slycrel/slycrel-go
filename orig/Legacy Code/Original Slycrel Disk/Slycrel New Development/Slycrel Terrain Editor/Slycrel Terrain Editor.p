unit Slycrel_Terrain_Edit;interfaceuses	HermHeaders;procedure MAIN (HermSetup: UserXIPtr);implementation{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}procedure PosCursor (r, c: integer; var HermSetup: UserXIPtr);	var		Rstr, Cstr, where: str255;	begin		with HermSetup^ do			begin				numToString(r + 3, Rstr);				numToString(c + 5, Cstr);				where := concat(Rstr, ';', Cstr, 'H');				ANSICode(Where, procs[13]);			end;	end;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}procedure BufferANSI (TheANSI: string; bCrBefore: boolean; var HermSetup: UserXIPtr);	begin		with HermSetup^ do			begin				Bufferit(concat(chr(27), '[', TheANSI), bCrBefore, 0, procs[98]);			end;	end;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}function GetTerrChar (TheByte: integer): char;	begin		case theByte of			Nothing: 				GetTerrChar := NoneChar;			FlatPlainGr: 				GetTerrChar := PlainsGreenChar;			FlatPlainBr: 				GetTerrChar := PlainsBrownChar;			Water: 				GetTerrChar := WaterChar;			Bridge: 				GetTerrChar := BridgeChar;			Boulder: 				GetTerrChar := BoulderChar;			Forest: 				GetTerrChar := ForestLightChar;			DeepForest: 				GetTerrChar := ForestDeepChar;			Swamp: 				GetTerrChar := SwampLightChar;			DeepSwamp: 				GetTerrChar := SwampDeepChar;			otherwise				GetTerrChar := VoidChar;		end;	end;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}procedure DrawPoint (R, C: integer; TheTerrain: TerrainType; var HermSetup: UserXIPtr);	var		GetTerrChar: string;	begin		with HermSetup^ do			begin				case TheTerrain[r, c] of					0: 						GetTerrChar := concat('0;37;40m', ' ');					1: 						GetTerrChar := concat('0;32;40m', '∞');					2: 						GetTerrChar := concat('0;33;40m', '∞');					3: 						GetTerrChar := concat('0;34;40m', '˜');					4: 						GetTerrChar := concat('0;34;43m', '');					5: 						GetTerrChar := concat('1;30;40m', 'Ì');					6: 						GetTerrChar := concat('1;32;40m', chr(6));					7: 						GetTerrChar := concat('0;32;40m', chr(6));					8: 						GetTerrChar := concat('1;30;47m', '±');					9: 						GetTerrChar := concat('1;30;40m', '≤');					otherwise						GetTerrChar := concat('1;31;40m', 'ù');				end;				ANSICode(GetTerrChar, procs[13]);			end;	end;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}procedure UpDateX (R, C: integer; TheTerrain: TerrainType; var HermSetup: UserXIPtr);	begin		with HermSetup^ do			begin				PosCursor(0, 58, HermSetup);				DrawPoint(r, c, TheTerrain, HermSetup);			end;	end;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}procedure UpDateTT (TheByte: byte; var HermSetup: UserXIPtr);	var		GetTerrChar: string;	begin		with HermSetup^ do			begin				PosCursor(-1, 58, HermSetup);				case theByte of					0: 						GetTerrChar := concat('0;37;40m', ' ');					1: 						GetTerrChar := concat('0;32;40m', '∞');					2: 						GetTerrChar := concat('0;33;40m', '∞');					3: 						GetTerrChar := concat('0;34;40m', '˜');					4: 						GetTerrChar := concat('0;34;43m', '');					5: 						GetTerrChar := concat('1;30;40m', 'Ì');					6: 						GetTerrChar := concat('1;32;40m', chr(6));					7: 						GetTerrChar := concat('0;32;40m', chr(6));					8: 						GetTerrChar := concat('1;30;47m', '±');					9: 						GetTerrChar := concat('1;30;40m', '≤');					otherwise						GetTerrChar := concat('1;31;40m', 'ù');				end;				ANSICode(GetTerrChar, procs[13]);			end;	end;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}procedure UpDateTOn (On: boolean; var HermSetup: UserXIPtr);	begin		with HermSetup^ do			begin				if on then					begin						PosCursor(-1, 60, HermSetup);						ANSICode('1;37;41m-ON!-', procs[13]);					end				else					begin						PosCursor(-1, 60, HermSetup);						ANSICode('0;37;44m<Off>', procs[13]);					end;			end;	end;{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}procedure DrawCombatField (TheTerrain: TerrainType; var HermSetup: UserXIPtr);	var		Current, Last: integer;		R, C: integer;		st1, TheLine: str255;	begin		with HermSetup^ do			begin				for r := 1 to 12 do					begin						current := 0;						Last := 0;						TheLine := '';						NumToString(r + 3, st1);						BufferANSI(concat(st1, ';6H'), false, HermSetup);						for c := 1 to 48 do							begin								last := current;								current := TheTerrain[r, c];								if last <> current then									begin										if TheLine <> '' then											BufferANSI(TheLine, false, HermSetup);{Buffer the ANSI if the Color Changes 'cause theline w/ ansi codes exceeds 255 chars}										case TheTerrain[r, c] of											0: 												TheLine := '0;37;40m';											1: 												TheLine := '0;32;40m';											2: 												TheLine := '0;33;40m';											3: 												TheLine := '0;34;40m';											4: 												TheLine := '0;34;43m';											5: 												TheLine := '1;30;40m';											6: 												TheLine := '1;32;40m';											7: 												TheLine := '0;32;40m';											8: 												TheLine := '1;30;47m';											9: 												TheLine := '1;30;40m';										end;{ Case }									end;{ If }								TheLine := concat(TheLine, GetTerrChar(TheTerrain[r, c]));							end;{ for c }						BufferANSI(TheLine, false, HermSetup);			{Buffer ANSI at the End of the Line}					end; { for r }				ReleaseBuffer(procs[99]);			end;{ HermSetup }	end;{ procedure }{-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-}procedure DisplayMap (TheTerrain: TerrainType; var HermSetup: UserXIPtr);	var		r, c: integer;		st1, st2: str255;	begin		with HermSetup^ do			begin				ANSICode('2J', procs[13]);				ANSICode('H', procs[13]);				Outline('C  >≥123456789012345678901234567890123456789012345678≥  T.T. =', true, 0, procs[1]);				Outline('    √¡¡¡¡≈¡¡¡¡≈¡¡¡¡≈¡¡¡¡≈¡¡¡¡≈¡¡¡¡≈¡¡¡¡≈¡¡¡¡≈¡¡¡¡≈¡¡¡¥     ˙ =', true, 0, procs[1]);				Outline('R 1>≥                                                ≥', true, 0, procs[1]);				Outline('R 2>≥                                                ≥', true, 0, procs[1]);				Outline('R 3>≥                                                ≥', true, 0, procs[1]);				Outline('R 4>≥                                                ≥', true, 0, procs[1]);				Outline('R 5>≥                                                ≥', true, 0, procs[1]);				Outline('R 6>≥                                                ≥', true, 0, procs[1]);				Outline('R 7>≥                                                ≥', true, 0, procs[1]);				Outline('R 8>≥                                                ≥', true, 0, procs[1]);				Outline('R 9>≥                                                ≥', true, 0, procs[1]);				Outline('R10>≥                                                ≥', true, 0, procs[1]);				Outline('R11>≥                                                ≥', true, 0, procs[1]);				Outline('R12>≥                                                ≥', true, 0, procs[1]);				Outline('    ¿¬¬¬¬≈¬¬¬¬≈¬¬¬¬≈¬¬¬¬≈¬¬¬¬≈¬¬¬¬≈¬¬¬¬≈¬¬¬¬≈¬¬¬¬≈¬¬¬Ÿ', true, 0, procs[1]);				Outline('I,J,K,L-Move Cursor, R-Retrieve, S-Save, T-Trace, C-ClearMemory, Q-Quit', true, 1, procs[1]);				Outline(' 0-Nothing, 1-Plains,   2-Road/Trail, 3-Water,    4-Bridge', true, 3, procs[1]);				Outline(' 5-Boulder, 6-Lt.Forest 7-Drk.Forest, 8-Lt.Swamp, 9-Drk.Swamp', true, 3, procs[1]);				DrawCombatField(TheTerrain, HermSetup);			end;	end;{--=--=--=--=--=--=--=--=--=--=--=--=--}procedure parseerr (err: OSErr; var HermSetup: UserXIPtr);	{check for an error}	var		st1, st2: str255;	begin		if err <> noerr then			with HermSetup^ do				begin					numToString(err, st1);					numToString(privates^^.stage[curNode^], st2);					Outline(concat('Error #', st1, ' in stage #', st2), true, 6, procs[1]);				end;	end;{--=--=--=--=--=--=--=--=--=--=--=--=--}procedure FOpen (FileName: str255; var fRefNum: integer; var HermSetup: UserXIPtr);	var		err: OSErr;	begin		err := FSOpen(FileName, 0, fRefNum);		parseerr(err, HermSetup);	end;{--=--=--=--=--=--=--=--=--=--=--=--=--}procedure FClose (var fRefNum: integer; var HermSetup: UserXIPtr);	var		err: OSErr;	begin		err := FSClose(fRefNum);		parseerr(err, HermSetup);	end;{--=--=--=--=--=--=--=--=--=--=--=--=--}procedure FCreate (FileName: Str255; var HermSetup: UserXIPtr);	var		err: OSErr;	begin		err := Create(Filename, 0, 'HRMS', 'DATA');		parseerr(Err, HermSetup);	end;{--=--=--=--=--=--=--=--=--=--=--=--=--}procedure FReadTerrain (fRefNum: integer; var TheTerr: TerrainType; var HermSetup: UserXIPtr);	var		ByteCount: longint;		err: OSErr;	begin		with HermSetup^ do			begin				ByteCount := SizeOf(TheTerr);				err := FSRead(fRefNum, ByteCount, @TheTerr);				parseerr(err, HermSetup);			end;	end;{--=--=--=--=--=--=--=--=--=--=--=--=--}procedure FWriteTerrain (fRefNum: integer; TheTerr: TerrainType; var HermSetup: UserXIPtr);	var		ByteCount: longint;		err: OSErr;	begin		ByteCount := Sizeof(TheTerr);		err := FSWrite(fRefNum, ByteCount, @TheTerr);		parseerr(err, HermSetup);	end;{--=--=--=--=--=--=--=--=--=--=--=--=--}procedure MAIN (HermSetup: UserXIPtr);	var		i, x, y, fRefNum: integer;		st1: str255;		boo1: boolean;{--=--=--=--=--=--=--=--=--=--=--=--=--}	procedure CS (Stage: integer);		begin			with HermSetup^ do				privates^^.Stage[curNode^] := stage;		end;{--=--=--=--=--=--=--=--=--=--=--=--=--}	begin		with HermSetup^ do			begin				if message <> closeExternal then					begin						if privates = nil then  {never been called before}							begin								privates := myPrivsHand(NewHandle(SizeOf(myPrivs)));								MoveHHi(handle(privates));								HNoPurge(handle(privates));								for i := 1 to 10 do									begin										privates^^.activeOn[i] := false;										privates^^.stage[i] := 0;										for x := 1 to 12 do											for y := 1 to 48 do												privates^^.Terrain[i, x, y] := 0;										privates^^.R[i] := 1;										privates^^.C[i] := 1;										privates^^.Trace[i] := false;									end;							end;						if not privates^^.activeOn[curNode^] then							begin								privates^^.activeOn[curNode^] := true;								privates^^.stage[curNode^] := 1;							end;					end;				case message of					closeExternal: 						begin							if privates <> nil then								begin									HPurge(handle(privates));									DisposHandle(handle(privates));									privates := nil;								end;						end;					closeNode: 						begin							n[curNode^]^.ActiveUserExternal := -1;							privates^^.activeOn[curNode^] := false;							privates^^.stage[curNode^] := 0;						end;					activeExt: 						begin							if not privates^^.activeOn[curNode^] then								begin									privates^^.activeOn[curNode^] := true;									CS(1);								end;							case privates^^.stage[curNode^] of								1: 									begin										DisplayMap(privates^^.Terrain[curNode^], HermSetup);										PosCursor(privates^^.R[curNode^], privates^^.C[curNode^], HermSetup);										OutChr('˙', procs[12]);										UpDateX(privates^^.R[curNode^], privates^^.C[curNode^], privates^^.Terrain[curNode^], HermSetup);										UpDateTT(privates^^.TraceType[curNode^], HermSetup);										UpDateTOn(privates^^.Trace[curNode^], HermSetup);										CS(2);									end;								2: 									begin										n[curNode^]^.curPrompt := '';										ANSICode('21;1H', procs[13]);										NumbersPrompt('>', 'IJKLRSTCQ?0123456789', 9, 0, procs[5]);										CS(3);									end;								3: 									begin										case n[curNode^]^.CurPrompt[1] of											'I': 												begin													PosCursor(privates^^.R[curNode^], privates^^.C[curNode^], HermSetup);													DrawPoint(privates^^.R[curNode^], privates^^.C[curNode^], privates^^.Terrain[curNode^], HermSetup);													privates^^.R[CurNode^] := privates^^.R[CurNode^] - 1;													if privates^^.R[curNode^] <= 1 then														privates^^.R[curNode^] := 1;													PosCursor(privates^^.R[curNode^], privates^^.C[curNode^], HermSetup);													OutChr('˙', procs[12]);													UpDateX(privates^^.R[curNode^], privates^^.C[curNode^], privates^^.Terrain[curNode^], HermSetup);													if privates^^.Trace[curNode^] then														privates^^.Terrain[curNode^, privates^^.R[curNode^], privates^^.C[curNode^]] := privates^^.TraceType[curNode^];													CS(2);												end;											'J': 												begin													PosCursor(privates^^.R[curNode^], privates^^.C[curNode^], HermSetup);													DrawPoint(privates^^.R[curNode^], privates^^.C[curNode^], privates^^.Terrain[curNode^], HermSetup);													privates^^.C[CurNode^] := privates^^.C[CurNode^] - 1;													if privates^^.C[curNode^] <= 1 then														privates^^.C[curNode^] := 1;													PosCursor(privates^^.R[curNode^], privates^^.C[curNode^], HermSetup);													OutChr('˙', procs[12]);													UpDateX(privates^^.R[curNode^], privates^^.C[curNode^], privates^^.Terrain[curNode^], HermSetup);													if privates^^.Trace[curNode^] then														privates^^.Terrain[curNode^, privates^^.R[curNode^], privates^^.C[curNode^]] := privates^^.TraceType[curNode^];													CS(2);												end;											'K': 												begin													PosCursor(privates^^.R[curNode^], privates^^.C[curNode^], HermSetup);													DrawPoint(privates^^.R[curNode^], privates^^.C[curNode^], privates^^.Terrain[curNode^], HermSetup);													privates^^.R[CurNode^] := privates^^.R[CurNode^] + 1;													if privates^^.R[curNode^] >= 12 then														privates^^.R[curNode^] := 12;													PosCursor(privates^^.R[curNode^], privates^^.C[curNode^], HermSetup);													OutChr('˙', procs[12]);													UpDateX(privates^^.R[curNode^], privates^^.C[curNode^], privates^^.Terrain[curNode^], HermSetup);													if privates^^.Trace[curNode^] then														privates^^.Terrain[curNode^, privates^^.R[curNode^], privates^^.C[curNode^]] := privates^^.TraceType[curNode^];													CS(2);												end;											'L': 												begin													PosCursor(privates^^.R[curNode^], privates^^.C[curNode^], HermSetup);													DrawPoint(privates^^.R[curNode^], privates^^.C[curNode^], privates^^.Terrain[curNode^], HermSetup);													privates^^.C[CurNode^] := privates^^.C[CurNode^] + 1;													if privates^^.C[curNode^] >= 48 then														privates^^.C[curNode^] := 48;													PosCursor(privates^^.R[curNode^], privates^^.C[curNode^], HermSetup);													OutChr('˙', procs[12]);													UpDateX(privates^^.R[curNode^], privates^^.C[curNode^], privates^^.Terrain[curNode^], HermSetup);													if privates^^.Trace[curNode^] then														privates^^.Terrain[curNode^, privates^^.R[curNode^], privates^^.C[curNode^]] := privates^^.TraceType[curNode^];													CS(2);												end;											'0': 												begin													if privates^^.Trace[curNode^] then														begin															privates^^.TraceType[curNode^] := 0;															UpDateTT(privates^^.TraceType[curNode^], HermSetup);														end													else														begin															privates^^.Terrain[curNode^, privates^^.r[curNode^], privates^^.c[curNode^]] := 0;															UpDateX(privates^^.R[curNode^], privates^^.C[curNode^], privates^^.Terrain[curNode^], HermSetup);														end;													CS(2);												end;											'1': 												begin													if privates^^.Trace[curNode^] then														begin															privates^^.TraceType[curNode^] := 1;															UpDateTT(privates^^.TraceType[curNode^], HermSetup);														end													else														begin															privates^^.Terrain[curNode^, privates^^.r[curNode^], privates^^.c[curNode^]] := 1;															UpDateX(privates^^.R[curNode^], privates^^.C[curNode^], privates^^.Terrain[curNode^], HermSetup);														end;													CS(2);												end;											'2': 												begin													if privates^^.Trace[curNode^] then														begin															privates^^.TraceType[curNode^] := 2;															UpDateTT(privates^^.TraceType[curNode^], HermSetup);														end													else														begin															privates^^.Terrain[curNode^, privates^^.r[curNode^], privates^^.c[curNode^]] := 2;															UpDateX(privates^^.R[curNode^], privates^^.C[curNode^], privates^^.Terrain[curNode^], HermSetup);														end;													CS(2);												end;											'3': 												begin													if privates^^.Trace[curNode^] then														begin															privates^^.TraceType[curNode^] := 3;															UpDateTT(privates^^.TraceType[curNode^], HermSetup);														end													else														begin															privates^^.Terrain[curNode^, privates^^.r[curNode^], privates^^.c[curNode^]] := 3;															UpDateX(privates^^.R[curNode^], privates^^.C[curNode^], privates^^.Terrain[curNode^], HermSetup);														end;													CS(2);												end;											'4': 												begin													if privates^^.Trace[curNode^] then														begin															privates^^.TraceType[curNode^] := 4;															UpDateTT(privates^^.TraceType[curNode^], HermSetup);														end													else														begin															privates^^.Terrain[curNode^, privates^^.r[curNode^], privates^^.c[curNode^]] := 4;															UpDateX(privates^^.R[curNode^], privates^^.C[curNode^], privates^^.Terrain[curNode^], HermSetup);														end;													CS(2);												end;											'5': 												begin													if privates^^.Trace[curNode^] then														begin															privates^^.TraceType[curNode^] := 5;															UpDateTT(privates^^.TraceType[curNode^], HermSetup);														end													else														begin															privates^^.Terrain[curNode^, privates^^.r[curNode^], privates^^.c[curNode^]] := 5;															UpDateX(privates^^.R[curNode^], privates^^.C[curNode^], privates^^.Terrain[curNode^], HermSetup);														end;													CS(2);												end;											'6': 												begin													if privates^^.Trace[curNode^] then														begin															privates^^.TraceType[curNode^] := 6;															UpDateTT(privates^^.TraceType[curNode^], HermSetup);														end													else														begin															privates^^.Terrain[curNode^, privates^^.r[curNode^], privates^^.c[curNode^]] := 6;															UpDateX(privates^^.R[curNode^], privates^^.C[curNode^], privates^^.Terrain[curNode^], HermSetup);														end;													CS(2);												end;											'7': 												begin													if privates^^.Trace[curNode^] then														begin															privates^^.TraceType[curNode^] := 7;															UpDateTT(privates^^.TraceType[curNode^], HermSetup);														end													else														begin															privates^^.Terrain[curNode^, privates^^.r[curNode^], privates^^.c[curNode^]] := 7;															UpDateX(privates^^.R[curNode^], privates^^.C[curNode^], privates^^.Terrain[curNode^], HermSetup);														end;													CS(2);												end;											'8': 												begin													if privates^^.Trace[curNode^] then														begin															privates^^.TraceType[curNode^] := 8;															UpDateTT(privates^^.TraceType[curNode^], HermSetup);														end													else														begin															privates^^.Terrain[curNode^, privates^^.r[curNode^], privates^^.c[curNode^]] := 8;															UpDateX(privates^^.R[curNode^], privates^^.C[curNode^], privates^^.Terrain[curNode^], HermSetup);														end;													CS(2);												end;											'9': 												begin													if privates^^.Trace[curNode^] then														begin															privates^^.TraceType[curNode^] := 9;															UpDateTT(privates^^.TraceType[curNode^], HermSetup);														end													else														begin															privates^^.Terrain[curNode^, privates^^.r[curNode^], privates^^.c[curNode^]] := 9;															UpDateX(privates^^.R[curNode^], privates^^.C[curNode^], privates^^.Terrain[curNode^], HermSetup);														end;													CS(2);												end;											'C': 												CS(40);											'R': 												CS(30);											'S': 												CS(35);											'T': 												CS(10);											'Q': 												CS(ShutDown);											'?': 												CS(1);											otherwise												CS(2);										end;	{Prompt Case}									end;								10: 									begin										if privates^^.Trace[curNode^] then											CS(15)										else											CS(20);									end;								15: 									begin										privates^^.Trace[curNode^] := false;										UpDateTOn(false, HermSetup);										CS(2);									end;								20: 									begin										n[curNode^]^.curPrompt := '';										ANSICode('22;1H', procs[13]);										Outline('Please Choose a Terrain Type to Trace(trail) You.', false, 3, procs[1]);										bCr(procs[0]);										NumbersPrompt('>', '0123456789', 9, 0, procs[5]);										CS(21);									end;								21: 									begin										case n[curNode^]^.curPrompt[1] of											'0': 												begin													privates^^.Trace[curNode^] := True;													privates^^.TraceType[curNode^] := 0;													UpDateTT(privates^^.TraceType[curNode^], HermSetup);													UpDateTOn(true, HermSetup);													CS(2);												end;											'1': 												begin													privates^^.Trace[curNode^] := True;													privates^^.TraceType[curNode^] := 1;													UpDateTT(privates^^.TraceType[curNode^], HermSetup);													UpDateTOn(true, HermSetup);													CS(2);												end;											'2': 												begin													privates^^.Trace[curNode^] := True;													privates^^.TraceType[curNode^] := 2;													UpDateTT(privates^^.TraceType[curNode^], HermSetup);													UpDateTOn(true, HermSetup);													CS(2);												end;											'3': 												begin													privates^^.Trace[curNode^] := True;													privates^^.TraceType[curNode^] := 3;													UpDateTT(privates^^.TraceType[curNode^], HermSetup);													UpDateTOn(true, HermSetup);													CS(2);												end;											'4': 												begin													privates^^.Trace[curNode^] := True;													privates^^.TraceType[curNode^] := 4;													UpDateTT(privates^^.TraceType[curNode^], HermSetup);													UpDateTOn(true, HermSetup);													CS(2);												end;											'5': 												begin													privates^^.Trace[curNode^] := True;													privates^^.TraceType[curNode^] := 5;													UpDateTT(privates^^.TraceType[curNode^], HermSetup);													UpDateTOn(true, HermSetup);													CS(2);												end;											'6': 												begin													privates^^.Trace[curNode^] := True;													privates^^.TraceType[curNode^] := 6;													UpDateTT(privates^^.TraceType[curNode^], HermSetup);													UpDateTOn(true, HermSetup);													CS(2);												end;											'7': 												begin													privates^^.Trace[curNode^] := True;													privates^^.TraceType[curNode^] := 7;													UpDateTT(privates^^.TraceType[curNode^], HermSetup);													UpDateTOn(true, HermSetup);													CS(2);												end;											'8': 												begin													privates^^.Trace[curNode^] := True;													privates^^.TraceType[curNode^] := 8;													UpDateTT(privates^^.TraceType[curNode^], HermSetup);													UpDateTOn(true, HermSetup);													CS(2);												end;											'9': 												begin													privates^^.Trace[curNode^] := True;													privates^^.TraceType[curNode^] := 9;													UpDateTT(privates^^.TraceType[curNode^], HermSetup);													UpDateTOn(true, HermSetup);													CS(2);												end;											otherwise												begin													privates^^.Trace[curNode^] := false;													UpDateTT(privates^^.TraceType[curNode^], HermSetup);													UpDateTOn(false, HermSetup);													CS(2);												end;										end;										ANSICode('22;1H', procs[13]);										Outline('                                                 ', false, 0, procs[1]);										bCr(procs[0]);										Outline('   ', false, 0, procs[1]);									end;								30: 									begin										n[curNode^]^.curPrompt := '';										ANSICode('22;1H', procs[13]);										Outline('Enter File Name To Retrive.', false, 3, procs[1]);										bCr(procs[0]);										LettersPrompt('>', '', 31, false, false, false, chr(0), procs[4]);										ANSIPrompter(31, procs[9]);										CS(31);									end;								31: 									begin										if n[curNode^]^.CurPrompt <> '' then											begin												FOpen(concat(filesPath^, TerrainPath, n[curNode^]^.CurPrompt), fRefNum, HermSetup);												FReadTerrain(fRefNum, privates^^.Terrain[curNode^], HermSetup);												FClose(fRefNum, HermSetup);											end;										CS(1);									end;								35: 									begin										n[curNode^]^.curPrompt := '';										ANSICode('22;1H', procs[13]);										Outline('Save As...  [EnterFileName]', false, 3, procs[1]);										bCr(procs[0]);										LettersPrompt('>', '', 31, false, false, false, chr(0), procs[4]);										ANSIPrompter(31, procs[9]);										CS(36);									end;								36: 									begin										if n[curNode^]^.CurPrompt <> '' then											begin												if not FExist(concat(filesPath^, TerrainPath, n[curNode^]^.CurPrompt), procs[62]) then													FCreate(concat(filesPath^, TerrainPath, n[curNode^]^.CurPrompt), Hermsetup);												FOpen(concat(filesPath^, TerrainPath, n[curNode^]^.CurPrompt), fRefNum, HermSetup);												FWriteTerrain(fRefNum, privates^^.Terrain[curNode^], HermSetup);												FClose(fRefNum, HermSetup);											end;										CS(1);									end;								40: 									begin										n[curNode^]^.curPrompt := '';										ANSICode('22;1H', procs[13]);										YesNoQuestion('Re-Set Terrain? ', false, procs[6]);										CS(41);									end;								41: 									begin										if n[curNode^]^.CurPrompt = 'Y' then											begin												for x := 1 to 12 do													for y := 1 to 48 do														privates^^.Terrain[curNode^, x, y] := 0;												privates^^.R[curNode^] := 1;												privates^^.C[curNode^] := 1;												privates^^.Trace[curNode^] := false;											end;										CS(1);									end;								ShutDown: 									begin										Outline('Now Returning to the BBS', true, 5, procs[1]);										privates^^.activeOn[curNode^] := false;										privates^^.stage[curNode^] := 0;										n[curNode^]^.activeUserExternal := -1;									end;							end;	{Stage Case}						end;					otherwise				end;			end;	end;end.