# Keep the build context small and avoid leaking local state into the image.

/slycrel
/server
/out

# Local mutable state — must not be baked into the image.
/state

.DS_Store
*.swp
.vscode/
.idea/
.claude/

.git/
.gitignore

# Original Pascal/C++ reference — large and unused by the server build.
/orig

# Godot client has its own deploy pipeline.
/clients

# Cloudflare deploy artifacts (wrangler/Worker) — not part of the image.
/deploy

session-log.txt
session-planning-detail.txt
