# Binary (anchored to repo root — don't clobber cmd/slycrel/)
/slycrel

# Game state (player data, not source)
data/state/

# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.swp
*~

# Legacy archives (too large for git)
orig/**/*.zip
orig/**/*.sit

# SVN metadata from original source
orig/**/.svn/

# Claude Code internals
.claude/
state/

# Cloudflare Pages build artifact — the build copies /data into
# clients/web/data so absolute /data/... fetches resolve from the
# deploy root. Local dev doesn't need this; it serves from repo root.
/clients/web/data/

# Wrangler's local cache, written next to deploy.sh on each deploy.
.wrangler/
